{
  "schema": "FileFlow.Workflow.v2",
  "name": "Procesamiento por Lotes",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-buf",
      "nodeTypeName": "BatchBufferNode",
      "x": 330,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "BatchSize": 10
      }
    },
    {
      "id": "node-zip",
      "nodeTypeName": "ArchiveCompressorNode",
      "x": 560,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "DestinationFolder": "{GlobalOutputDir}"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-buf",
      "targetPortName": "ItemIn"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-buf",
      "sourcePortName": "ItemOut",
      "targetNodeId": "node-zip",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-zip",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}