      "targetNodeId": "node-rel",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-rel",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
