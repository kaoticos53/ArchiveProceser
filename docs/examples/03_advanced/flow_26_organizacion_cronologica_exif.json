      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-exif",
      "nodeTypeName": "ExifMetadataNode",
      "x": 330,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-rel",
      "nodeTypeName": "FileRelocatorNode",
      "x": 560,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "DestinationDirectory": "{RelativeDir}\\{Year}\\{Month}",
        "CreateDirectories": true
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    }
