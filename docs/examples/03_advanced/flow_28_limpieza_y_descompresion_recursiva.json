{
  "schema": "FileFlow.Workflow.v2",
  "name": "Descompresión Recursiva y Limpieza",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-unp",
      "nodeTypeName": "SmartUnpackNode",
      "x": 330,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "CleanRedundantFolder": true
      }
    },
    {
      "id": "node-clean",
      "nodeTypeName": "EmptyDirectoryCleanerNode",
      "x": 560,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-unp",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-unp",
      "sourcePortName": "Out",
      "targetNodeId": "node-clean",
      "targetPortName": "TriggerIn"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-clean",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}