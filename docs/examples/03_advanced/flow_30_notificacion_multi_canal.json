{
  "schema": "FileFlow.Workflow.v2",
  "name": "Notificación Multi-Canal",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 200,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-fork",
      "nodeTypeName": "ForkJoinBarrierNode",
      "x": 320,
      "y": 200,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-web",
      "nodeTypeName": "WebhookNotificationNode",
      "x": 550,
      "y": 100,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-log",
      "nodeTypeName": "LogOutputNode",
      "x": 550,
      "y": 300,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 200,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-fork",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-fork",
      "sourcePortName": "Fork1",
      "targetNodeId": "node-web",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-fork",
      "sourcePortName": "Fork2",
      "targetNodeId": "node-log",
      "targetPortName": "In"
    },
    {
      "id": "e4",
      "sourceNodeId": "node-web",
      "sourcePortName": "Out",
      "targetNodeId": "node-fork",
      "targetPortName": "Branch1_Done"
    },
    {
      "id": "e5",
      "sourceNodeId": "node-log",
      "sourcePortName": "Out",
      "targetNodeId": "node-fork",
      "targetPortName": "Branch2_Done"
    },
    {
      "id": "e6",
      "sourceNodeId": "node-fork",
      "sourcePortName": "AllCompleted",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}