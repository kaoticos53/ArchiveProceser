{
  "schema": "FileFlow.Workflow.v2",
  "name": "Regulación Rate-Limit",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-th",
      "nodeTypeName": "ThrottleDelayNode",
      "x": 330,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "DelayMilliseconds": 1000
      }
    },
    {
      "id": "node-web",
      "nodeTypeName": "WebhookNotificationNode",
      "x": 560,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-th",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-th",
      "sourcePortName": "Out",
      "targetNodeId": "node-web",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-web",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}