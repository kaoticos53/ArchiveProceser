{
  "name": "Filtro por Tamaño de Archivo",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 180,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-flt",
      "nodeTypeName": "ExpressionFilterNode",
      "x": 320,
      "y": 180,
      "hasBreakpoint": false,
      "parameters": {
        "PropertyPath": "FileSizeBytes",
        "Operator": ">",
        "TargetValue": "104857600"
      }
    },
    {
      "id": "node-zip",
      "nodeTypeName": "ArchiveCompressorNode",
      "x": 550,
      "y": 100,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 180,
      "hasBreakpoint": false,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-flt",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-flt",
      "sourcePortName": "Match",
      "targetNodeId": "node-zip",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-flt",
      "sourcePortName": "NoMatch",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    },
    {
      "id": "e4",
      "sourceNodeId": "node-zip",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}