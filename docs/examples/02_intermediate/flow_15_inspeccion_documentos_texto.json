{
  "name": "Inspección de Documentos",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-doc",
      "nodeTypeName": "DocumentProcessorNode",
      "x": 320,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "ExtractWordCount": true
      }
    },
    {
      "id": "node-flt",
      "nodeTypeName": "ExpressionFilterNode",
      "x": 540,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "PropertyPath": "WordCount",
        "Operator": ">=",
        "TargetValue": "10"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 760,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-doc",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-doc",
      "sourcePortName": "Out",
      "targetNodeId": "node-flt",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-flt",
      "sourcePortName": "Match",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}