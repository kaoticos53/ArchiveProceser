{
  "schema": "FileFlow.Workflow.v2",
  "name": "Ejecución CLI Externa",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-cli",
      "nodeTypeName": "CliExecutionNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "ExecutablePath": "cmd.exe",
        "ArgumentsTemplate": "/c echo Verificando {FileName}"
      }
    },
    {
      "id": "node-log",
      "nodeTypeName": "LogOutputNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-cli",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-cli",
      "sourcePortName": "Success",
      "targetNodeId": "node-log",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}