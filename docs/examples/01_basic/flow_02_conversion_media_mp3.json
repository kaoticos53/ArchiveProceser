{
  "name": "Extracción de Audio MP3",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "SourcePath": "{RelativeDir}\\Input"
      }
    },
    {
      "id": "node-tr",
      "nodeTypeName": "MediaTranscoderNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "Preset": "Extraer Audio MP3",
        "CustomArguments": "-vn -c:a libmp3lame -b:a 192k"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "DestinationRoot": "{RelativeDir}\\Output"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-tr",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-tr",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}
