{
  "name": "Limpieza de Carpetas Vacías",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "EmitMode": "DirectoriesOnly"
      }
    },
    {
      "id": "node-clean",
      "nodeTypeName": "EmptyDirectoryCleanerNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "Recursive": true
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-clean",
      "targetPortName": "TriggerIn"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-clean",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}
