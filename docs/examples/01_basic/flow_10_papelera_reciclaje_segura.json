{
  "schema": "FileFlow.Workflow.v2",
  "name": "Eliminación en Papelera de Reciclaje",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-del",
      "nodeTypeName": "SafeRecycleDeleteNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "DeleteOriginalPath": false
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-del",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-del",
      "sourcePortName": "Deleted",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}