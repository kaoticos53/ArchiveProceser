{
  "name": "Optimización y Conversión de Imágenes",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "SourcePath": "{RelativeDir}\\Input",
        "Recursive": true
      }
    },
    {
      "id": "node-opt",
      "nodeTypeName": "ImageOptimizerNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "TargetFormat": "WebP",
        "Quality": 80,
        "MaxWidth": 1920,
        "MaxHeight": 1080
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "DestinationRoot": "{RelativeDir}\\Output"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-opt",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-opt",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}