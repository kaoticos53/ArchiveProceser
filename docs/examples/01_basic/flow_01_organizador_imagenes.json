{
  "schema": "FileFlow.Workflow.v2",
  "name": "Optimización y Conversión de Imágenes",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "SourcePath": "{RelativeDir}\\Input",
        "Recursive": true
      }
    },
    {
      "id": "node-opt",
      "nodeTypeName": "ImageOptimizerNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "TargetFormat": "WebP",
        "Quality": 80,
        "Width": "1920",
        "Height": "1080"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "DestinationRoot": "{RelativeDir}\\Output"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-opt",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-opt",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}