{
  "name": "Renombrado con Fechas",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-rename",
      "nodeTypeName": "AdvancedRenamerNode",
      "x": 350,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {
        "NameTemplate": "{Year}-{Month}-{Day}_{FileName}"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 600,
      "y": 150,
      "hasBreakpoint": false,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-rename",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-rename",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
