{
  "schema": "FileFlow.Workflow.v2",
  "name": "Deduplicación y Archivado Frisado 7Z",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 200,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-hash",
      "nodeTypeName": "HashCalculatorNode",
      "x": 300,
      "y": 200,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "Algorithm": "SHA512"
      }
    },
    {
      "id": "node-dedup",
      "nodeTypeName": "DeduplicationFilterNode",
      "x": 500,
      "y": 200,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-7z",
      "nodeTypeName": "ArchiveCompressorNode",
      "x": 720,
      "y": 120,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "DestinationFolder": "{GlobalOutputDir}/Frio",
        "ArchiveFormat": "7Z",
        "CompressionType": "LZMA",
        "ArchiveName": "{FileNameWithoutExtension}.7z"
      }
    },
    {
      "id": "node-quar",
      "nodeTypeName": "OriginalFileActionNode",
      "x": 720,
      "y": 280,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "ActionType": "MoveToQuarantine"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 940,
      "y": 120,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-hash",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-hash",
      "sourcePortName": "Out",
      "targetNodeId": "node-dedup",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-dedup",
      "sourcePortName": "Unique",
      "targetNodeId": "node-7z",
      "targetPortName": "In"
    },
    {
      "id": "e4",
      "sourceNodeId": "node-dedup",
      "sourcePortName": "Duplicate",
      "targetNodeId": "node-quar",
      "targetPortName": "In"
    },
    {
      "id": "e5",
      "sourceNodeId": "node-7z",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}