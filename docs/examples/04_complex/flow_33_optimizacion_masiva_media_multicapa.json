{
  "name": "Optimización Multimedia Multicapa",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-flt",
      "nodeTypeName": "ExpressionFilterNode",
      "x": 320,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {
        "Operator": ">",
        "ComparisonValue": "52428800",
        "Property": "FileSizeBytes"
      }
    },
    {
      "id": "node-tr",
      "nodeTypeName": "MediaTranscoderNode",
      "x": 550,
      "y": 100,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-opt",
      "nodeTypeName": "ImageOptimizerNode",
      "x": 550,
      "y": 300,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-del",
      "nodeTypeName": "SafeRecycleDeleteNode",
      "x": 1000,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {
        "DeleteOriginalPath": false
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-flt",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-flt",
      "sourcePortName": "True",
      "targetNodeId": "node-tr",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-flt",
      "sourcePortName": "False",
      "targetNodeId": "node-opt",
      "targetPortName": "In"
    },
    {
      "id": "e4",
      "sourceNodeId": "node-tr",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    },
    {
      "id": "e5",
      "sourceNodeId": "node-opt",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    },
    {
      "id": "e6",
      "sourceNodeId": "node-snk",
      "sourcePortName": "Done",
      "targetNodeId": "node-del",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}
