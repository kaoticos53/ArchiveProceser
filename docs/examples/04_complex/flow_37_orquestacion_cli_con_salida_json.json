{
  "name": "Orquestación CLI con Captura de Salida",
  "globalOutputDir": "{RelativeDir}",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-cli",
      "nodeTypeName": "CliExecutionNode",
      "x": 320,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {
        "CaptureOutputToMetadata": true
      }
    },
    {
      "id": "node-flt",
      "nodeTypeName": "ExpressionFilterNode",
      "x": 550,
      "y": 200,
      "hasBreakpoint": false,
      "parameters": {
        "Operator": "Contains",
        "ComparisonValue": "OK",
        "Property": "CliOutput"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 780,
      "y": 120,
      "hasBreakpoint": false,
      "parameters": {}
    },
    {
      "id": "node-web",
      "nodeTypeName": "WebhookNotificationNode",
      "x": 780,
      "y": 280,
      "hasBreakpoint": false,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-cli",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-cli",
      "sourcePortName": "Success",
      "targetNodeId": "node-flt",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-flt",
      "sourcePortName": "True",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    },
    {
      "id": "e4",
      "sourceNodeId": "node-flt",
      "sourcePortName": "False",
      "targetNodeId": "node-web",
      "targetPortName": "In"
    }
  ],
  "breakpointNodeIds": []
}
