{
  "schema": "FileFlow.Workflow.v2",
  "name": "Ingesta Documental Empresarial",
  "globalOutputDir": "{RelativeDir}",
  "temporaryDirectory": "",
  "nodes": [
    {
      "id": "node-src",
      "nodeTypeName": "FolderSourceNode",
      "x": 100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-doc",
      "nodeTypeName": "DocumentProcessorNode",
      "x": 300,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    },
    {
      "id": "node-inj",
      "nodeTypeName": "VariableInjectorNode",
      "x": 500,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "Company": "EnterpriseCorp"
      }
    },
    {
      "id": "node-ren",
      "nodeTypeName": "AdvancedRenamerNode",
      "x": 700,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "PipelineName": "Renombrado Corporativo",
        "RenameMode": "DirectInPlace",
        "CollisionStrategy": "AutoIncrement",
        "MethodSteps": "[{\"id\":\"step_1\",\"name\":\"Plantilla Documental\",\"methodType\":\"NewName\",\"applyTo\":\"FullName\",\"pattern\":\"{Year}_DOC_{Guid}\",\"isEnabled\":true}]"
      }
    },
    {
      "id": "node-buf",
      "nodeTypeName": "BatchBufferNode",
      "x": 900,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "BatchSize": 50
      }
    },
    {
      "id": "node-zip",
      "nodeTypeName": "ArchiveCompressorNode",
      "x": 1100,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {
        "DestinationFolder": "{GlobalOutputDir}/Archivado"
      }
    },
    {
      "id": "node-snk",
      "nodeTypeName": "DestinationSinkNode",
      "x": 1300,
      "y": 150,
      "hasBreakpoint": false,
      "isLoggingEnabled": true,
      "parameters": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "sourceNodeId": "node-src",
      "sourcePortName": "Out",
      "targetNodeId": "node-doc",
      "targetPortName": "In"
    },
    {
      "id": "e2",
      "sourceNodeId": "node-doc",
      "sourcePortName": "Out",
      "targetNodeId": "node-inj",
      "targetPortName": "In"
    },
    {
      "id": "e3",
      "sourceNodeId": "node-inj",
      "sourcePortName": "Out",
      "targetNodeId": "node-ren",
      "targetPortName": "In"
    },
    {
      "id": "e4",
      "sourceNodeId": "node-ren",
      "sourcePortName": "Out",
      "targetNodeId": "node-buf",
      "targetPortName": "ItemIn"
    },
    {
      "id": "e5",
      "sourceNodeId": "node-buf",
      "sourcePortName": "ItemOut",
      "targetNodeId": "node-zip",
      "targetPortName": "In"
    },
    {
      "id": "e6",
      "sourceNodeId": "node-zip",
      "sourcePortName": "Out",
      "targetNodeId": "node-snk",
      "targetPortName": "In"
    }
  ],
  "annotations": [],
  "groups": [],
  "breakpointNodeIds": [],
  "disabledLoggingNodeIds": []
}