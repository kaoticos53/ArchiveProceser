  <!-- Network Nodes -->
  <data name="FtpUploadNode_Name" xml:space="preserve"><value>FTP / FTPS Upload</value></data>
  <data name="FtpUploadNode_Desc" xml:space="preserve"><value>Uploads files to an FTP or FTPS server with TLS/SSL encryption and auto-created remote directories.</value></data>
  <data name="FtpDownloadNode_Name" xml:space="preserve"><value>FTP / FTPS Download</value></data>
  <data name="FtpDownloadNode_Desc" xml:space="preserve"><value>Downloads files from an FTP or FTPS server to a local folder for pipeline processing.</value></data>
  <data name="SftpUploadNode_Name" xml:space="preserve"><value>SFTP / SSH Upload</value></data>
  <data name="SftpUploadNode_Desc" xml:space="preserve"><value>Securely transfers files via SFTP (SSH) to Linux/VPS servers supporting passwords and private keys.</value></data>
  <data name="SftpDownloadNode_Name" xml:space="preserve"><value>SFTP / SSH Download</value></data>
  <data name="SftpDownloadNode_Desc" xml:space="preserve"><value>Securely downloads files via SFTP (SSH) from Linux/VPS servers to a local folder.</value></data>
  <data name="WebDavUploadNode_Name" xml:space="preserve"><value>WebDAV / Nextcloud Upload</value></data>
  <data name="WebDavUploadNode_Desc" xml:space="preserve"><value>Uploads files to WebDAV storage servers (Nextcloud, ownCloud, NAS, Apache WebDAV).</value></data>
  <data name="SmbCopyNode_Name" xml:space="preserve"><value>SMB / Windows Share Copy</value></data>
  <data name="SmbCopyNode_Desc" xml:space="preserve"><value>Copies files to local network shares (UNC path) with optional Windows network credentials.</value></data>
  <data name="RemoteDownloadNode_Name" xml:space="preserve"><value>HTTP / HTTPS Remote Download</value></data>
