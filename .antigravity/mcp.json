{
  "mcpServers": {
    "memory": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory",
        "./.antigravity/memory_store.json"
      ],
      "env": {
        "MEMORY_FILE_PATH": "./.antigravity/memory_store.json"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "."
      ]
    },
    "ripgrep": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-ripgrep",
        "D:\\Users\\Ricardo\\Documents\\GitHub\\ArchiveProceser"
      ]
    },
    "uno": {
      "url": "https://mcp.platform.uno/v1"
    },
    "uno-app": {
      "command": "dotnet",
      "args": [
        "dnx",
        "-y",
        "uno.devserver",
        "--mcp-app",
        "--mcp-wait-tools-list"
      ]
    }
  }
}