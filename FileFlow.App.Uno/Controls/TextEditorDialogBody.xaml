<UserControl
    x:Class="FileFlow.App.Uno.Controls.TextEditorDialogBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileFlow.App.Uno.Platform">

  <!--
    El CUERPO del diálogo de edición de texto y prompts del host Uno: es la vista del view model
    PORTABLE `TextEditorDialogViewModel` (el mismo que envuelve la ventana del escritorio), servido
    dentro de un `ContentDialog` de WinUI por `UnoWindowService`.

    Lo que hace, y de dónde sale cada cosa:
      - la CAJA es la del usuario: `Text` en dos sentidos, así que cada tecla actualiza el view model
        y con él las estadísticas y la vista previa (las calcula el VM, no la vista);
      - «Insertar Variable» despliega el PANEL DE VARIABLES DEL PROPIO VM (`IsSidePanelVisible` +
        `FilteredSideVariables` + `SideSearchText`): el catálogo viaja en el VM y elegir una llama a
        `InsertTokenAt`, que inserta el token en el punto del cursor y devuelve el nuevo cursor. No se
        abre un segundo diálogo encima del primero (WinUI no admite dos a la vez en la misma raíz);
      - la VISTA PREVIA es la del VM (`VariableTemplateResolver` sobre el contexto real);
      - los TEXTOS son las claves del diccionario del host (`Uno_Dialog_*`), cuyos valores se copian
        del diccionario del escritorio: la misma regla que la barra del menú.
  -->
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid RowSpacing="8" MinWidth="560">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="6">
        <TextBox x:Name="EditorBox"
                 AcceptsReturn="True" Height="200" TextWrapping="Wrap" FontSize="12"
                 Text="{Binding Text, Mode=TwoWay}"
                 AutomationProperties.AutomationId="TextEditorBox" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="InsertVariableButton" Click="OnInsertVariableClicked"
                  Padding="10,4" FontSize="11"
                  AutomationProperties.AutomationId="TextEditorInsertVariableButton" />
          <Button x:Name="ClearButton" Click="OnClearClicked"
                  Padding="10,4" FontSize="11"
                  AutomationProperties.AutomationId="TextEditorClearButton" />
        </StackPanel>
      </StackPanel>

      <!-- El panel de variables del PROPIO view model (no un diálogo anidado). -->
      <Border x:Name="VariablePanelBorder" Grid.Column="1" Width="260" Padding="8" CornerRadius="6"
              VerticalAlignment="Top"
              Background="{StaticResource CanvasSurfaceBrush}"
              BorderBrush="{StaticResource CanvasBorderBrush}"
              BorderThickness="1"
              Visibility="{Binding IsSidePanelVisible, Converter={StaticResource BoolToVis}}"
              AutomationProperties.AutomationId="TextEditorVariablePanel">
        <StackPanel Spacing="6">
          <TextBlock x:Name="VariablesHeader" FontSize="11" FontWeight="SemiBold"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource CanvasTextBrush}" />
          <TextBox x:Name="VariableSearchBox" FontSize="11"
                   Text="{Binding SideSearchText, Mode=TwoWay}"
                   AutomationProperties.AutomationId="TextEditorVariableSearchBox" />
          <ListView x:Name="VariableList" MaxHeight="220" SelectionMode="Single"
                    ItemsSource="{Binding FilteredSideVariables}"
                    IsItemClickEnabled="True" ItemClick="OnVariableItemClicked"
                    AutomationProperties.AutomationId="TextEditorVariableList">
            <ListView.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="0">
                  <TextBlock Text="{Binding Token}" FontSize="11" FontWeight="SemiBold"
                             Foreground="{StaticResource CanvasAccentGlowBrush}" />
                  <TextBlock Text="{Binding Description}" FontSize="10"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource CanvasSecondaryBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </StackPanel>
      </Border>
    </Grid>

    <!-- La vista previa evaluada: la calcula el VM con el contexto real del nodo. -->
    <StackPanel Grid.Row="1" Spacing="2"
                Visibility="{Binding IsPreviewVisible, Converter={StaticResource BoolToVis}}">
      <TextBlock x:Name="PreviewLabel" FontSize="10" TextWrapping="Wrap"
                 Foreground="{StaticResource CanvasAccentGlowBrush}" />
      <TextBlock Text="{Binding PreviewText}" FontSize="11" TextWrapping="Wrap"
                 Foreground="{StaticResource CanvasSuccessBrush}" />
    </StackPanel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14">
      <TextBlock Text="{Binding CharCountText}" FontSize="10"
                 Foreground="{StaticResource CanvasSecondaryBrush}" />
      <TextBlock Text="{Binding WordCountText}" FontSize="10"
                 Foreground="{StaticResource CanvasSecondaryBrush}" />
      <TextBlock Text="{Binding LineCountText}" FontSize="10"
                 Foreground="{StaticResource CanvasSecondaryBrush}" />
    </StackPanel>
  </Grid>
</UserControl>
