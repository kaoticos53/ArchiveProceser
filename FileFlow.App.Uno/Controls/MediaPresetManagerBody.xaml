<UserControl
    x:Class="FileFlow.App.Uno.Controls.MediaPresetManagerBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FileFlow.Plugin.Integrations.UI.ViewModels"
    xmlns:svc="using:FileFlow.Plugin.Integrations.UI.Services">

  <!--
    El GESTOR DE PRESETS DE MEDIOS del host Uno: la vista del MediaPresetManagerViewModel portable del plugin
    de integraciones (el MISMO con el que el escritorio monta su ventana). Aquí no hay ni una regla del
    producto: qué presets hay, qué se normaliza al guardar, qué no se puede borrar y qué se confirma lo
    decide el view model; esta vista sólo lo enseña y le pasa lo que el usuario escribe.
  -->
  <Grid Margin="14" RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 1. Cabecera: el título, su explicación y el restablecimiento del catálogo -->
    <Grid Grid.Row="0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="2">
        <TextBlock x:Name="HeaderTitle" FontSize="14" FontWeight="Bold"
                   Foreground="{StaticResource CanvasAccentGlowBrush}" />
        <TextBlock x:Name="HeaderDesc" FontSize="11" TextWrapping="Wrap"
                   Foreground="{StaticResource CanvasSecondaryBrush}" />
      </StackPanel>

      <Button Grid.Column="1" x:Name="ResetButton" VerticalAlignment="Center" Padding="10,4" FontSize="11"
              Command="{Binding ResetDefaultsCommand}"
              AutomationProperties.AutomationId="PresetManagerResetButton">
        <TextBlock x:Name="ResetLabel" FontSize="11" />
      </Button>
    </Grid>

    <!-- 2. Cuerpo: el catálogo a la izquierda, el formulario del elegido a la derecha -->
    <Grid Grid.Row="1" ColumnSpacing="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="250" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid Grid.Column="0" RowSpacing="8">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CanvasCardBrush}" CornerRadius="6"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1" Padding="6">
          <ListView x:Name="PresetList" SelectionMode="Single" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding Presets}"
                    SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                    AutomationProperties.AutomationId="PresetManagerList">
            <ListView.ItemTemplate>
              <DataTemplate x:DataType="svc:MediaPreset">
                <!-- El nombre de automatización de la fila: sin él, el canal externo (lector de pantalla o
                     driver de QA) lee el NOMBRE DEL TIPO del elemento en vez del preset que la fila enseña. -->
                <StackPanel Padding="0,3" Spacing="1" AutomationProperties.Name="{Binding Name}">
                  <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis"
                             Foreground="{StaticResource CanvasTextBrush}" />
                  <TextBlock Text="{Binding OutputExtension}" FontSize="10"
                             Foreground="{StaticResource CanvasAccentGlowBrush}" />
                </StackPanel>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
          <Button x:Name="NewButton" Padding="10,5" FontSize="11"
                  Command="{Binding NewPresetCommand}"
                  AutomationProperties.AutomationId="PresetManagerNewButton">
            <TextBlock x:Name="NewLabel" FontSize="11" />
          </Button>
          <Button x:Name="DeleteButton" Padding="10,5" FontSize="11"
                  Command="{Binding DeletePresetCommand}"
                  AutomationProperties.AutomationId="PresetManagerDeleteButton">
            <TextBlock x:Name="DeleteLabel" FontSize="11"
                       Foreground="{StaticResource CanvasWarningBrush}" />
          </Button>
        </StackPanel>
      </Grid>

      <Border Grid.Column="1" Background="{StaticResource CanvasCardBrush}" CornerRadius="6"
              BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1" Padding="14">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="FormPanel" Spacing="10">

            <TextBlock x:Name="FormTitle" FontSize="12" FontWeight="Bold"
                       Foreground="{StaticResource CanvasTextBrush}" />

            <StackPanel Spacing="4">
              <TextBlock x:Name="NameLabel" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource CanvasSecondaryBrush}" />
              <TextBox x:Name="NameBox" Padding="6,4" FontSize="11"
                       Text="{Binding PresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.AutomationId="PresetManagerNameBox" />
            </StackPanel>

            <Grid ColumnSpacing="10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock x:Name="CategoryLabel" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
                <ComboBox x:Name="CategoryBox" HorizontalAlignment="Stretch" FontSize="11"
                          ItemsSource="{Binding Categories}"
                          SelectedItem="{Binding Category, Mode=TwoWay}"
                          AutomationProperties.AutomationId="PresetManagerCategoryBox" />
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock x:Name="ExtensionLabel" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
                <TextBox x:Name="ExtensionBox" Padding="6,4" FontSize="11"
                         Text="{Binding OutputExtension, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="PresetManagerExtensionBox" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock x:Name="DescriptionLabel" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource CanvasSecondaryBrush}" />
              <TextBox x:Name="DescriptionBox" Padding="6,4" FontSize="11" Height="52" AcceptsReturn="True"
                       TextWrapping="Wrap"
                       Text="{Binding PresetDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.AutomationId="PresetManagerDescriptionBox" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock x:Name="FfmpegLabel" FontSize="11" FontWeight="SemiBold"
                         Foreground="{StaticResource CanvasSecondaryBrush}" />
              <TextBox x:Name="FfmpegBox" Padding="6,4" FontSize="11" Height="62" AcceptsReturn="True"
                       TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace"
                       Text="{Binding FfmpegArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                       AutomationProperties.AutomationId="PresetManagerFfmpegBox" />
            </StackPanel>

            <Button x:Name="SaveButton" Padding="14,6" HorizontalAlignment="Right" FontSize="11"
                    Command="{Binding SaveCurrentCommand}"
                    IsEnabled="{Binding HasSelection}"
                    AutomationProperties.AutomationId="PresetManagerSaveButton">
              <TextBlock x:Name="SaveLabel" FontSize="11" />
            </Button>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- 3. Pie: cerrar la superficie (el modal lo posee el servicio de ventanas, no esta vista) -->
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button x:Name="CloseButton" Padding="16,6" FontSize="11" Click="OnCloseClicked"
              AutomationProperties.AutomationId="PresetManagerCloseButton">
        <TextBlock x:Name="CloseLabel" FontSize="11" />
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
