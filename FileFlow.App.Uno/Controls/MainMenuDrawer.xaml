<UserControl
    x:Class="FileFlow.App.Uno.Controls.MainMenuDrawer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    El CAJÓN del menú principal del host Uno: el mismo cajón de la versión anterior (el Border de 320 px de
    MainWindow.axaml) sobre el mismo estado (ControlBarViewModel.IsMenuOpen, que conmuta el botón «Menú»
    de la barra y este propio cajón).

    LO QUE ESTÁ: las secciones cuyas entradas tienen destino real en este host — APARIENCIA E IDIOMA (el
    tema y el idioma del propio ControlBar, que aplican y guardan al elegir, más el punto de entrada a la
    superficie de AJUSTES del host) y PANELES Y HERRAMIENTAS (el Inspector). El pie enseña la versión del
    producto, como la versión anterior.

    GESTIÓN DE FLUJOS (hito 258) y AYUDA Y RECURSOS, más el ESTUDIO DE TEMAS, las MÉTRICAS y el VFS (hito
    259). Las de flujo se cumplen por el canal ASÍNCRONO del host —sus comandos del núcleo piden un diálogo
    SÍNCRONO que desde el hilo de UI devuelve nulo/falso— y las cuatro de ventana por el catálogo de diálogos
    del host, que es quien las sirve.

    LO QUE NO ESTÁ, Y POR QUÉ: el DISEÑADOR DE DATASETS de la versión anterior, porque su ventana la monta el propio
    plugin con el toolkit nativo y este host es WinUI (declarado en DeclaredPendingEntries). Todo lo que
    falta queda declarado en el plan de la rebanada 5 y en el informe, nunca como un botón mudo.
  -->
  <Grid x:Name="OverlayRoot" Visibility="Collapsed">
    <Border x:Name="Scrim" Background="#A6000000" Tapped="OnScrimTapped"
            AutomationProperties.AutomationId="DrawerScrim" />

    <Border x:Name="DrawerPanel"
            HorizontalAlignment="Left" Width="320"
            Background="{StaticResource CanvasSurfaceBrush}"
            BorderBrush="{StaticResource CanvasBorderBrush}"
            BorderThickness="0,0,1,0"
            AutomationProperties.AutomationId="MainMenuDrawer">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera del cajón -->
        <Border Grid.Row="0" Background="{StaticResource CanvasCardBrush}"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="0,0,0,1"
                Padding="16,12">
          <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="{StaticResource CanvasAccentPrimaryBrush}" CornerRadius="6"
                      Width="30" Height="30">
                <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource CanvasOnAccentBrush}" />
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="DrawerTitle" FontSize="14" FontWeight="Bold"
                           Foreground="{StaticResource CanvasTextBrush}" />
                <TextBlock x:Name="DrawerSubtitle" FontSize="11"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
              </StackPanel>
            </StackPanel>

            <Button x:Name="DrawerCloseButton" Grid.Column="1" Click="OnCloseClicked"
                    VerticalAlignment="Center" Padding="7,3" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerCloseButton">
              <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource CanvasTextBrush}" />
            </Button>
          </Grid>
        </Border>

        <!-- Secciones del cajón -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <StackPanel Padding="14,12" Spacing="10">

            <TextBlock x:Name="FlowSectionLabel" FontSize="10" FontWeight="Bold"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />

            <!-- GESTIÓN DE FLUJOS (hito 258): las tres órdenes de la versión anterior que dependen de un diálogo.
                 Se cumplen por el canal ASÍNCRONO del host (los pickers de WinRT y la confirmación
                 asíncrona) más los métodos del view model portable que ya no necesitan el diálogo: el
                 comando del núcleo pide el contrato SÍNCRONO, que desde el hilo de UI devuelve nulo/falso. -->
            <Button x:Name="DrawerNewButton" Click="OnNewWorkflowClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerNewButton">
              <TextBlock x:Name="DrawerNewLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="DrawerLoadButton" Click="OnLoadWorkflowClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerLoadButton">
              <TextBlock x:Name="DrawerLoadLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="DrawerSaveButton" Click="OnSaveWorkflowClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerSaveButton">
              <TextBlock x:Name="DrawerSaveLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <TextBlock x:Name="AppearanceSectionLabel" FontSize="10" FontWeight="Bold" Margin="0,10,0,0"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />

            <StackPanel Spacing="4">
              <TextBlock x:Name="ThemeLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
              <ComboBox x:Name="ThemeCombo" FontSize="12" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AvailableThemes}"
                        SelectedValue="{Binding SelectedTheme, Mode=TwoWay}"
                        SelectedValuePath="Id" DisplayMemberPath="Name"
                        AutomationProperties.AutomationId="ControlBarThemeCombo" />
            </StackPanel>

            <StackPanel Spacing="4">
              <TextBlock x:Name="LanguageLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
              <ComboBox x:Name="LanguageCombo" FontSize="12" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AvailableLanguages}"
                        SelectedValue="{Binding SelectedLanguage, Mode=TwoWay}"
                        SelectedValuePath="Code" DisplayMemberPath="DisplayName"
                        AutomationProperties.AutomationId="ControlBarLanguageCombo" />
            </StackPanel>

            <!-- ESTUDIO DE TEMAS (hito 259): la orden canónica de la versión anterior, que pide su ventana por el
                 catálogo de diálogos. Aquí la sirve el servicio del host como superficie propia. -->
            <Button x:Name="DrawerThemeStudioButton" Click="OnThemeStudioClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerThemeStudioButton">
              <TextBlock x:Name="DrawerThemeStudioLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="DrawerSettingsButton" Click="OnSettingsClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerSettingsButton">
              <TextBlock x:Name="DrawerSettingsLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <TextBlock x:Name="PanelsSectionLabel" FontSize="10" FontWeight="Bold" Margin="0,10,0,0"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />

            <Button x:Name="DrawerInspectorButton" Click="OnInspectorClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerInspectorButton">
              <TextBlock x:Name="DrawerInspectorLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <!-- MÉTRICAS Y VFS (hito 259): las dos órdenes canónicas de la versión anterior, servidas por el
                 catálogo de diálogos del host (superficies propias, no ventanas nuevas). -->
            <Button x:Name="DrawerMetricsButton" Click="OnMetricsClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerMetricsButton">
              <TextBlock x:Name="DrawerMetricsLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="DrawerVfsButton" Click="OnVfsClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerVfsButton">
              <TextBlock x:Name="DrawerVfsLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <!-- DISEÑADOR DE DATASETS (hito 261): la superficie que declara el NODO de datos sintéticos por el
                 contrato del SDK. La x que necesita el host no es la ventana del plugin original sino su
                 view model portable, y el cajón sólo declara QUÉ orden se ha pedido: la ventana la sirve con
                 su propio catálogo de diálogos. -->
            <Button x:Name="DrawerDataSetButton" Click="OnDataSetDesignerClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerDataSetButton">
              <TextBlock x:Name="DrawerDataSetLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <TextBlock x:Name="HelpSectionLabel" FontSize="10" FontWeight="Bold" Margin="0,10,0,0"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />

            <!-- AYUDA Y RECURSOS (hito 258): las tres órdenes canónicas de la versión anterior. Manual y Ejemplos
                 abren con el shell lo que el ViewModel localiza (el mismo camino que la versión anterior);
                 «Acerca de» pasa por el servicio de ventanas del host. -->
            <Button x:Name="DrawerManualButton" Click="OnUserManualClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerManualButton">
              <TextBlock x:Name="DrawerManualLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="DrawerExamplesButton" Click="OnExamplesClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerExamplesButton">
              <TextBlock x:Name="DrawerExamplesLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>

            <Button x:Name="DrawerAboutButton" Click="OnAboutClicked"
                    HorizontalAlignment="Stretch" Padding="10,6" FontSize="12"
                    Background="Transparent" BorderThickness="1"
                    BorderBrush="{StaticResource CanvasBorderBrush}"
                    AutomationProperties.AutomationId="ControlBarDrawerAboutButton">
              <TextBlock x:Name="DrawerAboutLabel" FontSize="12"
                         Foreground="{StaticResource CanvasTextBrush}" />
            </Button>
          </StackPanel>
        </ScrollViewer>

        <!-- Pie del cajón: la versión del producto, como el de la versión anterior -->
        <Border Grid.Row="2" Background="{StaticResource CanvasCardBrush}"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="0,1,0,0"
                Padding="14,9">
          <StackPanel HorizontalAlignment="Center" Spacing="2">
            <TextBlock x:Name="DrawerVersion" FontSize="11" FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource CanvasTextBrush}" />
            <TextBlock Text="© RGLara" FontSize="10" HorizontalAlignment="Center"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
