<UserControl
    x:Class="FileFlow.App.Uno.Controls.EditorCanvasControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileFlow.App.Uno.Controls">

  <!-- Tokens medidos del tema oscuro (builtin_themes.json / DarkTheme.axaml del escritorio) -->
  <UserControl.Resources>
    <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#10131B" />
    <SolidColorBrush x:Key="CanvasGridBrush" Color="#21262D" />
    <SolidColorBrush x:Key="CanvasCardBrush" Color="#161B22" />
    <SolidColorBrush x:Key="CanvasBorderBrush" Color="#30363D" />
    <SolidColorBrush x:Key="CanvasTextBrush" Color="#F0F6FC" />
    <SolidColorBrush x:Key="CanvasMutedBrush" Color="#7C8698" />
    <SolidColorBrush x:Key="CanvasWireBrush" Color="#818CF8" />
    <x:Double x:Key="CanvasGridStep">25</x:Double>
  </UserControl.Resources>

  <Grid x:Name="RootGrid" Background="{StaticResource CanvasBackgroundBrush}"
        PointerPressed="OnCanvasPressed" PointerReleased="OnCanvasReleased"
        PointerMoved="OnCanvasMoved" PointerCaptureLost="OnCanvasReleased">

    <!-- Grid de fondo dibujado por el code-behind (paso 25, el doble drenado del editor) -->
    <Canvas x:Name="GridLayer" IsHitTestVisible="False" />

    <!-- El plano del grafo: pan (arrastre) + zoom (rueda/botones). La geometría vive en espacio de grafo. -->
    <Canvas x:Name="CanvasPlane">
      <Canvas.RenderTransform>
        <CompositeTransform x:Name="CanvasTransform" ScaleX="1" ScaleY="1" TranslateX="0" TranslateY="0" />
      </Canvas.RenderTransform>

      <!-- Cables: debajo de las tarjetas; los calcula el code-behind con ConnectionGeometry -->
      <Canvas x:Name="WireLayer" IsHitTestVisible="False" />

      <!-- Tarjetas de nodo: la POSICIÓN la aplica NodeLayoutApplier (con el conversor del 217) -->
      <ItemsControl x:Name="NodesHost" ItemsSource="{Binding Nodes}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <Canvas />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <controls:NodeCardView />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Canvas>

    <!-- Barra de zoom (el estándar del editor) -->
    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,16"
            Background="{StaticResource CanvasCardBrush}" BorderBrush="{StaticResource CanvasBorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="8,4">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="−" Click="OnZoomOut" Background="Transparent" BorderThickness="0" MinWidth="32" Padding="0" />
        <TextBlock x:Name="ZoomText" Text="100 %" VerticalAlignment="Center" Width="44" TextAlignment="Center"
                   Foreground="{StaticResource CanvasTextBrush}" />
        <Button Content="+" Click="OnZoomIn" Background="Transparent" BorderThickness="0" MinWidth="32" Padding="0" />
        <Button Content="Ajustar" Click="OnFitToScreen" Background="Transparent" BorderThickness="0" Padding="8,2" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
