<UserControl
    x:Class="FileFlow.App.Uno.Controls.PasswordManagerBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    El GESTOR DE CONTRASEÑAS del host Uno: la vista del PasswordManagerViewModel portable del plugin de
    archivos (el MISMO con el que el escritorio monta su ventana). Aquí no hay ni una regla del producto:
    qué es una clave, cuántas hay, qué se guarda en el parámetro del nodo y qué se lee o escribe en el .txt
    lo decide el view model; esta vista sólo lo enseña y le pasa lo que el usuario escribe.
  -->
  <Grid Margin="14" RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- 1. Cabecera: el título y su explicación -->
    <StackPanel Grid.Row="0" Spacing="2">
      <TextBlock x:Name="HeaderTitle" FontSize="14" FontWeight="Bold"
                 Foreground="{StaticResource CanvasAccentGlowBrush}" />
      <TextBlock x:Name="HeaderDesc" FontSize="11" TextWrapping="Wrap"
                 Foreground="{StaticResource CanvasSecondaryBrush}" />
    </StackPanel>

    <!-- 2. Importar / Exportar (el archivo lo elige el host) y el recuento del view model -->
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0" x:Name="ImportButton" Padding="10,4" FontSize="11" Click="OnImportClicked"
              AutomationProperties.AutomationId="PasswordManagerImportButton">
        <TextBlock x:Name="ImportLabel" FontSize="11" />
      </Button>

      <Button Grid.Column="1" x:Name="ExportButton" Padding="10,4" FontSize="11" Click="OnExportClicked"
              AutomationProperties.AutomationId="PasswordManagerExportButton">
        <TextBlock x:Name="ExportLabel" FontSize="11" />
      </Button>

      <TextBlock Grid.Column="2" x:Name="CountText" FontSize="11" FontWeight="SemiBold"
                 HorizontalAlignment="Right" VerticalAlignment="Center"
                 Text="{Binding CountLabel}"
                 Foreground="{StaticResource CanvasSecondaryBrush}"
                 AutomationProperties.AutomationId="PasswordManagerCountText" />
    </Grid>

    <!-- 3. El editor: una clave por línea -->
    <Border Grid.Row="2" Background="{StaticResource CanvasCardBrush}" CornerRadius="6"
            BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1" Padding="4">
      <TextBox x:Name="EditorBox"
               AcceptsReturn="True"
               TextWrapping="NoWrap"
               FontFamily="Cascadia Code, Consolas, monospace"
               FontSize="12"
               Background="Transparent"
               BorderThickness="0"
               Padding="8"
               Height="220"
               Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               AutomationProperties.AutomationId="PasswordManagerEditorBox" />
    </Border>
  </Grid>
</UserControl>
