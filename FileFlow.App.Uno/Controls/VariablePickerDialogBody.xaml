<UserControl
    x:Class="FileFlow.App.Uno.Controls.VariablePickerDialogBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileFlow.App.Uno.Platform">

  <!--
    El CUERPO del selector de variables del host Uno: la vista del view model PORTABLE
    `VariablePickerViewModel` (el mismo que envuelve la ventana del escritorio), servido dentro de un
    `ContentDialog` de WinUI por `UnoWindowService`.

    El catálogo, el filtro por texto y por categoría, el detalle y el token elegido son del VM: esta
    vista sólo los enseña y devuelve el token por el botón primario del diálogo (o por el doble clic,
    que es el `InsertSelectedCommand` del VM). Los textos salen del diccionario del host (`Uno_Dialog_*`
    para los rótulos de la vista; las claves canónicas del producto para lo que el VM compone).
  -->
  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
  </UserControl.Resources>

  <Grid RowSpacing="8" MinWidth="620" MaxHeight="460">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="12"
               Text="{Binding SearchText, Mode=TwoWay}"
               AutomationProperties.AutomationId="VariablePickerSearchBox" />

      <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontSize="10"
                 Text="{Binding CountStatusText}"
                 Foreground="{StaticResource CanvasSecondaryBrush}"
                 AutomationProperties.AutomationId="VariablePickerCountText" />
    </Grid>

    <Grid Grid.Row="1" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <ListView x:Name="VariablesList" Grid.Column="0" SelectionMode="Single"
                ItemsSource="{Binding FilteredVariables}"
                SelectedItem="{Binding SelectedVariable, Mode=TwoWay}"
                AutomationProperties.AutomationId="VariablePickerList">
        <ListView.ItemTemplate>
          <DataTemplate>
            <StackPanel Spacing="0">
              <TextBlock Text="{Binding Token}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource CanvasAccentGlowBrush}" />
              <TextBlock Text="{Binding Description}" FontSize="10"
                         TextTrimming="CharacterEllipsis"
                         Foreground="{StaticResource CanvasSecondaryBrush}" />
            </StackPanel>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>

      <Border Grid.Column="1" Width="250" Padding="10" CornerRadius="6"
              VerticalAlignment="Stretch"
              Background="{StaticResource CanvasSurfaceBrush}"
              BorderBrush="{StaticResource CanvasBorderBrush}"
              BorderThickness="1"
              Visibility="{Binding HasSelectedVariable, Converter={StaticResource BoolToVis}}">
        <StackPanel Spacing="6">
          <TextBlock x:Name="DetailTitle" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource CanvasTextBrush}" />

          <TextBlock x:Name="TokenLabel" FontSize="10"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock x:Name="DetailTokenBlock" Text="{Binding DetailToken}" FontSize="11" FontWeight="SemiBold"
                     TextWrapping="Wrap" IsTextSelectionEnabled="True"
                     Foreground="{StaticResource CanvasAccentGlowBrush}"
                     AutomationProperties.AutomationId="VariablePickerDetailToken" />

          <TextBlock x:Name="DescriptionLabel" FontSize="10"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Text="{Binding DetailDescription}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource CanvasTextBrush}" />

          <TextBlock x:Name="CategoryLabel" FontSize="10"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Text="{Binding DetailCategory}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource CanvasTextBrush}" />

          <TextBlock x:Name="SourceLabel" FontSize="10"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Text="{Binding DetailSource}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource CanvasTextBrush}" />

          <TextBlock x:Name="SampleLabel" FontSize="10"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Text="{Binding DetailEvaluated}" FontSize="11" TextWrapping="Wrap"
                     Foreground="{StaticResource CanvasSuccessBrush}"
                     AutomationProperties.AutomationId="VariablePickerDetailEvaluated" />

          <Button x:Name="CopyTokenButton" Click="OnCopyTokenClicked"
                  Padding="10,4" FontSize="11" Margin="0,4,0,0"
                  AutomationProperties.AutomationId="VariablePickerCopyTokenButton" />
        </StackPanel>
      </Border>
    </Grid>

    <TextBlock x:Name="NoResultsText" Grid.Row="2" FontSize="11"
               Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVis}}"
               Foreground="{StaticResource CanvasWarningBrush}" />
  </Grid>
</UserControl>
