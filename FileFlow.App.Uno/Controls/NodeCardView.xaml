<UserControl
    x:Class="FileFlow.App.Uno.Controls.NodeCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Border Width="220" Background="{StaticResource CanvasCardBrush}"
          BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1" CornerRadius="8">
    <StackPanel>
      <!-- Cabecera -->
      <Border Background="{StaticResource CanvasCardBrush}" BorderThickness="0,0,0,1"
              BorderBrush="{StaticResource CanvasBorderBrush}" CornerRadius="8,8,0,0" Padding="10,6">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource CanvasTextBrush}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="1" Text="{Binding Category}" FontSize="10"
                     Foreground="{StaticResource CanvasMutedBrush}" />
        </Grid>
      </Border>
      <!-- Cuerpo: descripción en modo lectura -->
      <TextBlock Text="{Binding Description}" FontSize="10.5" Margin="10,8" TextWrapping="Wrap"
                 MaxLines="4" TextTrimming="CharacterEllipsis"
                 Foreground="{StaticResource CanvasMutedBrush}" />
    </StackPanel>
  </Border>
</UserControl>
