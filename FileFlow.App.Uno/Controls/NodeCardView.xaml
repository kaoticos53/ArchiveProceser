<UserControl
    x:Class="FileFlow.App.Uno.Controls.NodeCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileFlow.App.Uno.Platform">

  <!-- La tarjeta completa del lienzo Uno: la misma jerarquía que la NodeCardView del host original
       (559 líneas de referencia), traducida a XAML WinUI. Donde la versión anterior usa clases de estilo
       (combinaciones de bools del VM), WinUI exige conversores que devuelvan el valor final — la
       matriz de colores es la misma (Platform/SocketConverters.cs). Los puertos se dibujan con su
       forma/tipo/estado pero sin interacción hasta la fase 3.3. -->

  <UserControl.Resources>
    <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <conv:InverseBoolToVisibilityConverter x:Key="InvBoolToVis" />
    <conv:NodeExecutionStatusToBrushConverter x:Key="StatusToBrush" />
    <conv:BreakpointToBrushConverter x:Key="BreakpointToBrush" />
    <conv:LoggingToBrushConverter x:Key="LoggingToBrush" />
    <conv:DurationMsToTextConverter x:Key="DurationToText" />
    <conv:BytesToTextConverter x:Key="BytesToText" />
    <conv:MaterialIconKindToGeometryConverter x:Key="IconToGeometry" />
    <conv:SocketColorConverter x:Key="SocketColor" />
    <conv:SocketFillConverter x:Key="SocketFill" />
    <conv:SocketTriangleFillConverter x:Key="SocketTriangleFill" />
    <conv:SocketStateOpacityConverter x:Key="SocketOpacity" />
    <conv:SocketRadiusConverter x:Key="SocketRadius" />
    <conv:SocketLabelOpacityConverter x:Key="SocketLabelOpacity" />

    <!-- Tokens Canvas* unificados en App.xaml (fase 3.5): los resuelve la app y UnoThemeHost los
         republica al cambiar de tema. Aquí sólo queda la densidad local de la tarjeta. -->
    <x:Double x:Key="CanvasFontMicro">11</x:Double>

  </UserControl.Resources>

  <!-- El adaptador de lectura que el lienzo pone como DataContext: Node para el contenido de tarjeta,
       Position para el code-behind (la proyección del 217). -->
  <Grid Width="{Binding Node.Width}">
    <!-- Glows de estado (selección / ejecución / error): borde exterior sobre el fondo del lienzo -->
    <Border BorderBrush="{StaticResource CanvasAccentPrimaryBrush}" BorderThickness="2" CornerRadius="10"
            Margin="-2" IsHitTestVisible="False"
            Visibility="{Binding Node.IsSelected, Converter={StaticResource BoolToVis}}" />
    <Border BorderBrush="{StaticResource CanvasSuccessBrush}" BorderThickness="2" CornerRadius="10"
            Margin="-2" IsHitTestVisible="False"
            Visibility="{Binding Node.IsExecuting, Converter={StaticResource BoolToVis}}" />
    <Border BorderBrush="{StaticResource CanvasPurpleBrush}" BorderThickness="2" CornerRadius="10"
            Margin="-2" IsHitTestVisible="False"
            Visibility="{Binding Node.IsFaulted, Converter={StaticResource BoolToVis}}" />

    <Border Background="{StaticResource CanvasCardBrush}"
            BorderBrush="{StaticResource CanvasBorderBrush}"
            BorderThickness="1" CornerRadius="8">
      <StackPanel>
        <!-- ================= Cabecera ================= -->
        <Border Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{StaticResource CanvasBorderBrush}">
          <StackPanel>
            <!-- Barra de acento de categoría (la franja neón superior) -->
            <Border Height="8" Margin="-16,-6,-16,7">
              <Border.Background>
                <!-- El Color del brush se bindiga aquí en el NodeCardViewModel (no en Node): es la
                     propiedad del adaptador que el conversor del 217 ya proyectó. Un binding a
                     Node.* dentro de un SolidColorBrush no resuelve en WinUI y la franja queda
                     transparente — defecto que la comparación visual del 226 destapó. -->
                <SolidColorBrush Color="{Binding AccentBrushColor}" />
              </Border.Background>
            </Border>

            <!-- LÍNEA 1 · Identidad: icono del tipo, título, breakpoint, logging, parámetros -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <!-- Icono del tipo sobre el fondo del acento: path data del paquete Material.Icons (los
                   mismos datos que la versión anterior), resuelta a geometría ASIGNABLE por el conversor. -->
              <Border Grid.Column="0" Width="22" Height="22" CornerRadius="6" Margin="0,0,8,0"
                      Background="{StaticResource CanvasSurfaceBrush}"
                      BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                      ToolTipService.ToolTip="{Binding Node.Category}">
                <Path x:Name="TypeIcon" Width="13" Height="13" Stretch="Uniform"
                      Data="{Binding Node.Icon, Converter={StaticResource IconToGeometry}}">
                  <Path.Fill>
                    <SolidColorBrush Color="{Binding AccentBrushColor}" />
                  </Path.Fill>
                </Path>
              </Border>

              <!-- Título / caja de renombrado (la edición llega en la fase 3.2; la caja ya existe).
                   x:Name: el sondeo en runtime (modo selfcheck) lee este TextBlock para verificar que el
                   binding {Binding Node.Title} produjo texto real en el control, no sólo en el VM. -->
              <TextBlock x:Name="TitleText" Grid.Column="1" Text="{Binding Node.Title}" FontSize="12" FontWeight="SemiBold"
                         Foreground="{StaticResource CanvasTextBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"
                         Visibility="{Binding Node.IsEditingTitle, Converter={StaticResource InvBoolToVis}}" />
              <TextBox x:Name="TitleEditBox" Grid.Column="1" Text="{Binding Node.EditingTitleText, Mode=TwoWay}" FontSize="12"
                       FontWeight="SemiBold" Margin="-2,0,0,0" VerticalAlignment="Center"
                       Background="{StaticResource CanvasSurfaceBrush}"
                       Foreground="{StaticResource CanvasTextBrush}"
                       BorderBrush="{StaticResource CanvasAccentPrimaryBrush}" BorderThickness="1"
                       MinWidth="120"
                       KeyDown="OnTitleEditBoxKeyDown"
                       LostFocus="OnTitleEditBoxLostFocus"
                       Visibility="{Binding Node.IsEditingTitle, Converter={StaticResource BoolToVis}}" />

              <!-- Breakpoint (LED circular) y logging (LED cuadrado cian) -->
              <Button Grid.Column="2" Command="{Binding Node.ToggleBreakpointCommand}"
                      Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,5,0">
                <Ellipse Width="11" Height="11"
                         Fill="{Binding Node.HasBreakpoint, Converter={StaticResource BreakpointToBrush}}"
                         Stroke="{StaticResource CanvasBorderBrush}" StrokeThickness="1.5" />
              </Button>
              <Button Grid.Column="3" Command="{Binding Node.ToggleLoggingCommand}"
                      Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0">
                <Border Width="14" Height="14" CornerRadius="4"
                        Background="{Binding Node.IsLoggingEnabled, Converter={StaticResource LoggingToBrush}}"
                        BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1">
                  <Path x:Name="ConsoleGlyph" Width="9" Height="9" Stretch="Uniform"
                        Fill="{StaticResource CanvasOnAccentBrush}"
                        Data="{Binding ConsoleIconGeometry}" />
                </Border>
              </Button>

              <!-- Conmutador del panel de ACCIONES (el chevron de la versión anterior). Sin él la tarjeta no
                   tiene forma de desplegarse, y el panel es el que trae las acciones rápidas del nodo
                   —entre ellas el «🎬 Presets...» del nodo de transcodificación—: la puerta de la
                   tarjeta quedaría dibujada y sin puerta. El estado es del NÚCLEO (la misma IsExpanded
                   que la versión anterior conmuta), así que aquí sólo se pinta y se conmuta.

                   El conmutador SÓLO se dibuja si el nodo declara acciones: sin ellas el panel no
                   tendría nada que enseñar y el chevron sería un botón que no hace nada al pulsarlo.
                   El x:Name sigue siendo «ParametersToggle» porque es un ancla estable de las sondas
                   en runtime y de las guardias; lo que se despliega ya no son parámetros. -->
              <ToggleButton x:Name="ParametersToggle" Grid.Column="4"
                            IsChecked="{Binding Node.IsExpanded, Mode=TwoWay}"
                            Visibility="{Binding HasCustomActions, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.AutomationId="NodeCardExpandToggle"
                            AutomationProperties.Name="{Binding ParametersToggleToolTip}"
                            ToolTipService.ToolTip="{Binding ParametersToggleToolTip}"
                            Background="Transparent" BorderThickness="0" Padding="3,0" Margin="3,0,0,0"
                            VerticalAlignment="Center">
                <Path x:Name="ParametersIcon" Width="10" Height="10" Stretch="Uniform"
                      Data="{Binding ExpandIconGeometry}"
                      Fill="{StaticResource CanvasSecondaryBrush}" />
              </ToggleButton>
            </Grid>

            <!-- LÍNEA 2 · Contexto: badge de categoría, LED de estado, texto de estado, cuello de botella -->
            <Grid Margin="0,7,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0" Background="{StaticResource CanvasSurfaceBrush}"
                      BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                      CornerRadius="999" Padding="5,1" VerticalAlignment="Center">
                <TextBlock Text="{Binding Node.Category}" FontSize="{StaticResource CanvasFontMicro}"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
              </Border>

              <Ellipse Grid.Column="1" Width="7" Height="7" Margin="7,0,5,0" VerticalAlignment="Center"
                       Fill="{Binding Node.ExecutionStatus, Converter={StaticResource StatusToBrush}}" />

              <TextBlock Grid.Column="2" Text="{Binding Node.ExecutionStatusText}"
                         FontSize="{StaticResource CanvasFontMicro}"
                         Foreground="{StaticResource CanvasSecondaryBrush}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis" />

              <!-- Cuello de botella: badge ámbar con el ratio -->
              <Border Grid.Column="3" Background="{StaticResource CanvasWarningBrush}"
                      CornerRadius="999" Padding="4,1" VerticalAlignment="Center"
                      Visibility="{Binding Node.IsBottleneck, Converter={StaticResource BoolToVis}}">
                  <StackPanel Orientation="Horizontal" Spacing="3">
                    <Path Width="9" Height="9" Stretch="Uniform" Fill="{StaticResource CanvasOnAccentBrush}"
                          Data="{Binding AlertIconGeometry}" />
                    <TextBlock Text="{Binding Node.BottleneckRatioText}"
                               FontSize="{StaticResource CanvasFontMicro}" FontWeight="SemiBold"
                               Foreground="{StaticResource CanvasOnAccentBrush}" />
                  </StackPanel>
              </Border>
            </Grid>

            <!-- Barra de progreso de la ejecución -->
            <StackPanel Margin="0,7,0,0"
                        Visibility="{Binding Node.IsProgressActive, Converter={StaticResource BoolToVis}}">
              <ProgressBar Minimum="0" Maximum="100" Height="3.5"
                           Value="{Binding Node.ProgressPercentage, Mode=OneWay}"
                           Background="{StaticResource CanvasSurfaceBrush}"
                           Foreground="{StaticResource CanvasSuccessBrush}" CornerRadius="4" />
              <TextBlock Text="{Binding Node.ProgressMessage}" FontSize="{StaticResource CanvasFontMicro}"
                         Foreground="{StaticResource CanvasSecondaryBrush}" Margin="0,2,0,0"
                         HorizontalAlignment="Right" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- ================= Cuerpo: puertos dibujados y panel de parámetros plegable ================= -->
        <StackPanel Margin="0,4">
          <!-- Los puertos viven DENTRO de la cara de la tarjeta (hito 278). Antes el Grid sangraba 16 px por
               cada lado para sacar el socket al borde, y ese sobrante quedaba fuera del rectángulo de la
               tarjeta: ni se pintaba ni se podía pulsar — el socket era invisible y su única zona activa era
               el texto de la etiqueta. Traído adentro, el punto se ve y la fila entera se pulsa. -->
          <Grid Margin="0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="12" />
              <ColumnDefinition Width="*" />
</Grid.ColumnDefinitions>
            <ItemsControl Grid.Column="0" ItemsSource="{Binding Node.InputPorts}" HorizontalAlignment="Left">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <!-- Socket VIVO (fase 3.3): pulsa para terminar un cable, click derecho para desconectar.
                       El gesto lo maneja la tarjeta y lo sube al lienzo por SocketRequested.
                       El fondo TRANSPARENTE más el relleno hacen de la fila ENTERA la zona activa, no del
                       texto de la etiqueta (que medía ~19 px): sin fondo, el hit-test de los huecos de la
                       fila caía en la cara de la tarjeta —que sí lo tiene— y la pulsación arrastraba el nodo
                       en vez de arrancar el cable (hito 278). -->
                  <StackPanel Orientation="Horizontal" Margin="0,1" Spacing="5" Padding="4,3"
                              Background="Transparent"
                              PointerPressed="OnSocketPressed" PointerReleased="OnSocketReleased"
                              PointerCaptureLost="OnSocketReleased"
                              RightTapped="OnSocketRightTapped">
                    <Grid Width="15" Height="15">
                      <Border Width="13" Height="13" CornerRadius="{Binding Converter={StaticResource SocketRadius}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{Binding Converter={StaticResource SocketFill}}"
                              BorderThickness="2"
                              BorderBrush="{Binding Converter={StaticResource SocketColor}}"
                              Opacity="{Binding Converter={StaticResource SocketOpacity}}" />
                      <Path Data="M 1,1 L 10,6 L 1,11 Z" Width="11" Height="11"
                            Stretch="Uniform" StrokeThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stroke="{Binding Converter={StaticResource SocketColor}}"
                            Fill="{Binding Converter={StaticResource SocketTriangleFill}}"
                            Opacity="{Binding Converter={StaticResource SocketOpacity}}"
                            Visibility="{Binding IsTriangleSocket, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CanvasTextBrush}" VerticalAlignment="Center"
                               Opacity="{Binding Converter={StaticResource SocketLabelOpacity}}" />
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Column="2" ItemsSource="{Binding Node.OutputPorts}" HorizontalAlignment="Right">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,1" Spacing="5" Padding="4,3"
                              HorizontalAlignment="Right"
                              Background="Transparent"
                              PointerPressed="OnSocketPressed" PointerReleased="OnSocketReleased"
                              PointerCaptureLost="OnSocketReleased"
                              RightTapped="OnSocketRightTapped">
                    <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{StaticResource CanvasTextBrush}" VerticalAlignment="Center"
                               Opacity="{Binding Converter={StaticResource SocketOpacity}}" />
                    <Grid Width="15" Height="15">
                      <Border Width="13" Height="13" CornerRadius="{Binding Converter={StaticResource SocketRadius}}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Background="{Binding Converter={StaticResource SocketFill}}"
                              BorderThickness="2"
                              BorderBrush="{Binding Converter={StaticResource SocketColor}}"
                              Opacity="{Binding Converter={StaticResource SocketOpacity}}" />
                      <Path Data="M 1,1 L 10,6 L 1,11 Z" Width="11" Height="11"
                            Stretch="Uniform" StrokeThickness="1.5"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Stroke="{Binding Converter={StaticResource SocketColor}}"
                            Fill="{Binding Converter={StaticResource SocketTriangleFill}}"
                            Opacity="{Binding Converter={StaticResource SocketOpacity}}"
                            Visibility="{Binding IsTriangleSocket, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>

          <!-- Panel de ACCIONES plegable (Blender inset): aparece desplegado Y sólo si el nodo declara
               acciones rápidas.

               Aquí vivía el LISTADO de parámetros del nodo: nombres sin editor —nada que pulsar, nada
               que teclear— porque los editores son de la ficha del inspector (la tarjeta es mobiliario
               del lienzo y su ancho no da para un editor por parámetro). Una lista que invita a
               interactuar y no responde es peor que no tenerla: los parámetros se editan en el
               inspector y punto. Lo que queda es lo que SÍ hace algo al pulsarlo: las acciones del
               nodo, que son también la puerta a sus superficies («🎬 Presets...», configurar el VLM,
               el estudio de scripts...). -->
          <Border x:Name="ParametersPanel" Margin="8,5,8,3" Background="{StaticResource CanvasSurfaceBrush}"
                  BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                  CornerRadius="6" Padding="8,6"
                  Visibility="{Binding ActionsPanelVisible, Converter={StaticResource BoolToVis}}">
            <StackPanel Spacing="8">
              <!-- Acciones rápidas (p. ej. añadir variable / caso de switch, o abrir una superficie del nodo) -->
              <ItemsControl ItemsSource="{Binding Node.CustomActions}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Command="{Binding ExecuteCommand}" Content="{Binding Title}"
                            Background="{StaticResource CanvasBgDarkBrush}"
                            Foreground="{StaticResource CanvasAccentGlowBrush}"
                            BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1"
                            CornerRadius="4" Padding="6,2.5" Margin="0,2,4,2"
                            FontSize="{StaticResource CanvasFontMicro}" FontWeight="SemiBold" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ================= Pie: telemetría (procesados, latencia, memoria, GPU) ================= -->
        <Border Padding="6,3.5" BorderThickness="0,1,0,0" BorderBrush="{StaticResource CanvasBorderBrush}"
                Visibility="{Binding Node.FooterVisible, Converter={StaticResource BoolToVis}}">
          <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
            <!-- Procesados -->
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource CanvasMutedBrush}"
                    Data="{Binding CounterIconGeometry}" />
              <TextBlock Text="{Binding Node.CurrentStats.ProcessedCount}" FontSize="10"
                         Foreground="{StaticResource CanvasMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- Latencia -->
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource CanvasAccentGlowBrush}"
                    Data="{Binding PulseIconGeometry}" />
              <TextBlock Text="{Binding Node.RollingLatencyMs, Converter={StaticResource DurationToText}}"
                         FontSize="10" Foreground="{StaticResource CanvasAccentGlowBrush}"
                         VerticalAlignment="Center" />
            </StackPanel>
            <!-- Memoria atribuida -->
            <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center"
                        Visibility="{Binding Node.HasRamTelemetry, Converter={StaticResource BoolToVis}}">
              <Path Width="10" Height="10" Stretch="Uniform" Fill="{StaticResource CanvasMutedBrush}"
                    Data="{Binding ExpansionCardIconGeometry}" />
              <TextBlock
                Text="{Binding Node.CurrentStats.RollingAvgAllocatedBytes, Converter={StaticResource BytesToText}}"
                FontSize="10" Foreground="{StaticResource CanvasMutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <!-- GPU -->
            <Border Background="{StaticResource CanvasPurpleBrush}" CornerRadius="999" Padding="4,0.5"
                    VerticalAlignment="Center"
                    Visibility="{Binding Node.IsGpuAccelerated, Converter={StaticResource BoolToVis}}">
              <TextBlock Text="GPU" FontSize="{StaticResource CanvasFontMicro}" FontWeight="SemiBold"
                         Foreground="{StaticResource CanvasOnAccentBrush}" />
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
