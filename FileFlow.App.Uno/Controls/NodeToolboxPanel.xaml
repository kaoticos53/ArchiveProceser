<UserControl
    x:Class="FileFlow.App.Uno.Controls.NodeToolboxPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:FileFlow.App.Uno.Platform"
    xmlns:controls="using:FileFlow.App.Uno.Controls">

  <UserControl.Resources>
    <conv:MaterialIconKindToGeometryConverter x:Key="IconToGeometry" />
  </UserControl.Resources>

  <Grid RowSpacing="8" Padding="10,10,8,8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Título + toggle compacto/detallado (hito 246): el MISMO comando ToggleViewModeCommand del
         VM del núcleo que el escritorio. La reacción vive en código (el x:Bind de una DataTemplate
         de WinUI no alcanza la página — la lección que dejó el pendiente declarado). -->
    <Grid Grid.Row="0" ColumnSpacing="6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                 VerticalAlignment="Center"
                 Foreground="{StaticResource CanvasTextBrush}" />
      <Button x:Name="ViewModeToggle" Grid.Column="1" Click="OnViewModeToggleClicked"
              AutomationProperties.AutomationId="ToolboxViewModeToggle"
              Background="Transparent" BorderThickness="1" BorderBrush="{StaticResource CanvasSecondaryBrush}"
              Padding="6,2" VerticalAlignment="Center">
        <PathIcon x:Name="ViewModeIcon"
                  Data="M3,2.5 H21 V4.5 H3 Z M3,7.5 H21 V9.5 H3 Z M3,12.5 H21 V14.5 H3 Z M3,17.5 H13 V19.5 H3 Z"
                  Width="12" Height="12"
                  Foreground="{StaticResource CanvasSecondaryBrush}" />
      </Button>
    </Grid>

    <!-- Buscador + chips de categoría -->
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBox x:Name="SearchBox" Text="{x:Bind Vm.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               PlaceholderText="Buscar nodo… (Ctrl+F)" FontSize="12" />
      <ItemsControl x:Name="CategoryChips" ItemsSource="{x:Bind Vm.AvailableCategories}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <!-- Las categorías se PARTEN en filas (hito 272): con el StackPanel horizontal, las once
                 que no cabían en el ancho del cajón quedaban recortadas y sin forma de alcanzarlas
                 —ni scroll ni rueda—, así que once de los quince filtros no se podían pulsar. -->
            <controls:WrapPanel Spacing="4" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <ToggleButton Click="OnCategoryChipClicked" Content="{Binding DisplayName}"
                          FontSize="11" Padding="8,2"
                          Tag="{Binding Key}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <!-- Grupos acordeón del VM (expansión exclusiva gestionada por HandleGroupExpanded) -->
    <ScrollViewer x:Name="ToolboxScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <ItemsControl x:Name="GroupsHost" ItemsSource="{x:Bind Vm.CategoryGroups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel>
              <ToggleButton IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Background="Transparent" BorderThickness="0" Padding="4,3" Margin="0,1">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{Binding Icon, Converter={StaticResource IconToGeometry}}"
                            Width="14" Height="14"
                            Foreground="{StaticResource CanvasSecondaryBrush}" />
                  <TextBlock Text="{Binding CategoryName}" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource CanvasTextBrush}" />
                  <TextBlock Text="{Binding Items.Count}" FontSize="11" Opacity="0.6"
                             Foreground="{StaticResource CanvasSecondaryBrush}" />
                </StackPanel>
              </ToggleButton>
              <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsExpanded}"
                            Margin="14,0,0,4">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border x:Name="ToolboxItemRoot" DoubleTapped="OnItemDoubleTapped"
                            Background="Transparent" BorderThickness="0" CornerRadius="4"
                            Padding="4,3" Margin="0,1" ToolTipService.ToolTip="{Binding Description}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <PathIcon Data="{Binding Icon, Converter={StaticResource IconToGeometry}}"
                                  Width="16" Height="16"
                                  Foreground="{StaticResource CanvasAccentGlowBrush}" />
                        <StackPanel Spacing="0">
                          <TextBlock Text="{Binding Name}" FontSize="12"
                                     Foreground="{StaticResource CanvasTextBrush}"
                                     TextTrimming="CharacterEllipsis" MaxLines="1" />
                          <!-- El bloque detallado (insignia de rol + descripción) vive sólo en modo
                               detallado: la visibilidad la aplica el código — al conmutar el VM y al
                               materializarse el contenedor (Loading; el recorrido del árbol en
                               plena regeneración de ítems lanza COMException, la medición del 246)
                               — en compacto queda el nombre, como en el escritorio. -->
                          <StackPanel x:Name="ToolboxItemDetails" Tag="ToolboxItemDetails" Loading="OnToolboxItemDetailsLoading">
                            <TextBlock Text="{Binding RoleBadge}" FontSize="10"
                                       Foreground="{StaticResource CanvasSecondaryBrush}" />
                            <TextBlock Text="{Binding Description}" FontSize="10"
                                       Foreground="{StaticResource CanvasSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxLines="2" Opacity="0.85" />
                          </StackPanel>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </Grid>
</UserControl>
