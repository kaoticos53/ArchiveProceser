<UserControl
    x:Class="FileFlow.App.Uno.Controls.VirtualFileSystemExplorerBody"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    El EXPLORADOR DEL SISTEMA DE ARCHIVOS VIRTUAL del host Uno: la misma información que la ventana del
    escritorio (`FileFlow.App/Views/Components/VirtualFileSystemExplorerWindow.axaml`) sobre el MISMO
    `VirtualFileSystemExplorerViewModel` portable, que este host construye con el almacén que la orden le
    pasa por el catálogo de diálogos (`DialogKeys.VirtualFileSystemExplorer`, payload = el almacén virtual
    de la última ejecución).

    DOS DIFERENCIAS DECLARADAS: el escritorio abre una ventana no modal (aquí es una superficie del host)
    y su rejilla es un `DataGrid` cuyas columnas «Tamaño» y «Modificado» no enlazan con ninguna propiedad
    del fichero virtual —se declaran y quedan vacías—: aquí no se dibujan columnas muertas, sólo los cuatro
    campos que el `VirtualFileEntry` del núcleo sí tiene (nombre, ruta virtual, rol y nodo emisor).
  -->
  <Grid x:Name="VfsRoot" MinWidth="820" MinHeight="460"
        AutomationProperties.AutomationId="VfsExplorerBody"
        RowSpacing="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Cabecera + KPI del almacén -->
    <Grid Grid.Row="0" ColumnSpacing="10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="📁" FontSize="15" VerticalAlignment="Center"
                     Foreground="{StaticResource CanvasAccentPrimaryBrush}" />
          <TextBlock x:Name="HeaderTitle" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"
                     Foreground="{StaticResource CanvasTextBrush}" />
        </StackPanel>
        <TextBlock x:Name="HeaderSubtitle" FontSize="11" Margin="24,0,0,0"
                   Foreground="{StaticResource CanvasSecondaryBrush}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Border Background="{StaticResource CanvasCardBrush}" CornerRadius="6" Padding="12,7"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="KpiFilesLabel" FontSize="10" HorizontalAlignment="Center"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />
            <TextBlock x:Name="KpiFilesValue" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                       Text="{Binding TotalFiles}"
                       Foreground="{StaticResource CanvasAccentGlowBrush}"
                       AutomationProperties.AutomationId="VfsTotalFiles" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource CanvasCardBrush}" CornerRadius="6" Padding="12,7"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="KpiSourceLabel" FontSize="10" HorizontalAlignment="Center"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />
            <TextBlock x:Name="KpiSourceValue" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                       Text="{Binding TotalSourceFiles}"
                       Foreground="{StaticResource CanvasAccentPrimaryBrush}"
                       AutomationProperties.AutomationId="VfsTotalSource" />
          </StackPanel>
        </Border>
        <Border Background="{StaticResource CanvasCardBrush}" CornerRadius="6" Padding="12,7"
                BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1">
          <StackPanel>
            <TextBlock x:Name="KpiDestinationLabel" FontSize="10" HorizontalAlignment="Center"
                       Foreground="{StaticResource CanvasSecondaryBrush}" />
            <TextBlock x:Name="KpiDestinationValue" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                       Text="{Binding TotalDestinationFiles}"
                       Foreground="{StaticResource CanvasSuccessBrush}"
                       AutomationProperties.AutomationId="VfsTotalDestination" />
          </StackPanel>
        </Border>
      </StackPanel>
    </Grid>

    <!-- Barra de herramientas: el filtro del view model y su comando de refresco -->
    <Grid Grid.Row="1" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" FontSize="12" Padding="8,6"
               Text="{Binding SearchText, Mode=TwoWay}"
               AutomationProperties.AutomationId="VfsSearchBox" />
      <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefreshClicked" Padding="10,6" FontSize="12"
              AutomationProperties.AutomationId="VfsRefreshButton">
        <TextBlock x:Name="RefreshLabel" FontSize="12" />
      </Button>
    </Grid>

    <!-- Lista de ficheros virtuales (cabecera + filas con las mismas columnas) -->
    <Border Grid.Row="2" Background="{StaticResource CanvasCardBrush}" CornerRadius="6"
            BorderBrush="{StaticResource CanvasBorderBrush}" BorderThickness="1" Padding="4">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="8,6" ColumnSpacing="6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="110" />
            <ColumnDefinition Width="150" />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" x:Name="ColName" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Grid.Column="1" x:Name="ColVirtualPath" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Grid.Column="2" x:Name="ColRole" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
          <TextBlock Grid.Column="3" x:Name="ColSourceNode" FontSize="11" FontWeight="SemiBold"
                     Foreground="{StaticResource CanvasSecondaryBrush}" />
        </Grid>

        <ListView x:Name="FileList" Grid.Row="1" SelectionMode="Single"
                  Background="Transparent" BorderThickness="0"
                  ItemsSource="{Binding FilteredFiles}"
                  SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                  AutomationProperties.AutomationId="VfsFileList">
          <ListView.ItemTemplate>
            <DataTemplate>
              <!-- El nombre de automatización de la fila: sin él, el canal externo lee el nombre del TIPO del
                   elemento en vez del archivo que la fila enseña. -->
              <Grid Padding="4,3" ColumnSpacing="6" AutomationProperties.Name="{Binding FileName}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="220" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                  <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding FileName}" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CanvasTextBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding VirtualPath}" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding Role}" FontSize="12"
                           Foreground="{StaticResource CanvasTextBrush}" />
                <TextBlock Grid.Column="3" Text="{Binding SourceNodeName}" FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CanvasTextBrush}" />
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Border>

    <!-- Pie: los metadatos del fichero seleccionado y el cierre del host -->
    <Grid Grid.Row="3" ColumnSpacing="8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Spacing="3">
        <TextBlock x:Name="MetadataLabel" FontSize="11" FontWeight="SemiBold"
                   Foreground="{StaticResource CanvasSecondaryBrush}" />
        <ListView x:Name="MetadataList" MaxHeight="96" SelectionMode="None"
                  Background="Transparent" BorderThickness="0"
                  ItemsSource="{Binding SelectedFileMetadata}"
                  AutomationProperties.AutomationId="VfsMetadataList">
          <ListView.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Key}" FontSize="11"
                           Foreground="{StaticResource CanvasSecondaryBrush}" />
                <TextBlock Text="{Binding Value}" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource CanvasTextBrush}" />
              </StackPanel>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </StackPanel>

      <Button x:Name="CloseButton" Grid.Column="1" Click="OnCloseClicked" Padding="14,6" FontSize="12"
              VerticalAlignment="Bottom"
              AutomationProperties.AutomationId="VfsCloseButton">
        <TextBlock x:Name="CloseLabel" FontSize="12" />
      </Button>
    </Grid>
  </Grid>
</UserControl>
