<Window
    x:Class="FileFlow.App.Uno.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileFlow.App.Uno.Controls">

  <Grid x:Name="root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- El MENÚ PRINCIPAL del host (hito 257): la barra de control del escritorio —marca, botón de menú y
         las tres islas (modos · ciclo · herramientas)— sobre el MISMO ControlBarViewModel del núcleo. Su
         punto de entrada a los ajustes conserva el AutomationId «SettingsButton» del hito 255. -->
    <controls:ControlBar x:Name="Bar" Grid.Row="0" />

    <!-- Las tres zonas del editor de escritorio: cajón de herramientas | lienzo | inspector -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <controls:NodeToolboxPanel x:Name="Toolbox" Grid.Column="0"
                                 Background="{StaticResource CanvasSurfaceBrush}" />

      <controls:EditorCanvasControl x:Name="Canvas" Grid.Column="1" />

      <controls:NodeInspectorPanel x:Name="Inspector" Grid.Column="2" Width="300"
                                   VerticalAlignment="Stretch" />
    </Grid>

    <Border Grid.Row="2" Background="#161B22" Padding="16,8">
      <!-- El botón Ejecutar (hito 243): el comando canónico del ControlBar del núcleo (el mismo
           del escritorio), montado por código en StatusBarHost para que el guion UIA externo
           pueda invocar el ciclo completo del flujo. -->
      <StackPanel x:Name="StatusBarHost" Spacing="4">
        <TextBlock x:Name="engineStatus" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
                   Foreground="#F0F6FC" />
      </StackPanel>
    </Border>

    <!-- El cajón del menú principal (hito 257): el «menú» de la barra, desplegado sobre toda la ventana
         como el del escritorio (velo + panel de 320 px a la izquierda) y con el mismo estado
         (ControlBar.IsMenuOpen) que conmuta el botón «Menú». -->
    <controls:MainMenuDrawer x:Name="Drawer" Grid.Row="0" Grid.RowSpan="3" />

    <!-- La superficie de ajustes (hito 255): se despliega sobre TODA la ventana, como el cajón del
         escritorio, y vive en su propio control — el host aporta la vista, el núcleo el view model.
         Es la última hija de la raíz para que quede POR ENCIMA del marco (y del cajón del menú). -->
    <controls:SettingsPanel x:Name="Settings" Grid.Row="0" Grid.RowSpan="3" />
  </Grid>
</Window>
