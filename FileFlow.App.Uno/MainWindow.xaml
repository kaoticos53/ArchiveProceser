<Window
    x:Class="FileFlow.App.Uno.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileFlow.App.Uno.Controls">

  <Grid x:Name="root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- El MENÚ PRINCIPAL del host (hito 257): la barra de control del escritorio —marca, botón de menú y
         las tres islas (modos · ciclo · herramientas)— sobre el MISMO ControlBarViewModel del núcleo. Su
         punto de entrada a los ajustes conserva el AutomationId «SettingsButton» del hito 255. -->
    <controls:ControlBar x:Name="Bar" Grid.Row="0" />

    <!-- Las cinco zonas del editor de escritorio: cajón | asa | lienzo | asa | inspector.

         El escritorio declara esta misma topología en su `MainWindow.axaml` (260 · GridSplitter · lienzo ·
         GridSplitter · ficha) y reparte los anchos con sus cotas: cajón 180–480 y ficha 220–750. Aquí las
         asas son `PanelSplitter` —WinUI 3 no trae `GridSplitter` y este host no referencia el paquete de la
         comunidad—, con el reparto del escritorio y una cota más: el arrastre no puede dejar al lienzo por
         debajo de su mínimo, porque el área de clic de las tarjetas se mide del árbol visual. Hito 270. -->
    <Grid x:Name="Workspace">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="ToolboxColumn" Width="280" MinWidth="180" MaxWidth="480" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="CanvasColumn" Width="*" MinWidth="320" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="220" MaxWidth="750" />
      </Grid.ColumnDefinitions>

      <controls:NodeToolboxPanel x:Name="Toolbox" Grid.Column="0"
                                 Background="{StaticResource CanvasSurfaceBrush}" />

      <!-- El asa del CAJÓN: su columna está a la izquierda, así que crece al arrastrar hacia la derecha. -->
      <controls:PanelSplitter x:Name="ToolboxSplitter" Grid.Column="1"
                              AutomationProperties.AutomationId="ToolboxSplitter" />

      <controls:EditorCanvasControl x:Name="Canvas" Grid.Column="2" />

      <!-- El asa de la FICHA: su columna está a la derecha, así que crece al arrastrar hacia la izquierda.
           Su visibilidad sigue a la del panel: una asa sin columna que gobierne es un mando que no manda. -->
      <controls:PanelSplitter x:Name="InspectorSplitter" Grid.Column="3"
                              AutomationProperties.AutomationId="InspectorSplitter" />

      <controls:NodeInspectorPanel x:Name="Inspector" Grid.Column="4"
                                   VerticalAlignment="Stretch" HorizontalAlignment="Stretch" />
    </Grid>

    <Border Grid.Row="2" Background="#161B22" Padding="16,8">
      <!-- El botón Ejecutar (hito 243): el comando canónico del ControlBar del núcleo (el mismo
           del escritorio), montado por código en StatusBarHost para que el guion UIA externo
           pueda invocar el ciclo completo del flujo. -->
      <StackPanel x:Name="StatusBarHost" Spacing="4">
        <TextBlock x:Name="engineStatus" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
                   Foreground="#F0F6FC" />
      </StackPanel>
    </Border>

    <!-- El cajón del menú principal (hito 257): el «menú» de la barra, desplegado sobre toda la ventana
         como el del escritorio (velo + panel de 320 px a la izquierda) y con el mismo estado
         (ControlBar.IsMenuOpen) que conmuta el botón «Menú». -->
    <controls:MainMenuDrawer x:Name="Drawer" Grid.Row="0" Grid.RowSpan="3" />

    <!-- La superficie de ajustes (hito 255): se despliega sobre TODA la ventana, como el cajón del
         escritorio, y vive en su propio control — el host aporta la vista, el núcleo el view model.
         Es la última hija de la raíz para que quede POR ENCIMA del marco (y del cajón del menú). -->
    <controls:SettingsPanel x:Name="Settings" Grid.Row="0" Grid.RowSpan="3" />
  </Grid>
</Window>
