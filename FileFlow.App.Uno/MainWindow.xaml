<Window
    x:Class="FileFlow.App.Uno.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileFlow.App.Uno.Controls">

  <Grid x:Name="root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#161B22" Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="FileFlow Studio" FontSize="16" FontWeight="SemiBold" Foreground="#F0F6FC" />
        <TextBlock Text="Uno Platform — editor (rebanada 4)" Opacity="0.7" VerticalAlignment="Center"
                   FontSize="12" Foreground="#F0F6FC" />
      </StackPanel>
    </Border>

    <!-- Las tres zonas del editor de escritorio: cajón de herramientas | lienzo | inspector -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <controls:NodeToolboxPanel x:Name="Toolbox" Grid.Column="0"
                                 Background="{StaticResource CanvasSurfaceBrush}" />

      <controls:EditorCanvasControl x:Name="Canvas" Grid.Column="1" />

      <controls:NodeInspectorPanel x:Name="Inspector" Grid.Column="2" Width="300"
                                   VerticalAlignment="Stretch" />
    </Grid>

    <Border Grid.Row="2" Background="#161B22" Padding="16,8">
      <TextBlock x:Name="engineStatus" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
                 Foreground="#F0F6FC" />
    </Border>
  </Grid>
</Window>
