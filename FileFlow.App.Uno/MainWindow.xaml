<Window
    x:Class="FileFlow.App.Uno.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:FileFlow.App.Uno.Controls">

  <Grid x:Name="root">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#161B22" Padding="16,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock Text="FileFlow Studio" FontSize="16" FontWeight="SemiBold" Foreground="#F0F6FC" />
        <TextBlock Text="Uno Platform — lienzo (fase 3.1)" Opacity="0.7" VerticalAlignment="Center"
                   FontSize="12" Foreground="#F0F6FC" />
      </StackPanel>
    </Border>

    <controls:EditorCanvasControl x:Name="Canvas" Grid.Row="1" />

    <Border Grid.Row="2" Background="#161B22" Padding="16,8">
      <TextBlock x:Name="engineStatus" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
                 Foreground="#F0F6FC" />
    </Border>
  </Grid>
</Window>
