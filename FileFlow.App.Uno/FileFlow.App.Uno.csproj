<Project Sdk="Uno.Sdk/6.7.30">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Plataforma de destino, EXPLÍCITA: FileFlowTarget=windows|desktop|wasm|ios. Por defecto, Windows
         nativo en Windows_NT y Skia Desktop (Linux/macOS) en el resto. La selección NO depende de que el SDK
         haya dejado TargetFramework vacío (lo daba por sentado y el TFM se quedaba en net10.0). -->
    <FileFlowTarget Condition="'$(FileFlowTarget)' == '' and '$(OS)' == 'Windows_NT'">windows</FileFlowTarget>
    <FileFlowTarget Condition="'$(FileFlowTarget)' == ''">desktop</FileFlowTarget>

    <UnoSingleProject>true</UnoSingleProject>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UnoFeatures>Hosting;Configuration;Toolkit</UnoFeatures>
    <ApplicationIcon>..\assets\FileFlow.ico</ApplicationIcon>
    <DefaultLanguage>en</DefaultLanguage>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
  </PropertyGroup>

  <!-- TargetFramework por plataforma: se fija DESPUÉS de los props del SDK para no quedar preemptado. -->
  <PropertyGroup Condition="'$(FileFlowTarget)' == 'windows'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FileFlowTarget)' == 'desktop'">
    <TargetFramework>net10.0-desktop</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FileFlowTarget)' == 'wasm'">
    <TargetFramework>net10.0-browserwasm</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(FileFlowTarget)' == 'ios'">
    <TargetFramework>net10.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- =================================================================== -->
  <!-- CONFIGURACIÓN ESPECÍFICA DE WINDOWS (WinUI 3 / Windows App SDK)      -->
  <!-- =================================================================== -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250903001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileFlow.App.Core\FileFlow.App.Core.csproj" />
    <ProjectReference Include="..\FileFlow.Sdk\FileFlow.Sdk.csproj" />
    <ProjectReference Include="..\FileFlow.Core\FileFlow.Core.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.FileSystem\FileFlow.Plugin.FileSystem.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Archives\FileFlow.Plugin.Archives.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Images\FileFlow.Plugin.Images.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Logic\FileFlow.Plugin.Logic.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Hashing\FileFlow.Plugin.Hashing.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Integrations\FileFlow.Plugin.Integrations.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Scripting\FileFlow.Plugin.Scripting.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Documents\FileFlow.Plugin.Documents.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Network\FileFlow.Plugin.Network.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Data\FileFlow.Plugin.Data.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.AI\FileFlow.Plugin.AI.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Subflows\FileFlow.Plugin.Subflows.csproj" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build;Publish">
    <PropertyGroup>
      <PluginsTargetFolder>$(TargetDir)Plugins\</PluginsTargetFolder>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsTargetFolder)" />
    <ItemGroup>
      <!-- Los plugins son librerías net10.0 puras: su salida no sigue el TFM del host (windows10.0.19041.0). -->
      <PluginFiles Include="..\FileFlow.Plugin.*\bin\$(Configuration)\net10.0\FileFlow.Plugin.*.dll" />
    </ItemGroup>
    <!-- Junto al exe: PluginRegistryHelper.RegisterBuiltInAssemblies los JIT-carga por nombre desde la base de la app. -->
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" />
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginsTargetFolder)" SkipUnchangedFiles="false" />
  </Target>
</Project>
