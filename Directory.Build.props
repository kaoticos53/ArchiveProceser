<Project>
  <Import Project="$(MSBuildThisFileDirectory)version.props" Condition="Exists('$(MSBuildThisFileDirectory)version.props')" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);NU1603;NU1903;NU1902</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903;NU1902</WarningsNotAsErrors>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- =================================================================== -->
  <!-- SABOR DE UI: qué toolkit se compila (hito 268)                       -->
  <!-- =================================================================== -->
  <!--
    El producto tiene DOS hosts con interfaces gráficas distintas y un solo grafo de nodos. El host de
    ESCRITORIO (Avalonia) monta las ventanas modales que los plugins traen consigo; el host UNO (WinUI 3)
    no puede montarlas —son ventanas del toolkit del escritorio— y las declara por su propio catálogo.

    Hasta el hito 267 el host Uno se compilaba con la MISMA solución y con MSBuild de Visual Studio, así
    que arrastraba las 16 DLL de Avalonia de los cinco plugins que declaran ventanas. La solución del host
    Uno (FileFlow.Uno.slnx) compila el grafo SIN ese toolkit: los paquetes de Avalonia y los ficheros que
    sólo existen para el escritorio quedan fuera, y el nodo que necesita su ventana declara la frontera por
    los diálogos del host.

    La elección es de la SOLUCIÓN (o de quien pasa -p:FileFlowUnoHost=true a mano): abrir FileFlow.Uno.slnx
    —en Visual Studio o con `dotnet build`— es lo que pide el sabor Uno, y compilar cualquier proyecto suelto
    o la solución del escritorio es lo que pide el sabor de escritorio (el de por defecto, para que un
    `dotnet build` sin contexto no cambie de producto por sorpresa).
  -->
  <PropertyGroup>
    <FileFlowUnoHost Condition="'$(FileFlowUnoHost)' == '' and '$(SolutionFileName)' == 'FileFlow.Uno.slnx'">true</FileFlowUnoHost>
    <FileFlowUnoHost Condition="'$(FileFlowUnoHost)' == ''">false</FileFlowUnoHost>

    <FileFlowDesktopToolkit Condition="'$(FileFlowUnoHost)' == 'true'">false</FileFlowDesktopToolkit>
    <FileFlowDesktopToolkit Condition="'$(FileFlowDesktopToolkit)' == ''">true</FileFlowDesktopToolkit>

    <!-- La constante que lee el nodo: sin el toolkit del escritorio no hay ventana que montar. -->
    <DefineConstants Condition="'$(FileFlowDesktopToolkit)' == 'false'">$(DefineConstants);FILEFLOW_NO_DESKTOP_TOOLKIT</DefineConstants>
  </PropertyGroup>

  <!-- =================================================================== -->
  <!-- Tarea MSBuild para lectura e incremento automático del Build Number -->
  <!-- =================================================================== -->
  <UsingTask TaskName="AutoIncrementBuildNumber" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <BuildFilePath ParameterType="System.String" Required="true" />
      <BuildNumber ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          int num = 100;
          try
          {
              lock (typeof(AutoIncrementBuildNumber))
              {
                  if (System.IO.File.Exists(BuildFilePath))
                  {
                      var info = new System.IO.FileInfo(BuildFilePath);
                      string content = System.IO.File.ReadAllText(BuildFilePath).Trim();
                      if (int.TryParse(content, out int parsed))
                      {
                          num = parsed;
                      }

                      // Si el archivo se modificó hace más de 3 segundos, es una nueva compilación -> incrementar
                      if ((System.DateTime.UtcNow - info.LastWriteTimeUtc).TotalSeconds > 3.0)
                      {
                          num++;
                          System.IO.File.WriteAllText(BuildFilePath, num.ToString());
                      }
                  }
                  else
                  {
                      System.IO.File.WriteAllText(BuildFilePath, num.ToString());
                  }
              }
          }
          catch
          {
              // En caso de concurrencia temporal de archivos, mantener número
          }
          BuildNumber = num.ToString();
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="ResolveBuildVersion" BeforeTargets="BeforeBuild;BeforeCompile;GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(BuildNumberResolved)' != 'true'">
    <AutoIncrementBuildNumber BuildFilePath="$(MSBuildThisFileDirectory).build_number">
      <Output TaskParameter="BuildNumber" PropertyName="ResolvedBuildNumber" />
    </AutoIncrementBuildNumber>

    <PropertyGroup>
      <BuildNumber Condition="'$(BuildNumber)' == ''">$(ResolvedBuildNumber)</BuildNumber>
      <BuildNumber Condition="'$(BuildNumber)' == ''">100</BuildNumber>
      <BuildNumberResolved>true</BuildNumberResolved>

      <!-- Ensamblado de cadenas SemVer 2.0 -->
      <VersionMajor Condition="'$(VersionMajor)' == ''">1</VersionMajor>
      <VersionMinor Condition="'$(VersionMinor)' == ''">0</VersionMinor>
      <VersionPatch Condition="'$(VersionPatch)' == ''">0</VersionPatch>

      <VersionPrefix>$(VersionMajor).$(VersionMinor).$(VersionPatch)</VersionPrefix>
      <VersionSuffix Condition="'$(VersionPreRelease)' != ''">$(VersionPreRelease)</VersionSuffix>
      
      <_PreReleaseSuffix Condition="'$(VersionPreRelease)' != ''">-$(VersionPreRelease)</_PreReleaseSuffix>
      <_PreReleaseSuffix Condition="'$(VersionPreRelease)' == ''"></_PreReleaseSuffix>

      <InformationalVersion>$(VersionPrefix)$(_PreReleaseSuffix)+build.$(BuildNumber)</InformationalVersion>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).0.0</AssemblyVersion>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).$(BuildNumber)</FileVersion>
      <Version>$(InformationalVersion)</Version>
    </PropertyGroup>
  </Target>

</Project>
