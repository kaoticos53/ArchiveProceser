<Window x:Class="FileFlow.Plugin.Archives.UI.Views.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_WindowTitle]}"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_HeaderTitle]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_HeaderSubtitle]}" 
                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Barra de Acciones: Importar / Exportar -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Click="ImportFromTxt_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Cursor="Hand">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_ImportTxt]}" FontSize="11" />
            </Button>

            <Button Grid.Column="1" Click="ExportToTxt_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Cursor="Hand">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_ExportTxt]}" FontSize="11" />
            </Button>

            <TextBlock Grid.Column="2" x:Name="TxtPasswordCount" Text="0" 
                       HorizontalAlignment="Right" VerticalAlignment="Center" 
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
        </Grid>

        <!-- Editor Multilinea de Contraseñas -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
            <TextBox x:Name="TxtPasswordEditor"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas, Cascadia Code, monospace"
                     FontSize="12"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0"
                     Padding="8"
                     TextChanged="TxtPasswordEditor_TextChanged" />
        </Border>

        <!-- Botones de Confirmación -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Cancel]}" FontSize="12" Cursor="Hand" />
            <Button Click="Save_Click" Style="{DynamicResource PrimaryButton}" Padding="16,6" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_SaveKeys]}" FontSize="12" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
