<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FileFlow.Sdk.Localization"
        x:Class="FileFlow.Plugin.Archives.UI.Views.PasswordManagerWindow"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_WindowTitle]}"
        Height="440" Width="540"
        MinHeight="360" MinWidth="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_HeaderTitle]}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{DynamicResource AccentPrimaryBrush}" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_HeaderSubtitle]}" 
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Barra de Acciones: Importar / Exportar -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*" Margin="0,0,0,8">
            <Button Grid.Column="0" Click="ImportFromTxt_Click" Padding="10,5" Margin="0,0,8,0">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_ImportTxt]}" FontSize="{DynamicResource FontSizeCaption}" />
            </Button>

            <Button Grid.Column="1" Click="ExportToTxt_Click" Padding="10,5">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_ExportTxt]}" FontSize="{DynamicResource FontSizeCaption}" />
            </Button>

            <TextBlock Grid.Column="2" x:Name="TxtPasswordCount" Text="0" 
                       HorizontalAlignment="Right" VerticalAlignment="Center" 
                       FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
        </Grid>

        <!-- Editor Multilínea de Contraseñas -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="4">
            <TextBox x:Name="TxtPasswordEditor"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas, Cascadia Code, monospace"
                     FontSize="{DynamicResource FontSizeBodySm}"
                     Background="Transparent"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderThickness="0"
                     Padding="8"
                     TextChanged="TxtPasswordEditor_TextChanged" />
        </Border>

        <!-- Botones de Confirmación -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0" Spacing="8">
            <Button Click="Cancel_Click" Padding="14,6" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Cancel]}" FontSize="{DynamicResource FontSizeBodySm}" />
            <Button Classes="primary" Click="Save_Click" Padding="16,6" CornerRadius="{DynamicResource RadiusSm}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PasswordManager_SaveKeys]}" FontSize="{DynamicResource FontSizeBodySm}" />
        </StackPanel>
    </Grid>
</Window>
