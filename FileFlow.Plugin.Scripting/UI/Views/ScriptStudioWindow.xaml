<Window x:Class="FileFlow.Plugin.Scripting.UI.Views.ScriptStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_Title]}"
        Width="1100" Height="750"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}" 
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI, Roboto, sans-serif" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimaryBrush}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera y Barra de Herramientas -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_Engine]}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="130" SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}" SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="⚡ C# (Roslyn)" Tag="CSharp"/>
                        <ComboBoxItem Content="🌐 JavaScript" Tag="JavaScript"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_ManualPdf]}" Click="OpenManual_Click" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_Templates]}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="250" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_LoadTemplate]}" Command="{Binding LoadSelectedPresetCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cuerpo Principal: Editor central y Panel lateral de Puertos/Pruebas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Editor de Código AvalonEdit -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                <avalonEdit:TextEditor x:Name="CodeEditor"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13.5"
                                       Background="{DynamicResource BgSurfaceBrush}"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="{DynamicResource TextSecondaryBrush}"
                                       TextChanged="CodeEditor_TextChanged"/>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch"/>

            <!-- Panel Lateral Derecho: Puertos y Probador -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Pestaña 1: Puertos Dinámicos -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_TabPorts]}" Foreground="{DynamicResource TextPrimaryBrush}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_InputPorts]}" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding InputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="✕" HorizontalAlignment="Right" Padding="4,1" Margin="0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentErrorBrush}"
                                                            Command="{Binding DataContext.RemoveInputPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewInputPortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_AddPort]}" Command="{Binding AddInputPortCommand}" Margin="4,0,0,0"/>
                                </Grid>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_OutputPorts]}" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding OutputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                    <Button Content="✕" HorizontalAlignment="Right" Padding="4,1" Margin="0" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentErrorBrush}"
                                                            Command="{Binding DataContext.RemoveOutputPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewOutputPortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_AddPort]}" Command="{Binding AddOutputPortCommand}" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pestaña 2: Probador en Vivo -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_TabTest]}" Foreground="{DynamicResource TextPrimaryBrush}">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_TestFileName]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBox Text="{Binding TestFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_RunTest]}" Command="{Binding RunTestCommand}" Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" Padding="8,6"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="{Binding TestStatus}" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" Margin="0,8,0,4"/>

                            <!-- Consola de Resultados y Emisiones -->
                            <Border Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding TestEmittedPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource AccentSuccessBrush}" FontWeight="Bold" FontSize="11"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,4"/>
                                        <ItemsControl ItemsSource="{Binding TestLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Pestaña 3: Guardar en Mis Scripts -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_TabSave]}" Foreground="{DynamicResource TextPrimaryBrush}">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_ScriptName]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_ScriptDesc]}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBox Text="{Binding NewPresetDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_SaveToMyScripts]}" Command="{Binding SaveCurrentAsPresetCommand}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF" FontWeight="Bold"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Pie de Ventana: Aceptar / Cancelar -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_Tip]}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_Apply]}" Click="ApplyAndClose_Click" Background="{DynamicResource AccentSuccessBrush}" Foreground="#FFFFFF" FontWeight="Bold" Padding="16,6"/>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ScriptStudio_Cancel]}" Click="Cancel_Click" Margin="8,0,0,0" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
