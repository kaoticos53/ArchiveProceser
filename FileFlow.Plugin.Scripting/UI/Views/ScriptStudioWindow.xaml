<Window x:Class="FileFlow.Plugin.Scripting.UI.Views.ScriptStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="Estudio de Scripting Personalizado (C# / JavaScript)"
        Width="1100" Height="750"
        WindowStartupLocation="CenterOwner"
        Background="#181825" Foreground="#CDD6F4"
        FontFamily="Segoe UI, Roboto, sans-serif" FontSize="13">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="BorderBrush" Value="#89B4FA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#89B4FA"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="BorderBrush" Value="#45475A"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera y Barra de Herramientas -->
        <Border Grid.Row="0" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💻 Motor de Scripting:" FontWeight="Bold" Foreground="#89B4FA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox Width="130" SelectedValuePath="Tag" SelectedValue="{Binding SelectedLanguage}" SelectionChanged="Language_SelectionChanged">
                        <ComboBoxItem Content="⚡ C# (Roslyn)" Tag="CSharp"/>
                        <ComboBoxItem Content="🌐 JavaScript" Tag="JavaScript"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📖 Manual PDF..." Click="OpenManual_Click" Background="#45475A" Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock Text="📚 Plantillas:" Foreground="#A6ADC8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox Width="250" ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}"/>
                    <Button Content="📂 Cargar Plantilla" Command="{Binding LoadSelectedPresetCommand}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cuerpo Principal: Editor central y Panel lateral de Puertos/Pruebas -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <!-- Editor de Código AvalonEdit -->
            <Border Grid.Column="0" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="4">
                <avalonEdit:TextEditor x:Name="CodeEditor"
                                       FontFamily="Cascadia Code, Consolas, Courier New"
                                       FontSize="13.5"
                                       Background="#11111B"
                                       Foreground="#CDD6F4"
                                       ShowLineNumbers="True"
                                       LineNumbersForeground="#585B70"
                                       TextChanged="CodeEditor_TextChanged"/>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch"/>

            <!-- Panel Lateral Derecho: Puertos y Probador -->
            <Border Grid.Column="2" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="10">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Pestaña 1: Puertos Dinámicos -->
                    <TabItem Header="🔌 Puertos" Foreground="#CDD6F4">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="Puertos de Entrada (Inputs):" FontWeight="Bold" Foreground="#89B4FA" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding InputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#313244" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                                    <Button Content="✕" HorizontalAlignment="Right" Padding="4,1" Margin="0" Background="#45475A" Foreground="#F38BA8"
                                                            Command="{Binding DataContext.RemoveInputPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewInputPortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="➕ Añadir" Command="{Binding AddInputPortCommand}" Margin="4,0,0,0"/>
                                </Grid>

                                <TextBlock Text="Puertos de Salida (Outputs):" FontWeight="Bold" Foreground="#A6E3A1" Margin="0,8,0,4"/>
                                <ItemsControl ItemsSource="{Binding OutputPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#313244" CornerRadius="4" Padding="6,3" Margin="0,2">
                                                <Grid>
                                                    <TextBlock Text="{Binding}" Foreground="#CDD6F4" VerticalAlignment="Center"/>
                                                    <Button Content="✕" HorizontalAlignment="Right" Padding="4,1" Margin="0" Background="#45475A" Foreground="#F38BA8"
                                                            Command="{Binding DataContext.RemoveOutputPortCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding NewOutputPortName, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1" Content="➕ Añadir" Command="{Binding AddOutputPortCommand}" Margin="4,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pestaña 2: Probador en Vivo -->
                    <TabItem Header="🧪 Probar en Vivo" Foreground="#CDD6F4">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Nombre de archivo de prueba:" Foreground="#A6ADC8" FontSize="11"/>
                                <TextBox Text="{Binding TestFileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                                <Button Content="▶️ Ejecutar Prueba del Script" Command="{Binding RunTestCommand}" Background="#2E4053" Foreground="#89B4FA" FontWeight="Bold" Padding="8,6"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="{Binding TestStatus}" FontWeight="Bold" Foreground="#F9E2AF" Margin="0,8,0,4"/>

                            <!-- Consola de Resultados y Emisiones -->
                            <Border Grid.Row="2" Background="#11111B" BorderBrush="#313244" BorderThickness="1" CornerRadius="4" Padding="6">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding TestEmittedPorts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="11"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Separator Background="#313244" Margin="0,4"/>
                                        <ItemsControl ItemsSource="{Binding TestLogs}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" Foreground="#CDD6F4" FontSize="11" TextWrapping="Wrap"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>

                    <!-- Pestaña 3: Guardar en Mis Scripts -->
                    <TabItem Header="💾 Guardar" Foreground="#CDD6F4">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Nombre del Script:" Foreground="#A6ADC8" FontSize="11"/>
                            <TextBox Text="{Binding NewPresetName, UpdateSourceTrigger=PropertyChanged}" Margin="0,2,0,6"/>
                            <TextBlock Text="Descripción:" Foreground="#A6ADC8" FontSize="11"/>
                            <TextBox Text="{Binding NewPresetDescription, UpdateSourceTrigger=PropertyChanged}" Height="50" TextWrapping="Wrap" Margin="0,2,0,10"/>
                            <Button Content="💾 Guardar en Mis Scripts" Command="{Binding SaveCurrentAsPresetCommand}" Background="#1E66F5" Foreground="White" FontWeight="Bold"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Pie de Ventana: Aceptar / Cancelar -->
        <Border Grid.Row="2" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="💡 Tip: En C# usa 'await EmitAsync(\&quot;Puerto\&quot;);', en JS usa 'emit(\&quot;Puerto\&quot;, item);'" Foreground="#6C7086" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="✓ Aplicar y Cerrar" Click="ApplyAndClose_Click" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" Padding="16,6"/>
                    <Button Content="Cancelar" Click="Cancel_Click" Margin="8,0,0,0" Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
