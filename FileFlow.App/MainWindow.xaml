<Window x:Class="FileFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FileFlow.App.Views"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}" Height="850" Width="1340"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ControlBar.ContinueWorkflowCommand}" />
        <KeyBinding Key="F10" Command="{Binding ControlBar.StepNextCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding ControlBar.StopWorkflowCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="60" MaxHeight="550" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <views:ControlBarView Grid.Row="0" DataContext="{Binding ControlBar}" />

        <!-- Main Workspace (Toolbox + Resizer + Canvas Editor + Resizer + Inspector Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="0">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="MinWidth" Value="240" />
                            <Setter Property="MaxWidth" Value="750" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeInspector.IsOpen}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Node Toolbox -->
            <views:NodeToolboxView Grid.Column="0" DataContext="{Binding Toolbox}" />

            <!-- Vertical Resizer Bar for Toolbox -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="{DynamicResource BgSurfaceBrush}" 
                          ShowsPreview="True" 
                          Cursor="SizeWE"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolboxResizeToolTip]}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,1,0">
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Main Canvas Editor -->
            <views:EditorView Grid.Column="2" DataContext="{Binding Editor}" />

            <!-- Vertical Resizer Bar for Inspector Panel -->
            <GridSplitter Grid.Column="3" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="{DynamicResource BgSurfaceBrush}" 
                          ShowsPreview="True" 
                          Cursor="SizeWE"
                          Visibility="{Binding NodeInspector.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,1,0">
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right Panel: Node Data Inspector (Collapsible & Auto-Sizing) -->
            <views:NodeInspectorPanelView Grid.Column="4" 
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          DataContext="{Binding NodeInspector}"
                                          Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Horizontal Resizer Bar for Bottom Execution Log Console -->
        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Center" 
                      Background="{DynamicResource BgSurfaceBrush}" 
                      ShowsPreview="True" 
                      Cursor="SizeNS"
                      ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConsoleResizeToolTip]}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,1">
                        <Rectangle Width="24" Height="1" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Bottom Realtime Execution Console -->
        <views:LogView Grid.Row="3" DataContext="{Binding LogConsole}" />
    </Grid>
</Window>
