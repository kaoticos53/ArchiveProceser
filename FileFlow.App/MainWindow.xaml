<Window x:Class="FileFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:FileFlow.App.Views"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}" Height="850" Width="1340"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding ControlBar.ContinueWorkflowCommand}" />
        <KeyBinding Key="F10" Command="{Binding ControlBar.StepNextCommand}" />
        <KeyBinding Key="F5" Modifiers="Shift" Command="{Binding ControlBar.StopWorkflowCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding ControlBar.SaveWorkflowCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding ControlBar.LoadWorkflowCommand}" />
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding ControlBar.NewWorkflowCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Ctrl" Command="{Binding Editor.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Ctrl" Command="{Binding Editor.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Ctrl" Command="{Binding Editor.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Ctrl" Command="{Binding Editor.ZoomOutCommand}" />
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding Editor.FitToScreenCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Ctrl" Command="{Binding Editor.FitToScreenCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="60" MaxHeight="550" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <views:ControlBarView Grid.Row="0" DataContext="{Binding ControlBar}" />

        <!-- Main Workspace (Toolbox + Resizer + Canvas Editor + Resizer + Inspector Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="360" MinWidth="0">
                    <ColumnDefinition.Style>
                        <Style TargetType="ColumnDefinition">
                            <Setter Property="Width" Value="360" />
                            <Setter Property="MinWidth" Value="240" />
                            <Setter Property="MaxWidth" Value="750" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding NodeInspector.IsOpen}" Value="False">
                                    <Setter Property="Width" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="MaxWidth" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ColumnDefinition.Style>
                </ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Node Toolbox -->
            <views:NodeToolboxView Grid.Column="0" DataContext="{Binding Toolbox}" />

            <!-- Vertical Resizer Bar for Toolbox -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="{DynamicResource BgSurfaceBrush}" 
                          ShowsPreview="True" 
                          Cursor="SizeWE"
                          ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToolboxResizeToolTip]}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,1,0">
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Main Canvas Editor -->
            <views:EditorView Grid.Column="2" DataContext="{Binding Editor}" />

            <!-- Vertical Resizer Bar for Inspector Panel -->
            <GridSplitter Grid.Column="3" 
                          Width="5" 
                          HorizontalAlignment="Center" 
                          VerticalAlignment="Stretch" 
                          Background="{DynamicResource BgSurfaceBrush}" 
                          ShowsPreview="True" 
                          Cursor="SizeWE"
                          Visibility="{Binding NodeInspector.IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,1,0">
                            <Rectangle Width="1" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <!-- Right Panel: Node Data Inspector (Collapsible & Auto-Sizing) -->
            <views:NodeInspectorPanelView Grid.Column="4" 
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          DataContext="{Binding NodeInspector}"
                                          Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>

        <!-- Horizontal Resizer Bar for Bottom Execution Log Console -->
        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      HorizontalAlignment="Stretch" 
                      VerticalAlignment="Center" 
                      Background="{DynamicResource BgSurfaceBrush}" 
                      ShowsPreview="True" 
                      Cursor="SizeNS"
                      ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ConsoleResizeToolTip]}">
            <GridSplitter.Template>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,1">
                        <Rectangle Width="24" Height="1" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.5" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </GridSplitter.Template>
        </GridSplitter>

        <!-- Bottom Realtime Execution Console -->
        <views:LogView Grid.Row="3" DataContext="{Binding LogConsole}" />

        <!-- Semi-Transparent Backdrop Overlay for Side Navigation Drawer -->
        <Border Grid.RowSpan="4"
                Panel.ZIndex="99"
                Background="#60000000"
                Visibility="{Binding ControlBar.IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.InputBindings>
                <MouseBinding MouseAction="LeftClick" Command="{Binding ControlBar.ToggleMenuCommand}" />
            </Border.InputBindings>
        </Border>

        <!-- Modern Side Navigation Drawer Panel (Supports Theme DynamicResources) -->
        <Border Grid.RowSpan="4"
                Panel.ZIndex="100"
                HorizontalAlignment="Left"
                Width="320"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="0,0,1,0"
                Visibility="{Binding ControlBar.IsMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="8" Width="34" Height="34" Margin="0,0,12,0">
                                <TextBlock Text="⚡" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FileFlow Studio" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Gestor de Flujos v1.0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Command="{Binding ControlBar.ToggleMenuCommand}" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Style="{StaticResource SecondaryButton}" 
                                Padding="8,4"
                                Width="30" Height="30" 
                                ToolTip="Cerrar Menú">
                            <TextBlock Text="✕" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Drawer Content Actions -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <!-- Section: Flow Management -->
                        <TextBlock Text="GESTIÓN DE FLUJOS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <Button Command="{Binding ControlBar.NewWorkflowCommand}" Style="{StaticResource DrawerMenuItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Nuevo Flujo" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.LoadWorkflowCommand}" Style="{StaticResource DrawerMenuItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📂" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Cargar Flujo..." FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.SaveWorkflowCommand}" Style="{StaticResource DrawerMenuItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💾" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Guardar Flujo..." FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Theme & Language Customization -->
                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="4,12,4,12" />
                        <TextBlock Text="APARIENCIA E IDIOMA" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <!-- Theme Selector in Drawer -->
                        <Grid Margin="4,6,4,8">
                            <TextBlock Text="Tema Visual:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox SelectedValue="{Binding ControlBar.SelectedTheme, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      HorizontalAlignment="Right"
                                      Width="140">
                                <ComboBoxItem Tag="Dark">🌙 Oscuro</ComboBoxItem>
                                <ComboBoxItem Tag="Light">☀️ Claro</ComboBoxItem>
                                <ComboBoxItem Tag="Pastel">🌸 Primavera</ComboBoxItem>
                                <ComboBoxItem Tag="Cyber">🔮 Cyber Neón</ComboBoxItem>
                                <ComboBoxItem Tag="System">💻 Sistema</ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <!-- Language Selector in Drawer -->
                        <Grid Margin="4,4,4,8">
                            <TextBlock Text="Idioma:" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox SelectedValue="{Binding ControlBar.SelectedLanguage, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      HorizontalAlignment="Right"
                                      Width="140">
                                <ComboBoxItem Tag="es-ES">🌐 Español</ComboBoxItem>
                                <ComboBoxItem Tag="en-US">🇬🇧 English</ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <!-- Section: Panels & Tools -->
                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="4,12,4,12" />
                        <TextBlock Text="PANELES Y HERRAMIENTAS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <Button Command="{Binding ControlBar.ToggleInspectorCommand}" Style="{StaticResource DrawerMenuItemButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" FontSize="16" Margin="0,0,12,0" />
                                <TextBlock Text="Inspector de Datos" FontSize="14" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Drawer Footer -->
                <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <TextBlock Text="Engine .NET 9 | C# 13" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
