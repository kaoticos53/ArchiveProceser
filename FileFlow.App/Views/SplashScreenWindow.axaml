<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:FileFlow.Sdk.Localization"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="FileFlow.App.Views.SplashScreenWindow"
        Title="FileFlow Studio"
        Width="540"
        Height="350"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        Topmost="True"
        CanResize="False">

    <!--
        Pantalla de carga: 100% tokens del tema (sin literales de color ni forma). El contenedor es la
        clase de modal del sistema de diseño (BgCard + borde + RadiusXxl + Elev4) y un resplandor de
        acento (ElevGlowAccent) sobre un velo exterior que recorta la transparencia. El resplandor y el
        shimmer de la barra son deterministas para las capturas: la sesión headless purga las animaciones
        de estilo, así que el barrido vive en el code-behind y no arranca en pruebas (ver SplashShimmer).
    -->
    <Grid Margin="{DynamicResource Pad6}">
        <Border Classes="modal"
                Padding="0"
                BoxShadow="{DynamicResource ElevGlowAccent}">
            <Grid Margin="{DynamicResource Pad8}" RowDefinitions="Auto,*,Auto,Auto,Auto">

                <!-- Cabecera: marca + producto + versión -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource Space6}">
                    <Border Classes="brandLg"
                            Width="52"
                            Height="52"
                            CornerRadius="{DynamicResource RadiusXl}">
                        <materialIcons:MaterialIcon HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextOnAccentBrush}"
                                                    Kind="Flash"
                                                    Width="26"
                                                    Height="26" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="{DynamicResource Space1}">
                        <TextBlock Classes="display primaryText" Text="FileFlow Studio" />
                        <TextBlock x:Name="TxtVersion"
                                   Classes="bodySm secondary"
                                   Text="v1.0.0" />
                    </StackPanel>
                </StackPanel>

                <!-- Contenido central: motor + insignia de nodos -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="{DynamicResource Space3}">
                    <TextBlock Classes="body secondary"
                               Text="{Binding [Splash_InitializingEngine], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <TextBlock x:Name="TxtNodesBadge"
                               Classes="caption accentCyan"
                               Text="{Binding [Splash_LoadingNodes], Source={x:Static loc:LocalizationManager.Instance}}" />
                </StackPanel>

                <!-- Estado y porcentaje -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                    <TextBlock x:Name="TxtStatus"
                               Grid.Column="0"
                               Classes="caption secondary"
                               Text="{Binding [Splash_StatusServices], Source={x:Static loc:LocalizationManager.Instance}}" />
                    <TextBlock x:Name="TxtPercentage"
                               Grid.Column="1"
                               Classes="caption numeric accentCyan"
                               Text="0%" />
                </Grid>

                <!-- Barra de progreso (el shimmer vive en el code-behind) -->
                <ProgressBar x:Name="PbProgress"
                             Grid.Row="3"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="6"
                             CornerRadius="{DynamicResource RadiusXs}"
                             Foreground="{DynamicResource AccentPrimaryBrush}"
                             Background="{DynamicResource BgDarkBrush}" />

                <!-- Pie -->
                <TextBlock Grid.Row="4"
                           Classes="micro muted"
                           HorizontalAlignment="Center"
                           Margin="0,16,0,0"
                           Text="{Binding [Splash_Footer], Source={x:Static loc:LocalizationManager.Instance}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
