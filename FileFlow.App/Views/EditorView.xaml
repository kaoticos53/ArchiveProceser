<UserControl x:Class="FileFlow.App.Views.EditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             xmlns:components="clr-namespace:FileFlow.App.Views.Components"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{DynamicResource BgEditorBrush}">
        <!-- Lienzo del Editor de Nodos Modularizado -->
        <nodify:NodifyEditor ItemsSource="{Binding Nodes}"
                             Connections="{Binding Connections}"
                             Decorators="{Binding CanvasDecorators}"
                             PendingConnection="{Binding PendingConnection}"
                             SelectedItems="{Binding SelectedNodes}"
                             ViewportZoom="{Binding ViewportZoom, Mode=TwoWay}"
                             ViewportLocation="{Binding ViewportLocation, Mode=TwoWay}"
                             ViewportSize="{Binding ViewportSize, Mode=OneWayToSource}"
                             MinViewportZoom="0.2"
                             MaxViewportZoom="2.5"
                             AllowDrop="True"
                             Drop="Editor_Drop"
                             Background="Transparent">

            <!-- Contenedor transparente de cada Nodo -->
            <nodify:NodifyEditor.ItemContainerStyle>
                <Style TargetType="{x:Type nodify:ItemContainer}" BasedOn="{StaticResource {x:Type nodify:ItemContainer}}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="Width" Value="{Binding Width, Mode=TwoWay}" />
                    <Setter Property="MinWidth" Value="240" />
                    <Setter Property="MaxWidth" Value="600" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type nodify:ItemContainer}">
                                <Border Background="Transparent" BorderBrush="Transparent" BorderThickness="0" Padding="0" Margin="0">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </nodify:NodifyEditor.ItemContainerStyle>

            <!-- Plantilla de la Tarjeta del Nodo (Modularizada en NodeCardView) -->
            <nodify:NodifyEditor.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                    <components:NodeCardView />
                </DataTemplate>
            </nodify:NodifyEditor.ItemTemplate>

            <!-- Contenedor de Decoradores (Notas Adhesivas y Marcos de Grupo) -->
            <nodify:NodifyEditor.DecoratorContainerStyle>
                <Style TargetType="{x:Type nodify:DecoratorContainer}" BasedOn="{StaticResource {x:Type nodify:DecoratorContainer}}">
                    <Setter Property="Location" Value="{Binding Location, Mode=TwoWay}" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </nodify:NodifyEditor.DecoratorContainerStyle>

            <!-- Plantilla Polimórfica de Decoradores -->
            <nodify:NodifyEditor.DecoratorTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}">
                        <ContentControl.Resources>
                            <DataTemplate DataType="{x:Type vm:AnnotationViewModel}">
                                <components:AnnotationCardView />
                            </DataTemplate>
                            <DataTemplate DataType="{x:Type vm:GroupViewModel}">
                                <components:GroupCardView />
                            </DataTemplate>
                        </ContentControl.Resources>
                    </ContentControl>
                </DataTemplate>
            </nodify:NodifyEditor.DecoratorTemplate>

            <!-- Curva de Conexión Pendiente -->
            <nodify:NodifyEditor.PendingConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:PendingConnectionViewModel}">
                    <nodify:PendingConnection StartedCommand="{Binding DataContext.StartConnectionCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                               CompletedCommand="{Binding DataContext.FinishConnectionCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                               Source="{Binding Source.Anchor}"
                                               Target="{Binding TargetLocation, Mode=TwoWay}"
                                               Direction="Forward"
                                               Stroke="{DynamicResource AccentGlowBrush}"
                                               StrokeThickness="2.5"
                                               StrokeDashArray="5 3" />
                </DataTemplate>
            </nodify:NodifyEditor.PendingConnectionTemplate>

            <!-- Conectores / Cables con Menú contextual -->
            <nodify:NodifyEditor.ConnectionTemplate>
                <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                    <nodify:Connection Source="{Binding Source.Anchor}"
                                       Target="{Binding Target.Anchor}"
                                       Stroke="{DynamicResource ConnectionWireBrush}"
                                       StrokeThickness="3"
                                       Direction="Forward"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">
                        <nodify:Connection.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DeleteConnection]}"
                                          Command="{Binding PlacementTarget.Tag.DeleteConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </nodify:Connection.ContextMenu>
                    </nodify:Connection>
                </DataTemplate>
            </nodify:NodifyEditor.ConnectionTemplate>
        </nodify:NodifyEditor>


        <!-- Barra de Migas de Pan (Breadcrumbs) para Navegación Multinivel de Sub-flujos -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="20,16,0,0"
                Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8,4"
                Visibility="{Binding Breadcrumbs.Count, Converter={StaticResource NullToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding Breadcrumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{Binding Name}"
                                    Command="{Binding DataContext.NavigateBreadcrumbCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{DynamicResource CleanGhostButtonStyle}"
                                    FontSize="12" FontWeight="Medium" Foreground="{DynamicResource AccentGlowBrush}" />
                            <TextBlock Text=" ❯ " Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="2,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Barra Flotante de Zoom Modularizada -->
        <components:EditorZoomBarView />
    </Grid>
</UserControl>

