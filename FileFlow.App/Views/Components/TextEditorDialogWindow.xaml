<Window x:Class="FileFlow.App.Views.Components.TextEditorDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_WindowTitle]}"
        Width="740" Height="520"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Cabecera con Título del Parámetro y Badges de Estadísticas -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtTitle" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_Title], FallbackValue='Editor de Texto / Prompt'}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="TxtSubtitle" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_Subtitle], FallbackValue='Parámetro configurable'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>

            <!-- Badges de Estadísticas -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                    <TextBlock x:Name="TxtCharCount" Text="🔤 0 car." FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,0,6,0">
                    <TextBlock x:Name="TxtWordCount" Text="📝 0 pal." FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3">
                    <TextBlock x:Name="TxtLineCount" Text="📄 1 lín." FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Barra de Herramientas de Edición Rápida -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Botón Insertar Variable -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnInsertVar" Click="BtnInsertVar_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{}{x} " FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_InsertVar]}" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCopy" Click="BtnCopy_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" Margin="0,0,6,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_CopyFullTextToolTip], FallbackValue='Copiar texto completo al portapapeles'}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_Copy]}" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Botón Limpiar -->
                <Button Grid.Column="2" x:Name="BtnClear" Click="BtnClear_Click" Style="{StaticResource SecondaryButton}" Padding="8,4" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_ClearContentToolTip], FallbackValue='Borrar todo el contenido'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🗑️ " />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_Clear]}" FontSize="11" Foreground="{DynamicResource AccentErrorBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Área de Edición Multilínea Principal -->
        <TextBox Grid.Row="2"
                 x:Name="TxtEditor"
                 TextChanged="TxtEditor_TextChanged"
                 PreviewKeyDown="TxtEditor_PreviewKeyDown"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code, Consolas, Segoe UI, monospace"
                 FontSize="12.5"
                 Padding="10,8"
                 Background="{DynamicResource BgCardBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderDarkBrush}"
                 BorderThickness="1"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch">
            <TextBox.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6" />
                </Style>
            </TextBox.Resources>
        </TextBox>

        <!-- Panel de Vista Previa Resuelta en Tiempo Real (si contiene variables {x}) -->
        <Border Grid.Row="3" x:Name="BorderLivePreview" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" MaxHeight="100" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_EvaluatedPreview]}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,4" />
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtLivePreview" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Pie de Botones: Guardar y Cancelar -->
        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_ShortcutFooter], FallbackValue='Atajo: Ctrl + Enter para Guardar • Esc para Cancelar'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" VerticalAlignment="Center" />

            <Button Grid.Column="1" Click="BtnCancel_Click" Style="{StaticResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" IsCancel="True" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_CancelBtn]}" />
            
            <Button Grid.Column="2" Click="BtnSave_Click" Style="{StaticResource PrimaryButton}" Padding="16,6" IsDefault="True" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_SaveBtn]}" />
        </Grid>
    </Grid>
</Window>
