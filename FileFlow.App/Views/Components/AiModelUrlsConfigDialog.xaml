<Window x:Class="FileFlow.App.Views.Components.AiModelUrlsConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_Title]}"
        Height="560" Width="700" MinHeight="480" MinWidth="580"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Encabezado del Modelo -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                        <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCategory" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Border>
                        <TextBlock x:Name="TxtModelName" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_Subtitle]}" 
                               FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock x:Name="TxtFileName" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Badge Estado de Configuración -->
                <Border Grid.Column="1" x:Name="BorderStatusBadge" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="1" CornerRadius="6" Padding="8,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusBadge" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. Editor de URLs -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Etiqueta -->
                <Grid Grid.Row="0" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_UrlsLabel]}" 
                               FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtUrlsCount" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                </Grid>

                <!-- Cuadro de texto multilínea para URLs -->
                <TextBox Grid.Row="1" x:Name="TxtUrls" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                         Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8,6" FontSize="11"
                         FontFamily="Consolas, Cascadia Code, Courier New"
                         TextChanged="TxtUrls_TextChanged" />

                <!-- Barra de herramientas bajo el editor -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                    <Button Click="TestUrls_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="0,0,8,0" Cursor="Hand">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_TestBtn]}" FontSize="10.5" />
                    </Button>
                    <Button Click="ResetToDefaults_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Cursor="Hand">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_ResetBtn]}" FontSize="10.5" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Panel de Resultados de Prueba de Conexión -->
        <Border Grid.Row="2" x:Name="BorderTestResults" Visibility="Collapsed"
                Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10" MaxHeight="110">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="TxtTestResults" FontSize="10" TextWrapping="Wrap" 
                           FontFamily="Consolas, Cascadia Code, Courier New" />
            </ScrollViewer>
        </Border>

        <!-- 4. Barra de Acciones / Guardado -->
        <Grid Grid.Row="3" Margin="0,4,0,0">
            <TextBlock Text="💡 El sistema probará las URLs en orden hasta completar la descarga." 
                       FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Cancel_Click" IsCancel="True" Style="{DynamicResource SecondaryButton}" 
                        Padding="14,6" Margin="0,0,8,0" Cursor="Hand">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_CancelBtn]}" FontSize="11" />
                </Button>
                <Button Click="Save_Click" IsDefault="True" Style="{DynamicResource PrimaryButton}" 
                        Padding="16,6" Cursor="Hand">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelUrls_SaveBtn]}" FontSize="11" FontWeight="SemiBold" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
