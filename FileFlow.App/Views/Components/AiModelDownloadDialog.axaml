<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FileFlow.App.ViewModels"
        xmlns:views="using:FileFlow.App.Views.Components"
        xmlns:loc="using:FileFlow.Sdk.Localization"
        x:Class="FileFlow.App.Views.Components.AiModelDownloadDialog"
        x:DataType="vm:AiModelManagerViewModel"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_WindowTitle]}"
        Height="660" Width="900" MinHeight="520" MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}">

    <!--
        Asistente de descarga: la misma pieza que la pestaña de ajustes, envuelta en su propia ventana.
        Antes este diálogo era la única vista del gestor y enlazaba miembros inexistentes del view model
        (SizeText, IsInstalled, DownloadCommand, DeleteCommand), así que abría una lista sin tallas, sin estado
        y con botones mudos. Ahora la lista vive en AiModelManagerView y aquí sólo se envuelve.
    -->
    <Grid Margin="16" RowDefinitions="*,Auto">
        <views:AiModelManagerView Grid.Row="0" />

        <Button Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0" Click="Close_Click">
            <TextBlock Classes="caption"
                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close]}" />
        </Button>
    </Grid>
</Window>
