<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:vm="using:FileFlow.App.ViewModels"
        xmlns:loc="using:FileFlow.Sdk.Localization"
        x:Class="FileFlow.App.Views.Components.AiModelDownloadDialog"
        x:DataType="vm:AiModelManagerViewModel"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_WindowTitle]}"
        Height="620" Width="780" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}">

    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="14,10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon VerticalAlignment="Center"  Kind="Robot" Width="16" Height="16" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_HeaderTitle]}" 
                                   FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_HeaderSubtitle]}" 
                               FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                </StackPanel>

                <Border Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InstalledSummary}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- Global Action Toolbar -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="10,8" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,*">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Command="{Binding DownloadMissingModelsCommand}"
                            Padding="12,6"
                            IsEnabled="{Binding HasMissingModels}"
                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="White">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon  Kind="Download" Width="11" Height="11" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AiModels_DownloadAll]}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding RefreshStatusCommand}" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon  Kind="Refresh" Width="11" Height="11" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AiModels_Refresh]}" FontSize="{DynamicResource FontSizeCaption}" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding OpenModelsFolderCommand}" Padding="10,6">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <materialIcons:MaterialIcon  Kind="Folder" Width="11" Height="11" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AiModels_OpenDir]}" FontSize="{DynamicResource FontSizeCaption}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Models List -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="8">
            <ListBox ItemsSource="{Binding Models}" Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vm:AiModelItemViewModel">
                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="12,8" Margin="0,2">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource FontSizeMicro}" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource BgHoverBrush}" CornerRadius="{DynamicResource RadiusXs}" Padding="6,2" VerticalAlignment="Center" Margin="8,0">
                                    <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="SemiBold" />
                                </Border>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Button Command="{Binding DownloadCommand}" Content="Descargar" Padding="10,5" IsVisible="{Binding !IsInstalled}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" />
                                    <Button Command="{Binding DeleteCommand}" Padding="8,5" IsVisible="{Binding IsInstalled}" >
                                        <materialIcons:MaterialIcon Kind="TrashCan" Width="14" Height="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Click="Close_Click" Content="Cerrar" Padding="16,6" CornerRadius="{DynamicResource RadiusSm}" />
        </Grid>
    </Grid>
</Window>
