<Window x:Class="FileFlow.App.Views.Components.WorkflowMetricsDashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:WorkflowMetricsDashboardViewModel}"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MetricsDashboard_Title], FallbackValue='FileFlow - Panel Centralizado de Rendimiento y Métricas'}"
        Width="1080" Height="700"
        MinWidth="880" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

            <!-- Estilo de Barra de Progreso Moderna con Esquinas Redondeadas -->
            <Style x:Key="ModernRoundedProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="6" />
                <Setter Property="Background" Value="#0F172A" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Grid>
                                <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                                <Border x:Name="PART_Track" />
                                <Grid x:Name="PART_Indicator" ClipToBounds="True" HorizontalAlignment="Left">
                                    <Border Background="{TemplateBinding Foreground}" CornerRadius="3" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Gradientes para Barras de Distribución -->
            <LinearGradientBrush x:Key="TimeBarGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#38BDF8" Offset="0" />
                <GradientStop Color="#6366F1" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="RamBarGradient" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Color="#A855F7" Offset="0" />
                <GradientStop Color="#EC4899" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Fondo Principal y Marco Estilizado con Sombra Suave -->
    <Border CornerRadius="14"
            Background="#0B0F19"
            BorderBrush="#2A3854"
            BorderThickness="1"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="4" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />  <!-- 0: Cabecera -->
                <RowDefinition Height="Auto" />  <!-- 1: KPIs Globales -->
                <RowDefinition Height="*" />     <!-- 2: Gráficos + DataGrid -->
                <RowDefinition Height="Auto" />  <!-- 3: Barra inferior -->
            </Grid.RowDefinitions>

            <!-- 1. Cabecera Personalizada Glassmorphism -->
            <Border Grid.Row="0" Background="#131D31" CornerRadius="14,14,0,0" Padding="18,12" MouseLeftButtonDown="Header_MouseLeftButtonDown" BorderBrush="#1E293B" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="32" Height="32" CornerRadius="8" Background="#1E293B" BorderBrush="#38BDF8" BorderThickness="1" Margin="0,0,10,0">
                            <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MetricsDashboard_Title], FallbackValue='Panel de Rendimiento y Profiling de Flujo'}"
                                   FontWeight="Bold" FontSize="15" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <Border Margin="12,0,0,0" Padding="8,3" CornerRadius="10" Background="#1E293B" BorderBrush="#334155" BorderThickness="1">
                            <TextBlock Text="{Binding TotalNodesCount, StringFormat='{}{0} Nodos en Canvas'}" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding RefreshMetricsCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" Margin="0,0,8,0"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Refresh], FallbackValue='Actualizar'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 " FontSize="11" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Refresh], FallbackValue='Actualizar'}" FontSize="11" />
                            </StackPanel>
                        </Button>
                        <Button Click="CloseButton_Click" Style="{StaticResource SecondaryButton}" Padding="9,5" ToolTip="Cerrar">
                            <TextBlock Text="✕" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. KPIs Globales con Acento Superior y Fondo Gradiente -->
            <Grid Grid.Row="1" Margin="16,14,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- KPI 1: Invocaciones Totales -->
                <Border Grid.Column="0" CornerRadius="8" Padding="12,10" Margin="0,0,6,0" BorderBrush="#334155" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E293B" Offset="0" />
                            <GradientStop Color="#111827" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Height="2" Background="#64748B" HorizontalAlignment="Stretch" Margin="0,0,0,6" CornerRadius="1" />
                        <TextBlock Text="📦 Invocaciones" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding TotalInvocations, StringFormat='{}{0:N0}'}" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0" />
                        <TextBlock Text="Ejecuciones totales" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- KPI 2: Tiempo Acumulado -->
                <Border Grid.Column="1" CornerRadius="8" Padding="12,10" Margin="3,0,3,0" BorderBrush="#1E3A8A" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E293B" Offset="0" />
                            <GradientStop Color="#0F172A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Height="2" Background="#38BDF8" HorizontalAlignment="Stretch" Margin="0,0,0,6" CornerRadius="1" />
                        <TextBlock Text="⏱️ Tiempo Total" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding FormattedTotalDuration}" FontSize="18" FontWeight="Bold" Foreground="#38BDF8" Margin="0,4,0,0" />
                        <TextBlock Text="Tiempo flujo acumulado" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- KPI 3: Latencia Media -->
                <Border Grid.Column="2" CornerRadius="8" Padding="12,10" Margin="3,0,3,0" BorderBrush="#064E3B" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E293B" Offset="0" />
                            <GradientStop Color="#0F172A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Height="2" Background="#10B981" HorizontalAlignment="Stretch" Margin="0,0,0,6" CornerRadius="1" />
                        <TextBlock Text="⚡ Latencia Media" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding FormattedAvgLatency}" FontSize="18" FontWeight="Bold" Foreground="#34D399" Margin="0,4,0,0" />
                        <TextBlock Text="Por elemento / nodo" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- KPI 4: RAM Asignada -->
                <Border Grid.Column="3" CornerRadius="8" Padding="12,10" Margin="3,0,3,0" BorderBrush="#581C87" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E293B" Offset="0" />
                            <GradientStop Color="#0F172A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Height="2" Background="#A855F7" HorizontalAlignment="Stretch" Margin="0,0,0,6" CornerRadius="1" />
                        <TextBlock Text="💾 RAM Estimada" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding FormattedTotalRam}" FontSize="18" FontWeight="Bold" Foreground="#C084FC" Margin="0,4,0,0" />
                        <TextBlock Text="Total asignaciones" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- KPI 5: GPU DirectML -->
                <Border Grid.Column="4" CornerRadius="8" Padding="12,10" Margin="3,0,3,0" BorderBrush="#083344" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E293B" Offset="0" />
                            <GradientStop Color="#0F172A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Height="2" Background="#06B6D4" HorizontalAlignment="Stretch" Margin="0,0,0,6" CornerRadius="1" />
                        <TextBlock Text="🎮 Ops GPU" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding GpuAcceleratedOpsCount, StringFormat='{}{0} nodos'}" FontSize="18" FontWeight="Bold" Foreground="#22D3EE" Margin="0,4,0,0" />
                        <TextBlock Text="Aceleración DirectML" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>

                <!-- KPI 6: Cuellos de Botella -->
                <Border Grid.Column="5" CornerRadius="8" Padding="12,10" Margin="6,0,0,0" BorderBrush="#4C0519" BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#1E293B" Offset="0" />
                            <GradientStop Color="#0F172A" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Height="2" Background="#F43F5E" HorizontalAlignment="Stretch" Margin="0,0,0,6" CornerRadius="1" />
                        <TextBlock Text="⚠️ Cuellos Botella" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8" />
                        <TextBlock Text="{Binding BottleneckNodesCount, StringFormat='{}{0} nodos'}" FontSize="18" FontWeight="Bold" Foreground="#FB7185" Margin="0,4,0,0" />
                        <TextBlock Text="&gt; 25% tiempo flujo" FontSize="9.5" Foreground="#64748B" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Contenido Principal: Gráficos de Distribución (Izquierda) + Ranking DataGrid (Derecha) -->
            <Grid Grid.Row="2" Margin="16,4,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda: Gráficos de Distribución -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Margin="0,0,10,0">
                    <StackPanel>
                        <!-- Distribución de Tiempo por Nodo -->
                        <Border Background="#131D31" CornerRadius="10" BorderBrush="#243048" BorderThickness="1" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="⏱️ Distribución de Tiempo (%)" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding TimeDistributionBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontSize="10.5" FontWeight="SemiBold" Foreground="#38BDF8" />
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernRoundedProgressBar}" Foreground="{StaticResource TimeBarGradient}" Margin="0,4,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Distribución de Memoria RAM por Nodo -->
                        <Border Background="#131D31" CornerRadius="10" BorderBrush="#243048" BorderThickness="1" Padding="14">
                            <StackPanel>
                                <TextBlock Text="💾 Asignación de RAM (%)" FontWeight="Bold" FontSize="12" Foreground="#F8FAFC" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding RamDistributionBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontSize="10.5" FontWeight="SemiBold" Foreground="#C084FC" />
                                                </Grid>
                                                <ProgressBar Grid.Row="1" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernRoundedProgressBar}" Foreground="{StaticResource RamBarGradient}" Margin="0,4,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Columna Derecha: Ranking Detallado en DataGrid -->
                <Border Grid.Column="1" Background="#131D31" CornerRadius="10" BorderBrush="#243048" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Cabecera de la Tabla con Buscador Integrado -->
                        <Grid Grid.Row="0" Margin="4,2,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="📋 Ranking Comparativo de Rendimiento" FontWeight="Bold" FontSize="12.5" Foreground="#F8FAFC" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding FilteredNodeRows.Count, StringFormat='{} ({0} filtrados)'}" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0,0,0" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#0F172A" CornerRadius="6" BorderBrush="#334155" BorderThickness="1" Padding="6,2">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B" />
                                    <TextBox Grid.Column="1" Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="#F8FAFC" BorderThickness="0" FontSize="11" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- DataGrid Estilizado -->
                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding FilteredNodeRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  CanUserSortColumns="True"
                                  IsReadOnly="True"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  RowBackground="#0D1322"
                                  AlternatingRowBackground="#121A2C"
                                  Foreground="#F8FAFC"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#1E293B"
                                  HeadersVisibility="Column"
                                  FontSize="11.5">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#172238" />
                                    <Setter Property="Foreground" Value="#94A3B8" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Padding" Value="8,7" />
                                    <Setter Property="BorderBrush" Value="#243048" />
                                    <Setter Property="BorderThickness" Value="0,0,1,1" />
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Padding" Value="8,6" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <!-- Columna: Nodo (Icono + Título) -->
                                <DataGridTemplateColumn Header="Nodo" Width="170" SortMemberPath="Title">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NodeIcon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#F8FAFC" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Columna: Categoría (Pill Badge) -->
                                <DataGridTemplateColumn Header="Categoría" Width="120" SortMemberPath="Category">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="6,2" CornerRadius="8" Background="{Binding CategoryBadgeBackground}" BorderBrush="{Binding CategoryBadgeBorder}" BorderThickness="1" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding CategoryIcon}" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{Binding CategoryBadgeForeground}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <DataGridTextColumn Header="Invocac." Binding="{Binding ExecutionCount}" Width="65" />
                                <DataGridTextColumn Header="Lat. Total" Binding="{Binding FormattedAvgDuration}" Width="85" />
                                <DataGridTextColumn Header="Lat. (8 ops)" Binding="{Binding FormattedRollingDuration}" Width="95" FontWeight="Bold" Foreground="#38BDF8" />
                                <DataGridTextColumn Header="RAM Media" Binding="{Binding FormattedAvgRam}" Width="85" />
                                <DataGridTextColumn Header="RAM Pico" Binding="{Binding FormattedPeakRam}" Width="85" Foreground="#C084FC" />

                                <!-- Columna: GPU Badge -->
                                <DataGridTemplateColumn Header="GPU" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="4,1" CornerRadius="4" Background="#083344" BorderBrush="#06B6D4" BorderThickness="1"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding IsGpuAccelerated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Text="GPU" FontSize="8.5" FontWeight="Bold" Foreground="#22D3EE" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Columna: Cuello de Botella Visual -->
                                <DataGridTemplateColumn Header="Cuello Botella" Width="100" SortMemberPath="RelativeBottleneckRatio">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding BottleneckPercentageText}" FontWeight="Bold" Foreground="{Binding BottleneckBarBrush}" FontSize="11" />
                                                <ProgressBar Grid.Row="1" Value="{Binding BottleneckPercentage, Mode=OneWay}" Maximum="100" Style="{StaticResource ModernRoundedProgressBar}" Foreground="{Binding BottleneckBarBrush}" Margin="0,2,0,0" Height="4" />
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 4. Barra Inferior de Acciones Glassmorphism -->
            <Border Grid.Row="3" Background="#131D31" CornerRadius="0,0,14,14" Padding="18,12" BorderBrush="#1E293B" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button Command="{Binding ExportCsvCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄 " FontSize="11" />
                                <TextBlock Text="Exportar CSV" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ExportJsonCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{}{ } " FontSize="11" />
                                <TextBlock Text="Exportar JSON" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ResetAllMetricsCommand}" Style="{StaticResource SecondaryButton}" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔄 " FontSize="11" />
                                <TextBlock Text="Restablecer Todo" FontSize="11" FontWeight="SemiBold" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1" Click="CloseButton_Click" Style="{StaticResource PrimaryButton}" Padding="16,6">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close], FallbackValue='Cerrar'}" FontSize="11.5" FontWeight="Bold" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
