<Window x:Class="FileFlow.App.Views.Components.AiModelDownloadDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AiModelManagerViewModel}"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_WindowTitle]}"
        Height="620" Width="780" MinHeight="500" MinWidth="650"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Encabezado -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🤖 " FontSize="16" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_HeaderTitle]}" 
                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AiModelManager_HeaderSubtitle]}" 
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Resumen de modelos instalados -->
                <Border Grid.Column="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="1" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding InstalledSummary}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>
        </Border>

        <!-- 2. Barra de Acciones Globales -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <!-- Botón Descargar Faltantes -->
                    <Button Command="{Binding DownloadMissingModelsCommand}"
                            Style="{DynamicResource PrimaryButton}"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand"
                            IsEnabled="{Binding HasMissingModels}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⬇️ " FontSize="11" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AiModels_DownloadAll]}" FontWeight="SemiBold" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Actualizar -->
                    <Button Command="{Binding RefreshStatusCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            Padding="10,6" Margin="0,0,8,0" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄 " FontSize="11" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AiModels_Refresh]}" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Botón Abrir Carpeta -->
                    <Button Command="{Binding OpenModelsFolderCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            Padding="10,6" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 " FontSize="11" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AiModels_OpenDir]}" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Indicador de descarga global -->
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" 
                           Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Text="⏳ Descargando modelos..." FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
            </Grid>
        </Border>

        <!-- 3. Lista de Modelos Disponibles -->
        <Border Grid.Row="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgSurfaceBrush}" 
                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                    BorderThickness="1" CornerRadius="6" 
                                    Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Col 0: Icono de Estado -->
                                    <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" />

                                    <!-- Col 1: Información del Modelo -->
                                    <StackPanel Grid.Column="1" Margin="8,0,12,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Badge de Categoría -->
                                            <Border Background="{DynamicResource AccentGlowBrush}" CornerRadius="3" Padding="5,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>

                                            <!-- Nombre -->
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />

                                            <!-- Tamaño estimado -->
                                            <TextBlock Text="{Binding ExpectedSizeLabel, StringFormat='({0})'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <!-- Descripción -->
                                        <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,2,0,0" />

                                        <!-- Barra de Progreso (solo durante descarga) -->
                                        <ProgressBar Value="{Binding Progress}" Maximum="100" Height="5" Margin="0,5,0,0"
                                                     Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                     Foreground="{DynamicResource AccentPrimaryBrush}"
                                                     Background="{DynamicResource BgCardBrush}" />

                                        <!-- Texto de Progreso -->
                                        <TextBlock Text="{Binding ProgressText}" FontSize="9.5" Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Col 2: Estado en disco -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="11" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding DiskSizeLabel}" FontSize="10" 
                                                   Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" Margin="0,2,0,0" />
                                    </StackPanel>

                                    <!-- Col 3: Botones de Acción -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <!-- Botón Descargar (visible si NO descargado o durante descarga) -->
                                        <Button Content="⬇️ Descargar"
                                                Command="{Binding DataContext.DownloadModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding CanDownload}"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                                Style="{DynamicResource PrimaryButton}"
                                                Padding="10,5" FontSize="10.5" Cursor="Hand" />

                                        <!-- Botón Eliminar (visible si YA descargado) -->
                                        <Button Content="🗑️ Eliminar"
                                                Command="{Binding DataContext.DeleteModelCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsDownloaded, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                Style="{DynamicResource SecondaryButton}"
                                                Padding="8,5" FontSize="10.5" Cursor="Hand" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 4. Pie de Ventana -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Ruta de la carpeta -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📁 Carpeta de modelos: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Text="{Binding ModelsDirectory}" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" />
            </StackPanel>

            <!-- Botón Cerrar -->
            <Button Grid.Column="1" Click="Close_Click" Style="{DynamicResource SecondaryButton}" Padding="16,6" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close]}" FontSize="11.5" Cursor="Hand" />
        </Grid>
    </Grid>
</Window>
