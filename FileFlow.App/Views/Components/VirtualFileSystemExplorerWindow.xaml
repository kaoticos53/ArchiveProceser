<Window x:Class="FileFlow.App.Views.Components.VirtualFileSystemExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VfsExplorer_Title]}"
        Height="720" Width="1100" MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="HeaderKpiCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="ToolActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Cabecera & KPIs -->
            <RowDefinition Height="Auto" /> <!-- Barra de herramientas -->
            <RowDefinition Height="*" />    <!-- Contenido 3 columnas -->
        </Grid.RowDefinitions>

        <!-- 1. Cabecera y KPIs Resumen -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Vertical">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🗂️" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VfsExplorer_HeaderTitle]}"
                               FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VfsExplorer_HeaderSubtitle]}"
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="34,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Style="{StaticResource HeaderKpiCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📄 Archivos" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalFiles}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HeaderKpiCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VfsExplorer_KpiSource], FallbackValue='📥 Orígenes'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalSourceFiles}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HeaderKpiCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VfsExplorer_KpiDestination], FallbackValue='📤 Destinos'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalDestinationFiles}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HeaderKpiCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="📁 Carpetas" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalDirectories}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HeaderKpiCardStyle}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="💾 Tamaño Simulado" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource HeaderKpiCardStyle}" Margin="0">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⚠️ Conflictos _N" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalConflicts}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Barra de Herramientas y Filtros -->
        <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Buscador -->
                <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" VerticalAlignment="Center" Margin="4,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center" FontSize="12" />
                    </Grid>
                </Border>

                <!-- Filtro por categoría -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Categoría:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableCategories}" SelectedItem="{Binding SelectedCategoryFilter}"
                              Width="120" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12" Height="28" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Filtro por Rol en Pipeline -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <TextBlock Text="Rol:" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,6,0" />
                    <ComboBox ItemsSource="{Binding AvailableRoles}" SelectedItem="{Binding SelectedRoleFilter}"
                              Width="110" Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                              FontSize="12" Height="28" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Botones de Acción -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolActionButtonStyle}" Command="{Binding CopyAsciiTreeCommand}" Margin="0,0,8,0"
                            ToolTip="Copia la estructura completa de carpetas en formato de árbol de texto ASCII">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0" />
                            <TextBlock Text="Copiar Árbol ASCII" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolActionButtonStyle}" Command="{Binding MaterializeToSandboxAndOpenCommand}" Margin="0,0,8,0"
                            ToolTip="Materializa físicamente los archivos virtuales en un directorio temporal y abre el Explorador de Windows">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📂" Margin="0,0,6,0" />
                            <TextBlock Text="Abrir en Sandbox" Foreground="{DynamicResource AccentCyanBrush}" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource ToolActionButtonStyle}" Command="{Binding RefreshDataCommand}" Margin="0,0,8,0" ToolTip="Refrescar datos del VFS">
                        <TextBlock Text="🔄" />
                    </Button>

                    <Button Style="{StaticResource ToolActionButtonStyle}" Command="{Binding ClearVirtualFileSystemCommand}" ToolTip="Limpiar VFS">
                        <TextBlock Text="🗑️" Foreground="{DynamicResource AccentErrorBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Contenido Principal: Árbol + Tabla + Inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="180" /> <!-- Árbol de carpetas -->
                <ColumnDefinition Width="6" />                   <!-- GridSplitter -->
                <ColumnDefinition Width="*" MinWidth="350" />   <!-- Tabla de archivos -->
                <ColumnDefinition Width="6" />                   <!-- GridSplitter -->
                <ColumnDefinition Width="340" MinWidth="250" /> <!-- Inspector de detalles -->
            </Grid.ColumnDefinitions>

            <!-- Panel Izquierdo: TreeView de Directorios -->
            <Border Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="📁 Carpetas Virtuales" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="4,0,0,8" />

                    <TreeView Grid.Row="1" ItemsSource="{Binding DirectoryTreeNodes}" Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Padding" Value="4,3" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📁" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding FileCount}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Panel Central: Tabla de Archivos Virtuales -->
            <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="4,0,0,8">
                        <TextBlock Text="📄 Archivos Generados" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />
                        <TextBlock Text="{Binding FilteredFiles.Count, StringFormat=' ({0})'}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="12" FontWeight="Bold" />
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredFiles}" SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                              RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <!-- Rol en Pipeline (Origen / Destino / Intermedio) -->
                            <DataGridTemplateColumn Header="Rol" Width="85">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="5,2" HorizontalAlignment="Center" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Role}" Value="Source">
                                                            <Setter Property="Background" Value="#223B82F6" />
                                                            <Setter Property="BorderBrush" Value="#663B82F6" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Destination">
                                                            <Setter Property="Background" Value="#2210B981" />
                                                            <Setter Property="BorderBrush" Value="#6610B981" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Role}" Value="Intermediate">
                                                            <Setter Property="Background" Value="#22F59E0B" />
                                                            <Setter Property="BorderBrush" Value="#66F59E0B" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Role}" Value="Source">
                                                                <Setter Property="Text" Value="📥 Origen" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="Destination">
                                                                <Setter Property="Text" Value="📤 Destino" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Role}" Value="Intermediate">
                                                                <Setter Property="Text" Value="⚙️ Interm." />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentWarningBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Archivo" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                                            <TextBlock Text="📄" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" Width="50" />

                            <DataGridTemplateColumn Header="Operación" Width="95">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="6,2" HorizontalAlignment="Center" Background="{DynamicResource BgCardBrush}" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}">
                                            <TextBlock Text="{Binding OperationType}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="Original">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="Saved">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentSuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="Renamed">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="ConflictRenamed">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentWarningBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="Moved">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentCyanBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding OperationType}" Value="Copied">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentPurpleBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="Vinculado" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <TextBlock Text="{Binding DestinationPath}" FontSize="11" Foreground="{DynamicResource AccentSuccessBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DestinationPath}" />
                                            <TextBlock Text="{Binding RelatedSourcePath}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RelatedSourcePath}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Nodo Emisor" Binding="{Binding SourceNodeName}" Width="110" />
                            <DataGridTextColumn Header="Carpeta Virtual" Binding="{Binding DirectoryPath}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- Panel Derecho: Inspector de Metadatos & Trazabilidad -->
            <Border Grid.Column="4" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
                <TabControl Background="Transparent" BorderThickness="0">
                    <!-- Pestaña 1: Metadatos Enriquecidos -->
                    <TabItem Header="🏷️ Metadatos">
                        <Grid Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding SelectedFile.FileName, StringFormat='Detalles de: {0}'}"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedFileMetadata}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" HeadersVisibility="Column"
                                      RowHeaderWidth="0" GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Grupo" Binding="{Binding Category}" Width="100" />
                                    <DataGridTextColumn Header="Campo" Binding="{Binding Key}" Width="110" />
                                    <DataGridTextColumn Header="Valor" Binding="{Binding Value}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Pestaña 2: Historial de Ejecución -->
                    <TabItem Header="⏱️ Trazabilidad">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <ItemsControl ItemsSource="{Binding SelectedFile.ExecutionLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pestaña 3: Comparativa Antes vs Después -->
                    <TabItem Header="🔄 Antes / Después">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Rol en Pipeline:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedFile.Role}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Border>

                                <TextBlock Text="Ruta Original (Antes):" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedFile.OriginalPath}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentWarningBrush}" />
                                </Border>

                                <TextBlock Text="Ruta Virtual (Después):" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedFile.VirtualPath}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentSuccessBrush}" />
                                </Border>

                                <TextBlock Text="Ruta de Destino Vinculada:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,12">
                                    <TextBlock Text="{Binding SelectedFile.DestinationPath, FallbackValue='(Sin destino)'}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                </Border>

                                <TextBlock Text="Operación Realizada:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                                    <TextBlock Text="{Binding SelectedFile.OperationType}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Pestaña 4: Árbol ASCII -->
                    <TabItem Header="🌲 Árbol ASCII">
                        <Grid Margin="0,8,0,0">
                            <TextBox Text="{Binding AsciiTreeText}" IsReadOnly="True" TextWrapping="NoWrap"
                                     FontFamily="Consolas, Courier New" FontSize="11"
                                     Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
