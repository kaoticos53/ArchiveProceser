<Window x:Class="FileFlow.App.Views.Components.WorkflowSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_WindowTitle]}"
        Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_HeaderTitle]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" />
            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_HeaderSubtitle]}" 
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- Tab 1: Almacenamiento y Rutas -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_TabStorage]}" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Ruta de Salida Global -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_GlobalOutputDirTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_GlobalOutputDirDesc]}" 
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGlobalOutputDir" 
                                         Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8,5" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseGlobalOutput_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0" Cursor="Hand">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_BrowseBtn]}" FontSize="11" />
                                </Button>
                            </Grid>

                            <!-- Resolución de Colisión por Defecto -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ConflictStrategyTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <ComboBox x:Name="CmbConflictStrategy" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" Margin="0,0,0,14">
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ConflictRename]}" Tag="RenameIncremental" IsSelected="True" />
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ConflictOverwrite]}" Tag="Overwrite" />
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ConflictSkip]}" Tag="Skip" />
                            </ComboBox>

                            <!-- Auto-guardado de Proyectos -->
                            <CheckBox x:Name="ChkEnableAutoSave" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_EnableAutoSave]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <Grid Margin="20,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AutoSaveInterval]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtAutoSaveInterval" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" Text="5" />
                                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_MinutesLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: Apariencia & UI -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_TabAppearance]}" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Tema Predeterminado -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_DefaultThemeTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Click="OpenThemeCustomizer_Click" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,2">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_CustomizeThemesBtn]}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                </Button>
                            </Grid>
                            <ComboBox x:Name="CmbActiveTheme" 
                                      Background="{DynamicResource BgSurfaceBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                      BorderBrush="{DynamicResource BorderDarkBrush}" 
                                      SelectedValuePath="Id" 
                                      DisplayMemberPath="Name" 
                                      Padding="6,4" 
                                      FontSize="11" 
                                      Margin="0,0,0,14" />

                            <!-- Modo de Vista del Catálogo de Nodos -->
                            <CheckBox x:Name="ChkIsCompactToolbox" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_CompactToolbox]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- Ajustes de Consola de Logs -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LogConsoleTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkAutoScrollConsole" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AutoScrollConsole]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" IsChecked="True" />
                            
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_MaxLogEntries]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtMaxLogEntries" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" Text="1000" />
                                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LinesUnlimitedLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 3: Rendimiento & Ejecución -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_TabPerformance]}" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Concurrencia de Hilos de CPU -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ParallelCpuTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ParallelCpuDesc]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_MaxCpuThreads]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtMaxThreads" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" Text="8" />
                                <TextBlock Grid.Column="2" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ThreadsLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>

                            <!-- Estado del Modo Prueba (DryRun) por Defecto -->
                            <CheckBox x:Name="ChkDefaultDryRun" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_DefaultDryRun]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" IsChecked="True" />

                            <!-- Nivel Mínimo de Logs -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LogLevelTitle]}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <ComboBox x:Name="CmbDefaultLogLevel" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11">
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LogLevelInfo]}" Tag="Information" IsSelected="True" />
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LogLevelWarning]}" Tag="Warning" />
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LogLevelError]}" Tag="Error" />
                                <ComboBoxItem Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_LogLevelDebug]}" Tag="Debug" />
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 4: Herramientas Externas -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_TabExternalTools]}" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_ExecutablesTitle]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="AutoDetect_Click" Style="{DynamicResource PrimaryButton}" Padding="10,4" Cursor="Hand">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_AutoDetectBtn]}" FontSize="10.5" />
                                </Button>
                            </Grid>

                            <!-- FFmpeg -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_FfmpegLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFfmpeg" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseFfmpeg_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>

                            <!-- FFprobe -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_FfprobeLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFfprobe" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseFfprobe_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>

                            <!-- 7-Zip -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_SevenZipLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSevenZip" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseSevenZip_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>

                            <!-- Python -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_PythonLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPython" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowsePython_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Pie con Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Cancel]}" FontSize="11.5" Cursor="Hand" />
            <Button Click="Save_Click" Style="{DynamicResource PrimaryButton}" Padding="16,6" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings_SaveBtn]}" FontSize="11.5" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
