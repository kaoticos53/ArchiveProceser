<Window x:Class="FileFlow.App.Views.Components.WorkflowSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ajustes Generales de la Aplicación"
        Height="520" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Encabezado -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="⚙️ Ajustes Generales de FileFlow Studio" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" />
            <TextBlock Text="Configura los parámetros globales persistentes de almacenamiento, apariencia, rendimiento y ejecutables externos." 
                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- TabControl -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            
            <!-- Tab 1: Almacenamiento y Rutas -->
            <TabItem Header="📂 Almacenamiento &amp; Rutas" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Ruta de Salida Global -->
                            <TextBlock Text="📁 Ruta de Salida Global por Defecto" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="Carpeta de destino predeterminada persistente al ejecutar flujos y guardar archivos convertidos." 
                                       FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtGlobalOutputDir" 
                                         Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8,5" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseGlobalOutput_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="6,0,0,0" Cursor="Hand">
                                    <TextBlock Text="📁 Examinar" FontSize="11" />
                                </Button>
                            </Grid>

                            <!-- Resolución de Colisión por Defecto -->
                            <TextBlock Text="⚡ Estrategia de Colisión de Archivos por Defecto" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <ComboBox x:Name="CmbConflictStrategy" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" Margin="0,0,0,14">
                                <ComboBoxItem Content="RenameIncremental (Renombrar Incremental ej: foto_1.jpg)" Tag="RenameIncremental" IsSelected="True" />
                                <ComboBoxItem Content="Overwrite (Sobrescribir archivo existente)" Tag="Overwrite" />
                                <ComboBoxItem Content="Skip (Omitir si el archivo existe)" Tag="Skip" />
                            </ComboBox>

                            <!-- Auto-guardado de Proyectos -->
                            <CheckBox x:Name="ChkEnableAutoSave" Content="Activar Auto-guardado automático de proyectos" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <Grid Margin="20,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Intervalo de auto-guardado:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtAutoSaveInterval" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" Text="5" />
                                <TextBlock Grid.Column="2" Text="minutos" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 2: Apariencia & UI -->
            <TabItem Header="🎨 Apariencia &amp; UI" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Tema Predeterminado -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="🎨 Tema Visual por Defecto" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Click="OpenThemeCustomizer_Click" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,2">
                                    <TextBlock Text="🎨 Personalizar Temas..." FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                </Button>
                            </Grid>
                            <ComboBox x:Name="CmbActiveTheme" 
                                      Background="{DynamicResource BgSurfaceBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}" 
                                      BorderBrush="{DynamicResource BorderDarkBrush}" 
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      Padding="6,4" 
                                      FontSize="11" 
                                      Margin="0,0,0,14" />

                            <!-- Modo de Vista del Catálogo de Nodos -->
                            <CheckBox x:Name="ChkIsCompactToolbox" Content="Iniciar Catálogo de Nodos en Modo Lista Compacta (28px)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                            <!-- Ajustes de Consola de Logs -->
                            <TextBlock Text="💻 Consola de Registros (Logs)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                            <CheckBox x:Name="ChkAutoScrollConsole" Content="Desplazamiento automático de consola al recibir registros" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" IsChecked="True" />
                            
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Máximo de líneas en consola:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtMaxLogEntries" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" Text="1000" />
                                <TextBlock Grid.Column="2" Text="líneas (0 = Ilimitado)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 3: Rendimiento & Ejecución -->
            <TabItem Header="⚡ Rendimiento &amp; Ejecución" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Concurrencia de Hilos de CPU -->
                            <TextBlock Text="⚡ Procesamiento en Paralelo y Concurrencia de CPU" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <TextBlock Text="Número máximo de hilos simultáneos para procesar lotes de archivos en paralelo." FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Hilos máximos de CPU:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Grid.Column="1" x:Name="TxtMaxThreads" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" Text="8" />
                                <TextBlock Grid.Column="2" Text="hilos" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>

                            <!-- Estado del Modo Prueba (DryRun) por Defecto -->
                            <CheckBox x:Name="ChkDefaultDryRun" Content="Iniciar la aplicación siempre con Modo Prueba (Simulación) activado" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" IsChecked="True" />

                            <!-- Nivel Mínimo de Logs -->
                            <TextBlock Text="🔍 Nivel Mínimo de Registro (Log Filter Level)" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,3" />
                            <ComboBox x:Name="CmbDefaultLogLevel" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11">
                                <ComboBoxItem Content="Information (Registros de flujo y eventos estándar)" Tag="Information" IsSelected="True" />
                                <ComboBoxItem Content="Warning (Solo advertencias y errores)" Tag="Warning" />
                                <ComboBoxItem Content="Error (Exclusivamente fallos críticos)" Tag="Error" />
                                <ComboBoxItem Content="Debug (Detalle exhaustivo de depuración)" Tag="Debug" />
                            </ComboBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>

            <!-- Tab 4: Herramientas Externas -->
            <TabItem Header="🛠️ Herramientas Externas" Padding="10,4" Cursor="Hand">
                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rutas de Ejecutables del Sistema" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Click="AutoDetect_Click" Style="{DynamicResource PrimaryButton}" Padding="10,4" Cursor="Hand">
                                    <TextBlock Text="🔍 Auto-Detectar Herramientas" FontSize="10.5" />
                                </Button>
                            </Grid>

                            <!-- FFmpeg -->
                            <TextBlock Text="🎬 FFmpeg (Transcodificación de Vídeo/Audio)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFfmpeg" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseFfmpeg_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>

                            <!-- FFprobe -->
                            <TextBlock Text="🔍 FFprobe (Inspección de Metadatos de Media)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtFfprobe" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseFfprobe_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>

                            <!-- 7-Zip -->
                            <TextBlock Text="📦 7-Zip (Archivos Comprimidos ZIP/7z/RAR)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSevenZip" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowseSevenZip_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>

                            <!-- Python -->
                            <TextBlock Text="🐍 Python (Scripts y Automatización CLI)" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPython" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" />
                                <Button Grid.Column="1" Click="BrowsePython_Click" Style="{DynamicResource SecondaryButton}" Padding="8,4" Margin="4,0,0,0" Content="📁" Cursor="Hand" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </TabItem>
        </TabControl>

        <!-- Pie con Botones -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" Content="Cancelar" FontSize="11.5" Cursor="Hand" />
            <Button Click="Save_Click" Style="{DynamicResource PrimaryButton}" Padding="16,6" Content="✅ Guardar Ajustes Permanentes" FontSize="11.5" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
