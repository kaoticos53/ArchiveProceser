<UserControl x:Class="FileFlow.App.Views.Components.NodeCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:nodify="clr-namespace:Nodify;assembly=Nodify"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:sdk="clr-namespace:FileFlow.Sdk;assembly=FileFlow.Sdk"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             xmlns:conv="clr-namespace:FileFlow.App.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NodeViewModel}"
             HorizontalAlignment="Stretch"
             PreviewMouseDown="UserControl_PreviewMouseDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <conv:BreakpointToBrushConverter x:Key="BreakpointToBrushConverter" />
            <conv:LoggingToBrushConverter x:Key="LoggingToBrushConverter" />
            <conv:LoggingToTooltipConverter x:Key="LoggingToTooltipConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Templates/NodeParameterTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch">
        <!-- Resplandor exterior exclusivo de Selección -->
        <Border BorderBrush="{DynamicResource AccentPrimaryBrush}" 
                BorderThickness="2" CornerRadius="11" Margin="-1.5" IsHitTestVisible="False"
                Visibility="{Binding IsSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Color="#4F46E5" Opacity="0.45" />
            </Border.Effect>
        </Border>

        <nodify:Node Style="{StaticResource BlenderNodeStyle}" 
                     Header="{Binding}" 
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Stretch"
                     MouseDoubleClick="Node_MouseDoubleClick"
                     Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}">
            
            <!-- Menú contextual del nodo -->
            <nodify:Node.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorTitle]}"
                              Command="{Binding PlacementTarget.DataContext.InspectNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <TextBlock Text="🔍" FontSize="12" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BreakpointToggle]}"
                              Command="{Binding PlacementTarget.DataContext.ToggleBreakpointCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <Ellipse Width="12" Height="12" Fill="#EF4444" />
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LoggingToggle]}"
                              Command="{Binding PlacementTarget.DataContext.ToggleLoggingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                        <MenuItem.Icon>
                            <Border Width="12" Height="12" CornerRadius="2" Background="#06B6D4">
                                <TextBlock Text="≡" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                            </Border>
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator />

                    <!-- Paleta de colores rápidos -->
                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ChangeColor]}">
                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorEmerald]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#10B981">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#10B981" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorCyan]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#06B6D4">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#06B6D4" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorPurple]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#A855F7">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#A855F7" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorAmber]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#F59E0B">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#F59E0B" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorRed]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#EF4444">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#EF4444" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorIndigo]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#818CF8">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#818CF8" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorMagenta]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#EC4899">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#EC4899" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ColorSlate]}"
                                  Command="{Binding PlacementTarget.DataContext.ChangeColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="#64748B">
                            <MenuItem.Icon>
                                <Ellipse Width="14" Height="14" Fill="#64748B" Stroke="#12141D" StrokeThickness="1" />
                            </MenuItem.Icon>
                        </MenuItem>

                        <Separator />

                        <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[CustomColor]}"
                                  Command="{Binding PlacementTarget.DataContext.ChooseCustomColorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </MenuItem>

                    <Separator />

                    <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DeleteNode]}"
                              Command="{Binding PlacementTarget.Tag.DeleteNodeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </nodify:Node.ContextMenu>

            <!-- Encabezado de la Tarjeta del Nodo -->
            <nodify:Node.HeaderTemplate>
                <DataTemplate DataType="{x:Type vm:NodeViewModel}">
                    <Border Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" CornerRadius="8.5,8.5,0,0" Padding="10,8">
                        <StackPanel>
                            <!-- Barra de acento superior -->
                            <Border Height="3" Background="{Binding AccentColor}" CornerRadius="8.5,8.5,0,0" Margin="-10,-8,-10,6" />

                            <!-- Fila principal de cabecera -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Botón Breakpoint -->
                                <Button Grid.Column="0" Command="{Binding ToggleBreakpointCommand}" 
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,5,0"
                                        Cursor="Hand" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BreakpointToggle]}">
                                    <Ellipse Width="11" Height="11" 
                                             Fill="{Binding HasBreakpoint, Converter={StaticResource BreakpointToBrushConverter}}" 
                                             Stroke="{DynamicResource BorderDarkBrush}" StrokeThickness="1.5" />
                                </Button>

                                <!-- Botón Toggle Logging (Emisión de logs de este nodo) -->
                                <Button Grid.Column="1" Command="{Binding ToggleLoggingCommand}" 
                                        Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,6,0"
                                        Cursor="Hand" ToolTip="{Binding IsLoggingEnabled, Converter={StaticResource LoggingToTooltipConverter}}">
                                    <Border Width="13" Height="13" CornerRadius="3"
                                            Background="{Binding IsLoggingEnabled, Converter={StaticResource LoggingToBrushConverter}}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1">
                                        <TextBlock Text="≡" FontSize="8.5" FontWeight="Bold" Foreground="White" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0" />
                                    </Border>
                                </Button>

                                <!-- Indicador LED de Estado de Ejecución -->
                                <Border Grid.Column="2" Width="9" Height="9" CornerRadius="4.5" Margin="0,0,7,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1C212E" />
                                            <Setter Property="BorderBrush" Value="#323B4E" />
                                            <Setter Property="BorderThickness" Value="1.2" />
                                            <Setter Property="ToolTip" Value="Inactivo" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="{x:Static sdk:NodeExecutionStatus.Running}">
                                                    <Setter Property="Background" Value="#10B981" />
                                                    <Setter Property="BorderBrush" Value="#34D399" />
                                                    <Setter Property="ToolTip" Value="Ejecutando..." />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.9" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="{x:Static sdk:NodeExecutionStatus.Completed}">
                                                    <Setter Property="Background" Value="#06B6D4" />
                                                    <Setter Property="BorderBrush" Value="#67E8F9" />
                                                    <Setter Property="ToolTip" Value="Completado" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="{x:Static sdk:NodeExecutionStatus.PausedAtBreakpoint}">
                                                    <Setter Property="Background" Value="#F59E0B" />
                                                    <Setter Property="BorderBrush" Value="#FCD34D" />
                                                    <Setter Property="ToolTip" Value="Pausado en Punto de Interrupción" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#F59E0B" BlurRadius="10" ShadowDepth="0" Opacity="1.0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="{x:Static sdk:NodeExecutionStatus.PausedOnError}">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                    <Setter Property="ToolTip" Value="Pausado por Error" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="1.0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExecutionStatus}" Value="{x:Static sdk:NodeExecutionStatus.Faulted}">
                                                    <Setter Property="Background" Value="#EF4444" />
                                                    <Setter Property="BorderBrush" Value="#FCA5A5" />
                                                    <Setter Property="ToolTip" Value="Error en nodo" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value>
                                                            <DropShadowEffect Color="#EF4444" BlurRadius="10" ShadowDepth="0" Opacity="1.0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>

                                <!-- Título del Nodo -->
                                <TextBlock Grid.Column="3" Text="{Binding Title}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                
                                <!-- Botón Expandir/Colapsar Parámetros -->
                                <ToggleButton Grid.Column="4"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                              Content="⚙"
                                              Foreground="{DynamicResource TextSecondaryBrush}"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Padding="6,2"
                                              Margin="6,0,0,0"
                                              Cursor="Hand"
                                              ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ToggleParametersToolTip]}" />
                            </Grid>

                            <!-- Barra de Progreso Iterativa -->
                            <Grid Margin="0,6,0,0" Visibility="{Binding IsProgressActive, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ProgressBar Grid.Row="0" Value="{Binding ProgressPercentage, Mode=OneWay}" Minimum="0" Maximum="100" Height="4" 
                                             Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource AccentSuccessBrush}" BorderThickness="0">
                                    <ProgressBar.Template>
                                        <ControlTemplate TargetType="ProgressBar">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="2">
                                                <Grid>
                                                    <Border Name="PART_Track" />
                                                    <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="2" />
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </ProgressBar.Template>
                                </ProgressBar>

                                <TextBlock Grid.Row="1" Text="{Binding ProgressMessage}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" Margin="0,2,0,0" 
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </nodify:Node.HeaderTemplate>

            <!-- Cuerpo del Nodo: Puertos, Parámetros y Barra Inferior -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,4,0,4">
                    <!-- Fila de Puertos (Entradas y Salidas en borde exterior) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Puertos de Entrada -->
                        <ItemsControl Grid.Column="0" ItemsSource="{Binding InputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                    <nodify:NodeInput DataContext="{Binding}"
                                                      Header="{Binding}" 
                                                      IsConnected="True" 
                                                      Anchor="{Binding Anchor, Mode=OneWayToSource}" 
                                                      DisconnectCommand="{Binding DataContext.DisconnectConnectorCommand, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                                                      HorizontalAlignment="Left"
                                                      Background="Transparent"
                                                      BorderBrush="Transparent"
                                                      BorderThickness="0"
                                                      Margin="-7,3,0,3">
                                        <nodify:NodeInput.HeaderTemplate>
                                            <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Círculo / Pin de Entrada en el borde exterior con ToolTip Rico -->
                                                    <Border Width="14" Height="14" CornerRadius="7" 
                                                            Background="{Binding PortColor}" 
                                                            BorderBrush="{DynamicResource BgCardBrush}" 
                                                            BorderThickness="2" 
                                                            Margin="0,0,6,0">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.35" />
                                                        </Border.Effect>
                                                        <Border.ToolTip>
                                                            <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Width="310">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.55" />
                                                                    </Border.Effect>
                                                                    <StackPanel>
                                                                        <!-- Encabezado del Puerto -->
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DirectionIcon}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,6,0" />
                                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                            </StackPanel>

                                                                            <Border Grid.Column="1" Background="{Binding PortColor}" CornerRadius="4" Padding="6,1.5">
                                                                                <TextBlock Text="{Binding DataTypeSimpleName}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,0,0,6" />

                                                                        <!-- Descripción del Puerto -->
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="15" />

                                                                        <!-- Panel de Métricas de Transmisión -->
                                                                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                                                            <StackPanel>
                                                                                <Grid Margin="0,0,0,3">
                                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_ItemsProcessed]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    <TextBlock Text="{Binding TransmittedCountText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                                                                </Grid>

                                                                                <Grid>
                                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_LastItem]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    <TextBlock Text="{Binding LastItemInfoText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" HorizontalAlignment="Right" />
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Inspección de Metadatos y Variables (Modo Depuración) -->
                                                                        <Border Visibility="{Binding HasMetadataVariables, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_VariablesHeader]}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,0,0,4" />
                                                                                <ItemsControl ItemsSource="{Binding MetadataVariables}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Margin="0,1">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="110" />
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Estado de Conexión -->
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ConnectionStatusIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                    <!-- Nombre del Puerto de Entrada -->
                                                    <TextBlock Text="{Binding DisplayName}" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                                               FontSize="11" FontWeight="SemiBold" 
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </nodify:NodeInput.HeaderTemplate>
                                    </nodify:NodeInput>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Puertos de Salida -->
                        <ItemsControl Grid.Column="2" ItemsSource="{Binding OutputPorts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                    <nodify:NodeOutput DataContext="{Binding}"
                                                       Header="{Binding}" 
                                                       IsConnected="True" 
                                                       Anchor="{Binding Anchor, Mode=OneWayToSource}" 
                                                       HorizontalAlignment="Right"
                                                       Background="Transparent"
                                                       BorderBrush="Transparent"
                                                       BorderThickness="0"
                                                       Margin="0,3,-7,3">
                                        <nodify:NodeOutput.HeaderTemplate>
                                            <DataTemplate DataType="{x:Type vm:PortViewModel}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <!-- Nombre del Puerto de Salida -->
                                                    <TextBlock Text="{Binding DisplayName}" 
                                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                                               FontSize="11" FontWeight="SemiBold" 
                                                               VerticalAlignment="Center" 
                                                               Margin="0,0,6,0" />
                                                    <!-- Círculo / Pin de Salida en el borde exterior con ToolTip Rico -->
                                                    <Border Width="14" Height="14" CornerRadius="7" 
                                                            Background="{Binding PortColor}" 
                                                            BorderBrush="{DynamicResource BgCardBrush}" 
                                                            BorderThickness="2">
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Color="#000000" Opacity="0.35" />
                                                        </Border.Effect>
                                                        <Border.ToolTip>
                                                            <ToolTip Background="Transparent" BorderThickness="0" Padding="0">
                                                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12,10" Width="310">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.55" />
                                                                    </Border.Effect>
                                                                    <StackPanel>
                                                                        <!-- Encabezado del Puerto -->
                                                                        <Grid Margin="0,0,0,6">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>

                                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DirectionIcon}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,6,0" />
                                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                            </StackPanel>

                                                                            <Border Grid.Column="1" Background="{Binding PortColor}" CornerRadius="4" Padding="6,1.5">
                                                                                <TextBlock Text="{Binding DataTypeSimpleName}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                                                            </Border>
                                                                        </Grid>

                                                                        <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,0,0,6" />

                                                                        <!-- Descripción del Puerto -->
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="15" />

                                                                        <!-- Panel de Métricas de Transmisión -->
                                                                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                                                            <StackPanel>
                                                                                <Grid Margin="0,0,0,3">
                                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_ItemsProcessed]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    <TextBlock Text="{Binding TransmittedCountText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                                                                </Grid>

                                                                                <Grid>
                                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_LastItem]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                                    <TextBlock Text="{Binding LastItemInfoText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" TextTrimming="CharacterEllipsis" MaxWidth="160" HorizontalAlignment="Right" />
                                                                                </Grid>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Inspección de Metadatos y Variables (Modo Depuración) -->
                                                                        <Border Visibility="{Binding HasMetadataVariables, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                                Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6" Margin="0,0,0,8">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_VariablesHeader]}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" Margin="0,0,0,4" />
                                                                                <ItemsControl ItemsSource="{Binding MetadataVariables}">
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate>
                                                                                            <Grid Margin="0,1">
                                                                                                <Grid.ColumnDefinitions>
                                                                                                    <ColumnDefinition Width="110" />
                                                                                                    <ColumnDefinition Width="*" />
                                                                                                </Grid.ColumnDefinitions>
                                                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="4,0,0,0" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </StackPanel>
                                                                        </Border>

                                                                        <!-- Estado de Conexión -->
                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding ConnectionStatusIcon}" FontSize="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ConnectionStatusText}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ToolTip>
                                                        </Border.ToolTip>
                                                    </Border>
                                                </StackPanel>
                                            </DataTemplate>
                                        </nodify:NodeOutput.HeaderTemplate>
                                    </nodify:NodeOutput>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Barra de Acciones Directas del Nodo (CustomActions siempre visibles) -->
                    <ItemsControl ItemsSource="{Binding CustomActions}" Margin="8,4,8,2" HorizontalAlignment="Stretch">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding ExecuteCommand}"
                                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="White"
                                        BorderThickness="0" Padding="10,4" FontSize="10" FontWeight="Bold" Cursor="Hand"
                                        ToolTip="{Binding Tooltip}"
                                        Margin="2">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4" />
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Panel de Parámetros Colapsable -->
                    <Border Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,6"
                            Margin="8,4,8,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[SettingsTitle]}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Lista de Parámetros Modularizada -->
                            <ItemsControl ItemsSource="{Binding Parameters}" ItemTemplate="{StaticResource NodeParameterItemTemplate}" />

                            <!-- Lista Dinámica de Casos para SwitchCaseNode -->
                            <ItemsControl ItemsSource="{Binding SwitchCases}"
                                          Visibility="{Binding IsSwitchCaseNode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                          Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SwitchCaseItemViewModel}">
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Nombre del Caso (Nombra el puerto de salida) -->
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource AccentPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="4,3"
                                                     Margin="0,0,4,0" FontWeight="SemiBold"
                                                     ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_SwitchCaseNameToolTip]}">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4" />
                                                     </Style>
                                                </TextBox.Resources>
                                            </TextBox>

                                            <!-- Patrón de Coincidencia del Caso -->
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                     BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="4,3"
                                                     HorizontalAlignment="Stretch"
                                                     ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_SwitchPatternsToolTip]}">
                                                <TextBox.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="4,0,0,4" />
                                                     </Style>
                                                </TextBox.Resources>
                                            </TextBox>

                                            <!-- Botón Eliminar Caso -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding NodeOwner.RemoveSwitchCaseCommand}"
                                                    CommandParameter="{Binding}"
                                                    Content="🗑"
                                                    Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentErrorBrush}"
                                                    BorderThickness="0" Padding="6,2" FontSize="10" Cursor="Hand"
                                                    ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_SwitchDeleteToolTip]}">
                                                <Button.Resources>
                                                    <Style TargetType="Border">
                                                        <Setter Property="CornerRadius" Value="0,4,4,0" />
                                                    </Style>
                                                </Button.Resources>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Barra Inferior del Nodo (Footer): Categoría y Latencia/Telemetría extendida hasta los bordes -->
                <Border Grid.Row="1"
                        Background="{DynamicResource BgHeaderBrush}" 
                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="0,1,0,0" 
                        CornerRadius="0,0,8.5,8.5" 
                        Padding="8,4"
                        VerticalAlignment="Bottom">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Etiqueta de Categoría e Indicador de Modelo IA (Izquierda) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource BgSurfaceBrush}" 
                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="5" 
                                    Padding="6,1.5" 
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentPrimaryBrush}" FontSize="9.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </Border>

                            <!-- Control / Botón LED de Estado de Modelo IA -->
                            <Button Margin="5,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Command="{Binding ToggleModelLoadCommand}"
                                    Visibility="{Binding IsModelManaged, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    ToolTip="{Binding ModelStatusToolTip}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{DynamicResource BgSurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                                BorderThickness="1"
                                                CornerRadius="5"
                                                Padding="5,1.5">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Micro LED -->
                                                <Border Width="7" Height="7" CornerRadius="3.5" Margin="0,0,4,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#64748B" />
                                                            <Setter Property="BorderBrush" Value="#475569" />
                                                            <Setter Property="BorderThickness" Value="1" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsModelLoaded}" Value="True">
                                                                    <Setter Property="Background" Value="#10B981" />
                                                                    <Setter Property="BorderBrush" Value="#34D399" />
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsModelLoading}" Value="True">
                                                                    <Setter Property="Background" Value="#F59E0B" />
                                                                    <Setter Property="BorderBrush" Value="#FCD34D" />
                                                                    <Setter Property="Effect">
                                                                        <Setter.Value>
                                                                            <DropShadowEffect Color="#F59E0B" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <TextBlock Text="AI" FontSize="8.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Badges de Métricas / Telemetría (Latencia, RAM, GPU) con ToolTip Detallado -->
                        <StackPanel Grid.Column="1" 
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="4,0,16,0"
                                    ToolTip="{Binding DetailedMetricsToolTip}">
                            <!-- Badge de Aceleración GPU -->
                            <Border Margin="0,0,3,0" 
                                    Padding="4,1.5" 
                                    CornerRadius="4" 
                                    Background="#083344" 
                                    BorderBrush="#06B6D4" 
                                    BorderThickness="1"
                                    Visibility="{Binding IsGpuAccelerated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="🎮 GPU" Foreground="#22D3EE" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </Border>

                            <!-- Badge de Memoria RAM Rodante -->
                            <Border Margin="0,0,3,0" 
                                    Padding="4,1.5" 
                                    CornerRadius="4" 
                                    Background="#1E1B4B" 
                                    BorderBrush="#6366F1" 
                                    BorderThickness="1"
                                    Visibility="{Binding RollingRamText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <TextBlock Text="{Binding RollingRamText}" Foreground="#A5B4FC" FontSize="8.5" FontWeight="Bold" VerticalAlignment="Center" />
                            </Border>

                            <!-- Badge de Latencia y Cuello de Botella -->
                            <Border Padding="5,1.5" 
                                    CornerRadius="4" 
                                    Visibility="{Binding LatencyText, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1E293B" />
                                        <Setter Property="BorderBrush" Value="#475569" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HeatLevel}" Value="{x:Static sdk:Telemetry.LatencyHeatLevel.Low}">
                                                <Setter Property="Background" Value="#064E3B" />
                                                <Setter Property="BorderBrush" Value="#10B981" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeatLevel}" Value="{x:Static sdk:Telemetry.LatencyHeatLevel.Medium}">
                                                <Setter Property="Background" Value="#78350F" />
                                                <Setter Property="BorderBrush" Value="#F59E0B" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding HeatLevel}" Value="{x:Static sdk:Telemetry.LatencyHeatLevel.High}">
                                                <Setter Property="Background" Value="#881337" />
                                                <Setter Property="BorderBrush" Value="#F43F5E" />
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#F43F5E" BlurRadius="6" ShadowDepth="0" Opacity="0.8" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding LatencyText}" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </nodify:Node>

        <!-- Tirador interactivo de Redimensionamiento -->
        <Thumb Width="14" Height="14"
               HorizontalAlignment="Right"
               VerticalAlignment="Bottom"
               Cursor="SizeNWSE"
               Margin="0,0,4,4"
               DragDelta="ResizeThumb_DragDelta">
            <Thumb.Template>
                <ControlTemplate>
                    <Path Data="M 8 0 L 8 8 L 0 8 Z" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.7" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
    </Grid>
</UserControl>
