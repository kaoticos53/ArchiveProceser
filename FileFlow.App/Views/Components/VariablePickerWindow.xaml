<Window x:Class="FileFlow.App.Views.Components.VariablePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:VariablePickerViewModel}"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_WindowTitle]}"
        Height="620" Width="840" MinHeight="500" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgAppBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="FilterChipRadioStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="CategoryFilterGroup" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="ChipBorder" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Cabecera -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{}{x} " FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_HeaderTitle]}" 
                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_HeaderSubtitle]}" 
                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" />
                </StackPanel>

                <!-- Badges de contexto de nodo y upstream -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                        <TextBlock Text="{Binding TargetNodeTitle, StringFormat='Nodo: {0}'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </Border>
                    <Border Visibility="{Binding HasUpstreamNodes, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                        <TextBlock Text="{Binding UpstreamCountText}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Barra de Búsqueda y Filtros de Categoría -->
        <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Campo de Búsqueda -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TxtSearch"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgSurfaceBrush}"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDarkBrush}"
                             Padding="10,6"
                             FontSize="12"
                             VerticalContentAlignment="Center" />

                    <!-- Placeholder -->
                    <TextBlock IsHitTestVisible="False"
                               Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_SearchPlaceholder]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Grid.Column="1" Command="{Binding ClearSearchCommand}"
                            Padding="8,4" Margin="6,0,0,0"
                            ToolTip="Limpiar búsqueda">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="✖" FontSize="10" />
                    </Button>
                </Grid>

                <!-- Chips / Filtros de Categoría -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategoryAll]}" IsChecked="True" Command="{Binding SetCategoryCommand}" CommandParameter="ALL" Style="{StaticResource FilterChipRadioStyle}" Margin="0,0,6,0" />
                    <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategoryUpstream]}" Command="{Binding SetCategoryCommand}" CommandParameter="UPSTREAM" Style="{StaticResource FilterChipRadioStyle}" Margin="0,0,6,0" />
                    <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategorySystem]}" Command="{Binding SetCategoryCommand}" CommandParameter="SYSTEM" Style="{StaticResource FilterChipRadioStyle}" Margin="0,0,6,0" />
                    <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategoryDates]}" Command="{Binding SetCategoryCommand}" CommandParameter="DATES" Style="{StaticResource FilterChipRadioStyle}" Margin="0,0,6,0" />
                    <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategorySizes]}" Command="{Binding SetCategoryCommand}" CommandParameter="SIZES" Style="{StaticResource FilterChipRadioStyle}" Margin="0,0,6,0" />
                    <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategoryFunctions]}" Command="{Binding SetCategoryCommand}" CommandParameter="FUNCTIONS" Style="{StaticResource FilterChipRadioStyle}" />
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 3. Contenedor Principal: Lista y Panel Lateral de Detalle -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Lista de Variables Filtradas -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0">
                <Grid>
                    <!-- Lista de resultados -->
                    <ListBox x:Name="ListVariables"
                             ItemsSource="{Binding FilteredVariables}"
                             SelectedItem="{Binding SelectedVariable}"
                             MouseDoubleClick="ListVariables_MouseDoubleClick"
                             KeyDown="ListVariables_KeyDown"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Margin" Value="0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Fila Superior: Token y Badges -->
                                    <Grid Grid.Row="0" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Token}" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource AccentCyanBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Badge Upstream -->
                                            <Border Visibility="{Binding IsUpstream, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding SourceNodeTitle, StringFormat='🔗 {0}'}" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Border>

                                            <!-- Badge Categoría -->
                                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="5,2">
                                                <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fila Inferior: Descripción y Muestra -->
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding SampleValue, StringFormat='Ej: {0}'}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Mensaje si no hay resultados -->
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_NoResults]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="12"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasNoResults, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>

            <!-- Panel Lateral de Detalle y Vista Previa -->
            <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_DetailTitle]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- Contenido del Detalle -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Visibility="{Binding HasSelectedVariable, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <!-- Token -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_TokenLabel]}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DetailToken}" FontFamily="Cascadia Code, Consolas, monospace" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentCyanBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Command="{Binding CopyTokenCommand}" Style="{DynamicResource SecondaryButton}" Padding="6,2" Margin="4,0,0,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CopyToken]}">
                                        <TextBlock Text="📋" FontSize="10" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Descripción -->
                            <TextBlock Text="Descripción:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DetailDescription}" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />

                            <!-- Categoría y Origen -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CategoryLabel]}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DetailCategory}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10" />

                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_SourceLabel]}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <TextBlock Text="{Binding DetailSource}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,10" />

                            <!-- Vista Previa Evaluada -->
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_SamplePreviewLabel]}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,0,0,2" />
                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentGlowBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,12">
                                <TextBlock Text="{Binding DetailEvaluated}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Placeholder si no hay selección -->
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_SelectVariableHint]}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"
                               Margin="16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelectedVariable}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Botón Insertar -->
                    <Button Grid.Row="2" x:Name="BtnInsert" Click="BtnInsert_Click"
                            Style="{DynamicResource PrimaryButton}"
                            Padding="12,8"
                            IsEnabled="{Binding HasSelectedVariable}"
                            Cursor="Hand"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{}{x} " FontWeight="Bold" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_InsertBtn]}" FontWeight="SemiBold" FontSize="11.5" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Pie de Ventana -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Contador de Resultados y Atajos -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding CountStatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                <TextBlock Text="Atajo: Doble clic o Enter para insertar • Esc para salir" FontSize="10" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Button Grid.Column="1" Click="BtnCancel_Click" Style="{DynamicResource SecondaryButton}" Padding="16,6" Margin="0,0,8,0" IsCancel="True" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_CancelBtn]}" />

            <Button Grid.Column="2" Click="BtnInsert_Click" Style="{DynamicResource PrimaryButton}" Padding="18,6" IsDefault="True" IsEnabled="{Binding HasSelectedVariable}" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VarPicker_InsertBtn]}" />
        </Grid>
    </Grid>
</Window>
