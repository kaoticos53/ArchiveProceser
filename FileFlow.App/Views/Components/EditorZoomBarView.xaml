<UserControl x:Class="FileFlow.App.Views.Components.EditorZoomBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:EditorViewModel}">
    <Border Background="{DynamicResource BgCardBrush}"
            BorderBrush="{DynamicResource BorderDarkBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,4"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Margin="0,0,16,16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.25" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- Zoom Out Button -->
            <Button Command="{Binding ZoomOutCommand}" Style="{DynamicResource SecondaryButton}" Padding="6,2" Width="28" Height="24" ToolTip="Reducir Zoom (Ctrl + -)">
                <TextBlock Text="−" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
            </Button>
            
            <!-- Zoom Slider -->
            <Slider Width="90" Minimum="0.2" Maximum="2.0" Value="{Binding ViewportZoom, Mode=TwoWay}"
                    SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" Margin="8,0" />
            
            <!-- Zoom In Button -->
            <Button Command="{Binding ZoomInCommand}" Style="{DynamicResource SecondaryButton}" Padding="6,2" Width="28" Height="24" ToolTip="Aumentar Zoom (Ctrl + +)">
                <TextBlock Text="+" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
            </Button>
            
            <!-- Zoom Percentage Label -->
            <TextBlock Text="{Binding ViewportZoom, StringFormat={}{0:P0}}" 
                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" 
                       VerticalAlignment="Center" Width="40" TextAlignment="Center" Margin="4,0,2,0"/>
            
            <!-- 1:1 Reset Button -->
            <Button Command="{Binding ResetZoomCommand}" Style="{DynamicResource SecondaryButton}" Padding="6,2" Height="24" ToolTip="Restablecer Zoom al 100% (Ctrl + 0)" Margin="2,0,0,0">
                <TextBlock Text="1:1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
        </StackPanel>
    </Border>
</UserControl>
