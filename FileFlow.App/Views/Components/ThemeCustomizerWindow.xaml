<Window x:Class="FileFlow.App.Views.Components.ThemeCustomizerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:components="clr-namespace:FileFlow.App.Views.Components"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_WindowTitle]}"
        Height="760" Width="1200"
        MinHeight="620" MinWidth="980"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🎨" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_HeaderTitle]}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_HeaderSubtitle]}" 
                           FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="28,2,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ImportThemeCommand}" Style="{DynamicResource SecondaryButton}" Padding="10,5" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" FontSize="12" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_ImportBtn]}" FontSize="11.5" />
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportThemeCommand}" Style="{DynamicResource SecondaryButton}" Padding="10,5">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" FontSize="12" Margin="0,0,4,0" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_ExportBtn]}" FontSize="11.5" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 2. Main Content (Themes List | Editor Controls | Live Preview Mockup) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Themes List -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_AvailableThemes]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,8" />

                    <ListBox Grid.Row="1" ItemsSource="{Binding AvailableThemes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="4,1" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding IsBuiltIn, Converter={StaticResource StringEqualsToVisibilityConverter}}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Usuario" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                <Setter Property="Text" Value="Fábrica" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="2" Margin="0,8,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Command="{Binding NewCustomThemeCommand}" Style="{DynamicResource SecondaryButton}" Padding="4,5" Margin="0,0,3,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_NewBtn]}" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                            <Button Grid.Column="1" Command="{Binding DuplicateThemeCommand}" Style="{DynamicResource SecondaryButton}" Padding="4,5" Margin="3,0,0,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_DuplicateBtn]}" FontSize="11" />
                            </Button>
                        </Grid>
                        <Button Command="{Binding DeleteThemeCommand}" Style="{DynamicResource DangerButton}" Padding="4,5" IsEnabled="{Binding IsCustomTheme}">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_DeleteBtn]}" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Column 1: Theme Properties Form -->
            <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- General Info -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_GeneralInfo]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Margin="0,0,0,6">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_ThemeName]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <TextBox Text="{Binding EditingTheme.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="Input_Changed" Padding="6,4" FontSize="12" />
                            </StackPanel>
                            <CheckBox Grid.Row="1" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_DarkMode]}" 
                                      IsChecked="{Binding EditingTheme.IsDark, Mode=TwoWay}" 
                                      Checked="Input_Changed" Unchecked="Input_Changed"
                                      FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                        </Grid>

                        <Separator Margin="0,4,0,8" />

                        <!-- Section 1: Backgrounds & Surfaces -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_SectionBackgrounds]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <components:ColorPickerButton Label="Fondo de Aplicación" SelectedColorHex="{Binding EditingTheme.AppBackground, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Lienzo de Nodos (Grid)" SelectedColorHex="{Binding EditingTheme.BgEditor, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Tarjetas de Nodos" SelectedColorHex="{Binding EditingTheme.BgCard, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Superficie de Controles" SelectedColorHex="{Binding EditingTheme.BgSurface, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Cabeceras y Barras" SelectedColorHex="{Binding EditingTheme.BgHeader, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Hover / Resaltado" SelectedColorHex="{Binding EditingTheme.BgHover, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />

                        <Separator Margin="0,4,0,8" />

                        <!-- Section 2: Accents & Status Colors -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_SectionAccents]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <components:ColorPickerButton Label="Acento Primario" SelectedColorHex="{Binding EditingTheme.AccentPrimary, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Acento Hover" SelectedColorHex="{Binding EditingTheme.AccentHover, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Acento Resplandor (Glow)" SelectedColorHex="{Binding EditingTheme.AccentGlow, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Estado Éxito / Completado" SelectedColorHex="{Binding EditingTheme.AccentSuccess, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Estado Advertencia / Pausa" SelectedColorHex="{Binding EditingTheme.AccentWarning, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Estado Error / Fallo" SelectedColorHex="{Binding EditingTheme.AccentError, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Acento Cian / Datos" SelectedColorHex="{Binding EditingTheme.AccentCyan, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Acento Púrpura / Presets" SelectedColorHex="{Binding EditingTheme.AccentPurple, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />

                        <Separator Margin="0,4,0,8" />

                        <!-- Section 3: Text & Borders -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_SectionTextsBorders]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <components:ColorPickerButton Label="Texto Principal" SelectedColorHex="{Binding EditingTheme.TextPrimary, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Texto Secundario" SelectedColorHex="{Binding EditingTheme.TextSecondary, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Borde Principal" SelectedColorHex="{Binding EditingTheme.BorderDark, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Líneas de Cuadrícula" SelectedColorHex="{Binding EditingTheme.GridLine, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />

                        <Separator Margin="0,4,0,8" />

                        <!-- Section 4: Connection Wire Gradient -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_SectionWireGradient]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <components:ColorPickerButton Label="Color Inicial del Cable" SelectedColorHex="{Binding EditingTheme.WireColorStart, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Color Medio del Cable" SelectedColorHex="{Binding EditingTheme.WireColorMid, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />
                        <components:ColorPickerButton Label="Color Final del Cable" SelectedColorHex="{Binding EditingTheme.WireColorEnd, Mode=TwoWay}" ColorChanged="ColorPicker_ColorChanged" />

                        <Separator Margin="0,4,0,8" />

                        <!-- Section 5: Typography and Aesthetics -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_SectionTypography]}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                        
                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_UiFontFamily]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding AvailableFontFamilies}" SelectedItem="{Binding EditingTheme.FontFamily, Mode=TwoWay}" SelectionChanged="Combo_SelectionChanged" Padding="6,4" />
                        </StackPanel>

                        <StackPanel Margin="0,0,0,6">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_CodeFontFamily]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                            <ComboBox ItemsSource="{Binding AvailableCodeFonts}" SelectedItem="{Binding EditingTheme.CodeFontFamily, Mode=TwoWay}" SelectionChanged="Combo_SelectionChanged" Padding="6,4" />
                        </StackPanel>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_BaseFontSize]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding FontSizes}" SelectedItem="{Binding EditingTheme.BaseFontSize, Mode=TwoWay}" SelectionChanged="Combo_SelectionChanged" Padding="6,4" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_CornerRadius]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding CornerRadiusOptions}" SelectedItem="{Binding EditingTheme.CornerRadius, Mode=TwoWay}" SelectionChanged="Combo_SelectionChanged" Padding="6,4" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,4,0,0">
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_NodeShadowBlur]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding EditingTheme.NodeShadowBlur, StringFormat='{}{0:0} px'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                            <Slider Minimum="0" Maximum="40" Value="{Binding EditingTheme.NodeShadowBlur, Mode=TwoWay}" ValueChanged="Slider_ValueChanged" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Column 2: Interactive Live Preview Mockup -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_LivePreviewTitle]}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_LivePreviewSubtitle]}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Mockup Container Applying Live Preview Resource Dictionary -->
                    <Border x:Name="LivePreviewContainer" Grid.Row="1" 
                            Background="{DynamicResource AppBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            ClipToBounds="True">

                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel>
                                <!-- Mockup Top Bar -->
                                <Border Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="10,6" Margin="-16,-16,-16,14">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{DynamicResource AccentPrimaryBrush}" Width="20" Height="20" CornerRadius="4" Margin="0,0,6,0">
                                                <TextBlock Text="⚡" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                                            </Border>
                                            <TextBlock Text="FileFlow Studio" FontWeight="Bold" FontSize="12" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Border Background="{DynamicResource AccentSuccessBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                                <TextBlock Text="● ONLINE" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Mockup Nodes Canvas -->
                                <Border Background="{DynamicResource BgEditorBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Height="230" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <!-- Node 1: Folder Source -->
                                        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Width="180" 
                                                Background="{DynamicResource BgCardBrush}" 
                                                BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="{DynamicResource AppCornerRadius}" 
                                                Effect="{DynamicResource NodeShadowEffect}">
                                            <StackPanel>
                                                <Border Background="{DynamicResource BgHeaderBrush}" Padding="8,5" CornerRadius="6,6,0,0">
                                                    <Grid>
                                                        <TextBlock Text="📁 Carpeta Origen" FontWeight="Bold" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="8,6">
                                                    <TextBlock Text="Ruta: C:\Fotos" FontSize="10" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="Salida: Out" FontSize="10" FontWeight="SemiBold" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,4,0,0" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- Simulated Connection Wire Gradient -->
                                        <Path Stroke="{DynamicResource ConnectionWireBrush}" StrokeThickness="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathFigure StartPoint="-50,-10">
                                                        <BezierSegment Point1="20,-10" Point2="20,10" Point3="90,10" />
                                                    </PathFigure>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>

                                        <!-- Node 2: Transformador (Selected & Glowing) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="200" 
                                                Background="{DynamicResource BgCardBrush}" 
                                                BorderBrush="{DynamicResource AccentPrimaryBrush}" 
                                                BorderThickness="2" 
                                                CornerRadius="{DynamicResource AppCornerRadius}" 
                                                Effect="{DynamicResource NodeShadowEffect}">
                                            <StackPanel>
                                                <Border Background="{DynamicResource BgHeaderBrush}" Padding="8,5" CornerRadius="6,6,0,0">
                                                    <Grid>
                                                        <TextBlock Text="⚡ Renombrador Avanzado" FontWeight="Bold" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentGlowBrush}" HorizontalAlignment="Right" />
                                                    </Grid>
                                                </Border>
                                                <StackPanel Margin="8,6">
                                                    <TextBlock Text="Entrada: In" FontSize="10" FontWeight="SemiBold" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource AccentCyanBrush}" />
                                                    <Border Background="{DynamicResource BgSurfaceBrush}" CornerRadius="4" Padding="6,3" Margin="0,4,0,0">
                                                        <TextBlock Text="{}{Year}_{FileName}" FontFamily="{DynamicResource CodeFontFamily}" FontSize="10" Foreground="{DynamicResource AccentGlowBrush}" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Mockup Controls Gallery (Buttons, Inputs, Badges, Table) -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Action Buttons & Inputs -->
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_PreviewActions], FallbackValue='Botones de Acción:'}" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <WrapPanel Margin="0,0,0,8">
                                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_BtnPrimary], FallbackValue='Primario'}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF" Padding="8,4" Margin="0,0,4,4" FontWeight="SemiBold" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" />
                                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_BtnSuccess], FallbackValue='Éxito'}" Background="{DynamicResource AccentSuccessBrush}" Foreground="#FFFFFF" Padding="8,4" Margin="0,0,4,4" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" />
                                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_BtnWarning], FallbackValue='Advertencia'}" Background="{DynamicResource AccentWarningBrush}" Foreground="#FFFFFF" Padding="8,4" Margin="0,0,4,4" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" />
                                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_BtnDanger], FallbackValue='Peligro'}" Background="{DynamicResource AccentErrorBrush}" Foreground="#FFFFFF" Padding="8,4" Margin="0,0,4,4" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" />
                                        </WrapPanel>

                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_PreviewInputs], FallbackValue='Campos de Texto y Código:'}" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_StandardTextSample], FallbackValue='Texto estándar de interfaz'}" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="11" FontFamily="{DynamicResource AppFontFamily}" Margin="0,0,0,4" />
                                        <TextBox Text="SELECT * FROM [Files] WHERE Ext = 'jpg'" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource AccentPurpleBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,3" FontSize="10.5" FontFamily="{DynamicResource CodeFontFamily}" />
                                    </StackPanel>

                                    <!-- Mock Data Table -->
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_PreviewDataTable], FallbackValue='Tabla de Datos de Ejemplo:'}" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_ColFile], FallbackValue='Fichero'}" FontWeight="Bold" FontSize="10.5" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Theme_ColResult], FallbackValue='Resultado'}" FontWeight="Bold" FontSize="10.5" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Separator Background="{DynamicResource BorderSubtleBrush}" Margin="0,2,0,4" />
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="foto_01.jpg" FontSize="10.5" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="2026_FOTO_01.jpg" FontSize="10.5" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                                <Grid Margin="0,2">
                                                    <TextBlock Text="video_demo.mp4" FontSize="10.5" FontFamily="{DynamicResource AppFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="2026_VIDEO_DEMO.mp4" FontSize="10.5" FontFamily="{DynamicResource CodeFontFamily}" Foreground="{DynamicResource AccentSuccessBrush}" HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Footer Action Bar -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding ApplyToApplicationCommand}" Style="{DynamicResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_TestInAppToolTip]}">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_TestInApp]}" FontSize="12" />
                </Button>
                <Button Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Cancel]}" FontSize="12" />
                </Button>
                <Button Command="{Binding SaveAndApplyCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource PrimaryButton}" Padding="18,6">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ThemeCustomizer_SaveAndApply]}" FontSize="12" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
