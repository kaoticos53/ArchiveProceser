<UserControl x:Class="FileFlow.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="180" d:DesignWidth="1000">
    <Border Background="{DynamicResource BgSurfaceBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,1,0,0" 
            Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Console Header & Status Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ExecutionConsoleTitle]}" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               FontSize="13" 
                               Margin="0,0,14,0" 
                               VerticalAlignment="Center" />

                    <!-- Filtros Rápidos por Nivel de Log -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                        <RadioButton Content="Todos" 
                                     Command="{Binding SetFilterCommand}" CommandParameter="all"
                                     IsChecked="True" Style="{StaticResource FilterRadioButton}" 
                                     Padding="8,2" FontSize="10.5" Margin="0,0,4,0" Cursor="Hand" />
                        
                        <RadioButton Command="{Binding SetFilterCommand}" CommandParameter="errors"
                                     Style="{StaticResource FilterRadioButton}" 
                                     Padding="8,2" FontSize="10.5" Margin="0,0,4,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔴 Errores (" FontWeight="Bold" />
                                <TextBlock Text="{Binding ErrorCount}" FontWeight="Bold" />
                                <TextBlock Text=")" FontWeight="Bold" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton Command="{Binding SetFilterCommand}" CommandParameter="warnings"
                                     Style="{StaticResource FilterRadioButton}" 
                                     Padding="8,2" FontSize="10.5" Margin="0,0,4,0" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🟠 Advertencias (" FontWeight="Bold" />
                                <TextBlock Text="{Binding WarningCount}" FontWeight="Bold" />
                                <TextBlock Text=")" FontWeight="Bold" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="11.5" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Fluent Progress Bar -->
                <ProgressBar Grid.Column="1" 
                             Value="{Binding ProgressPercentage}" 
                             Minimum="0" 
                             Maximum="100" 
                             Height="6" 
                             Margin="16,0" 
                             Foreground="{DynamicResource AccentSuccessBrush}" 
                             Background="{DynamicResource BgHoverBrush}" 
                             BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="3" />
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>

                <!-- Action Buttons: Export & Clear -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ExportLog]}" 
                            Command="{Binding ExportLogsCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="10,4" 
                            FontSize="11" 
                            Margin="0,0,8,0" />

                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ClearLog]}" 
                            Command="{Binding ClearLogsCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="10,4" 
                            FontSize="11" />
                </StackPanel>
            </Grid>

            <!-- Rich Colored Log Console (100% Selectable & Copyable Text) -->
            <RichTextBox x:Name="LogConsoleRichTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         IsDocumentEnabled="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="{DynamicResource BgCardBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderDarkBrush}"
                         BorderThickness="1"
                         FontFamily="Cascadia Code, Consolas, monospace"
                         FontSize="11.5"
                         Padding="10"
                         SelectionBrush="{DynamicResource AccentPrimaryBrush}">
                <FlowDocument PagePadding="0">
                    <Paragraph x:Name="LogDocumentParagraph" Margin="0" />
                </FlowDocument>
            </RichTextBox>
        </Grid>
    </Border>
</UserControl>
