<UserControl x:Class="FileFlow.App.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             xmlns:converters="clr-namespace:FileFlow.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="280" d:DesignWidth="1100">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
        <converters:LogLevelToBadgeBackgroundConverter x:Key="LogLevelToBadgeBackgroundConverter" />
        <converters:LogLevelToBadgeForegroundConverter x:Key="LogLevelToBadgeForegroundConverter" />
        <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>

    <Border Background="{DynamicResource BgSurfaceBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,1,0,0" 
            Padding="10,6,10,8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Unified Modern Toolbar -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Grupo Izquierdo: Título y Filtros Rápidos por Severidad -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ExecutionConsoleTitle]}" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               FontSize="12.5" 
                               Margin="0,0,10,0" 
                               VerticalAlignment="Center" />

                    <!-- Filtros Rápidos por Nivel de Log -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="2" 
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogFilterAll]}" 
                                         GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All, Mode=TwoWay}"
                                         Style="{StaticResource FilterRadioButton}" 
                                         Padding="6,2" FontSize="10.5" Cursor="Hand" />
                            
                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ErrorsOnly, Mode=TwoWay}"
                                         Style="{StaticResource FilterRadioButton}" 
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔴 " />
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogFilterErrors]}" FontWeight="SemiBold" />
                                    <TextBlock Text=" (" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ErrorCount}" FontWeight="Bold" Foreground="{DynamicResource AccentErrorBrush}" />
                                    <TextBlock Text=")" FontWeight="SemiBold" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=WarningsOnly, Mode=TwoWay}"
                                         Style="{StaticResource FilterRadioButton}" 
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟠 " />
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogFilterWarnings]}" FontWeight="SemiBold" />
                                    <TextBlock Text=" (" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WarningCount}" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />
                                    <TextBlock Text=")" FontWeight="SemiBold" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=InfoOnly, Mode=TwoWay}"
                                         Style="{StaticResource FilterRadioButton}" 
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔵 " />
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogFilterInfo]}" FontWeight="SemiBold" />
                                    <TextBlock Text=" (" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InfoCount}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                    <TextBlock Text=")" FontWeight="SemiBold" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DebugOnly, Mode=TwoWay}"
                                         Style="{StaticResource FilterRadioButton}" 
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🟣 " />
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogFilterDebug]}" FontWeight="SemiBold" />
                                    <TextBlock Text=" (" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DebugCount}" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                    <TextBlock Text=")" FontWeight="SemiBold" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Grupo Central: Input de Búsqueda Instantánea con Botón Limpiar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0">
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="6,2" 
                            Width="260"
                            Height="24"
                            VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            
                            <!-- Placeholder -->
                            <TextBlock Grid.Column="1" 
                                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogSearchPlaceholder]}" 
                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                       FontSize="10.5" 
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- TextBox de Búsqueda -->
                            <TextBox Grid.Column="1" 
                                     x:Name="TxtSearch" 
                                     Text="{Binding SearchFilter, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" 
                                     BorderThickness="0" 
                                     FontSize="10.5" 
                                     VerticalAlignment="Center" 
                                     Padding="0" />

                            <!-- Botón Limpiar Filtro -->
                            <Button Grid.Column="2" 
                                    Content="✕" 
                                    Command="{Binding ClearSearchFilterCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Foreground="{DynamicResource TextSecondaryBrush}" 
                                    FontSize="10" 
                                    FontWeight="Bold" 
                                    Padding="2,0" 
                                    Cursor="Hand"
                                    ToolTip="Limpiar búsqueda"
                                    Visibility="{Binding SearchFilter, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding TotalLogsCount, StringFormat='• {0:N0} logs'}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="10.5" 
                               Margin="8,0,0,0" 
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding StatusMessage, StringFormat='• {0}'}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="10.5" 
                               Margin="8,0,0,0" 
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Grupo Derecho: Controles de Depuración (En Vivo, Exportar, Limpiar) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogLive]}" 
                                  IsChecked="{Binding IsLiveMode, Mode=TwoWay}" 
                                  Style="{StaticResource SecondaryToggleButton}" 
                                  Padding="8,3" 
                                  FontSize="10.5" 
                                  FontWeight="SemiBold" 
                                  Margin="0,0,6,0"
                                  Cursor="Hand" 
                                  ToolTip="Alternar desplazamiento en vivo automático" />

                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogExport]}" 
                            Command="{Binding ExportLogsCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="8,3" 
                            FontSize="10.5" 
                            Margin="0,0,6,0"
                            ToolTip="Exportar historial de ejecución a archivo .log" />

                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogClear]}" 
                            Command="{Binding ClearLogsCommand}" 
                            Style="{StaticResource SecondaryButton}" 
                            Padding="8,3" 
                            FontSize="10.5"
                            ToolTip="Vaciar todos los logs de la consola y memoria" />
                </StackPanel>
            </Grid>

            <!-- Slim Progress Bar -->
            <ProgressBar Grid.Row="1" 
                         Value="{Binding ProgressPercentage}" 
                         Minimum="0" 
                         Maximum="100" 
                         Height="3" 
                         Margin="0,0,0,4" 
                         Foreground="{DynamicResource AccentSuccessBrush}" 
                         Background="{DynamicResource BgCardBrush}" 
                         BorderThickness="0"
                         Visibility="{Binding ProgressPercentage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

            <!-- Virtualized DataGrid (Ultra-Fast 120 FPS Database Grid) -->
            <DataGrid x:Name="LogDataGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      CanUserSortColumns="False"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}"
                      Background="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderDarkBrush}"
                      BorderThickness="1"
                      FontFamily="Cascadia Code, Consolas, monospace"
                      FontSize="11"
                      RowHeight="24"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingStackPanel.IsVirtualizing="True"
                      VirtualizingStackPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.IsDeferredScrollingEnabled="False">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                        <Setter Property="Padding" Value="6,3" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="Cursor" Value="Hand" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgSubtleBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="5,0" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="VerticalContentAlignment" Value="Center" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <!-- Hora -->
                    <DataGridTemplateColumn Width="95">
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogColTime], StringFormat='{}{0} ⬍'}" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="Timestamp" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10.5" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nivel (Pill Badge con Fondo Translúcido) -->
                    <DataGridTemplateColumn Width="65">
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogColLevel], StringFormat='{}{0} ⬍'}" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="Level" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Level, Converter={StaticResource LogLevelToBadgeBackgroundConverter}}"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}" 
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBadgeForegroundConverter}}" 
                                               FontWeight="Bold" 
                                               FontSize="9.5" 
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nodo -->
                    <DataGridTemplateColumn Width="125">
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogColNode], StringFormat='{}{0} ⬍'}" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="NodeName" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NodeName}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="10.5" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ID Fichero (Badge clicable para trazabilidad de extremo a extremo) -->
                    <DataGridTemplateColumn Width="85">
                        <DataGridTemplateColumn.Header>
                            <Button Content="ID ⬍" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="ItemId" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.FilterByItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding ItemId}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Cursor="Hand"
                                        VerticalAlignment="Center"
                                        ToolTip="Filtrar trazabilidad de este archivo"
                                        Visibility="{Binding ItemId, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                    <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="3" Padding="4,1">
                                        <TextBlock Text="{Binding ShortItemId, StringFormat='#{0}'}" 
                                                   Foreground="{DynamicResource AccentCyanBrush}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="9.5" />
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fichero -->
                    <DataGridTemplateColumn Width="150">
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogColFile], StringFormat='{}{0} ⬍'}" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="FileName" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           VerticalAlignment="Center"
                                           FontSize="10.5">
                                    <TextBlock.ToolTip>
                                        <ToolTip Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding FilePath, StringFormat='📁 Ruta: {0}'}" FontWeight="SemiBold" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding FormattedFileSize, StringFormat='⚖️ Tamaño: {0}'}" Visibility="{Binding FileSizeBytes, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                <TextBlock Text="{Binding ItemId, StringFormat='🆔 ID: {0}'}" Foreground="{DynamicResource AccentCyanBrush}" />
                                            </StackPanel>
                                        </ToolTip>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Duración -->
                    <DataGridTemplateColumn Width="80">
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogColDuration], StringFormat='{}{0} ⬍'}" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="DurationMs" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DurationMs, StringFormat='{}{0:F1} ms'}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" FontSize="10.5" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mensaje -->
                    <DataGridTemplateColumn Width="*">
                        <DataGridTemplateColumn.Header>
                            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[LogColMessage], StringFormat='{}{0} ⬍'}" Command="{Binding DataContext.SortByCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="Message" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="10" Cursor="Hand" />
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Badge JSON si contiene detalles estructurados -->
                                    <Border Background="{DynamicResource AccentPurpleBrush}" 
                                            Opacity="0.85" 
                                            CornerRadius="3" 
                                            Padding="4,1" 
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="Contiene detalles JSON (clic para desplegar)">
                                        <TextBlock Text="{}{ } JSON" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="10.5" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>

                <!-- Panel de Detalles Expansible al Seleccionar Fila -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgSurfaceBrush}" 
                                BorderBrush="{DynamicResource BorderDarkBrush}" 
                                BorderThickness="0,1,0,1" 
                                Padding="12,8" 
                                Margin="0,2,0,4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header de Metadatos del Archivo e ID -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4">
                                            <TextBlock Text="{Binding ItemId, StringFormat='🆔 ID de Flujo: {0}'}" 
                                                       Foreground="{DynamicResource AccentCyanBrush}" 
                                                       FontWeight="Bold" 
                                                       FontSize="11" />
                                        </Border>

                                        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4"
                                                Visibility="{Binding FilePath, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                            <TextBlock Text="{Binding FilePath, StringFormat='📁 {0}'}" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" 
                                                       FontSize="11" />
                                        </Border>

                                        <Border Background="{DynamicResource BgCardBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,4"
                                                Visibility="{Binding FormattedFileSize, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                            <TextBlock Text="{Binding FormattedFileSize, StringFormat='⚖️ {0}'}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" 
                                                       FontSize="11" />
                                        </Border>
                                    </WrapPanel>

                                    <!-- Acciones Rápidas -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🔍 Trazabilidad" 
                                                Command="{Binding DataContext.FilterByItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding ItemId}"
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="8,2" FontSize="10.5" Margin="0,0,6,0"
                                                Visibility="{Binding ItemId, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />

                                        <Button Content="📋 Copiar JSON" 
                                                Command="{Binding DataContext.CopyDetailsJsonCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding DetailsJson}"
                                                Style="{StaticResource SecondaryButton}" 
                                                Padding="8,2" FontSize="10.5"
                                                Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Visor JSON / Detalles Técnicos -->
                                <Border Grid.Row="1" 
                                        Background="{DynamicResource BgCardBrush}" 
                                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="8,6" 
                                        MaxHeight="200"
                                        Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                        <TextBox Text="{Binding DetailsJson, Mode=OneWay}" 
                                                 IsReadOnly="True" 
                                                 Background="Transparent" 
                                                 Foreground="{DynamicResource TextPrimaryBrush}" 
                                                 BorderThickness="0" 
                                                 FontFamily="Cascadia Code, Consolas, monospace" 
                                                 FontSize="11" 
                                                 TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
