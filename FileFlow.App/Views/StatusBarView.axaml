<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="1200"
             Background="{DynamicResource AppBackgroundBrush}"
             x:Class="FileFlow.App.Views.StatusBarView">

    <Border BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="10,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Contexto del Lienzo: Nodos y Conexiones (Isla) -->
                <ColumnDefinition Width="Auto" />
                
                <!-- Mensaje de Estado del Motor (Isla) -->
                <ColumnDefinition Width="Auto" />

                <!-- Ruta de Salida Global (Espacio Expansible *) -->
                <ColumnDefinition Width="*" />

                <!-- Rendimiento y Modelos IA -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Isla: Nodos y Conexiones del Grafo -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BgCardBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="8,3" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nodos -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧩" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NodeCount}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_Nodes]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Separador interno -->
                    <Border Width="1" Height="10" Background="{DynamicResource BorderDarkBrush}" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Conexiones -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🔗" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionCount}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_Connections]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Isla: Estado del Motor -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource BgCardBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="8,3" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentCyanBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Isla: Ruta de Salida Global (Expansible) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0">
                <Button Command="{Binding OpenGlobalOutputFolderCommand}" 
                        Padding="8,2.5" 
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_OutputLabel]}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=": " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GlobalOutputDir}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="450" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Isla: Modelos IA y Métricas de Hardware -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                <!-- Modelos IA en Memoria y Botón Liberar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            IsVisible="{Binding HasLoadedAiModels}">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LoadedAiModelsText}" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ClearAllAiModelsCommand}"
                            Padding="7,2"
                            Cursor="Hand">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_ClearAiMemory]}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Métricas de Hardware (RAM, CPU, GPU) -->
                <Border Background="{DynamicResource BgCardBrush}" 
                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="8,3" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Consumo RAM -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🧠 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Hardware_RamLabel], FallbackValue='RAM: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RamText}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Width="1" Height="10" Background="{DynamicResource BorderDarkBrush}" Margin="8,0" VerticalAlignment="Center" />

                        <!-- Consumo CPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💻 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Hardware_CpuLabel], FallbackValue='CPU: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuText}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Width="1" Height="10" Background="{DynamicResource BorderDarkBrush}" Margin="8,0" VerticalAlignment="Center" />

                        <!-- Consumo GPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🎮 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Hardware_GpuLabel], FallbackValue='GPU: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuText}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
