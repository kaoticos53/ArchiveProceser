<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="using:FileFlow.App.ViewModels"
             xmlns:loc="using:FileFlow.Sdk.Localization"
             x:Class="FileFlow.App.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel"
             Background="{DynamicResource BgHeaderBrush}">

    <!-- Barra de estado: islas de telemetría. Estilo 100% declarativo (Styles/*.axaml). -->
    <Border Classes="chromeBottom">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">

            <!-- Isla: Nodos y Conexiones del Grafo -->
            <Border Grid.Column="0" Classes="statusPill" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nodos -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding [StatusBar_NodesToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                        <materialIcons:MaterialIcon Margin="0,0,4,0" VerticalAlignment="Center"  Kind="Puzzle" Width="14" Height="14" />
                        <TextBlock Text="{Binding NodeCount}" Classes="numeric caption" VerticalAlignment="Center" />
                        <TextBlock Text=" " Classes="caption" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [StatusBar_Nodes], Source={x:Static loc:LocalizationManager.Instance}}" Classes="micro secondary" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Separador interno -->
                    <Border Classes="dividerV" Margin="8,0" Height="10" />

                    <!-- Conexiones -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                ToolTip.Tip="{Binding [StatusBar_ConnectionsToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                        <materialIcons:MaterialIcon Margin="0,0,4,0" VerticalAlignment="Center"  Kind="Link" Width="14" Height="14" />
                        <TextBlock Text="{Binding ConnectionCount}" Classes="numeric caption" VerticalAlignment="Center" />
                        <TextBlock Text=" " Classes="caption" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [StatusBar_Connections], Source={x:Static loc:LocalizationManager.Instance}}" Classes="micro secondary" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Isla: Estado del Motor -->
            <Border Grid.Column="1" Classes="statusPill" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource Space3}">
                    <Border Classes="led onInfo" />
                    <TextBlock Text="{Binding StatusMessage}" Classes="caption strong" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Isla: Ruta de Salida Global (Expansible) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0">
                <Button Command="{Binding OpenGlobalOutputFolderCommand}"
                        Classes="toolbar"
                        ToolTip.Tip="{Binding [StatusBar_OutputFolderToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <materialIcons:MaterialIcon VerticalAlignment="Center"  Kind="Folder" Width="14" Height="14" />
                        <TextBlock Text="{Binding [StatusBar_OutputLabel], Source={x:Static loc:LocalizationManager.Instance}}" Classes="micro secondary" VerticalAlignment="Center" />
                        <TextBlock Text=": " Classes="micro secondary" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GlobalOutputDir}" Classes="caption semiBold" MaxWidth="450" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Isla: Modelos IA y Métricas de Hardware -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="{DynamicResource Space4}">

                <!-- Modelos IA en Memoria y Botón Liberar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource Space3}"
                            IsVisible="{Binding HasLoadedAiModels}">
                    <Border Classes="statusPill" BorderBrush="{DynamicResource AccentSuccessBrush}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                            <Border Classes="led onSuccess" />
                            <TextBlock Text="{Binding LoadedAiModelsText}" Classes="micro strong accentSuccess" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ClearAllAiModelsCommand}"
                            Classes="toolbar"
                            ToolTip.Tip="{Binding LoadedAiModelsToolTip}">
                        <TextBlock Text="{Binding [StatusBar_ClearAiMemory], Source={x:Static loc:LocalizationManager.Instance}}" Classes="micro semiBold accentCyan" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Métricas de Hardware (RAM, CPU, GPU) agrupadas en píldora -->
                <Border Classes="statusPill">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Consumo RAM -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding [StatusBar_RamToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <materialIcons:MaterialIcon VerticalAlignment="Center"  Kind="Brain" Width="14" Height="14" />
                            <TextBlock Text="{Binding [Hardware_RamLabel], Source={x:Static loc:LocalizationManager.Instance}, FallbackValue='RAM: '}" Classes="micro secondary" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RamText}" Classes="numeric caption accentPurple" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Classes="dividerV" Height="10" />

                        <!-- Consumo CPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding [StatusBar_CpuToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <materialIcons:MaterialIcon VerticalAlignment="Center"  Kind="Laptop" Width="14" Height="14" />
                            <TextBlock Text="{Binding [Hardware_CpuLabel], Source={x:Static loc:LocalizationManager.Instance}, FallbackValue='CPU: '}" Classes="micro secondary" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuText}" Classes="numeric caption accentCyan" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Classes="dividerV" Height="10" />

                        <!-- Consumo GPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding [StatusBar_GpuToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <materialIcons:MaterialIcon VerticalAlignment="Center"  Kind="ExpansionCard" Width="14" Height="14" />
                            <TextBlock Text="{Binding [Hardware_GpuLabel], Source={x:Static loc:LocalizationManager.Instance}, FallbackValue='GPU: '}" Classes="micro secondary" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuText}" Classes="numeric caption accent" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
