<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:FileFlow.App.ViewModels"
             xmlns:loc="using:FileFlow.Sdk.Localization"
             x:Class="FileFlow.App.Views.StatusBarView"
             x:DataType="vm:StatusBarViewModel"
             Background="{DynamicResource BgHeaderBrush}">

    <Border BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="10,4">
        <Grid ColumnDefinitions="Auto,Auto,*,Auto">

            <!-- Isla: Nodos y Conexiones del Grafo -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BgSurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="8,3" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nodos -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{Binding [StatusBar_NodesToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                        <TextBlock Text="🧩" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NodeCount}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [StatusBar_Nodes], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Separador interno -->
                    <Border Width="1" Height="10" Background="{DynamicResource BorderDarkBrush}" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Conexiones -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{Binding [StatusBar_ConnectionsToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                        <TextBlock Text="🔗" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionCount}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=" " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [StatusBar_Connections], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Isla: Estado del Motor -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource BgSurfaceBrush}" 
                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="8,3" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Isla: Ruta de Salida Global (Expansible) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0">
                <Button Command="{Binding OpenGlobalOutputFolderCommand}" 
                        Padding="8,2.5" 
                        Cursor="Hand"
                        ToolTip.Tip="{Binding [StatusBar_OutputFolderToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [StatusBar_OutputLabel], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text=": " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GlobalOutputDir}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" MaxWidth="450" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Isla: Modelos IA y Métricas de Hardware -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="8">

                <!-- Modelos IA en Memoria y Botón Liberar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding HasLoadedAiModels}">
                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentSuccessBrush}" BorderThickness="1" CornerRadius="5" Padding="6,2.5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                            <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LoadedAiModelsText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ClearAllAiModelsCommand}"
                            Padding="7,2"
                            Cursor="Hand"
                            ToolTip.Tip="{Binding LoadedAiModelsToolTip}">
                        <TextBlock Text="{Binding [StatusBar_ClearAiMemory], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Métricas de Hardware (RAM, CPU, GPU) agrupadas en píldora -->
                <Border Background="{DynamicResource BgSurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="8,3" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Consumo RAM -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{Binding [StatusBar_RamToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <TextBlock Text="🧠 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [Hardware_RamLabel], Source={x:Static loc:LocalizationManager.Instance}, FallbackValue='RAM: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RamText}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Width="1" Height="10" Background="{DynamicResource BorderDarkBrush}" Margin="8,0" VerticalAlignment="Center" />

                        <!-- Consumo CPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{Binding [StatusBar_CpuToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <TextBlock Text="💻 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [Hardware_CpuLabel], Source={x:Static loc:LocalizationManager.Instance}, FallbackValue='CPU: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuText}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Width="1" Height="10" Background="{DynamicResource BorderDarkBrush}" Margin="8,0" VerticalAlignment="Center" />

                        <!-- Consumo GPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip.Tip="{Binding [StatusBar_GpuToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <TextBlock Text="🎮 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding [Hardware_GpuLabel], Source={x:Static loc:LocalizationManager.Instance}, FallbackValue='GPU: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuText}" FontFamily="JetBrains Mono, Cascadia Code, Consolas" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
