<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileFlow.Sdk.Localization"
             xmlns:vm="using:FileFlow.App.ViewModels"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FileFlow.App.Views.ControlBarView"
             x:DataType="vm:ControlBarViewModel">

    <!-- Barra de control: 3 islas semánticas (Modos · Ciclo de vida · Herramientas).
         Estilo 100% declarativo mediante la capa de componentes (Styles/*.axaml). -->
    <Border Classes="chromeTop">
        <Grid ColumnDefinitions="Auto,*,Auto">

            <!-- App Brand & Hamburger Side Drawer Toggle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleMenuCommand}"
                        Classes="toolbar"
                        Margin="0,0,10,0"
                        ToolTip.Tip="{Binding [ControlBar_MenuToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space3}">
                        <materialIcons:MaterialIcon Kind="Menu" Width="13" Height="13" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding [MenuBtn], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Classes="brand" Margin="0,0,8,0">
                    <materialIcons:MaterialIcon Kind="Flash" Width="15" Height="15"
                                                Foreground="{DynamicResource TextOnAccentBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="FileFlow Studio" Classes="subtitle" VerticalAlignment="Center" />

                <!-- Update Available Badge Button -->
                <Button Command="{Binding OpenUpdateDialogCommand}"
                        IsVisible="{Binding HasPendingUpdate}"
                        Classes="toolbar"
                        Margin="12,0,0,0"
                        BorderBrush="{DynamicResource AccentSuccessBrush}"
                        BorderThickness="1"
                        Padding="8,3"
                        CornerRadius="{DynamicResource RadiusSm}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <materialIcons:MaterialIcon Kind="RocketLaunch" Width="13" Height="13" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding PendingUpdateVersionTag}" Classes="caption semiBold" Foreground="{DynamicResource AccentSuccessBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Workflow Execution Controls (Divided into 3 Semantic Islands) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="{DynamicResource Space4}">

                <!-- Island 1: Modes & Workspace Tools -->
                <Border Classes="island">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                        <!-- Dry Run Toggle Button -->
                        <ToggleButton Classes="chip"
                                      IsChecked="{Binding IsDryRun}"
                                      ToolTip.Tip="{Binding [ControlBar_DryRunToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <Border Classes="led" Classes.on="{Binding IsDryRun}" />
                                <TextBlock Text="{Binding [DryRun], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption strong" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>

                        <!-- Watch Mode Button -->
                        <Button Command="{Binding ToggleWatchModeCommand}"
                                Classes="toolbar"
                                ToolTip.Tip="{Binding [ControlBar_WatchModeToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="Eye" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [ControlBar_Watcher], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption semiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- VFS Explorer Button (Visible when VFS results exist) -->
                        <Button Command="{Binding OpenVirtualFileSystemExplorerCommand}"
                                Classes="toolbar"
                                IsVisible="{Binding HasVirtualFiles}"
                                ToolTip.Tip="{Binding [ControlBar_VfsToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="FolderOpen" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding VirtualFilesCount, StringFormat='VFS ({0})'}" Classes="caption strong accentCyan" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Island 2: Workflow Lifecycle & Debugging Actions -->
                <Border Classes="island">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                        <!-- Run Normal -->
                        <Button Command="{Binding ExecuteWorkflowCommand}"
                                Classes="success"
                                IsVisible="{Binding !IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon Kind="Play" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [RunFlow], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Start Debugging -->
                        <Button Command="{Binding DebugWorkflowCommand}"
                                Classes="debug"
                                IsVisible="{Binding !IsRunning}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <materialIcons:MaterialIcon Kind="Bug" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [DebugFlow], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Debug Stepping Controls (visible during debugging) -->
                        <Button Command="{Binding StepNextCommand}"
                                Classes="warning"
                                IsVisible="{Binding IsDebugging}"
                                ToolTip.Tip="{Binding [ControlBar_StepNextToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="DebugStepOver" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [StepNext], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ContinueWorkflowCommand}"
                                Classes="success"
                                IsVisible="{Binding IsDebugging}"
                                ToolTip.Tip="{Binding [ControlBar_ContinueToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="FastForward" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [ContinueFlow], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Pause / Resume Button -->
                        <Button Command="{Binding TogglePauseCommand}"
                                Classes="toolbar"
                                IsVisible="{Binding IsRunning}"
                                ToolTip.Tip="{Binding [ControlBar_PauseToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="Pause" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Pause], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Stop Execution / Debugging -->
                        <Button Command="{Binding StopWorkflowCommand}"
                                Classes="danger"
                                IsVisible="{Binding IsRunning}"
                                ToolTip.Tip="{Binding [ControlBar_StopToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="Stop" Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [Stop], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Island 3: Tools & Views -->
                <Border Classes="island">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                        <!-- Undo Button -->
                        <Button Command="{Binding UndoCommand}"
                                Classes="toolbar"
                                IsEnabled="{Binding CanUndo}"
                                ToolTip.Tip="{Binding [UndoToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="Undo" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [UndoBtn], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption semiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Redo Button -->
                        <Button Command="{Binding RedoCommand}"
                                Classes="toolbar"
                                IsEnabled="{Binding CanRedo}"
                                ToolTip.Tip="{Binding [RedoToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="Redo" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [RedoBtn], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption semiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Rollback Last Execution Button -->
                        <Button Command="{Binding RollbackLastExecutionCommand}"
                                Classes="toolbar"
                                ToolTip.Tip="{Binding [RollbackExecutionToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="History" Width="14" Height="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [RollbackExecutionBtn], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption semiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Toggle Inspector Panel Button -->
                        <Button Command="{Binding ToggleInspectorCommand}"
                                Classes="toolbar"
                                ToolTip.Tip="{Binding [ControlBar_InspectorToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space2}">
                                <materialIcons:MaterialIcon Kind="Magnify" Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding [InspectorBtn], Source={x:Static loc:LocalizationManager.Instance}}" Classes="caption semiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
