<UserControl x:Class="FileFlow.App.Views.StatusBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="32" d:DesignWidth="1200"
             Background="#0C101B">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="10,4">
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Contexto del Lienzo: Nodos y Conexiones (Isla) -->
                <ColumnDefinition Width="Auto" />
                
                <!-- Mensaje de Estado del Motor (Isla) -->
                <ColumnDefinition Width="Auto" />

                <!-- Ruta de Salida Global (Espacio Expansible *) -->
                <ColumnDefinition Width="*" />

                <!-- Rendimiento y Modelos IA -->
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Isla: Nodos y Conexiones del Grafo -->
            <Border Grid.Column="0" 
                    Background="#111827" 
                    BorderBrush="#1F2937" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="8,3" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Nodos -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_NodesToolTip]}">
                        <TextBlock Text="🧩" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NodeCount}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <TextBlock Text=" " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_Nodes]}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Separador interno -->
                    <Border Width="1" Height="10" Background="#374151" Margin="8,0" VerticalAlignment="Center" />

                    <!-- Conexiones -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_ConnectionsToolTip]}">
                        <TextBlock Text="🔗" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ConnectionCount}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center" />
                        <TextBlock Text=" " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_Connections]}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Isla: Estado del Motor -->
            <Border Grid.Column="1" 
                    Background="#111827" 
                    BorderBrush="#1F2937" 
                    BorderThickness="1" 
                    CornerRadius="5" 
                    Padding="8,3" 
                    Margin="0,0,10,0" 
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="#38BDF8" Margin="0,0,6,0" VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#38BDF8" BlurRadius="5" ShadowDepth="0" Opacity="0.8" />
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="11" FontWeight="SemiBold" Foreground="#E2E8F0" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Isla: Ruta de Salida Global (Expansible) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,10,0">
                <Button Command="{Binding OpenGlobalOutputFolderCommand}" 
                        Style="{DynamicResource SecondaryButton}" 
                        Padding="8,2.5" 
                        Cursor="Hand"
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_OutputFolderToolTip]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁 " FontSize="11" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_OutputLabel]}" FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock Text=": " FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding GlobalOutputDir}" FontSize="10.5" FontWeight="SemiBold" Foreground="#F1F5F9" MaxWidth="450" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Isla: Modelos IA y Métricas de Hardware -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">

                <!-- Modelos IA en Memoria y Botón Liberar -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            Visibility="{Binding HasLoadedAiModels, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Border Background="#064E3B" BorderBrush="#059669" BorderThickness="1" CornerRadius="5" Padding="6,2.5" Margin="0,0,6,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="6" Height="6" CornerRadius="3" Background="#10B981" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect Color="#10B981" BlurRadius="6" ShadowDepth="0" Opacity="0.95" />
                                </Border.Effect>
                            </Border>
                            <TextBlock Text="{Binding LoadedAiModelsText}" FontSize="10.5" FontWeight="Bold" Foreground="#34D399" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding ClearAllAiModelsCommand}"
                            Style="{DynamicResource SecondaryButton}"
                            Padding="7,2"
                            Cursor="Hand"
                            ToolTip="{Binding LoadedAiModelsToolTip}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_ClearAiMemory]}" FontSize="10" FontWeight="SemiBold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <!-- Métricas de Hardware (RAM, CPU, GPU) agrupadas en píldora -->
                <Border Background="#111827" 
                        BorderBrush="#1F2937" 
                        BorderThickness="1" 
                        CornerRadius="5" 
                        Padding="8,3" 
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Consumo RAM -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_RamToolTip]}">
                            <TextBlock Text="🧠 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="RAM: " FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding RamText}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#A5B4FC" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Width="1" Height="10" Background="#374151" Margin="8,0" VerticalAlignment="Center" />

                        <!-- Consumo CPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_CpuToolTip]}">
                            <TextBlock Text="💻 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="CPU: " FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CpuText}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#67E8F9" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Separador -->
                        <Border Width="1" Height="10" Background="#374151" Margin="8,0" VerticalAlignment="Center" />

                        <!-- Consumo GPU -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StatusBar_GpuToolTip]}">
                            <TextBlock Text="🎮 " FontSize="11" VerticalAlignment="Center" />
                            <TextBlock Text="GPU: " FontSize="10.5" Foreground="#94A3B8" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding GpuText}" FontFamily="Consolas, Segoe UI" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
