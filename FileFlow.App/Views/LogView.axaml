<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:FileFlow.Sdk.Localization"
             xmlns:converters="using:FileFlow.App.Converters"
             xmlns:vm="using:FileFlow.App.ViewModels"
             xmlns:telemetry="using:FileFlow.Sdk.Telemetry"
             x:Class="FileFlow.App.Views.LogView"
             x:DataType="vm:LogViewModel">

    <Border Background="{DynamicResource BgSurfaceBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,1,0,0" 
            Padding="10,6,10,8">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Unified Modern Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">

                <!-- Grupo Izquierdo: Título y Filtros Rápidos por Severidad -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                    <TextBlock Text="{Binding [ExecutionConsoleTitle], Source={x:Static loc:LocalizationManager.Instance}}" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextPrimaryBrush}" 
                               FontSize="12.5" 
                               VerticalAlignment="Center" />

                    <!-- Filtros Rápidos por Nivel de Log -->
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="2">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton Content="{Binding [LogFilterAll], Source={x:Static loc:LocalizationManager.Instance}}" 
                                         GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All, Mode=TwoWay}"
                                         Padding="6,2" FontSize="10.5" Cursor="Hand" />
                            
                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=ErrorsOnly, Mode=TwoWay}"
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="🔴" />
                                    <TextBlock Text="{Binding [LogFilterErrors], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ErrorCount, StringFormat=' ({0})'}" FontWeight="Bold" Foreground="{DynamicResource AccentErrorBrush}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=WarningsOnly, Mode=TwoWay}"
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="🟠" />
                                    <TextBlock Text="{Binding [LogFilterWarnings], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding WarningCount, StringFormat=' ({0})'}" FontWeight="Bold" Foreground="{DynamicResource AccentWarningBrush}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=InfoOnly, Mode=TwoWay}"
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="🔵" />
                                    <TextBlock Text="{Binding [LogFilterInfo], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InfoCount, StringFormat=' ({0})'}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton GroupName="LogFilterGroup"
                                         IsChecked="{Binding ActiveFilter, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=DebugOnly, Mode=TwoWay}"
                                         Padding="6,2" FontSize="10.5" Cursor="Hand">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="🟣" />
                                    <TextBlock Text="{Binding [LogFilterDebug], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding DebugCount, StringFormat=' ({0})'}" FontWeight="Bold" Foreground="{DynamicResource AccentPurpleBrush}" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Grupo Central: Input de Búsqueda Instantánea con Botón Limpiar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0" Spacing="6">
                    <Border Background="{DynamicResource BgCardBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                            BorderThickness="1" 
                            CornerRadius="4" 
                            Padding="6,2" 
                            Width="260"
                            Height="26"
                            VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            
                            <TextBox Grid.Column="1" 
                                     PlaceholderText="{Binding [LogSearchPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}"
                                     Text="{Binding SearchFilter}" 
                                     Background="Transparent" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" 
                                     BorderThickness="0" 
                                     FontSize="10.5" 
                                     VerticalAlignment="Center" 
                                     Padding="0" />

                            <Button Grid.Column="2" 
                                    Content="✕" 
                                    Command="{Binding ClearSearchFilterCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Foreground="{DynamicResource TextSecondaryBrush}" 
                                    FontSize="10" 
                                    FontWeight="Bold" 
                                    Padding="2,0" 
                                    Cursor="Hand" 
                                    ToolTip.Tip="{Binding [Log_ClearSearchToolTip], Source={x:Static loc:LocalizationManager.Instance}}" 
                                    IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </Grid>
                    </Border>

                    <TextBlock Text="{Binding TotalLogsCount, StringFormat='• {0:N0} logs'}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="10.5" 
                               VerticalAlignment="Center" />

                    <TextBlock Text="{Binding StatusMessage, StringFormat='• {0}'}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" 
                               FontSize="10.5" 
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Grupo Derecho: Controles de Depuración (En Vivo, Exportar, Limpiar) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="6">
                    <ToggleButton Content="{Binding [LogLive], Source={x:Static loc:LocalizationManager.Instance}}" 
                                  IsChecked="{Binding IsLiveMode, Mode=TwoWay}" 
                                  Padding="8,3" 
                                  FontSize="10.5" 
                                  FontWeight="SemiBold" 
                                  Cursor="Hand" 
                                  ToolTip.Tip="{Binding [Log_ToggleLiveToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />

                    <Button Content="{Binding [LogExport], Source={x:Static loc:LocalizationManager.Instance}}" 
                            Command="{Binding ExportLogsCommand}" 
                            Padding="8,3" 
                            FontSize="10.5" 
                            ToolTip.Tip="{Binding [Log_ExportToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />

                    <Button Content="{Binding [LogClear], Source={x:Static loc:LocalizationManager.Instance}}" 
                            Command="{Binding ClearLogsCommand}" 
                            Padding="8,3" 
                            FontSize="10.5"
                            ToolTip.Tip="{Binding [Log_ClearToolTip], Source={x:Static loc:LocalizationManager.Instance}}" />
                </StackPanel>
            </Grid>

            <!-- Slim Progress Bar -->
            <ProgressBar Grid.Row="1" 
                         Value="{Binding ProgressPercentage}" 
                         Minimum="0" 
                         Maximum="100" 
                         Height="3" 
                         Margin="0,0,0,4" 
                         Foreground="{DynamicResource AccentSuccessBrush}" 
                         Background="{DynamicResource BgCardBrush}" 
                         BorderThickness="0"
                         IsVisible="{Binding ProgressPercentage, Converter={StaticResource InverseNullToVisibilityConverter}}" />

            <!-- Virtualized DataGrid -->
            <DataGrid x:Name="LogDataGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding Logs}"
                      SelectedItem="{Binding SelectedLog, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserResizeColumns="True"
                      GridLinesVisibility="Horizontal"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource BgCardBrush}"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      BorderBrush="{DynamicResource BorderDarkBrush}"
                      BorderThickness="1"
                      FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                      FontSize="11"
                      RowHeight="26">

                <DataGrid.Columns>
                    <!-- Hora -->
                    <DataGridTemplateColumn Width="90" Header="{Binding [LogColTime], Source={x:Static loc:LocalizationManager.Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="10" Padding="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nivel -->
                    <DataGridTemplateColumn Width="65" Header="{Binding [LogColLevel], Source={x:Static loc:LocalizationManager.Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <Border Background="{Binding Level, Converter={StaticResource LogLevelToBadgeBackgroundConverter}}"
                                        CornerRadius="3"
                                        Padding="4,1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}" 
                                               Foreground="{Binding Level, Converter={StaticResource LogLevelToBadgeForegroundConverter}}" 
                                               FontWeight="Bold" 
                                               FontSize="9" 
                                               VerticalAlignment="Center" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nodo -->
                    <DataGridTemplateColumn Width="120" Header="{Binding [LogColNode], Source={x:Static loc:LocalizationManager.Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <TextBlock Text="{Binding NodeName}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="10" Padding="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- ID Fichero -->
                    <DataGridTemplateColumn Width="75" Header="ID">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ShortItemId, StringFormat='#{0}'}" 
                                               Foreground="{DynamicResource AccentCyanBrush}" 
                                               FontWeight="SemiBold" 
                                               FontSize="9" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Fichero -->
                    <DataGridTemplateColumn Width="140" Header="{Binding [LogColFile], Source={x:Static loc:LocalizationManager.Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <TextBlock Text="{Binding FileName}" 
                                           Foreground="{DynamicResource TextSecondaryBrush}" 
                                           TextTrimming="CharacterEllipsis" 
                                           VerticalAlignment="Center"
                                           FontSize="10"
                                           Padding="4,0" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Duración -->
                    <DataGridTemplateColumn Width="75" Header="{Binding [LogColDuration], Source={x:Static loc:LocalizationManager.Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <TextBlock Text="{Binding DurationMs, StringFormat='{}{0:F1}ms'}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Mensaje -->
                    <DataGridTemplateColumn Width="*" Header="{Binding [LogColMessage], Source={x:Static loc:LocalizationManager.Instance}}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type telemetry:StructuredLogRecord}">
                                <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center" Margin="4,0">
                                    <Border Grid.Column="0" 
                                            Background="{DynamicResource AccentPurpleBrush}" 
                                            Opacity="0.85" 
                                            CornerRadius="3" 
                                            Padding="4,1" 
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding HasDetails}">
                                        <TextBlock Text="{}{ } JSON" Foreground="White" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding Message}" 
                                               Foreground="{DynamicResource TextPrimaryBrush}" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center" 
                                               FontSize="10.5" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Border>
</UserControl>
