<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels;assembly=FileFlow.App"
             xmlns:models="using:FileFlow.App.Models"
             xmlns:loc="using:FileFlow.Sdk.Localization"
             x:Class="FileFlow.App.Views.NodeToolboxView"
             x:DataType="vm:ToolboxViewModel">

    <Border Background="{DynamicResource BgCardBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,0,1,0" 
            Padding="12,10">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <!-- Header Title & View Mode Toggle -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
                <TextBlock Grid.Column="0" 
                           Text="{Binding [NodeToolboxTitle], Source={x:Static loc:LocalizationManager.Instance}}" 
                           FontSize="{DynamicResource FontSizeBody}" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           VerticalAlignment="Center" />

                <!-- Toggle Perspective (Domain vs Pipeline Stage) -->
                <Button Grid.Column="1"
                        Command="{Binding TogglePerspectiveCommand}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusXs}"
                        Padding="6,3"
                        Margin="0,0,6,0"
                        Cursor="Hand"
                        ToolTip.Tip="{Binding [TogglePerspectiveToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <TextBlock Text="{Binding PerspectiveButtonText}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyanBrush}" />
                </Button>

                <!-- Toggle Compact / Detailed View Mode -->
                <Button Grid.Column="2" 
                        Command="{Binding ToggleViewModeCommand}"
                        Background="Transparent" 
                        BorderBrush="{DynamicResource BorderDarkBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusXs}"
                        Padding="6,3"
                        Cursor="Hand"
                        ToolTip.Tip="{Binding [Toolbox_ToggleCompactToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                    <materialIcons:MaterialIcon Foreground="{DynamicResource TextSecondaryBrush}"  Kind="Menu" Width="11" Height="11" />
                </Button>
            </Grid>

            <!-- Search Bar with Search Icon -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}" 
                         PlaceholderText="{Binding [SearchNodesPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}"
                         Padding="8,5" 
                         FontSize="{DynamicResource FontSizeCaption}"
                         Background="{DynamicResource BgSurfaceBrush}"
                         BorderBrush="{DynamicResource BorderDarkBrush}"
                         CornerRadius="{DynamicResource RadiusXs}">
                    <TextBox.InnerLeftContent>
                        <materialIcons:MaterialIcon Margin="8,0,2,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"  Kind="Magnify" Width="11" Height="11" />
                    </TextBox.InnerLeftContent>
                </TextBox>
            </Grid>

            <!-- Category Filter Selector -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding AvailableCategories}"
                          SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                          Background="{DynamicResource BgSurfaceBrush}"
                          BorderBrush="{DynamicResource BorderDarkBrush}"
                          CornerRadius="{DynamicResource RadiusXs}"
                          Padding="8,4"
                          FontSize="{DynamicResource FontSizeCaption}"
                          HorizontalAlignment="Stretch"
                          Cursor="Hand">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolboxCategoryFilterItem">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="2,1">
                                <materialIcons:MaterialIcon Grid.Column="0" Kind="{Binding Icon}" Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="{DynamicResource ChipStrongBrush}" CornerRadius="{DynamicResource RadiusMd}" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Categorized Nodes List -->
            <ScrollViewer Grid.Row="3" Margin="0,0,4,0">
                <ItemsControl ItemsSource="{Binding CategoryGroups}" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ToolboxCategoryGroup">
                            <Expander Classes="menuAccordion" 
                                      IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <Expander.Header>
                                    <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                        <materialIcons:MaterialIcon Grid.Column="0" 
                                                                    Kind="{Binding Icon}" 
                                                                    Width="13" 
                                                                    Height="13" 
                                                                    Margin="0,0,5,0" 
                                                                    Foreground="{DynamicResource AccentCyanBrush}" 
                                                                    VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" 
                                                   Text="{Binding CategoryName}" 
                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                   FontWeight="SemiBold" 
                                                   FontSize="{DynamicResource FontSizeCaption}" 
                                                   TextTrimming="CharacterEllipsis" 
                                                   VerticalAlignment="Center" />
                                        <Border Grid.Column="2" 
                                                Background="{DynamicResource ChipBrush}" 
                                                CornerRadius="{DynamicResource RadiusPill}" 
                                                Padding="4,0.5" 
                                                Margin="4,0,4,0" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Items.Count}" 
                                                       FontSize="{DynamicResource FontSizeMicro}" 
                                                       FontWeight="Bold" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:NodeToolboxItem">
                                            <Border Classes="nodeMenuItem"
                                                    PointerPressed="NodeItem_PointerPressed"
                                                    PointerReleased="NodeItem_PointerReleased"
                                                    PointerMoved="NodeItem_PointerMoved">

                                                <!-- ToolTip Rico con Descripción -->
                                                <ToolTip.Tip>
                                                    <Border Background="{DynamicResource BgCardBrush}" 
                                                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                            BorderThickness="1.5" CornerRadius="{DynamicResource RadiusMd}" Padding="12,10" Width="260">
                                                        <StackPanel Spacing="4">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                 <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="14" Height="14" VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBodySm}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </StackPanel>
                                                            <Border Background="{DynamicResource ChipBrush}" CornerRadius="{DynamicResource RadiusXs}" Padding="5,1.5" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding RoleBadge}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                            </Border>
                                                            <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,2" />
                                                            <TextBlock Text="{Binding Description}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Border>
                                                </ToolTip.Tip>

                                                <StackPanel>
                                                    <!-- Fila de Icono, Título del Nodo y Botón Favorito -->
                                                    <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="18" VerticalAlignment="Center">
                                                        <materialIcons:MaterialIcon Grid.Column="0" 
                                                                                   Kind="{Binding Icon}" 
                                                                                   Width="13" 
                                                                                   Height="13" 
                                                                                   Margin="0,0,6,0" 
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" 
                                                                   Text="{Binding Name}" 
                                                                   FontWeight="Normal" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                   FontSize="{DynamicResource FontSizeCaption}" 
                                                                   TextTrimming="CharacterEllipsis" 
                                                                   VerticalAlignment="Center" />

                                                        <!-- Star Button for Favorites -->
                                                        <Button Grid.Column="2"
                                                                Command="{Binding $parent[UserControl].((vm:ToolboxViewModel)DataContext).ToggleFavoriteCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Width="18"
                                                                Height="18"
                                                                Margin="2,0,4,0"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="{Binding [Toolbox_FavoriteToolTip], Source={x:Static loc:LocalizationManager.Instance}}">
                                                            <materialIcons:MaterialIcon Kind="{Binding FavoriteIcon}"
                                                                       Width="11" Height="11"
                                                                       Foreground="{DynamicResource AccentWarningBrush}"
                                                                       VerticalAlignment="Center"
                                                                       HorizontalAlignment="Center" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- Role Badge + Description (visible en modo detallado) -->
                                                    <StackPanel IsVisible="{Binding !$parent[UserControl].((vm:ToolboxViewModel)DataContext).IsCompactMode}" Margin="19,2,0,2">
                                                        <Border Background="{DynamicResource ChipBrush}" CornerRadius="{DynamicResource RadiusXs}" Padding="4,1" Margin="0,2,0,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding RoleBadge}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                   FontSize="{DynamicResource FontSizeMicro}" 
                                                                   TextWrapping="Wrap" 
                                                                   Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
