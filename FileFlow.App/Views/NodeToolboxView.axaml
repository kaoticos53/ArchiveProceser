<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="280"
             x:Class="FileFlow.App.Views.NodeToolboxView">

    <Border Background="{DynamicResource BgCardBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,0,1,0" 
            Padding="12,10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header Title & View Mode Toggle -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[NodeToolboxTitle]}" 
                           FontSize="13.5" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextPrimaryBrush}" 
                           VerticalAlignment="Center" />

                <!-- Toggle Perspective (Domain vs Pipeline Stage) -->
                <Button Grid.Column="1"
                        Command="{Binding TogglePerspectiveCommand}"
                        Padding="6,2" FontSize="10"
                        Margin="0,0,4,0"
                        Cursor="Hand">
                    <TextBlock Text="{Binding PerspectiveButtonText}" FontSize="10" VerticalAlignment="Center" />
                </Button>

                <!-- Toggle Compact / Detailed View Mode -->
                <ToggleButton Grid.Column="2"
                              IsChecked="{Binding IsCompactMode, Mode=TwoWay}"
                              Padding="6,2" FontSize="10.5"
                              Cursor="Hand">
                    <ToggleButton.Content>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☰ " FontSize="10" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Toolbox_CompactBtn]}" FontSize="10.5" VerticalAlignment="Center" />
                        </StackPanel>
                    </ToggleButton.Content>
                </ToggleButton>
            </Grid>

            <!-- Search Input with Fluent Icon -->
            <Grid Grid.Row="1" Margin="0,0,0,8">
                <TextBox Text="{Binding SearchText, Mode=TwoWay}" 
                         Background="{DynamicResource BgSurfaceBrush}" 
                         Foreground="{DynamicResource TextPrimaryBrush}" 
                         BorderBrush="{DynamicResource BorderDarkBrush}" 
                         Padding="26,5,8,5" 
                         FontSize="11.5" />
                <TextBlock Text="🔍" 
                           FontSize="11" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Center" 
                           Margin="8,0,0,0" 
                           IsHitTestVisible="False" />
            </Grid>

            <!-- Modern Category Dropdown Selector (Compact 1-Row) -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <ComboBox ItemsSource="{Binding AvailableCategories}"
                          SelectedItem="{Binding SelectedCategoryItem, Mode=TwoWay}"
                          Background="{DynamicResource BgSurfaceBrush}"
                          Foreground="{DynamicResource TextPrimaryBrush}"
                          BorderBrush="{DynamicResource BorderDarkBrush}"
                          Padding="8,5"
                          FontSize="11.5"
                          HorizontalAlignment="Stretch"
                          Cursor="Hand">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ToolboxCategoryFilterItem}">
                            <Grid Margin="2,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Background="#20808080" CornerRadius="8" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Count}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <!-- Categorized Nodes List -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CategoryGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Margin="0,0,0,8" HorizontalAlignment="Stretch">
                                <Expander.Header>
                                    <TextBlock Text="{Binding CategoryName}" 
                                               Foreground="{DynamicResource AccentGlowBrush}" 
                                               FontWeight="Bold" 
                                               FontSize="12" 
                                               VerticalAlignment="Center" />
                                </Expander.Header>
                                <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceBrush}" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="8,5" 
                                                    Margin="0,2" 
                                                    Cursor="Hand"
                                                    PointerPressed="NodeItem_PointerPressed">

                                                <StackPanel>
                                                    <!-- Fila de Icono, Título del Nodo y Botón Favorito -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" 
                                                                   FontWeight="SemiBold" 
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                   FontSize="11.5" 
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Star Button for Favorites -->
                                                        <Button Grid.Column="2"
                                                                Command="{Binding $parent[UserControl].((vm:ToolboxViewModel)DataContext).ToggleFavoriteCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4,0"
                                                                Margin="4,0,0,0"
                                                                Cursor="Hand">
                                                            <TextBlock Text="{Binding IsFavorite, Converter={x:Static StringConverters.IsNullOrEmpty}}" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" />
                                                        </Button>
                                                    </Grid>

                                                    <!-- Role Badge + Description -->
                                                    <StackPanel IsVisible="{Binding !$parent[UserControl].((vm:ToolboxViewModel)DataContext).IsCompactMode}">
                                                        <Border Background="#14808080" CornerRadius="4" Padding="4,1" Margin="0,4,0,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding RoleBadge}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Border>
                                                        <TextBlock Text="{Binding Description}" 
                                                                   Foreground="{DynamicResource TextSecondaryBrush}" 
                                                                   FontSize="10.5" 
                                                                   TextWrapping="Wrap" 
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
