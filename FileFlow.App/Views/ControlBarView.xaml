<UserControl x:Class="FileFlow.App.Views.ControlBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="1100">
    <Border Background="{DynamicResource BgHeaderBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,0,0,1" 
            Padding="14,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Brand & Hamburger Side Drawer Toggle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleMenuCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Padding="10,6"
                        Margin="0,0,12,0"
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_MenuToolTip]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☰" FontSize="15" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[MenuBtn]}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text="FileFlow Studio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Workflow Execution Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Compact Dry Run Toggle Button -->
                <ToggleButton Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DryRun]}" 
                              IsChecked="{Binding IsDryRun}" 
                              Style="{DynamicResource SecondaryToggleButton}" 
                              Padding="8,5" 
                              Margin="0,0,8,0" 
                              ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_DryRunToolTip]}" />

                <!-- Watch Mode Button -->
                <Button Command="{Binding ToggleWatchModeCommand}" 
                        Padding="8,5" 
                        Margin="0,0,8,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_WatchModeToolTip]}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsWatching}" Value="True">
                                    <Setter Property="Background" Value="#065F46" />
                                    <Setter Property="BorderBrush" Value="#10B981" />
                                    <Setter Property="Foreground" Value="#34D399" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#10B981" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👁️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Vigilante" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Workflow Settings Modal Button -->
                <Button Command="{Binding OpenWorkflowSettingsCommand}" 
                        Style="{DynamicResource SecondaryButton}" 
                        Padding="8,5" 
                        Margin="0,0,8,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_SettingsToolTip]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[WorkflowSettingsBtn]}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Run Normal -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RunFlow]}" 
                        Command="{Binding ExecuteWorkflowCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentSuccessBrush}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" />

                <!-- Start Debugging -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DebugFlow]}" 
                        Command="{Binding DebugWorkflowCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentPurpleBrush}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" />

                <!-- Debug Stepping Controls (visible during debugging) -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StepNext]}" 
                        Command="{Binding StepNextCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentWarningBrush}" 
                        Visibility="{Binding IsDebugging, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_StepNextToolTip]}" />

                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ContinueFlow]}" 
                        Command="{Binding ContinueWorkflowCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentSuccessBrush}" 
                        Visibility="{Binding IsDebugging, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_ContinueToolTip]}" />

                <!-- Pause / Resume Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Pause]}" 
                        Command="{Binding TogglePauseCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_PauseToolTip]}" />

                <!-- Stop Execution / Debugging -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Stop]}" 
                        Command="{Binding StopWorkflowCommand}" 
                        Style="{StaticResource DangerButton}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_StopToolTip]}" />

                <!-- Rollback / Undo Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RollbackBtn]}" 
                        Command="{Binding RollbackLastExecutionCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Margin="8,0,0,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_RollbackToolTip]}" />

                <!-- Toggle Inspector Panel Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorBtn]}" 
                        Command="{Binding ToggleInspectorCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Margin="8,0,0,0" 
                        ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ControlBar_InspectorToolTip]}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

