<UserControl x:Class="FileFlow.App.Views.ControlBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="1100">
    <Border Background="{DynamicResource BgHeaderBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="0,0,0,1" 
            Padding="14,8">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- App Brand & Hamburger Side Drawer Toggle -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding ToggleMenuCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Padding="10,6"
                        Margin="0,0,12,0"
                        ToolTip="Abrir Menú Principal de Navegación">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="☰" FontSize="15" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Menú" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="6" Width="28" Height="28" Margin="0,0,10,0">
                    <TextBlock Text="⚡" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF" />
                </Border>
                <TextBlock Text="FileFlow Studio" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Workflow Execution Controls -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Compact Dry Run Toggle Button -->
                <ToggleButton Content="🧪 Modo Prueba" 
                              IsChecked="{Binding IsDryRun}" 
                              Style="{DynamicResource SecondaryToggleButton}" 
                              Padding="8,5" 
                              Margin="0,0,8,0" 
                              ToolTip="Modo simulación: Ejecuta el flujo sin modificar ni borrar archivos reales en disco" />

                <!-- Workflow Settings Modal Button -->
                <Button Command="{Binding OpenWorkflowSettingsCommand}" 
                        Style="{DynamicResource SecondaryButton}" 
                        Padding="8,5" 
                        Margin="0,0,8,0" 
                        ToolTip="Configurar la Ruta de Salida Global y opciones del proyecto">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙️" FontSize="12" Margin="0,0,4,0" VerticalAlignment="Center" />
                        <TextBlock Text="Ajustes del Flujo" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Run Normal -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[RunFlow]}" 
                        Command="{Binding ExecuteWorkflowCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentSuccessBrush}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" />

                <!-- Start Debugging -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DebugFlow]}" 
                        Command="{Binding DebugWorkflowCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentPurpleBrush}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" />

                <!-- Debug Stepping Controls (visible during debugging) -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[StepNext]}" 
                        Command="{Binding StepNextCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentWarningBrush}" 
                        Visibility="{Binding IsDebugging, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" 
                        ToolTip="Avanzar al siguiente paso (F10)" />

                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[ContinueFlow]}" 
                        Command="{Binding ContinueWorkflowCommand}" 
                        Style="{StaticResource IconButton}" 
                        Background="{DynamicResource AccentSuccessBrush}" 
                        Visibility="{Binding IsDebugging, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" 
                        ToolTip="Continuar ejecución normal (F5)" />

                <!-- Pause / Resume Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Pause]}" 
                        Command="{Binding TogglePauseCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        Margin="0,0,6,0" 
                        ToolTip="Pausar o Reanudar el flujo" />

                <!-- Stop Execution / Debugging -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Stop]}" 
                        Command="{Binding StopWorkflowCommand}" 
                        Style="{StaticResource DangerButton}" 
                        Visibility="{Binding IsRunning, Converter={StaticResource BooleanToVisibilityConverter}}" 
                        ToolTip="Detener ejecución (Shift+F5)" />

                <!-- Rollback / Undo Button -->
                <Button Content="↩ Deshacer" 
                        Command="{Binding RollbackLastExecutionCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Margin="8,0,0,0" 
                        ToolTip="Revertir y deshacer operaciones de la última ejecución (Rollback)" />

                <!-- Toggle Inspector Panel Button -->
                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorBtn]}" 
                        Command="{Binding ToggleInspectorCommand}" 
                        Style="{StaticResource SecondaryButton}" 
                        Margin="8,0,0,0" 
                        ToolTip="Abrir / Ocultar Inspector de Datos del Nodo" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

