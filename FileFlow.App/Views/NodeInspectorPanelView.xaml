<UserControl x:Class="FileFlow.App.Views.NodeInspectorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="380">
    <Border Background="{DynamicResource BgSurfaceBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- State 1: When NO node is selected -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Right" Margin="12,12,12,0" Padding="8,4" ToolTip="Cerrar Panel">
                    <TextBlock Text="✕ Cerrar" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Border Background="{DynamicResource BgHoverBrush}" Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorTitle]}" 
                               FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorNoSelection]}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" LineHeight="18" MaxWidth="280" />
                </StackPanel>
            </Grid>

            <!-- State 2: When a node is selected -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Panel Header -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InspectedNode.Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InspectedNode.ExecutionStatus}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding InspectedNode.Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Test Node Button -->
                        <Button Grid.Column="1" Command="{Binding TestNodeWithCustomFileCommand}" Style="{StaticResource SecondaryButton}" 
                                Padding="10,5" Margin="0,0,8,0" ToolTip="Probar este nodo de forma aislada con un archivo">
                            <TextBlock Text="🧪 Probar" FontSize="11" FontWeight="SemiBold" />
                        </Button>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" ToolTip="Cerrar Inspector">
                            <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Error Alert Banner (if node faulted) -->
                <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentErrorBrush}" BorderThickness="0,0,0,1" Padding="12"
                        Visibility="{Binding InspectedNode.LastErrorDetails, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚠️ " FontSize="13" Foreground="{DynamicResource AccentErrorBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorErrorTitle]}" 
                                       FontWeight="Bold" Foreground="{DynamicResource AccentErrorBrush}" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock Text="{Binding InspectedNode.LastErrorDetails}" Foreground="{DynamicResource AccentErrorBrush}" TextWrapping="Wrap" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                    </StackPanel>
                </Border>

                <!-- Modern Segmented Tabs -->
                <TabControl Grid.Row="2" Margin="12,10,12,12">
                    
                    <!-- TAB 1: Node Config & Parameters (ALWAYS VISIBLE & EDITABLE) -->
                    <TabItem Header="⚙️ Parámetros">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel>
                                <!-- Description Box -->
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Descripción del Nodo" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding InspectedNode.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>
                                </Border>

                                <!-- Parameters Form -->
                                <TextBlock Text="Configuración de Parámetros:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                
                                <ItemsControl ItemsSource="{Binding InspectedNode.Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardBrush}" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Padding="10,8" 
                                                    Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                    
                                                    <!-- String / Path / Number Value Input -->
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                             Background="{DynamicResource BgSurfaceBrush}" 
                                                             Foreground="{DynamicResource TextPrimaryBrush}" 
                                                             BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                             Padding="8,5" 
                                                             FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Ports Summary -->
                                <TextBlock Text="Puertos de Conexión:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Inputs -->
                                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Entradas (In)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding InspectedNode.InputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Outputs -->
                                    <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Salidas (Out)" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding InspectedNode.OutputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: Outputs Snapshots with Expandable Metadata -->
                    <TabItem Header="📤 Salidas">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Salidas Generadas (Click en ▶ para ver metadata):" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InspectedNode.OutputSnapshots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardBrush}" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Margin="0,0,0,8">
                                                <Expander IsExpanded="False" Padding="8,6">
                                                    <Expander.Header>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <!-- Header Row 1: Port + Timestamp -->
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                                <TextBlock Text="🟢 " FontSize="11" />
                                                                <TextBlock Text="{Binding PortName}" FontWeight="Bold" Foreground="{DynamicResource AccentSuccessBrush}" FontSize="12" />
                                                                <TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                            </StackPanel>
                                                            <!-- Header Row 2: Current Path -->
                                                            <TextBlock Grid.Row="1" Text="{Binding ItemSnapshot.CurrentPath}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                       FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding ItemSnapshot.CurrentPath}" />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <!-- Expandable Content: Full Metadata, Paths & Tags -->
                                                    <Border Background="{DynamicResource BgSurfaceBrush}" 
                                                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                            BorderThickness="0,1,0,0" 
                                                            Padding="10,8" 
                                                            Margin="-4,6,-4,-4">
                                                        <StackPanel>
                                                            <!-- Original Path -->
                                                            <TextBlock Text="Ruta Original:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBox Text="{Binding ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,6" />

                                                            <!-- File Size & IsDirectory -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <TextBlock Text="Tamaño: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ItemSnapshot.FileSizeBytes}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text=" bytes" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                                                <TextBlock Text="Carpeta: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ItemSnapshot.IsDirectory}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </StackPanel>

                                                            <!-- Metadata Dictionary -->
                                                            <TextBlock Text="Metadatos Asociados:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4" />
                                                            <ItemsControl ItemsSource="{Binding ItemSnapshot.Metadata}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,1">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Tags -->
                                                            <TextBlock Text="Etiquetas (Tags):" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,3" />
                                                            <ItemsControl ItemsSource="{Binding ItemSnapshot.Tags}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource AccentHoverBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,4,4">
                                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: Inputs Snapshots with Expandable Metadata -->
                    <TabItem Header="📥 Entradas">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Entradas Recibidas (Click en ▶ para ver metadata):" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding InspectedNode.InputSnapshots}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardBrush}" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1" 
                                                    CornerRadius="6" 
                                                    Margin="0,0,0,8">
                                                <Expander IsExpanded="False" Padding="8,6">
                                                    <Expander.Header>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <!-- Header Row 1: Port + Timestamp -->
                                                            <StackPanel Grid.Row="0" Orientation="Horizontal">
                                                                <TextBlock Text="🔵 " FontSize="11" />
                                                                <TextBlock Text="{Binding PortName}" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" FontSize="12" />
                                                                <TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                            </StackPanel>
                                                            <!-- Header Row 2: Current Path -->
                                                            <TextBlock Grid.Row="1" Text="{Binding ItemSnapshot.CurrentPath}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                       FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding ItemSnapshot.CurrentPath}" />
                                                        </Grid>
                                                    </Expander.Header>
                                                    <!-- Expandable Content: Full Metadata, Paths & Tags -->
                                                    <Border Background="{DynamicResource BgSurfaceBrush}" 
                                                            BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                            BorderThickness="0,1,0,0" 
                                                            Padding="10,8" 
                                                            Margin="-4,6,-4,-4">
                                                        <StackPanel>
                                                            <!-- Original Path -->
                                                            <TextBlock Text="Ruta Original:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBox Text="{Binding ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                                                     IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,6" />

                                                            <!-- File Size & IsDirectory -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                                <TextBlock Text="Tamaño: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ItemSnapshot.FileSizeBytes}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text=" bytes" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                                                                <TextBlock Text="Carpeta: " FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                                <TextBlock Text="{Binding ItemSnapshot.IsDirectory}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            </StackPanel>

                                                            <!-- Metadata Dictionary -->
                                                            <TextBlock Text="Metadatos Asociados:" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4" />
                                                            <ItemsControl ItemsSource="{Binding ItemSnapshot.Metadata}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,1">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto" MinWidth="90" />
                                                                                    <ColumnDefinition Width="*" />
                                                                                </Grid.ColumnDefinitions>
                                                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>

                                                            <!-- Tags -->
                                                            <TextBlock Text="Etiquetas (Tags):" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,3" />
                                                            <ItemsControl ItemsSource="{Binding ItemSnapshot.Tags}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal" />
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Border Background="{DynamicResource AccentHoverBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,4,4">
                                                                            <TextBlock Text="{Binding}" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </Expander>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 4: Metadata Diff -->
                    <TabItem Header="📊 Diff">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Diferencias de Metadatos (Entrada vs Salida):" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding MetadataDiffs}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      Background="{DynamicResource BgCardBrush}" 
                                      BorderBrush="{DynamicResource BorderDarkBrush}" 
                                      RowBackground="{DynamicResource BgSurfaceBrush}" 
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Clave" Binding="{Binding Key}" Width="110" />
                                    <DataGridTemplateColumn Header="Estado" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ChangeType}" 
                                                           Foreground="{Binding ChangeType, Converter={StaticResource DiffChangeTypeToBrushConverter}}" 
                                                           FontWeight="SemiBold" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Nuevo Valor" Binding="{Binding NewValue}" Width="*" />
                                    <DataGridTextColumn Header="Anterior" Binding="{Binding OldValue}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- TAB 5: Trace & Execution History -->
                    <TabItem Header="📜 Historial">
                        <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Detalles del Archivo Seleccionado:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                
                                <Border Background="{DynamicResource BgCardBrush}" 
                                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="10" 
                                        Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Ruta Actual:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.CurrentPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <TextBlock Text="Ruta Original:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Tamaño: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedSnapshot.ItemSnapshot.FileSizeBytes}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text=" bytes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Historial de Pasos por Nodos:" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedSnapshot.ItemSnapshot.ExecutionLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceBrush}" 
                                                    BorderBrush="{DynamicResource BorderDarkBrush}" 
                                                    BorderThickness="1" 
                                                    Padding="8,6" 
                                                    Margin="0,0,0,4" 
                                                    CornerRadius="4">
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
