<UserControl x:Class="FileFlow.App.Views.NodeInspectorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:conv="clr-namespace:FileFlow.App.Converters"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NodeInspectorViewModel}"
             d:DesignHeight="750" d:DesignWidth="380">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
            <conv:DiffChangeTypeToBrushConverter x:Key="DiffChangeTypeToBrushConverter" />
            <conv:InputOutputBulletConverter x:Key="InputOutputBulletConverter" />
            <conv:InputOutputBrushConverter x:Key="InputOutputBrushConverter" />
            <conv:DurationMsToTextConverter x:Key="DurationMsToTextConverter" />
            <conv:BytesToTextConverter x:Key="BytesToTextConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Templates/InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgSurfaceBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Estado 1: Sin nodo seleccionado -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Right" Margin="12,12,12,0" Padding="8,4" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ClosePanelToolTip]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕ " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_CloseBtn]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Border Background="{DynamicResource BgHoverBrush}" Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorTitle]}" 
                               FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorNoSelection]}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" LineHeight="18" MaxWidth="280" />
                </StackPanel>
            </Grid>

            <!-- Estado 2: Nodo Seleccionado -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado del Panel de Inspección -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InspectedNode.Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InspectedNode.ExecutionStatus}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding InspectedNode.Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Botones de Acción: Vista Previa y Probar Nodo -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                            <Button Command="{Binding OpenQuickPreviewCommand}" Style="{StaticResource SecondaryButton}" 
                                    Padding="10,5" Margin="0,0,6,0" 
                                    ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_PreviewToolTip]}">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_PreviewButton]}" FontSize="11" FontWeight="SemiBold" Foreground="#00E5FF" />
                            </Button>
                            <Button Command="{Binding TestNodeWithCustomFileCommand}" Style="{StaticResource SecondaryButton}" 
                                    Padding="10,5" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TestNodeToolTip]}">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TestBtn]}" FontSize="11" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>

                        <!-- Botón Cerrar -->
                        <Button Grid.Column="2" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ClosePanelToolTip]}">
                            <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Banner de Alerta de Error (si el nodo falló) -->
                <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentErrorBrush}" BorderThickness="0,0,0,1" Padding="12"
                        Visibility="{Binding InspectedNode.LastErrorDetails, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚠️ " FontSize="13" Foreground="{DynamicResource AccentErrorBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorErrorTitle]}" 
                                       FontWeight="Bold" Foreground="{DynamicResource AccentErrorBrush}" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock Text="{Binding InspectedNode.LastErrorDetails}" Foreground="{DynamicResource AccentErrorBrush}" TextWrapping="Wrap" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                    </StackPanel>
                </Border>

                <!-- Pestañas del Inspector -->
                <TabControl Grid.Row="2" Margin="12,10,12,12">
                    
                    <!-- PESTAÑA 1: Parámetros del Nodo -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabParameters]}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_NodeDescription]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding InspectedNode.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>
                                </Border>

                                <!-- Herramientas y Acciones Avanzadas del Nodo (CustomActions) -->
                                <ItemsControl ItemsSource="{Binding InspectedNode.CustomActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NodeActionViewModel}">
                                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Tooltip}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                    <Button Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Contexto de Depuración Activo para Evaluación de Parámetros -->
                                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚡ " FontSize="13" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ActiveContextLabel]}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                            <TextBlock Visibility="{Binding HasActiveEvaluationSnapshot, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                                       Text="{Binding ActiveEvaluationContextFileName, StringFormat='Archivo: {0}'}" 
                                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Visibility="{Binding HasActiveEvaluationSnapshot, Converter={StaticResource InverseBooleanToVisibilityConverter}}" 
                                                       Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_NoSnapshotForEvaluation]}" 
                                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ParametersConfig]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                
                                <ItemsControl ItemsSource="{Binding InspectedNode.Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NodeParameterViewModel}">
                                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8"
                                                    Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip="{Binding Key}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                        <!-- Badge si contiene expresión dinámica -->
                                                        <Border Grid.Column="1" Background="{DynamicResource BgHoverBrush}" CornerRadius="4" Padding="5,1" Margin="4,0,0,0"
                                                                Visibility="{Binding HasExpression, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{}{x}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ExpressionBadgeToolTip]}" />
                                                        </Border>
                                                    </Grid>
                                                    
                                                     <!-- Editor ComboBox para parámetros con opciones (Dropdowns como Protocol) -->
                                                    <ComboBox ItemsSource="{Binding Options}"
                                                              SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              IsEditable="False"
                                                              Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                              BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="12" Padding="8,5"
                                                              HorizontalAlignment="Stretch" />

                                                    <!-- Editor CheckBox para booleanos/toggles -->
                                                    <CheckBox IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Visibility="{Binding IsBooleanAndNoOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                                              FontSize="12" VerticalAlignment="Center" Margin="2,4,0,4" />

                                                    <!-- Editor con Botón Examinar para rutas de carpetas o archivos -->
                                                    <Grid Visibility="{Binding HasBrowseButton, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8,5" FontSize="12" />
                                                        <Button Grid.Column="1" Command="{Binding BrowsePathCommand}" Content="📁" Background="{DynamicResource AccentPrimaryBrush}" Foreground="White" BorderThickness="0" Padding="10,5" FontSize="12" Cursor="Hand" Margin="4,0,0,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BrowseExplorerToolTip]}" />
                                                    </Grid>

                                                    <!-- Editor Multilínea para Prompts, Templates, SQL y Textos Largos -->
                                                    <Grid Visibility="{Binding IsMultiLine, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <TextBox Grid.Row="0"
                                                                 Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True"
                                                                 TextWrapping="Wrap"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 MinHeight="75"
                                                                 MaxHeight="170"
                                                                 Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                                                 BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="11.5" Padding="8,6"
                                                                 FontFamily="Cascadia Code, Consolas, Segoe UI, monospace" />
                                                        
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                                            <Button Command="{Binding OpenTextEditorCommand}"
                                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                                    Style="{StaticResource SecondaryButton}" Padding="8,3" Margin="0,0,4,0"
                                                                    ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_ExpandToolTip], FallbackValue='Abrir editor ampliado (⤢)'}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="⤢ " FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" />
                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_WindowTitle], FallbackValue='Editor'}" FontSize="10.5" />
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding OpenVariablePickerCommand}"
                                                                    CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    Style="{StaticResource SecondaryButton}" Padding="8,3"
                                                                    ToolTip="Insertar variable dinámicamente ({x})">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{}{x} " FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource AccentGlowBrush}" />
                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_InsertVar], FallbackValue='Variables'}" FontSize="10.5" />
                                                                </StackPanel>
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- TextBox para parámetros de texto estándar -->
                                                    <Grid Visibility="{Binding IsStandardInput, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Grid.Column="0" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                                 Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8,5" FontSize="12" />
                                                        
                                                        <Button Grid.Column="1" Command="{Binding OpenTextEditorCommand}"
                                                                CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                                Content="⤢" 
                                                                Background="{DynamicResource BgHoverBrush}" 
                                                                Foreground="{DynamicResource AccentCyanBrush}" 
                                                                BorderThickness="0" 
                                                                Padding="7,4" 
                                                                FontSize="11" 
                                                                FontWeight="Bold" 
                                                                Cursor="Hand" 
                                                                Margin="4,0,0,0"
                                                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_ExpandToolTip], FallbackValue='Abrir editor ampliado (⤢)'}" />

                                                        <Button Grid.Column="2" 
                                                                Command="{Binding OpenVariablePickerCommand}"
                                                                CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                                                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                Content="{}{x}" 
                                                                Background="{DynamicResource BgHoverBrush}" 
                                                                Foreground="{DynamicResource AccentGlowBrush}" 
                                                                BorderThickness="0" 
                                                                Padding="7,4" 
                                                                FontSize="10.5" 
                                                                FontWeight="Bold" 
                                                                Cursor="Hand" 
                                                                Margin="2,0,0,0"
                                                                ToolTip="Insertar variable dinámicamente ({x})" />
                                                    </Grid>
                                                    
                                                    <!-- Previsualización Evaluada en Vivo (cuando contiene expresiones dinámicas) -->
                                                    <Border Margin="0,6,0,0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentCyanBrush}" BorderThickness="1" CornerRadius="5" Padding="8,6"
                                                            Visibility="{Binding HasExpression, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="⚡ " FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_EvaluatedLabel]}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" />
                                                                <TextBlock Text="{Binding EvaluatedValue}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                            <Button Grid.Column="2" Command="{Binding CopyEvaluatedValueCommand}" Style="{StaticResource SecondaryButton}" Padding="6,3" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                    ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_CopyEvaluatedToolTip]}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="📋 " FontSize="10" />
                                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Copy]}" FontSize="10" />
                                                                </StackPanel>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ConnectionPorts]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_InputsPortLabel]}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding InspectedNode.InputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OutputsPortLabel]}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding InspectedNode.OutputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PESTAÑA 2: Snapshots de Salida (Virtualizado) -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabOutputs]}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OutputsSubheader]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding InspectedNode.OutputSnapshots}" 
                                     SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource SnapshotExpanderTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemContainerBorder" 
                                                            Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="7">
                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                            <Setter TargetName="ItemContainerBorder" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True" />
                                                                <Condition Property="IsSelected" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 3: Snapshots de Entrada (Virtualizado) -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabInputs]}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_InputsSubheader]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding InspectedNode.InputSnapshots}" 
                                     SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource SnapshotExpanderTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,8" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemContainerBorder" 
                                                            Background="{TemplateBinding Background}" 
                                                            BorderBrush="{TemplateBinding BorderBrush}" 
                                                            BorderThickness="{TemplateBinding BorderThickness}" 
                                                            CornerRadius="7">
                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
                                                            <Setter TargetName="ItemContainerBorder" Property="Background" Value="{DynamicResource BgHoverBrush}" />
                                                        </Trigger>
                                                        <MultiTrigger>
                                                            <MultiTrigger.Conditions>
                                                                <Condition Property="IsMouseOver" Value="True" />
                                                                <Condition Property="IsSelected" Value="False" />
                                                            </MultiTrigger.Conditions>
                                                            <Setter TargetName="ItemContainerBorder" Property="BorderBrush" Value="{DynamicResource BorderLightBrush}" />
                                                        </MultiTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 4: Diferencias de Metadatos (Diff) -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabDiff]}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_DiffSubheader]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding MetadataDiffs}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      Background="{DynamicResource BgCardBrush}" 
                                      BorderBrush="{DynamicResource BorderDarkBrush}" 
                                      RowBackground="{DynamicResource BgSurfaceBrush}" 
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColKey]}" Binding="{Binding Key}" Width="110" />
                                    <DataGridTemplateColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColStatus]}" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ChangeType}" 
                                                           Foreground="{Binding ChangeType, Converter={StaticResource DiffChangeTypeToBrushConverter}}" 
                                                           FontWeight="SemiBold" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColNewValue]}" Binding="{Binding NewValue}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColOldValue]}" Binding="{Binding OldValue}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 5: Historial y Trazabilidad -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabHistory]}">
                        <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_SelectedFileDetails]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_CurrentPath]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.CurrentPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OriginalPath]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_SizeLabel]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text=": " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedSnapshot.ItemSnapshot.FileSizeBytes, Converter={StaticResource BytesToTextConverter}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_NodeStepHistory]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedSnapshot.ItemSnapshot.ExecutionLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,4" CornerRadius="4">
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PESTAÑA 6: Métricas y Rendimiento -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabMetrics], FallbackValue='📊 Rendimiento'}">
                        <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- KPIs Principales -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Tarjeta 1: Latencia Media -->
                                    <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_AvgLatency], FallbackValue='⚡ Latencia Media'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding InspectedNode.LatencyText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_TotalLabel], FallbackValue='Total: '}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding InspectedNode.CurrentStats.AverageTimeMs, Converter={StaticResource DurationMsToTextConverter}}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta 2: RAM por Item -->
                                    <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_RamPerItem], FallbackValue='💾 RAM / Item'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding InspectedNode.RollingRamText, FallbackValue='0 KB'}" FontSize="14" FontWeight="Bold" Foreground="#A5B4FC" Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_PeakLabel], FallbackValue='Pico: '}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <TextBlock Text="{Binding InspectedNode.CurrentStats.PeakAllocatedBytes, Converter={StaticResource BytesToTextConverter}}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta 3: Carga CPU / GPU -->
                                    <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_CpuHardware], FallbackValue='🖥️ CPU &amp; Hardware'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding InspectedNode.CurrentStats.AvgCpuPercentage, StringFormat='{}{0:F1}% CPU'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <Border Margin="6,0,0,0" Padding="4,1" CornerRadius="3" Background="#083344" BorderBrush="#06B6D4" BorderThickness="1"
                                                        Visibility="{Binding InspectedNode.IsGpuAccelerated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="🎮 GPU" FontSize="8" FontWeight="Bold" Foreground="#22D3EE" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Tarjeta 4: Procesados / Tasa Éxito -->
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_ItemsProcessed], FallbackValue='📦 Elementos'}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding InspectedNode.CurrentStats.ProcessedCount, StringFormat='{}{0} items'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,0" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_ErrorsLabel], FallbackValue='Errores: '}" FontSize="9.5" Foreground="{DynamicResource AccentErrorBrush}" />
                                                <TextBlock Text="{Binding InspectedNode.CurrentStats.ErrorCount}" FontSize="9.5" Foreground="{DynamicResource AccentErrorBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- Alerta de Cuello de Botella si aplica -->
                                <Border Background="#881337" BorderBrush="#F43F5E" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,10"
                                        Visibility="{Binding InspectedNode.IsBottleneck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⚠️ " FontSize="12" Foreground="White" />
                                        <TextBlock Text="{Binding InspectedNode.BottleneckRatioText, StringFormat='Cuello de botella en el flujo ({0})'}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </StackPanel>
                                </Border>

                                <!-- Historial de Muestras Rodantes (últimas 8 ops) -->
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_RollingHistory], FallbackValue='📈 Historial Rodante (Últimas 8 operaciones)'}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                        <ItemsControl ItemsSource="{Binding InspectedNode.CurrentStats.RecentSamples}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,0,0,4">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DurationMs, Converter={StaticResource DurationMsToTextConverter}, ConverterParameter='⚡ '}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding AllocatedBytes, Converter={StaticResource BytesToTextConverter}, ConverterParameter='  | 💾 '}" FontSize="10.5" Foreground="#A5B4FC" Margin="4,0,0,0" />
                                                            <Border Grid.Column="2" Margin="4,0" Padding="3,0" CornerRadius="3" Background="#083344" BorderBrush="#06B6D4" BorderThickness="1"
                                                                    Visibility="{Binding GpuAccelerated, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="GPU" FontSize="8" FontWeight="Bold" Foreground="#22D3EE" />
                                                            </Border>
                                                            <TextBlock Grid.Column="3" Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Botón Restablecer Métricas -->
                                <Button Command="{Binding ResetNodeMetricsCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔄 " FontSize="11" />
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Metrics_ResetNode], FallbackValue='Restablecer Métricas del Nodo'}" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
