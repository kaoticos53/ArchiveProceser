<UserControl x:Class="FileFlow.App.Views.NodeInspectorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:conv="clr-namespace:FileFlow.App.Converters"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:NodeInspectorViewModel}"
             d:DesignHeight="750" d:DesignWidth="380">

    <UserControl.Resources>
        <ResourceDictionary>
            <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
            <conv:DiffChangeTypeToBrushConverter x:Key="DiffChangeTypeToBrushConverter" />
            <conv:InputOutputBulletConverter x:Key="InputOutputBulletConverter" />
            <conv:InputOutputBrushConverter x:Key="InputOutputBrushConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Templates/InspectorTemplates.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{DynamicResource BgSurfaceBrush}" 
            BorderBrush="{DynamicResource BorderDarkBrush}" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- Estado 1: Sin nodo seleccionado -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource InverseNullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Right" Margin="12,12,12,0" Padding="8,4" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ClosePanelToolTip]}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="✕ " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_CloseBtn]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Border Background="{DynamicResource BgHoverBrush}" Width="64" Height="64" CornerRadius="32" Margin="0,0,0,16" HorizontalAlignment="Center">
                        <TextBlock Text="🔍" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorTitle]}" 
                               FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorNoSelection]}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" LineHeight="18" MaxWidth="280" />
                </StackPanel>
            </Grid>

            <!-- Estado 2: Nodo Seleccionado -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Encabezado del Panel de Inspección -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding InspectedNode.Title}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding InspectedNode.ExecutionStatus}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding InspectedNode.Category}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Botón Probar Nodo -->
                        <Button Grid.Column="1" Command="{Binding TestNodeWithCustomFileCommand}" Style="{StaticResource SecondaryButton}" 
                                Padding="10,5" Margin="0,0,8,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TestNodeToolTip]}">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TestBtn]}" FontSize="11" FontWeight="SemiBold" />
                        </Button>

                        <!-- Botón Cerrar -->
                        <Button Grid.Column="2" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ClosePanelToolTip]}">
                            <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Banner de Alerta de Error (si el nodo falló) -->
                <Border Grid.Row="1" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource AccentErrorBrush}" BorderThickness="0,0,0,1" Padding="12"
                        Visibility="{Binding InspectedNode.LastErrorDetails, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚠️ " FontSize="13" Foreground="{DynamicResource AccentErrorBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorErrorTitle]}" 
                                       FontWeight="Bold" Foreground="{DynamicResource AccentErrorBrush}" FontSize="12.5" />
                        </StackPanel>
                        <TextBlock Text="{Binding InspectedNode.LastErrorDetails}" Foreground="{DynamicResource AccentErrorBrush}" TextWrapping="Wrap" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" />
                    </StackPanel>
                </Border>

                <!-- Pestañas del Inspector -->
                <TabControl Grid.Row="2" Margin="12,10,12,12">
                    
                    <!-- PESTAÑA 1: Parámetros del Nodo -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabParameters]}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
                            <StackPanel>
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_NodeDescription]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding InspectedNode.Description}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" LineHeight="16" />
                                    </StackPanel>
                                </Border>

                                <!-- Herramientas y Acciones Avanzadas del Nodo (CustomActions) -->
                                <ItemsControl ItemsSource="{Binding InspectedNode.CustomActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:NodeActionViewModel}">
                                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource AccentPrimaryBrush}" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,4" />
                                                    <TextBlock Text="{Binding Tooltip}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                    <Button Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6" HorizontalAlignment="Left">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                                            <TextBlock Text="{Binding Title}" FontSize="11.5" FontWeight="Bold" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ParametersConfig]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                
                                <ItemsControl ItemsSource="{Binding InspectedNode.Parameters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding DisplayName}" ToolTip="{Binding Key}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                             Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="8,5" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ConnectionPorts]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_InputsPortLabel]}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentCyanBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding InspectedNode.InputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="4,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OutputsPortLabel]}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding InspectedNode.OutputPorts}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- PESTAÑA 2: Snapshots de Salida (Virtualizado) -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabOutputs]}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OutputsSubheader]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding InspectedNode.OutputSnapshots}" 
                                     SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource SnapshotExpanderTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 3: Snapshots de Entrada (Virtualizado) -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabInputs]}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_InputsSubheader]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <ListBox Grid.Row="1" 
                                     ItemsSource="{Binding InspectedNode.InputSnapshots}" 
                                     SelectedItem="{Binding SelectedSnapshot, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource SnapshotExpanderTemplate}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingStackPanel.IsVirtualizing="True"
                                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                                     VirtualizingStackPanel.ScrollUnit="Pixel"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter HorizontalAlignment="Stretch" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 4: Diferencias de Metadatos (Diff) -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabDiff]}">
                        <Grid Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_DiffSubheader]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <DataGrid Grid.Row="1" ItemsSource="{Binding MetadataDiffs}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" 
                                      Background="{DynamicResource BgCardBrush}" 
                                      BorderBrush="{DynamicResource BorderDarkBrush}" 
                                      RowBackground="{DynamicResource BgSurfaceBrush}" 
                                      AlternatingRowBackground="{DynamicResource BgCardBrush}" 
                                      Foreground="{DynamicResource TextPrimaryBrush}"
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColKey]}" Binding="{Binding Key}" Width="110" />
                                    <DataGridTemplateColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColStatus]}" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ChangeType}" 
                                                           Foreground="{Binding ChangeType, Converter={StaticResource DiffChangeTypeToBrushConverter}}" 
                                                           FontWeight="SemiBold" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColNewValue]}" Binding="{Binding NewValue}" Width="*" />
                                    <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_ColOldValue]}" Binding="{Binding OldValue}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- PESTAÑA 5: Historial y Trazabilidad -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_TabHistory]}">
                        <ScrollViewer Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_SelectedFileDetails]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_CurrentPath]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.CurrentPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OriginalPath]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_SizeLabel]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text=": " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedSnapshot.ItemSnapshot.FileSizeBytes}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text=" " FontSize="11" />
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_BytesLabel]}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_NodeStepHistory]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding SelectedSnapshot.ItemSnapshot.ExecutionLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" Padding="8,6" Margin="0,0,0,4" CornerRadius="4">
                                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" FontFamily="Cascadia Code, Consolas, monospace" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
