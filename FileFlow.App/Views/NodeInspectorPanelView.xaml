<UserControl x:Class="FileFlow.App.Views.NodeInspectorPanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="360">
    <Border Background="{StaticResource BgSurfaceBrush}" 
            BorderBrush="{StaticResource BorderDarkBrush}" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <!-- When NO node is selected -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button Grid.Row="0" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" 
                        HorizontalAlignment="Right" Margin="10,10,10,0" Padding="8,4" ToolTip="Cerrar Panel">
                    <TextBlock Text="✕ Cerrar" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Button>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <TextBlock Text="🔍" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,12" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorTitle]}" 
                               FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorNoSelection]}" 
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" FontSize="13" MaxWidth="280" />
                </StackPanel>
            </Grid>

            <!-- When a node is selected -->
            <Grid Visibility="{Binding InspectedNode, Converter={StaticResource NullToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="{StaticResource BgHeaderBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding InspectedNode.Title}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding InspectedNode.Category}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Test Node Button -->
                        <Button Grid.Column="1" Command="{Binding TestNodeWithCustomFileCommand}" Style="{StaticResource SecondaryButton}" 
                                Padding="8,4" Margin="0,0,8,0" ToolTip="Probar este nodo de forma aislada con un archivo">
                            <TextBlock Text="🧪 Probar" FontSize="11" />
                        </Button>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Command="{Binding ClosePanelCommand}" Style="{StaticResource SecondaryButton}" Padding="6,2">
                            <TextBlock Text="✕" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Error Alert Box (if node failed or paused on error) -->
                <Border Grid.Row="1" Background="#3B151A" BorderBrush="#EF4444" BorderThickness="0,0,0,1" Padding="12"
                        Visibility="{Binding InspectedNode.LastErrorDetails, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="⚠️ " FontSize="14" Foreground="#EF4444" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorErrorTitle]}" 
                                       FontWeight="Bold" Foreground="#EF4444" FontSize="13" />
                        </StackPanel>
                        <TextBlock Text="{Binding InspectedNode.LastErrorDetails}" Foreground="#FCA5A5" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas" />
                    </StackPanel>
                </Border>

                <!-- Main Content Tabs (Inputs, Outputs, Diff, Execution Log) -->
                <TabControl Grid.Row="2" Background="Transparent" BorderThickness="0" Margin="4">
                    <!-- Tab 1: Outputs -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorOutputs]}" FontSize="12">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Salidas Generadas:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />

                            <ListView Grid.Row="1" ItemsSource="{Binding InspectedNode.OutputSnapshots}" 
                                      SelectedItem="{Binding SelectedSnapshot}"
                                      Background="#161922" BorderBrush="{StaticResource BorderDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🟢 " FontSize="11" />
                                                    <TextBlock Text="{Binding PortName}" FontWeight="Bold" Foreground="#10B981" FontSize="12" />
                                                    <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ItemSnapshot.CurrentPath}" Foreground="{StaticResource TextPrimaryBrush}" 
                                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding ItemSnapshot.CurrentPath}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Tab 2: Inputs -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorInputs]}" FontSize="12">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Entradas Recibidas:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />

                            <ListView Grid.Row="1" ItemsSource="{Binding InspectedNode.InputSnapshots}" 
                                      SelectedItem="{Binding SelectedSnapshot}"
                                      Background="#161922" BorderBrush="{StaticResource BorderDarkBrush}" Foreground="{StaticResource TextPrimaryBrush}">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔵 " FontSize="11" />
                                                    <TextBlock Text="{Binding PortName}" FontWeight="Bold" Foreground="#60A5FA" FontSize="12" />
                                                    <TextBlock Text=" - " Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding ItemSnapshot.CurrentPath}" Foreground="{StaticResource TextPrimaryBrush}" 
                                                           FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding ItemSnapshot.CurrentPath}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Metadata Diff -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorMetadataDiff]}" FontSize="12">
                        <Grid Margin="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Text="Diferencias de Metadatos (Entrada vs Salida):" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />

                            <DataGrid Grid.Row="1" ItemsSource="{Binding MetadataDiffs}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" Background="#161922" BorderBrush="{StaticResource BorderDarkBrush}" 
                                      RowBackground="#1A1D27" AlternatingRowBackground="#1E2230" Foreground="{StaticResource TextPrimaryBrush}"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDarkBrush}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Clave" Binding="{Binding Key}" Width="110" />
                                    <DataGridTemplateColumn Header="Estado" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ChangeType}" 
                                                           Foreground="{Binding ChangeType, Converter={StaticResource DiffChangeTypeToBrushConverter}}" 
                                                           FontWeight="SemiBold" FontSize="11" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Nuevo Valor" Binding="{Binding NewValue}" Width="*" />
                                    <DataGridTextColumn Header="Anterior" Binding="{Binding OldValue}" Width="90" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Tab 4: File Context Item Details & Execution History -->
                    <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[InspectorExecutionLog]}" FontSize="12">
                        <ScrollViewer Margin="6" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Detalles del Archivo Seleccionado:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />
                                
                                <Border Background="#161922" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="Ruta Actual:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.CurrentPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <TextBlock Text="Ruta Original:" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />
                                        <TextBox Text="{Binding SelectedSnapshot.ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Tamaño: " FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock Text="{Binding SelectedSnapshot.ItemSnapshot.FileSizeBytes}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text=" bytes" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Historial de Pasos por Nodos:" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />
                                <ItemsControl ItemsSource="{Binding SelectedSnapshot.ItemSnapshot.ExecutionLog}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#1A1D27" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" Padding="6,4" Margin="0,0,0,4" CornerRadius="3">
                                                <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontFamily="Consolas" TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
