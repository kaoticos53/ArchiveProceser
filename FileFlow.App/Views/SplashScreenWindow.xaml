<Window x:Class="FileFlow.App.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileFlow Studio"
        Width="540"
        Height="350"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Glow Exterior -->
        <Border CornerRadius="16"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#6366F1"
                                  BlurRadius="30"
                                  ShadowDepth="0"
                                  Opacity="0.4" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Efectos Ambientales de Fondo -->
                <Ellipse Width="280" Height="280"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-90,-90,0"
                         Opacity="0.14">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="240" Height="240"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-70,0,0,-70"
                         Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#06B6D4" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Margin="32,26,32,20">
                    <Grid.RowDefinitions>
                        <!-- 0: Header (Logo + Title + Version) -->
                        <RowDefinition Height="Auto"/>
                        <!-- 1: Badges de características -->
                        <RowDefinition Height="*"/>
                        <!-- 2: Status & Percentage -->
                        <RowDefinition Height="Auto"/>
                        <!-- 3: Progress Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- 4: Footer (Copyright & GitHub) -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header con Icono, Título y Versión -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logotipo Insignia con Gradiente -->
                        <Border Width="52" Height="52" CornerRadius="12" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#06B6D4" BlurRadius="14" ShadowDepth="0" Opacity="0.55"/>
                            </Border.Effect>
                            <!-- Flow DAG Stylized Icon -->
                            <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M4 4h4v4H4zm12 0h4v4h-4zm-6 8h4v4h-4zm-6 8h4v4H4zm12 0h4v4h-4zM6 8v4h12V8m-6 4v4m0 0v4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FileFlow"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"
                                           FontFamily="Segoe UI, Inter, Arial"/>
                                <TextBlock Text="Studio"
                                           FontSize="24"
                                           FontWeight="Light"
                                           Foreground="#38BDF8"
                                           Margin="6,0,0,0"
                                           FontFamily="Segoe UI, Inter, Arial"/>
                                
                                <Border Background="#1E293B" 
                                        BorderBrush="#475569" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="6,2" 
                                        Margin="10,2,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtVersion"
                                               Text="v1.0.0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Automatización Inteligente de Archivos y Motor DAG"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Distintivos de Capacidades del Motor -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,10,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="3,0">
                                <TextBlock Text="⚡ Modo Asíncrono" FontSize="10.5" Foreground="#94A3B8"/>
                            </Border>
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="3,0">
                                <TextBlock x:Name="TxtNodesBadge" Text="🧩 57 Nodos DAG" FontSize="10.5" Foreground="#38BDF8" FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="12" Padding="9,4" Margin="3,0">
                                <TextBlock Text="🛡️ No Destructivo" FontSize="10.5" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Etiqueta de Estado y Porcentaje -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtStatus"
                                   Text="Iniciando motor FileFlow..."
                                   FontSize="11.5"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="380"/>

                        <TextBlock x:Name="TxtPercentage"
                                   Text="0%"
                                   FontSize="11.5"
                                   FontWeight="SemiBold"
                                   Foreground="#38BDF8"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Barra de Progreso Fluida con Gradiente -->
                    <Grid Grid.Row="3" Margin="0,0,0,14">
                        <!-- Track de Fondo -->
                        <Border Height="5" CornerRadius="2.5" Background="#1E293B"/>

                        <!-- Relleno de Barra -->
                        <ProgressBar x:Name="PbProgress"
                                     Height="5"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="#06B6D4"
                                     Background="Transparent"
                                     BorderThickness="0">
                            <ProgressBar.Resources>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border CornerRadius="2.5" Background="Transparent" ClipToBounds="True">
                                                    <Grid x:Name="PART_Track">
                                                        <Border x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="2.5">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#06B6D4" Offset="0"/>
                                                                    <GradientStop Color="#6366F1" Offset="0.7"/>
                                                                    <GradientStop Color="#A855F7" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                    </Grid>

                    <!-- Pie de Página: Autor / Copyright & Enlace a GitHub -->
                    <Grid Grid.Row="4" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Copyright & Autor -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="©" FontSize="10.5" Foreground="#64748B" Margin="0,0,3,0"/>
                            <TextBlock Text="RGLara" FontSize="10" FontWeight="SemiBold" Foreground="#94A3B8"/>
                        </StackPanel>

                        <!-- Repositorio GitHub con Icono SVG -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Icono GitHub -->
                            <Viewbox Width="12" Height="12" Margin="0,0,4,0" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#64748B" Data="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="github.com/kaoticos53/ArchiveProceser"
                                       FontSize="9.5"
                                       Foreground="#64748B"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
