<Window x:Class="FileFlow.App.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FileFlow Studio"
        Width="520"
        Height="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.0" To="1.0"
                             Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FadeOutStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.0"
                             Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid Margin="16">
        <!-- Glow Effect Exterior -->
        <Border CornerRadius="16"
                Background="#0F172A"
                BorderBrush="#334155"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#6366F1"
                                  BlurRadius="28"
                                  ShadowDepth="0"
                                  Opacity="0.45" />
            </Border.Effect>

            <Grid ClipToBounds="True">
                <!-- Decorative Subtle Background Gradient Shapes -->
                <Ellipse Width="260" Height="260"
                         HorizontalAlignment="Right" VerticalAlignment="Top"
                         Margin="0,-80,-80,0"
                         Opacity="0.15">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Ellipse Width="220" Height="220"
                         HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Margin="-60,0,0,-60"
                         Opacity="0.12">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#06B6D4" Offset="0"/>
                            <GradientStop Color="Transparent" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Grid Margin="32,28,32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Icon and Title -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Logo Glow Badge -->
                        <Border Width="52" Height="52" CornerRadius="12" Margin="0,0,16,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4F46E5" Offset="0"/>
                                    <GradientStop Color="#06B6D4" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#06B6D4" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <!-- Flow DAG Stylized Icon -->
                            <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M4 4h4v4H4zm12 0h4v4h-4zm-6 8h4v4h-4zm-6 8h4v4H4zm12 0h4v4h-4zM6 8v4h12V8m-6 4v4m0 0v4"/>
                                </Canvas>
                            </Viewbox>
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="FileFlow"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#F8FAFC"
                                           FontFamily="Segoe UI, Inter, Arial"/>
                                <TextBlock Text="Studio"
                                           FontSize="24"
                                           FontWeight="Light"
                                           Foreground="#38BDF8"
                                           Margin="6,0,0,0"
                                           FontFamily="Segoe UI, Inter, Arial"/>
                                
                                <Border Background="#1E293B" 
                                        BorderBrush="#475569" 
                                        BorderThickness="1" 
                                        CornerRadius="6" 
                                        Padding="6,2" 
                                        Margin="10,2,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtVersion"
                                               Text="v1.0.0"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#94A3B8"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Automatización de Archivos y Motor de Flujos DAG"
                                       FontSize="11"
                                       Foreground="#64748B"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Central Description / Features Mini Badges -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                            <Border Background="#1E293B" CornerRadius="12" Padding="10,4" Margin="4,0">
                                <TextBlock Text="⚡ .NET 9 Ultra High Throughput" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="12" Padding="10,4" Margin="4,0">
                                <TextBlock Text="🧩 27 Nodos DAG" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                            <Border Background="#1E293B" CornerRadius="12" Padding="10,4" Margin="4,0">
                                <TextBlock Text="🛡️ Zip Slip &amp; Zero-Alloc" FontSize="11" Foreground="#94A3B8"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status Label & Loading Progress -->
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <TextBlock x:Name="TxtStatus"
                                   Text="Iniciando motor FileFlow..."
                                   FontSize="12"
                                   Foreground="#CBD5E1"
                                   HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="360"/>

                        <TextBlock x:Name="TxtPercentage"
                                   Text="0%"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#38BDF8"
                                   HorizontalAlignment="Right"/>
                    </Grid>

                    <!-- Animated Progress Bar -->
                    <Grid Grid.Row="3">
                        <!-- Background Track -->
                        <Border Height="6" CornerRadius="3" Background="#1E293B"/>

                        <!-- Progress Bar Fill -->
                        <ProgressBar x:Name="PbProgress"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Foreground="#06B6D4"
                                     Background="Transparent"
                                     BorderThickness="0">
                            <ProgressBar.Resources>
                                <Style TargetType="ProgressBar">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ProgressBar">
                                                <Border CornerRadius="3" Background="Transparent" ClipToBounds="True">
                                                    <Grid x:Name="PART_Track">
                                                        <Border x:Name="PART_Indicator"
                                                                HorizontalAlignment="Left"
                                                                CornerRadius="3">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#06B6D4" Offset="0"/>
                                                                    <GradientStop Color="#6366F1" Offset="0.7"/>
                                                                    <GradientStop Color="#A855F7" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ProgressBar.Resources>
                        </ProgressBar>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
