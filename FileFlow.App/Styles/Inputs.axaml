<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Capa de campos del sistema de diseño.
        Los estados se declaran sobre las partes reales de la plantilla Fluent, que son las que el tema base pinta:
          TextBox  -> Border#PART_BorderElement (cara y borde) · TextPresenter#PART_TextPresenter (la etiqueta)
          ComboBox -> Border#Background / Border#HighlightBackground · ContentControl#ContentPresenter · PathIcon#DropDownGlyph
        Variantes de TextBox: search · mono · flush
    -->

    <!-- ============================= TextBox ============================= -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <!-- Deshabilitado: el mismo tratamiento que la capa de botones (ver Buttons.axaml «Deshabilitado») y por el
         mismo defecto medido. La etiqueta se leía con el primer plano deshabilitado del tema base —que se declara en
         el propio TextBox y al que un estilo de la capa no se lo sustituye— así que quedaba en 4,00:1 sobre el tema
         oscuro y 3,30:1 sobre el claro, por debajo del AA de texto: lo midió el tablero de estados del suite en cuanto
         sus celdas entraron en la guardia. Y la cara era la del tema base, ajena al sistema, atenuada con una
         opacidad del 50 % que no tocaba la etiqueta pero dejaba la cara a merced de lo que hubiera detrás.

         Ahora hay un solo nivel de atenuación y es explícito: cara y borde son tokens del tema, <b>opacos</b>, y el
         primer plano se declara donde de verdad se pinta la etiqueta —el TextPresenter, que hereda el Foreground del
         control y al que una declaración directa sí gana—. Medido por la guardia: 4,88:1 en el tema oscuro y 4,82:1
         en el claro. La cara es BgSurface y no BgDark (la del campo habilitado) porque es el token cuya pareja con
         TextMuted ya está garantizada a 4,5:1 en los 8 presets
         (BuiltInThemes_TextMuted_ShouldMeetAaContrastOnSurfaces); con BgDark, pastel_spring daría 4,44:1.

         El texto de reserva ya recibe TextMuted en cualquier estado por la regla de PART_Placeholder, así que no
         hace falta declararlo otra vez aquí: es el mismo token. -->
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
    </Style>

    <!-- El primer plano de la etiqueta se declara con TextElement.Foreground porque TextPresenter no expone la
         propiedad (el compilador de XAML lo rechaza) y es esa propiedad heredada la que el presentador usa para
         pintar el texto. -->
    <Style Selector="TextBox:disabled /template/ TextPresenter#PART_TextPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Campo de búsqueda: ligeramente más bajo y con tipografía de caption -->
    <Style Selector="TextBox.search">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- Entrada monoespaciada (rutas, códigos, patrones) -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <!-- Campo sin cromo: vive dentro de un contenedor Border.inset que ya aporta fondo y borde -->
    <Style Selector="TextBox.flush">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TextBox.flush /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============================= ComboBox ============================= -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- El tema base pinta su propia capa sobre <c>Border#Background</c>, así que declarar el estado en las
         propiedades del control no se ve: se declara sobre la parte que de verdad se pinta. Medido con el tablero
         de estados del suite: en el tema oscuro el desplegable se <b>oscurecía</b> al pasar el puntero
         (#131720 → #050709, porque el relleno del tema base es un velo negro translúcido) mientras que en claro
         aclaraba; con estas reglas los dos temas hacen lo que el sistema de diseño declara. -->
    <Style Selector="ComboBox /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
    </Style>

    <Style Selector="ComboBox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    </Style>

    <Style Selector="ComboBox:focus /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <!-- Deshabilitado: el mismo contrato que los botones y que el campo de texto —cara, borde y primer plano
         declarados, sin opacidad— y por el mismo defecto medido: el tema base declara el primer plano deshabilitado
         <b>directamente sobre la parte que pinta la etiqueta</b> (ContentControl#ContentPresenter) y nuestra capa no
         declaraba ninguno, así que se leía el suyo: 3,50:1 sobre el tema oscuro y 2,62:1 sobre el claro, por debajo
         del AA de texto. Se declaran las tres partes que el tema base apaga: la etiqueta, el texto de reserva y el
         glifo del desplegable —si el glifo conservara el color del tema, el píxel más claro de la celda no sería la
         etiqueta y la guardia de contraste estaría midiendo otra cosa—. -->
    <Style Selector="ComboBox:disabled /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
    </Style>

    <Style Selector="ComboBox:disabled /template/ ContentControl#ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="ComboBox:disabled /template/ TextBlock#PlaceholderTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="ComboBox:disabled /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Elev3}" />
    </Style>

    <!-- Elementos del desplegable (ComboBoxItem) -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- ============================= AutoCompleteBox ============================= -->

    <Style Selector="AutoCompleteBox">
        <Setter Property="MinimumPrefixLength" Value="0" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
    </Style>

    <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox /template/ Popup#PART_Popup Border#PART_SuggestionsContainer">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Elev3}" />
    </Style>

    <!-- ===================== Campo numérico (NumericUpDown) ===================== -->
    <!--
        Los ajustes numéricos del Theme Studio (radios, tamaños, densidad y sombras) se editan aquí: el
        control toma la tipografía, el radio y los colores del tema para que no desentone con los campos de texto.
    -->

    <Style Selector="NumericUpDown">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="NumericUpDown /template/ RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ============================= Casillas ============================= -->

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

</Styles>
