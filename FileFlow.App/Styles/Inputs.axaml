<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Capa de campos del sistema de diseño.
        Los estados se declaran sobre las partes reales de la plantilla Fluent:
          TextBox  -> Border#PART_BorderElement
          ComboBox -> Border#Background / Border#HighlightBackground
        Variantes de TextBox: search · mono · flush
    -->

    <!-- ============================= TextBox ============================= -->

    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="7,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    </Style>

    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <Style Selector="TextBox /template/ TextBlock#PART_Placeholder">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- Campo de búsqueda: ligeramente más bajo y con tipografía de caption -->
    <Style Selector="TextBox.search">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="24" />
    </Style>

    <!-- Entrada monoespaciada (rutas, códigos, patrones) -->
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{DynamicResource CodeFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <!-- Campo sin cromo: vive dentro de un contenedor Border.inset que ya aporta fondo y borde -->
    <Style Selector="TextBox.flush">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="TextBox.flush /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============================= ComboBox ============================= -->

    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBox /template/ Border#PopupBorder">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Elev3}" />
    </Style>

    <!-- Elementos del desplegable (ComboBoxItem) -->
    <Style Selector="ComboBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- ============================= AutoCompleteBox ============================= -->

    <Style Selector="AutoCompleteBox">
        <Setter Property="MinimumPrefixLength" Value="0" />
        <Setter Property="MaxDropDownHeight" Value="280" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
    </Style>

    <Style Selector="AutoCompleteBox /template/ TextBox#PART_TextBox">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="AutoCompleteBox /template/ Popup#PART_Popup Border#PART_SuggestionsContainer">
        <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="BoxShadow" Value="{DynamicResource Elev3}" />
    </Style>

    <!-- ===================== Campo numérico (NumericUpDown) ===================== -->
    <!--
        Los ajustes numéricos del Theme Studio (radios, tamaños, densidad y sombras) se editan aquí: el
        control toma la tipografía, el radio y los colores del tema para que no desentone con los campos de texto.
    -->

    <Style Selector="NumericUpDown">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="26" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner">
        <Setter Property="Background" Value="{DynamicResource BgDarkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ ButtonSpinner:focus-within">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ TextBox#PART_TextBox">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="NumericUpDown /template/ RepeatButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <Style Selector="NumericUpDown /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- ============================= Casillas ============================= -->

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

</Styles>
