<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Capa de botones del sistema de diseño.
        Los estados hover/pressed/disabled se declaran sobre la parte real de la plantilla Fluent
        (ContentPresenter#PART_ContentPresenter) porque el tema base fija ahí los colores y
        esos setters tienen prioridad sobre los TemplateBinding de la plantilla.
        Variantes: primary · success · danger · warning · ghost · icon · toolbar · link · pill
    -->

    <Styles.Resources>
        <!-- Segmento tipo pastilla (grupos de filtros exclusivos): ControlTheme propio, sin depender
             de las partes internas del RadioButton de Fluent. -->
        <ControlTheme x:Key="SegmentTheme" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
            <Setter Property="Padding" Value="8,2.5" />
            <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>

            <Style Selector="^:checked">
                <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
            </Style>

            <Style Selector="^:checked:pointerover">
                <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
            </Style>
        </ControlTheme>
    </Styles.Resources>

    <!-- ============================= Botón base ============================= -->

    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHeaderBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <!-- ============================= Deshabilitado =============================
         El estado deshabilitado <b>conserva la identidad de la variante</b>: tiene cara propia en lugar de
         adoptar el relleno neutro del tema base, que borraba el color de todas las variantes por igual y que
         en un botón sin fondo —ghost, icon, link— lo <i>añadía</i>, convirtiendo un botón transparente en una
         caja gris. Medido con el tablero de estados del suite: las cuatro variantes daban el mismo gris
         (#22262B en oscuro, #E3E5E6 en claro).

         Y declara <b>el primer plano</b>, que es la mitad que faltaba. El tema base atenúa la etiqueta por su
         cuenta en esta misma parte (Foreground = ButtonForegroundDisabled), así que la opacidad que había aquí
         antes atenuaba dos veces lo mismo: medido con el tablero y con las capturas del producto, el texto
         deshabilitado quedaba en 2,13:1 sobre el tema oscuro y en <b>1,20:1</b> sobre el claro — es decir,
         invisible, porque en claro el gris del tema base caía más cerca del color correcto y nadie lo había
         medido hasta que hubo línea base del producto en los dos temas.

         Ahora hay un solo nivel de atenuación y es explícito: la cara de cada variante y un primer plano
         pensado para ella. TextMuted es el token de texto atenuado del sistema (contrato de 4,5:1 sobre las
         superficies, con guardia propia) y sobre las caras de acento va TextPrimary, porque esas caras son
         claras en el tema claro y oscuras en el oscuro, igual que una superficie. -->
    <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.success:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSuccessMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSuccessMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.danger:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentErrorMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentErrorMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.warning:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentWarningMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentWarningMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.debug:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPurpleMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPurpleMutedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Button.link:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- El chip declara su primer plano por su cuenta (TextSecondary, más arriba en prioridad que la regla
         base por ser posterior), así que aquí hay que volver a declararlo: sin esta línea el chip deshabilitado
         se quedaba con TextSecondary —un token que no tiene contrato de contraste sobre superficies— en lugar
         del de atenuado. Medido: 4,34:1 en claro frente a 4,82:1 con TextMuted. -->
    <Style Selector="Button.chipButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <!-- ============================= Variantes ============================= -->

    <!-- Acento principal -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Opacity" Value="0.82" />
    </Style>

    <!-- Éxito (ejecutar) -->
    <Style Selector="Button.success">
        <Setter Property="Background" Value="{DynamicResource AccentSuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSuccessBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.success:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSuccessBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentGlowBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="Opacity" Value="0.88" />
    </Style>

    <Style Selector="Button.success:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSuccessBrush}" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <!-- Peligro (detener, borrar) -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource AccentErrorBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentErrorBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentErrorBrush}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- Advertencia (paso a paso, depuración) -->
    <Style Selector="Button.warning">
        <Setter Property="Background" Value="{DynamicResource AccentWarningBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentWarningBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.warning:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentWarningBrush}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- Depuración (morado) -->
    <Style Selector="Button.debug">
        <Setter Property="Background" Value="{DynamicResource AccentPurpleBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPurpleBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="Button.debug:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPurpleBrush}" />
        <Setter Property="Opacity" Value="0.88" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- Sin fondo ni borde -->
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>

    <!-- Botón de icono (cuadrado, compacto) -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBodySm}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Botón de barra de herramientas (compacto, con borde) -->
    <Style Selector="Button.toolbar">
        <Setter Property="Padding" Value="8,3.5" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    </Style>

    <!-- Enlace de texto -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGlowBrush}" />
        <Setter Property="Padding" Value="4,2" />
    </Style>

    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>

    <!-- Chip de Selección / Version Option -->
    <Style Selector="Button.chipButton">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="6,2.5" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- La cara y el primer plano del chip ya los declara la variante sobre el control (arriba): repetirlos
         aquí no cambiaba nada del aspecto —es el mismo token— pero sí tapaba la declaración del estado
         deshabilitado, porque un setter posterior sobre la misma parte gana al anterior. Sin esta duplicación,
         el chip deshabilitado usa el primer plano que le corresponde. -->
    <Style Selector="Button.chipButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
    </Style>

    <Style Selector="Button.chipButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentCyanBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="Button.chipButton.selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="Button.chipButton.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- Pastilla completa -->
    <Style Selector="Button.pill">
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusPill}" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- ============================= ToggleButton ============================= -->

    <Style Selector="ToggleButton">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusXs}" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="ToggleButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <!-- Chip activado (modo Dry Run, modo En vivo): acento sólido -->
    <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>

    <Style Selector="ToggleButton.chip">
        <Setter Property="Padding" Value="8,3.5" />
    </Style>

    <Style Selector="ToggleButton.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="MinWidth" Value="26" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <!-- Mismo contrato que los botones (ver el bloque «Deshabilitado»): cara propia y primer plano explícito,
         sin opacidad sobre la parte, que además de la cara atenuaría la etiqueta que el tema base ya atenúa. -->
    <Style Selector="ToggleButton:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    </Style>

    <Style Selector="ToggleButton.chip:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
    </Style>

    <Style Selector="ToggleButton.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="ToggleButton.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource BgHoverBrush}" />
    </Style>

    <Style Selector="ToggleButton.icon:checked /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

    <!-- Compuesto: pasar el puntero por un conmutador de icono ya activado tiene que encenderlo, como en el chip.
         Sin esta regla, las celdas «seleccionada» y «seleccionada+hover» del tablero de estados salían con el
         mismo color y el estado compuesto no existía. -->
    <Style Selector="ToggleButton.icon:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
    </Style>

</Styles>
