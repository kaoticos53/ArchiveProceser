<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FileFlow.App.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="FileFlow.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
        <StyleInclude Source="avares://Nodify.Avalonia/Themes/Controls.xaml" />

        <!-- Component layer del sistema de diseño (debe ir después de FluentTheme para ganar la cascada) -->
        <StyleInclude Source="avares://FileFlow.App/Styles/Typography.axaml" />
        <StyleInclude Source="avares://FileFlow.App/Styles/Surfaces.axaml" />
        <StyleInclude Source="avares://FileFlow.App/Styles/Buttons.axaml" />
        <StyleInclude Source="avares://FileFlow.App/Styles/Inputs.axaml" />
        <StyleInclude Source="avares://FileFlow.App/Styles/Containers.axaml" />
        <StyleInclude Source="avares://FileFlow.App/Styles/Ports.axaml" />

        <!-- Iconografía vectorial: la plantilla del control MaterialIcon resuelve `Foreground` como relleno.
             Registrada una sola vez para el host y para las ventanas de los plugins. -->
        <materialIcons:MaterialIconStyles />

        <!-- Global Fluent Typography & Control Styles -->
        <!-- Tipografía alimentada por el tema activo: cambiar ThemeDefinition.FontFamily / BaseFontSize
             desde el Theme Studio se refleja en toda la aplicación sin tocar cada vista. -->
        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="FontSize" Value="{DynamicResource AppFontSize}" />
        </Style>
        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
            <converters:NodeExecutionStatusToBrushConverter x:Key="NodeExecutionStatusToBrushConverter" />
            <converters:DiffChangeTypeToBrushConverter x:Key="DiffChangeTypeToBrushConverter" />
            <converters:BreakpointToBrushConverter x:Key="BreakpointToBrushConverter" />
            <converters:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
            <converters:InputOutputBulletConverter x:Key="InputOutputBulletConverter" />
            <converters:InputOutputBrushConverter x:Key="InputOutputBrushConverter" />
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
            <converters:LogLevelToBadgeConverter x:Key="LogLevelToBadgeConverter" />
            <converters:LogLevelToBadgeBackgroundConverter x:Key="LogLevelToBadgeBackgroundConverter" />
            <converters:LogLevelToBadgeForegroundConverter x:Key="LogLevelToBadgeForegroundConverter" />
            <converters:LoggingToBrushConverter x:Key="LoggingToBrushConverter" />
            <converters:LoggingToTooltipConverter x:Key="LoggingToTooltipConverter" />
            <converters:DurationMsToTextConverter x:Key="DurationMsToTextConverter" />
            <converters:BytesToTextConverter x:Key="BytesToTextConverter" />
            <converters:StringsEqualMultiConverter x:Key="StringsEqualMultiConverter" />
            <converters:StringEqualsToBooleanConverter x:Key="StringEqualsToBooleanConverter" />
            <converters:BooleanToBrushConverter x:Key="BooleanToBrushConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
