<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FileFlow.App.Converters"
             x:Class="FileFlow.App.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
    </Application.Styles>

    <Application.Resources>
        <ResourceDictionary>
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
            <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
            <converters:NodeExecutionStatusToBrushConverter x:Key="NodeExecutionStatusToBrushConverter" />
            <converters:DiffChangeTypeToBrushConverter x:Key="DiffChangeTypeToBrushConverter" />
            <converters:BreakpointToBrushConverter x:Key="BreakpointToBrushConverter" />
            <converters:BooleanToGridLengthConverter x:Key="BooleanToGridLengthConverter" />
            <converters:InputOutputBulletConverter x:Key="InputOutputBulletConverter" />
            <converters:InputOutputBrushConverter x:Key="InputOutputBrushConverter" />
            <converters:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />
            <converters:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
            <converters:LogLevelToBrushConverter x:Key="LogLevelToBrushConverter" />
            <converters:LogLevelToBadgeConverter x:Key="LogLevelToBadgeConverter" />
            <converters:LogLevelToBadgeBackgroundConverter x:Key="LogLevelToBadgeBackgroundConverter" />
            <converters:LogLevelToBadgeForegroundConverter x:Key="LogLevelToBadgeForegroundConverter" />
            <converters:LoggingToBrushConverter x:Key="LoggingToBrushConverter" />
            <converters:LoggingToTooltipConverter x:Key="LoggingToTooltipConverter" />
            <converters:DurationMsToTextConverter x:Key="DurationMsToTextConverter" />
            <converters:BytesToTextConverter x:Key="BytesToTextConverter" />
            <converters:StringsEqualMultiConverter x:Key="StringsEqualMultiConverter" />
            <converters:StringEqualsToBooleanConverter x:Key="StringEqualsToBooleanConverter" />

            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/DarkTheme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
