<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify">

    <!-- Rainbow Spring / Pastel Color Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FAF7FD" />
    <SolidColorBrush x:Key="BgDarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgEditorBrush" Color="#EBE4F5" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#F5EEFD" />
    <SolidColorBrush x:Key="BgHeaderBrush" Color="#F2E8FC" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#E9D8FD" />
    
    <!-- Spring Pastel Accents -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#8B5CF6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#F472B6" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="#FB923C" />
    <SolidColorBrush x:Key="AccentErrorBrush" Color="#FB7185" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#38BDF8" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#C084FC" />

    <!-- Typography & Borders -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#2E1065" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#DDD6FE" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#F3E8FF" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#D9CCE8" />

    <!-- Scrollbar Brushes -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#DDD6FE" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#A78BFA" />

    <!-- Rainbow Spring Wire Gradient Brush (Sakura Pink -> Peach -> Mint -> Sky Blue -> Lavender) -->
    <LinearGradientBrush x:Key="ConnectionWireBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#F472B6" Offset="0.0" />
        <GradientStop Color="#FBBF24" Offset="0.25" />
        <GradientStop Color="#34D399" Offset="0.5" />
        <GradientStop Color="#38BDF8" Offset="0.75" />
        <GradientStop Color="#A78BFA" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Node Drop Shadow Effect with Soft Pastel Bloom -->
    <DropShadowEffect x:Key="NodeShadowEffect" BlurRadius="22" ShadowDepth="4" Direction="270" Color="#A855F7" Opacity="0.16" />
</ResourceDictionary>
