<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify">

    <!-- Fluent Light Color Palette -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="BgDarkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgEditorBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#F9FAFB" />
    <SolidColorBrush x:Key="BgHeaderBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#E2E8F0" />
    
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="AccentErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#0891B2" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#9333EA" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#64748B" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#CBD5E1" />

    <!-- Scrollbar Brushes -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#94A3B8" />

    <!-- Connection Wire Gradient Brush -->
    <LinearGradientBrush x:Key="ConnectionWireBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#6366F1" Offset="0.0" />
        <GradientStop Color="#4F46E5" Offset="0.5" />
        <GradientStop Color="#7C3AED" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Node Drop Shadow Effect -->
    <DropShadowEffect x:Key="NodeShadowEffect" BlurRadius="20" ShadowDepth="3" Direction="270" Color="#000000" Opacity="0.08" />
</ResourceDictionary>
