<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="clr-namespace:Nodify;assembly=Nodify">

    <!-- Fluent Dark Color Palette (GitHub/Windows 11 Dark Mode) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="BgDarkBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="BgEditorBrush" Color="#10131B" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#161B22" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#131720" />
    <SolidColorBrush x:Key="BgHeaderBrush" Color="#1A1F29" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#21262D" />
    
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#A855F7" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#30363D" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#21262D" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#1A202C" />

    <!-- Scrollbar Brushes -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#384152" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#4F5B73" />

    <!-- Connection Wire Gradient Brush -->
    <LinearGradientBrush x:Key="ConnectionWireBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#818CF8" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="0.5" />
        <GradientStop Color="#C084FC" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Node Drop Shadow Effect -->
    <DropShadowEffect x:Key="NodeShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55" />
</ResourceDictionary>
