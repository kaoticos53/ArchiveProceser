<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        BASELINE DE TOKENS DE ARRANQUE.
        Este diccionario es el espejo del preset integrado `dark_fluent` y sólo se usa para la primera
        resolución de recursos (splash y primera ventana) antes de que ThemeManager aplique el tema guardado.
        La fuente autoritativa de los presets es Resources/builtin_themes.json (BuiltInThemesCatalog) y el
        generador runtime ThemeResourceApplier, que REESCRIBE estas claves al cambiar de tema.
        La paridad entre este fichero y el preset `dark_fluent` está cubierta por ThemeTokenCompletenessTests.
    -->

    <!-- Superficies -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="BgDarkBrush" Color="#0D1117" />
    <SolidColorBrush x:Key="BgEditorBrush" Color="#10131B" />
    <SolidColorBrush x:Key="BgCardBrush" Color="#161B22" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="#131720" />
    <SolidColorBrush x:Key="BgHeaderBrush" Color="#1A1F29" />
    <SolidColorBrush x:Key="BgHoverBrush" Color="#21262D" />
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#E6131720" />

    <!-- Acentos y estados -->
    <SolidColorBrush x:Key="AccentPrimaryBrush" Color="#6366F1" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4F46E5" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#818CF8" />
    <SolidColorBrush x:Key="AccentSuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="AccentWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="AccentErrorBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="AccentCyanBrush" Color="#06B6D4" />
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="#A855F7" />

    <!-- Caras atenuadas de los acentos (estado deshabilitado de las variantes de acento): el acento mezclado
         con la superficie del tema al 45 %. Las deriva ThemeResourceApplier; aquí van los valores del preset
         por defecto, que un test compara byte a byte con lo que genera. Una clave por línea: el test de paridad
         lee una sola clave por línea y dos pinceles juntos dejarían el segundo sin registrar. -->
    <SolidColorBrush x:Key="AccentPrimaryMutedBrush" Color="#373B7E" />
    <SolidColorBrush x:Key="AccentSuccessMutedBrush" Color="#12604C" />
    <SolidColorBrush x:Key="AccentWarningMutedBrush" Color="#795417" />
    <SolidColorBrush x:Key="AccentErrorMutedBrush" Color="#762B30" />
    <SolidColorBrush x:Key="AccentPurpleMutedBrush" Color="#563381" />

    <!-- Textos -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F6FC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8B949E" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7C8698" />
    <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />

    <!-- Bordes y rejilla -->
    <SolidColorBrush x:Key="BorderDarkBrush" Color="#30363D" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#21262D" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#1A202C" />

    <!-- Barras de desplazamiento -->
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#384152" />
    <SolidColorBrush x:Key="ScrollbarThumbHoverBrush" Color="#4F5B73" />

    <!-- Cable de conexión (gradiente por defecto) -->
    <LinearGradientBrush x:Key="ConnectionWireBrush" StartPoint="0%,0%" EndPoint="100%,0%">
        <GradientStop Color="#818CF8" Offset="0.0" />
        <GradientStop Color="#6366F1" Offset="0.5" />
        <GradientStop Color="#C084FC" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Tipografía y forma -->
    <FontFamily x:Key="AppFontFamily">Segoe UI Variable Text, Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, sans-serif</FontFamily>
    <FontFamily x:Key="CodeFontFamily">Cascadia Code, Consolas, monospace</FontFamily>
    <x:Double x:Key="AppFontSize">12</x:Double>
    <CornerRadius x:Key="AppCornerRadius">6</CornerRadius>

    <!-- Escala de radios (derivada del radio base del tema por ThemeResourceApplier) -->
    <CornerRadius x:Key="RadiusXs">4</CornerRadius>
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">10</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="RadiusXxl">14</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- Escala tipográfica (derivada del tamaño de fuente base del tema) -->
    <x:Double x:Key="FontSizeMicro">10</x:Double>
    <x:Double x:Key="FontSizeCaption">11</x:Double>
    <x:Double x:Key="FontSizeBodySm">12</x:Double>
    <x:Double x:Key="FontSizeBody">13</x:Double>
    <x:Double x:Key="FontSizeSubtitle">15</x:Double>
    <x:Double x:Key="FontSizeTitle">17</x:Double>
    <x:Double x:Key="FontSizeDisplay">20</x:Double>

    <!-- Escala de espaciado (derivada de SpacingUnit = 4) -->
    <x:Double x:Key="Space1">2</x:Double>
    <x:Double x:Key="Space2">4</x:Double>
    <x:Double x:Key="Space3">6</x:Double>
    <x:Double x:Key="Space4">8</x:Double>
    <x:Double x:Key="Space5">12</x:Double>
    <x:Double x:Key="Space6">16</x:Double>
    <x:Double x:Key="Space7">20</x:Double>
    <x:Double x:Key="Space8">24</x:Double>
    <x:Double x:Key="Space9">32</x:Double>
    <Thickness x:Key="Pad1">2</Thickness>
    <Thickness x:Key="Pad2">4</Thickness>
    <Thickness x:Key="Pad3">6</Thickness>
    <Thickness x:Key="Pad4">8</Thickness>
    <Thickness x:Key="Pad5">12</Thickness>
    <Thickness x:Key="Pad6">16</Thickness>
    <Thickness x:Key="Pad7">20</Thickness>
    <Thickness x:Key="Pad8">24</Thickness>
    <Thickness x:Key="Pad9">32</Thickness>

    <!-- Escala de elevación (derivada de NodeShadowBlur = 24 y NodeShadowOpacity = 0.55) -->
    <BoxShadows x:Key="Elev1">0 1 8.4 0 #3F000000</BoxShadows>
    <BoxShadows x:Key="Elev2">0 2 12 0 #62000000</BoxShadows>
    <BoxShadows x:Key="Elev3">0 4 18 0 #8C000000</BoxShadows>
    <BoxShadows x:Key="Elev4">0 8 24 0 #8C000000</BoxShadows>
    <BoxShadows x:Key="ElevPanelLeft">8.4 0 32.4 0 #70000000</BoxShadows>
    <BoxShadows x:Key="ElevGlowAccent">0 0 10.08 0 #996366F1</BoxShadows>
    <BoxShadows x:Key="ElevGlowSuccess">0 0 14.88 0 #E010B981</BoxShadows>
    <BoxShadows x:Key="ElevGlowError">0 0 13.92 0 #D9EF4444</BoxShadows>

    <!-- Velos de capas modales (independientes de la paleta) -->
    <SolidColorBrush x:Key="ScrimBrush" Color="#66000000" />
    <SolidColorBrush x:Key="ScrimStrongBrush" Color="#99000000" />

    <!-- Tintes de microsuperficies (derivados de TextSecondary = #8B949E) -->
    <SolidColorBrush x:Key="ChipBrush" Color="#188B949E" />
    <SolidColorBrush x:Key="ChipStrongBrush" Color="#208B949E" />
    <SolidColorBrush x:Key="TintFaintBrush" Color="#088B949E" />
</ResourceDictionary>
