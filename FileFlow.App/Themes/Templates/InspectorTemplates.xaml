<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sdk="clr-namespace:FileFlow.Sdk;assembly=FileFlow.Sdk"
                    xmlns:conv="clr-namespace:FileFlow.App.Converters"
                    xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk">

    <conv:InputOutputBulletConverter x:Key="InputOutputBulletConverter" />
    <conv:InputOutputBrushConverter x:Key="InputOutputBrushConverter" />

    <!-- Snapshot Item DataTemplate (Outputs & Inputs) -->
    <DataTemplate x:Key="SnapshotExpanderTemplate" DataType="{x:Type sdk:NodeDataSnapshot}">
        <Border Background="{DynamicResource BgCardBrush}" 
                BorderBrush="{DynamicResource BorderDarkBrush}" 
                BorderThickness="1" 
                CornerRadius="6">
            <Expander IsExpanded="False" Padding="8,6">
                <Expander.Header>
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Header Row 1: Port + Timestamp -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding IsInput, Converter={StaticResource InputOutputBulletConverter}}" FontSize="11" />
                            <TextBlock Text="{Binding PortName}" FontWeight="Bold" 
                                       Foreground="{Binding IsInput, Converter={StaticResource InputOutputBrushConverter}}" FontSize="12" />
                            <TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Timestamp, StringFormat='HH:mm:ss.fff'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        </StackPanel>
                        <!-- Header Row 2: Current Path -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding ItemSnapshot.CurrentPath}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                   FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding ItemSnapshot.CurrentPath}" />

                        <!-- Botón Previsualizar Snapshot específico -->
                        <Button Grid.RowSpan="2" Grid.Column="1"
                                Command="{Binding DataContext.PreviewSpecificSnapshotCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                Style="{StaticResource SecondaryButton}"
                                Padding="8,4" Margin="8,0,4,0" VerticalAlignment="Center"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Preview_InspectFileToolTip], FallbackValue='Previsualizar este archivo'}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁️" FontSize="11" Foreground="#00E5FF" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Preview_InspectFileBtn], FallbackValue='Ver'}" FontSize="10.5" FontWeight="SemiBold" Foreground="#00E5FF" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Expander.Header>
                <!-- Expandable Content: Full Metadata, Paths & Tags -->
                <Border Background="{DynamicResource BgSurfaceBrush}" 
                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                        BorderThickness="0,1,0,0" 
                        Padding="10,8" 
                        Margin="-4,6,-4,-4">
                    <StackPanel>
                        <!-- Original Path -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_OriginalPath], FallbackValue='Ruta Original:'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding ItemSnapshot.OriginalPath, Mode=OneWay}" 
                                 IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,6" />

                        <!-- File Size & IsDirectory -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_SizeLabel], FallbackValue='Tamaño: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ItemSnapshot.FileSizeBytes}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_BytesLabel], FallbackValue=' bytes'}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_Folder], FallbackValue='Carpeta: '}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding ItemSnapshot.IsDirectory}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Metadata Dictionary -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_AssociatedMetadata], FallbackValue='Metadatos Asociados:'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,4" />
                        <ItemsControl ItemsSource="{Binding ItemSnapshot.Metadata}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" Margin="0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="90" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Key}" FontWeight="Bold" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="10.5" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Tags -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Inspector_Tags], FallbackValue='Etiquetas (Tags):'}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,3" />
                        <ItemsControl ItemsSource="{Binding ItemSnapshot.Tags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource AccentHoverBrush}" CornerRadius="8" Padding="6,2" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding}" FontSize="10" Foreground="#FFFFFF" FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Expander>
        </Border>
    </DataTemplate>

</ResourceDictionary>
