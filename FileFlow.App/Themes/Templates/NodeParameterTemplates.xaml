<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:nodify="https://miroiu.github.io/nodify"
                    xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
                    xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk">

    <!-- Node Parameter Row DataTemplate -->
    <DataTemplate x:Key="NodeParameterItemTemplate" DataType="{x:Type vm:NodeParameterViewModel}">
        <Grid Margin="0,3" Visibility="{Binding IsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Standard Node Parameter Row -->
            <Grid Visibility="{Binding IsVariableInjectorNode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="ParamKey" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" MinWidth="75" VerticalAlignment="Center" Margin="0,0,8,0" />

                <!-- Dropdown ComboBox for parameters with options -->
                <Grid Grid.Column="1" Visibility="{Binding HasOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="False"
                              Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                              BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="4,2"
                              HorizontalAlignment="Stretch" />

                    <Button Grid.Column="1"
                            Command="{Binding OpenMediaPresetManagerCommand}"
                            Visibility="{Binding IsMediaPreset, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="⚙️ Presets"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="5,2"
                            Margin="4,0,0,0"
                            FontSize="9.5"
                            Cursor="Hand"
                            ToolTip="Abrir el Gestor de Presets (Crear, Editar, Eliminar Presets)" />
                </Grid>

                <!-- Slider for Numeric Range Parameters (e.g. Quality) -->
                <Grid Grid.Column="1" 
                      Visibility="{Binding IsSlider, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="38" />
                    </Grid.ColumnDefinitions>

                    <Slider Grid.Column="0"
                            Value="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="{Binding SliderMin}"
                            Maximum="{Binding SliderMax}"
                            SmallChange="{Binding SliderStep}"
                            LargeChange="10"
                            IsSnapToTickEnabled="True"
                            TickFrequency="{Binding SliderStep}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                    <TextBox Grid.Column="1"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="2,1"
                             TextAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <!-- CheckBox for Boolean parameters -->
                <CheckBox Grid.Column="1"
                          IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Visibility="{Binding IsBooleanAndNoOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                          VerticalAlignment="Center" Margin="2,0,0,0" />

                <!-- Path Selector Input -->
                <Grid Grid.Column="1" 
                      Visibility="{Binding HasBrowseButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" 
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="5,3"
                             HorizontalAlignment="Stretch">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4,0,0,4" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" 
                            Command="{Binding BrowsePathCommand}" 
                            Content="📁" 
                            Background="{DynamicResource AccentPrimaryBrush}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="6,2" 
                            FontSize="10" 
                            Cursor="Hand"
                            ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BrowseExplorerToolTip]}">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" 
                            Command="{Binding OpenVariablePickerCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                            Content="{}{x}" 
                            Background="{DynamicResource BgHoverBrush}" 
                            Foreground="{DynamicResource AccentGlowBrush}" 
                            BorderThickness="0" 
                            Padding="5,2" 
                            FontSize="10" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            ToolTip="Insertar variable dinámicamente ({x})">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,4,4,0" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- TextBox for standard text/numeric parameters -->
                <Grid Grid.Column="1"
                      Visibility="{Binding IsStandardInput, Converter={StaticResource BooleanToVisibilityConverter}}"
                      HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="5,3"
                             HorizontalAlignment="Stretch">
                        <TextBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4,0,0,4" />
                            </Style>
                        </TextBox.Resources>
                    </TextBox>

                    <Button Grid.Column="1" 
                            Command="{Binding OpenPasswordManagerCommand}"
                            Visibility="{Binding IsPasswordList, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Content="🔑 Claves" 
                            Background="{DynamicResource AccentPrimaryBrush}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Padding="6,2" 
                            FontSize="10" 
                            Cursor="Hand"
                            ToolTip="Gestionar lista de contraseñas (Importar / Exportar / Editar)">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0" />
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Grid.Column="2" 
                            Command="{Binding OpenVariablePickerCommand}"
                            CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                            Content="{}{x}" 
                            Background="{DynamicResource BgHoverBrush}" 
                            Foreground="{DynamicResource AccentGlowBrush}" 
                            BorderThickness="0" 
                            Padding="5,2" 
                            FontSize="10" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            ToolTip="Insertar variable dinámicamente ({x})">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="0,4,4,0" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>

            <!-- Dynamic Variable Row for VariableInjectorNode -->
            <Grid Visibility="{Binding IsVariableInjectorNode, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Variable Key / Name TextBox -->
                <TextBox Grid.Column="0"
                         Text="{Binding Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource AccentPrimaryBrush}" 
                         BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="4,3"
                         Margin="0,0,4,0" FontWeight="SemiBold"
                         ToolTip="Nombre de la variable">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Variable Value / Expression TextBox -->
                <TextBox Grid.Column="1"
                         Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                         BorderBrush="{DynamicResource BorderDarkBrush}" FontSize="10" Padding="4,3"
                         HorizontalAlignment="Stretch">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>

                <!-- Insert Variable [{x}] Picker Button -->
                <Button Grid.Column="2" 
                        Command="{Binding OpenVariablePickerCommand}"
                        CommandParameter="{Binding RelativeSource={RelativeSource Self}}"
                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=nodify:NodifyEditor}}"
                        Content="{}{x}" 
                        Background="{DynamicResource BgHoverBrush}" 
                        Foreground="{DynamicResource AccentGlowBrush}" 
                        BorderThickness="0" 
                        Padding="5,2" 
                        FontSize="10" 
                        FontWeight="Bold" 
                        Cursor="Hand"
                        ToolTip="Insertar variable ({x})">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0" />
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Delete Variable Trash Button -->
                <Button Grid.Column="3"
                        Command="{Binding NodeOwner.RemoveParameterCommand}"
                        CommandParameter="{Binding}"
                        Content="🗑"
                        Background="{DynamicResource BgHoverBrush}" Foreground="{DynamicResource AccentErrorBrush}" 
                        BorderThickness="0" Padding="6,2" FontSize="10" Cursor="Hand"
                        ToolTip="Eliminar variable">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="0,4,4,0" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
