<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
                    xmlns:vm="using:FileFlow.App.ViewModels"
                    xmlns:models="using:FileFlow.App.Models"
                    xmlns:loc="using:FileFlow.Sdk.Localization">

    <!-- Blender / ComfyUI Node Parameter Row DataTemplate -->
    <DataTemplate x:Key="NodeParameterItemTemplate" DataType="vm:NodeParameterViewModel">
        <Grid Margin="0,2" IsVisible="{Binding IsVisible}">
            <!-- Standard Single-Line Node Parameter Row -->
            <Grid IsVisible="{Binding IsStandardRow}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Key}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="Medium" 
                           MinWidth="75" VerticalAlignment="Center" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />

                <!-- 1. ToggleSwitch for Boolean parameters -->
                <ToggleSwitch Grid.Column="1"
                              IsChecked="{Binding ValueAsBool, Mode=TwoWay}"
                              IsVisible="{Binding IsBooleanAndNoOptions}"
                              OnContent="" OffContent=""
                              HorizontalAlignment="Right"
                              VerticalAlignment="Center"
                              Margin="0,-2" />

                <!-- 2. Slider with Value Badge for Range parameters -->
                <Grid Grid.Column="1" 
                      IsVisible="{Binding IsSlider}"
                      HorizontalAlignment="Stretch"
                      ColumnDefinitions="*,Auto"
                      VerticalAlignment="Center">
                    <Slider Grid.Column="0"
                            Value="{Binding SliderValue, Mode=TwoWay}"
                            Minimum="{Binding SliderMin}"
                            Maximum="{Binding SliderMax}"
                            SmallChange="{Binding SliderStep}"
                            LargeChange="10"
                            IsSnapToTickEnabled="True"
                            TickFrequency="{Binding SliderStep}"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0" />

                    <Border Grid.Column="1"
                            Background="{DynamicResource BgSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusXs}"
                            Padding="5,1.5"
                            MinWidth="32"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding SliderDisplayValue}"
                                   FontSize="{DynamicResource FontSizeMicro}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   HorizontalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- 3. NumericUpDown for Numeric parameters -->
                <NumericUpDown Grid.Column="1"
                               Value="{Binding SliderValue, Mode=TwoWay}"
                               Minimum="{Binding SliderMin}"
                               Maximum="{Binding SliderMax}"
                               Increment="{Binding SliderStep}"
                               FormatString="0"
                               IsVisible="{Binding IsNumber}"
                               Background="{DynamicResource BgSurfaceBrush}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               BorderBrush="{DynamicResource BorderDarkBrush}"
                               BorderThickness="1"
                               FontSize="{DynamicResource FontSizeMicro}"
                               Padding="4,2"
                               CornerRadius="{DynamicResource RadiusXs}"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Center" />

                <!-- 4. Dropdown ComboBox for parameters with options -->
                <Grid Grid.Column="1" IsVisible="{Binding IsDropdown}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Standard non-editable ComboBox -->
                    <ComboBox Grid.Column="0"
                              ItemsSource="{Binding Options}"
                              SelectedItem="{Binding Value, Mode=TwoWay}"
                              IsVisible="{Binding !IsEditableDropdown}"
                              Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                              BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" FontSize="{DynamicResource FontSizeMicro}" Padding="6,3"
                              CornerRadius="{DynamicResource RadiusXs}"
                              HorizontalAlignment="Stretch"
                              MaxDropDownHeight="240" />

                    <!-- Editable Dropdown -->
                    <Grid Grid.Column="0" IsVisible="{Binding IsEditableDropdown}" HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
                        <AutoCompleteBox Grid.Column="0"
                                         ItemsSource="{Binding Options}"
                                         Text="{Binding Value, Mode=TwoWay}"
                                         MinimumPrefixLength="0"
                                         FilterMode="None"
                                         Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                                         BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" FontSize="{DynamicResource FontSizeMicro}" Padding="6,3"
                                         CornerRadius="{DynamicResource RadiusXs}"
                                         HorizontalAlignment="Stretch"
                                         MaxDropDownHeight="240" />
                        <Button Grid.Column="1" 
                                Command="{Binding OpenVariablePickerCommand}"
                                CommandParameter="{Binding $self}"
                                Content="{}{x}" 
                                Background="{DynamicResource BgHoverBrush}" 
                                Foreground="{DynamicResource AccentGlowBrush}" 
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1" 
                                Padding="6,3" 
                                FontSize="{DynamicResource FontSizeMicro}" 
                                FontWeight="Bold" 
                                Cursor="Hand"
                                CornerRadius="{DynamicResource RadiusXs}"
                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_InsertVariableToolTip]}" />
                    </Grid>

                    <Button Grid.Column="1"
                            Command="{Binding OpenMediaPresetManagerCommand}"
                            IsVisible="{Binding IsMediaPreset}"
                            Content="Presets"
                            Background="{DynamicResource AccentPrimaryBrush}"
                            Foreground="{DynamicResource TextOnAccentBrush}"
                            BorderThickness="0"
                            Padding="6,3"
                            Margin="4,0,0,0"
                            FontSize="{DynamicResource FontSizeMicro}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            CornerRadius="{DynamicResource RadiusXs}"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_OpenPresetManager]}" />
                </Grid>

                <!-- 5. Path Selector Input (with integrated folder icon button) -->
                <Grid Grid.Column="1" 
                      IsVisible="{Binding HasBrowseButton}"
                      HorizontalAlignment="Stretch"
                      ColumnDefinitions="*,Auto,Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding Value, Mode=TwoWay}" 
                             Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" FontSize="{DynamicResource FontSizeMicro}" Padding="6,3"
                             HorizontalAlignment="Stretch" CornerRadius="4,0,0,4" />

                    <Button Grid.Column="1" 
                            Command="{Binding BrowsePathCommand}" 
                            Background="{DynamicResource AccentPrimaryBrush}" 
                            Foreground="{DynamicResource TextOnAccentBrush}" 
                            BorderThickness="0" 
                            Padding="6,3" 
                            Cursor="Hand"
                            CornerRadius="0"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[BrowseExplorerToolTip]}">
                        <materialIcons:MaterialIcon Kind="FolderOpen" Width="12" Height="12" Foreground="{DynamicResource TextOnAccentBrush}" />
                    </Button>

                    <Button Grid.Column="2" 
                            Command="{Binding OpenVariablePickerCommand}"
                            CommandParameter="{Binding $self}"
                            Content="{}{x}" 
                            Background="{DynamicResource BgHoverBrush}" 
                            Foreground="{DynamicResource AccentGlowBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,1,1,1" 
                            Padding="6,3" 
                            FontSize="{DynamicResource FontSizeMicro}" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            CornerRadius="0,4,4,0"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_InsertVariableToolTip]}" />
                </Grid>

                <!-- 6. File Version Selector (Interactive Chips) -->
                <Grid Grid.Column="1" IsVisible="{Binding IsFileVersionSelector}" HorizontalAlignment="Stretch" ColumnDefinitions="*,Auto">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AvailableVersionOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:FileVersionOption">
                                    <Button Command="{Binding $parent[ItemsControl].((vm:NodeParameterViewModel)DataContext).SelectVersionOptionCommand}"
                                            CommandParameter="{Binding}"
                                            Padding="5,2"
                                            Background="{DynamicResource BgSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusXs}"
                                            Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="10" Height="10" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Tag}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Button Grid.Column="1" 
                            Command="{Binding OpenVariablePickerCommand}"
                            CommandParameter="{Binding $self}"
                            Content="{}{x}" 
                            Background="{DynamicResource BgHoverBrush}" 
                            Foreground="{DynamicResource AccentGlowBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" 
                            Padding="5,2" 
                            Margin="4,0,0,0"
                            FontSize="{DynamicResource FontSizeMicro}" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            CornerRadius="{DynamicResource RadiusXs}"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_InsertVariableToolTip]}" />
                </Grid>

                <!-- 7. TextBox for standard text parameters -->
                <Grid Grid.Column="1"
                      IsVisible="{Binding IsStandardInput}"
                      HorizontalAlignment="Stretch"
                      ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Grid.Column="0" 
                             Text="{Binding Value, Mode=TwoWay}" 
                             Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                             BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" FontSize="{DynamicResource FontSizeMicro}" Padding="6,3"
                             HorizontalAlignment="Stretch" CornerRadius="4,0,0,4" />

                    <Button Grid.Column="1" 
                            Command="{Binding OpenPasswordManagerCommand}"
                            IsVisible="{Binding IsPasswordList}"
                            Content="Claves" 
                            Background="{DynamicResource AccentPrimaryBrush}" 
                            Foreground="{DynamicResource TextOnAccentBrush}" 
                            BorderThickness="0" 
                            Padding="6,3" 
                            FontSize="{DynamicResource FontSizeMicro}" 
                            FontWeight="SemiBold" 
                            Cursor="Hand"
                            CornerRadius="0"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_OpenPasswordManager]}" />

                    <Button Grid.Column="2" 
                            Command="{Binding OpenTextEditorCommand}"
                            CommandParameter="{Binding $self}"
                            Background="{DynamicResource BgHoverBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,1,1,1" 
                            Padding="6,3" 
                            Cursor="Hand"
                            CornerRadius="0"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_ExpandToolTip]}">
                        <materialIcons:MaterialIcon Kind="ArrowExpandAll" Width="10" Height="10" Foreground="{DynamicResource AccentCyanBrush}" />
                    </Button>

                    <Button Grid.Column="3" 
                            Command="{Binding OpenVariablePickerCommand}"
                            CommandParameter="{Binding $self}"
                            Content="{}{x}" 
                            Background="{DynamicResource BgHoverBrush}" 
                            Foreground="{DynamicResource AccentGlowBrush}" 
                            BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="0,1,1,1" 
                            Padding="6,3" 
                            FontSize="{DynamicResource FontSizeMicro}" 
                            FontWeight="Bold" 
                            Cursor="Hand"
                            CornerRadius="0,4,4,0"
                            ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_InsertVariableToolTip]}" />
                </Grid>
            </Grid>

            <!-- Multi-line / Rich parameter row (Only shown when IsMultilineRow is TRUE) -->
            <Grid IsVisible="{Binding IsMultilineRow}" RowDefinitions="Auto,Auto" Margin="0,3">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip.Tip="{Binding Key}" 
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="Medium" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                        <Button Command="{Binding OpenVariablePickerCommand}"
                                CommandParameter="{Binding $self}"
                                Content="{}{x}" 
                                Background="{DynamicResource BgHoverBrush}" 
                                Foreground="{DynamicResource AccentGlowBrush}" 
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1" 
                                Padding="5,2" 
                                FontSize="{DynamicResource FontSizeMicro}" 
                                FontWeight="Bold" 
                                Cursor="Hand"
                                CornerRadius="{DynamicResource RadiusXs}"
                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Node_Param_InsertVariableToolTip]}" />
                        <Button Command="{Binding OpenTextEditorCommand}"
                                CommandParameter="{Binding $self}"
                                Background="{DynamicResource BgHoverBrush}" 
                                BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1" 
                                Padding="5,2" 
                                Cursor="Hand"
                                CornerRadius="{DynamicResource RadiusXs}"
                                ToolTip.Tip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[TextEditor_ExpandToolTip]}">
                            <materialIcons:MaterialIcon Kind="ArrowExpandAll" Width="10" Height="10" Foreground="{DynamicResource AccentCyanBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
                <TextBox Grid.Row="1"
                         Text="{Binding Value, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="50" MaxHeight="120"
                         Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" 
                         BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" FontSize="{DynamicResource FontSizeMicro}" Padding="6,4"
                         CornerRadius="{DynamicResource RadiusXs}" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
