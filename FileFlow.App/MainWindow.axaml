<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:views="clr-namespace:FileFlow.App.Views"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        x:Class="FileFlow.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
        Height="850" Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding ControlBar.ContinueWorkflowCommand}" />
        <KeyBinding Gesture="F10" Command="{Binding ControlBar.StepNextCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding ControlBar.StopWorkflowCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding ControlBar.SaveWorkflowCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding ControlBar.LoadWorkflowCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ControlBar.NewWorkflowCommand}" />
        <KeyBinding Gesture="Ctrl+Z" Command="{Binding Editor.UndoCommand}" />
        <KeyBinding Gesture="Ctrl+Y" Command="{Binding Editor.RedoCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+Z" Command="{Binding Editor.RedoCommand}" />
        <KeyBinding Gesture="Ctrl+C" Command="{Binding Editor.CopySelectedNodesCommand}" />
        <KeyBinding Gesture="Ctrl+V" Command="{Binding Editor.PasteNodesCommand}" />
        <KeyBinding Gesture="Ctrl+X" Command="{Binding Editor.CutSelectedNodesCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding Editor.DuplicateSelectedNodesCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding Editor.DeleteSelectedNodesCommand}" />
        <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding Editor.ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+Add" Command="{Binding Editor.ZoomInCommand}" />
        <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding Editor.ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding Editor.ZoomOutCommand}" />
        <KeyBinding Gesture="Ctrl+D0" Command="{Binding Editor.FitToScreenCommand}" />
        <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding Editor.FitToScreenCommand}" />
    </Window.KeyBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="200" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="200" MinHeight="60" MaxHeight="550" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Control Bar -->
        <views:ControlBarView Grid.Row="0" DataContext="{Binding ControlBar}" />

        <!-- Main Workspace (Toolbox + Resizer + Canvas Editor + Resizer + Inspector Panel) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" MaxWidth="480" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{Binding NodeInspector.IsOpen, Converter={StaticResource BooleanToGridLengthConverter}, ConverterParameter=360}" MinWidth="0" MaxWidth="750" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Node Toolbox -->
            <views:NodeToolboxView Grid.Column="0" DataContext="{Binding Toolbox}" />

            <!-- Vertical Resizer Bar for Toolbox -->
            <GridSplitter Grid.Column="1" 
                          Width="5" 
                          Background="{DynamicResource BgSurfaceBrush}" 
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast" />

            <!-- Main Canvas Editor -->
            <views:EditorView Grid.Column="2" DataContext="{Binding Editor}" />

            <!-- Vertical Resizer Bar for Inspector Panel -->
            <GridSplitter Grid.Column="3" 
                          Width="5" 
                          Background="{DynamicResource BgSurfaceBrush}" 
                          ResizeDirection="Columns"
                          Cursor="SizeWestEast"
                          IsVisible="{Binding NodeInspector.IsOpen}" />

            <!-- Right Panel: Node Data Inspector (Collapsible & Auto-Sizing) -->
            <views:NodeInspectorPanelView Grid.Column="4" 
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Stretch"
                                          DataContext="{Binding NodeInspector}"
                                          IsVisible="{Binding IsOpen}" />
        </Grid>

        <!-- Horizontal Resizer Bar for Bottom Execution Log Console -->
        <GridSplitter Grid.Row="2" 
                      Height="5" 
                      Background="{DynamicResource BgSurfaceBrush}" 
                      ResizeDirection="Rows"
                      Cursor="SizeNorthSouth" />

        <!-- Bottom Realtime Execution Console -->
        <views:LogView Grid.Row="3" DataContext="{Binding LogConsole}" />

        <!-- Bottom Interactive Status Bar -->
        <views:StatusBarView Grid.Row="4" DataContext="{Binding StatusBar}" />

        <!-- Semi-Transparent Backdrop Overlay for Side Navigation Drawer -->
        <Border Grid.RowSpan="5"
                ZIndex="99"
                Background="{DynamicResource ScrimBrush}"
                IsVisible="{Binding ControlBar.IsMenuOpen}"
                PointerPressed="DrawerBackdrop_PointerPressed" />

        <!-- Modern Side Navigation Drawer Panel (Supports Theme DynamicResources) -->
        <Border Grid.RowSpan="5"
                ZIndex="100"
                HorizontalAlignment="Left"
                Width="320"
                Background="{DynamicResource BgSurfaceBrush}"
                BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="0,0,1,0"
                BoxShadow="{DynamicResource ElevPanelLeft}"
                IsVisible="{Binding ControlBar.IsMenuOpen}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drawer Header -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="18,16">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="{DynamicResource RadiusMd}" Width="34" Height="34" Margin="0,0,12,0">
                                <materialIcons:MaterialIcon HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFF"  Kind="Flash" Width="18" Height="18" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FileFlow Studio" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_AppSubtitle]}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </StackPanel>
                        </StackPanel>

                        <Button Command="{Binding ControlBar.ToggleMenuCommand}" 
                                HorizontalAlignment="Right" 
                                VerticalAlignment="Center"
                                Padding="8,4"
                                Width="30" Height="30">
                            <materialIcons:MaterialIcon Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"  Kind="Close" Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Drawer Content Actions -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14">
                        <!-- Section: Flow Management -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_FlowManagement]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <Button Command="{Binding ControlBar.NewWorkflowCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="FileDocument" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_NewWorkflow]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.LoadWorkflowCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="FolderOpen" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_LoadWorkflow]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.SaveWorkflowCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="ContentSaveOutline" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_SaveWorkflow]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Theme & Language Customization -->
                        <Separator Margin="4,12,4,12" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_AppearanceLanguage]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <!-- Theme Selector in Drawer -->
                        <Grid Margin="4,6,4,8">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_ThemeLabel]}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox ItemsSource="{Binding ControlBar.AvailableThemes}"
                                      SelectedValue="{Binding ControlBar.SelectedTheme, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Id}"
                                      DisplayMemberBinding="{Binding Name}"
                                      HorizontalAlignment="Right"
                                      Width="175"
                                      Padding="6,4" />
                        </Grid>

                        <!-- Language Selector in Drawer -->
                        <Grid Margin="4,4,4,8">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_LanguageLabel]}" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <ComboBox SelectedValue="{Binding ControlBar.SelectedLanguage, Mode=TwoWay}"
                                      SelectedValueBinding="{Binding Tag, RelativeSource={RelativeSource Self}}"
                                      HorizontalAlignment="Right"
                                      Width="140">
                                <ComboBoxItem Tag="es-ES">Español</ComboBoxItem>
                                <ComboBoxItem Tag="en-US">English</ComboBoxItem>
                            </ComboBox>
                        </Grid>

                        <!-- Theme Studio Button in Drawer -->
                        <Button Command="{Binding ControlBar.OpenThemeCustomizerCommand}" HorizontalAlignment="Stretch" Margin="0,2,0,4">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="Palette" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_CustomizeTheme]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Panels & Tools -->
                        <Separator Margin="4,12,4,12" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_PanelsTools]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <Button Command="{Binding ControlBar.ToggleInspectorCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="Magnify" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_DataInspector]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.OpenMetricsDashboardCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="ChartBar" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_MetricsDashboard], FallbackValue='Métricas y Rendimiento'}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.OpenVirtualFileSystemExplorerCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="FolderOpen" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VfsExplorer_HeaderTitle], FallbackValue='Explorador Virtual (VFS)'}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.OpenWorkflowSettingsCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="Cog" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_Settings]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <!-- Section: Help & Resources -->
                        <Separator Margin="4,12,4,12" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_HelpResources]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,0,8" />

                        <Button Command="{Binding ControlBar.OpenUserManualCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="BookOpen" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_UserManual]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.OpenExamplesFolderCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0"  Kind="Lightbulb" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_ExampleFlows]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>

                        <Button Command="{Binding ControlBar.OpenAboutDialogCommand}" HorizontalAlignment="Stretch" Margin="0,2">
                            <StackPanel Orientation="Horizontal">
                                <materialIcons:MaterialIcon Margin="0,0,12,0" Kind="InformationOutline" Width="16" Height="16" />
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Drawer_About]}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- Drawer Footer -->
                <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{Binding AppVersionDisplay}" FontSize="{DynamicResource FontSizeBodySm}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="© RGLara" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
