<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FileFlow.App.Views"
        xmlns:vm="clr-namespace:FileFlow.App.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        x:Class="FileFlow.App.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AppTitle]}"
        Height="850" Width="1340"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <views:MainView />
</Window>
