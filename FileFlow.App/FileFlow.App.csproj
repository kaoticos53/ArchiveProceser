<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\FileFlow.ico</ApplicationIcon>
    <!-- Reduce carpetas de idioma satelite (cs/de/fr/it/ja/ko/pl/pt-BR/ru/tr/zh-Hans/zh-Hant) generadas por WPF/.NET -->
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileFlow.Sdk\FileFlow.Sdk.csproj" />
    <ProjectReference Include="..\FileFlow.Core\FileFlow.Core.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.FileSystem\FileFlow.Plugin.FileSystem.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Archives\FileFlow.Plugin.Archives.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Images\FileFlow.Plugin.Images.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Logic\FileFlow.Plugin.Logic.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Hashing\FileFlow.Plugin.Hashing.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Integrations\FileFlow.Plugin.Integrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Nodify" Version="3.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build;Publish">
    <PropertyGroup>
      <PluginsTargetFolder>$(TargetDir)Plugins\</PluginsTargetFolder>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsTargetFolder)" />
    <ItemGroup>
      <PluginFiles Include="..\FileFlow.Plugin.FileSystem\bin\$(Configuration)\net9.0-windows\FileFlow.Plugin.FileSystem.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Archives\bin\$(Configuration)\net9.0-windows\FileFlow.Plugin.Archives.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Integrations\bin\$(Configuration)\net9.0-windows\FileFlow.Plugin.Integrations.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Images\bin\$(Configuration)\net9.0\FileFlow.Plugin.Images.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Logic\bin\$(Configuration)\net9.0\FileFlow.Plugin.Logic.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Hashing\bin\$(Configuration)\net9.0\FileFlow.Plugin.Hashing.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginsTargetFolder)" SkipUnchangedFiles="false" />
  </Target>
</Project>

