<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\assets\FileFlow.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1903;NU1902</WarningsNotAsErrors>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileFlow.Sdk\FileFlow.Sdk.csproj" />
    <ProjectReference Include="..\FileFlow.Core\FileFlow.Core.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.FileSystem\FileFlow.Plugin.FileSystem.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Archives\FileFlow.Plugin.Archives.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Images\FileFlow.Plugin.Images.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Logic\FileFlow.Plugin.Logic.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Hashing\FileFlow.Plugin.Hashing.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Integrations\FileFlow.Plugin.Integrations.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Scripting\FileFlow.Plugin.Scripting.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Documents\FileFlow.Plugin.Documents.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Network\FileFlow.Plugin.Network.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Data\FileFlow.Plugin.Data.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.AI\FileFlow.Plugin.AI.csproj" />
    <ProjectReference Include="..\FileFlow.Plugin.Subflows\FileFlow.Plugin.Subflows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- Iconografía vectorial multiplataforma (Material Design Icons). Sustituye a los emojis,
         que dependen de fuentes del sistema y no se renderizan igual en Windows/Linux/macOS. -->
    <PackageReference Include="Material.Icons.Avalonia" Version="3.0.2" />
    <PackageReference Include="Nodify.Avalonia" Version="2.0.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.2" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\builtin_themes.json" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build;Publish">
    <PropertyGroup>
      <PluginsTargetFolder>$(TargetDir)Plugins\</PluginsTargetFolder>
    </PropertyGroup>
    <MakeDir Directories="$(PluginsTargetFolder)" />
    <ItemGroup>
      <PluginFiles Include="..\FileFlow.Plugin.FileSystem\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.FileSystem.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Archives\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Archives.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Integrations\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Integrations.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Scripting\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Scripting.*" />
      <PluginFiles Include="..\FileFlow.Plugin.AI\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.AI.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Documents\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Documents.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Network\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Network.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Data\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Data.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Images\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Images.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Logic\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Logic.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Hashing\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Hashing.*" />
      <PluginFiles Include="..\FileFlow.Plugin.Subflows\bin\$(Configuration)\$(TargetFramework)\FileFlow.Plugin.Subflows.*" />
    </ItemGroup>
    <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(PluginsTargetFolder)" SkipUnchangedFiles="false" />
  </Target>
</Project>

