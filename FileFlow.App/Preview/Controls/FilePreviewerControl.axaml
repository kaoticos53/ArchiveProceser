<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
             Design.DesignHeight="600" Design.DesignWidth="900"
             x:Class="FileFlow.App.Preview.Controls.FilePreviewerControl"
             Background="{DynamicResource BgEditorBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="300" MinWidth="220" MaxWidth="500" />
        </Grid.ColumnDefinitions>

        <!-- Área Central de Visualización -->
        <Grid Grid.Column="0" Background="{DynamicResource BgSurfaceBrush}">
            <ContentControl Content="{Binding ActiveVisualElement}" />

            <!-- Indicador de Carga -->
            <Border Background="{DynamicResource ScrimStrongBrush}" IsVisible="{Binding IsLoading}"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                    <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeBodySm}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Divisor de Columna con GridSplitter -->
        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                      Background="{DynamicResource BorderDarkBrush}" ResizeDirection="Columns" />

        <!-- Panel Lateral de Metadatos y Trazabilidad -->
        <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1,0,0,0">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- Cabecera del Panel Lateral -->
                <Border Grid.Row="0" Background="{DynamicResource BgHeaderBrush}" Padding="14,10" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Preview_MetadataTitle], FallbackValue='Metadatos e Información'}" 
                               Foreground="{DynamicResource AccentCyanBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBodySm}" />
                </Border>

                <!-- Lista de Metadatos -->
                <ScrollViewer Grid.Row="1" Padding="10">
                    <ItemsControl ItemsSource="{Binding MetadataItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Margin="0,0,0,6" Padding="8,6">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeMicro}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Value}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Botones de Acción Rápida -->
                <Border Grid.Row="2" Background="{DynamicResource BgHeaderBrush}" Padding="10" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Preview_CopyPath], FallbackValue='Copiar Ruta'}" 
                                Command="{Binding CopyPathToClipboardCommand}" Padding="10,5" FontSize="{DynamicResource FontSizeCaption}" />
                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Preview_OpenExplorer], FallbackValue='Explorador'}" 
                                Command="{Binding OpenInExplorerCommand}" Padding="10,5" Background="{DynamicResource AccentCyanBrush}" Foreground="#0B0D14" FontWeight="Bold" FontSize="{DynamicResource FontSizeCaption}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
