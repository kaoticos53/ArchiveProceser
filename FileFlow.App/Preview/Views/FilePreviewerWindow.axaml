<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:controls="clr-namespace:FileFlow.App.Preview.Controls"
        xmlns:views="clr-namespace:FileFlow.App.Preview.Views"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="Vista Previa de Archivo — FileFlow Studio" 
        Height="700" Width="1050" MinWidth="600" MinHeight="450"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        x:Class="FileFlow.App.Preview.Views.FilePreviewerWindow">

    <Window.Resources>
        <views:AddOneConverter x:Key="AddOneConverter" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barra Superior Flotante Compacta -->
        <Border Grid.Row="0" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="14,0">
            <Grid>
                <!-- Navegación Anterior / Siguiente -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Content="{materialIcons:MaterialIconExt Kind=ChevronLeft}" Command="{Binding NavigatePreviousCommand}" IsEnabled="{Binding CanNavigatePrevious}"
                            Width="30" Height="28" Margin="0,0,4,0" Cursor="Hand" />
                    <Button Content="{materialIcons:MaterialIconExt Kind=Play}" Command="{Binding NavigateNextCommand}" IsEnabled="{Binding CanNavigateNext}"
                            Width="30" Height="28" Margin="0,0,12,0" Cursor="Hand" />
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBodySm}" Text="{Binding CurrentIndex, Converter={StaticResource AddOneConverter}}" />
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBodySm}" Text=" de " />
                        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource FontSizeBodySm}" Text="{Binding TotalItemsCount}" />
                    </StackPanel>
                </StackPanel>

                <!-- Título Central -->
                <TextBlock Text="{Binding CurrentContext.FileName}" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="500" />

                <!-- Botón de Cerrar -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cerrar" Click="CloseButton_Click" Padding="12,4" Background="{DynamicResource BgHeaderBrush}" Foreground="{DynamicResource TextPrimaryBrush}" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenedor del Previewer Control -->
        <controls:FilePreviewerControl Grid.Row="1" />
    </Grid>
</Window>
