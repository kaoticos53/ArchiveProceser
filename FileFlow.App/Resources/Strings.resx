  <data name="SwitchCaseNode_Desc" xml:space="preserve"><value>Evaluates a file property or extension and dynamically routes it to output ports based on configurable pattern lists.</value></data>

  <data name="ExpressionFilterNode_Name" xml:space="preserve"><value>Conditional Filter</value></data>
  <data name="ExpressionFilterNode_Desc" xml:space="preserve"><value>Evaluates numeric or text conditions on file properties and branches flow to True or False ports.</value></data>

