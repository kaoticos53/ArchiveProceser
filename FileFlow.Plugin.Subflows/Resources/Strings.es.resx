  <data name="SubflowNode_Name" xml:space="preserve"><value>Subflujo Reutilizable</value></data>
  <data name="SubflowNode_Desc" xml:space="preserve"><value>Encapsula un subgrafo DAG completo en un único nodo modular reutilizable con puertos dinámicos mapeados a sus entradas y salidas internas.</value></data>
