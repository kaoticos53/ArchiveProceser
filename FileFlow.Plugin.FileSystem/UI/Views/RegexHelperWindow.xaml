<Window x:Class="FileFlow.Plugin.FileSystem.UI.Views.RegexHelperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.Plugin.FileSystem.UI.ViewModels"
        xmlns:sdk="clr-namespace:FileFlow.Sdk.Renaming;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:RegexHelperViewModel}"
        Title="FileFlow - Asistente y Probador de Expresiones Regulares"
        Height="720" Width="1020" MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚡ Asistente y Probador de Expresiones Regulares (Regex)" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Background="{DynamicResource AccentPrimaryBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Live Tester &amp; Presets" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Prueba tus expresiones en vivo con nombres de muestra, inspecciona grupos de captura y carga patrones comunes listos para usar."
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Content: Library (Left) + Tester (Right) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Pattern Library & Presets -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📚 Biblioteca de Patrones:" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

                    <TabControl Grid.Row="1" Background="Transparent" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <!-- Tab 1: Predefinidos -->
                        <TabItem Header="Predefinidos">
                            <ListBox ItemsSource="{Binding BuiltInPatterns}" SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type sdk:RegexPatternItem}">
                                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Border Background="{DynamicResource BorderDarkBrush}" CornerRadius="4" Padding="4,1" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Category}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Pattern}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="2" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="32" TextTrimming="CharacterEllipsis" Width="240" HorizontalAlignment="Left" />
                                                    <Button Command="{Binding DataContext.ApplyLibraryPatternCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource SecondaryButton}" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <TextBlock Text="▶ Probar" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <!-- Tab 2: Mis Patrones Guardados -->
                        <TabItem Header="Mis Patrones">
                            <ListBox ItemsSource="{Binding UserPatterns}" SelectedItem="{Binding SelectedLibraryItem, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0" Margin="0,6,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type sdk:RegexPatternItem}">
                                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,2">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <Button Command="{Binding DataContext.DeleteUserPatternCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0" Padding="4,0" HorizontalAlignment="Right" ToolTip="Eliminar patrón">
                                                        <TextBlock Text="🗑️" FontSize="10" />
                                                    </Button>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Pattern}" FontFamily="Cascadia Code, Consolas, monospace" FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                                                <Grid Grid.Row="2">
                                                    <TextBlock Text="{Binding Description}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="28" Width="240" HorizontalAlignment="Left" />
                                                    <Button Command="{Binding DataContext.ApplyLibraryPatternCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{DynamicResource SecondaryButton}" Padding="6,2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                        <TextBlock Text="▶ Probar" FontSize="10" FontWeight="SemiBold" />
                                                    </Button>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                    </TabControl>

                    <!-- Save Current Pattern Section -->
                    <Border Grid.Row="2" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="💾 Guardar Patrón Actual en Favoritos:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewPatternName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"
                                         Padding="6,3" FontSize="11" ToolTip="Nombre del patrón" />
                                <TextBox Grid.Column="1" Text="{Binding NewPatternCategory, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"
                                         Padding="6,3" FontSize="11" ToolTip="Categoría" />
                            </Grid>
                            <TextBox Text="{Binding NewPatternDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4"
                                     Padding="6,3" FontSize="11" ToolTip="Descripción o notas de uso" />
                            <Button Command="{Binding SaveCurrentPatternCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,4" HorizontalAlignment="Right">
                                <TextBlock Text="💾 Guardar en Mis Patrones" FontSize="10.5" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT: Live Regex Tester & Group Inspector -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 1. Regex Pattern Input -->
                        <TextBlock Text="Expresión Regular (Regex):" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="13" FontWeight="SemiBold"
                                 Padding="8,6" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource AccentPrimaryBrush}"
                                 BorderBrush="{DynamicResource BorderDarkBrush}" />

                        <!-- Validation Status Message -->
                        <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,4,0,8">
                            <TextBlock Text="{Binding RegexErrorMessage}" FontSize="11"
                                       Foreground="{Binding IsValidRegex, Converter={x:Null}}" FontWeight="SemiBold" />
                        </Border>

                        <!-- Flags Bar -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <CheckBox Content="Ignorar Mayúsculas/Minúsculas (IgnoreCase)" IsChecked="{Binding IgnoreCase}" Margin="0,0,16,4" />
                            <CheckBox Content="Multilínea (Multiline)" IsChecked="{Binding Multiline}" Margin="0,0,16,4" />
                            <CheckBox Content="Punto coincide con todo (Singleline)" IsChecked="{Binding Singleline}" Margin="0,0,16,4" />
                            <CheckBox Content="Ignorar Espacios (IgnoreWhitespace)" IsChecked="{Binding IgnorePatternWhitespace}" Margin="0,0,16,4" />
                        </WrapPanel>

                        <!-- 2. Replacement Pattern -->
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="Patrón de Reemplazo (Opcional):" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="Grupos de captura: $1, $2, ${nombre}, $&amp; (coincidencia completa)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <TextBox Text="{Binding Replacement, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="12"
                                 Padding="8,5" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Margin="0,0,0,8" />

                        <!-- 3. Test Input -->
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="Texto / Nombres de Archivo de Prueba:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button Command="{Binding LoadSampleInputCommand}" Style="{DynamicResource SecondaryButton}" Padding="6,2" HorizontalAlignment="Right">
                                <TextBlock Text="📋 Cargar Muestras Típicas" FontSize="10" />
                            </Button>
                        </Grid>
                        <TextBox Text="{Binding TestInput, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5"
                                 Padding="8,5" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Margin="0,0,0,8" />

                        <!-- 4. Matches & Capture Groups Breakdown -->
                        <Grid Margin="0,4,0,4">
                            <TextBlock Text="Coincidencias y Grupos de Captura:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding MatchCount, StringFormat='Total Coincidencias: {0}'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                        <ListBox ItemsSource="{Binding Matches}" MaxHeight="120" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Margin="0,0,0,8">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RegexMatchItemViewModel}">
                                    <Border Padding="4,2" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="0,0,0,1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Value, StringFormat='Match {0}: &quot;{1}&quot;'}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            <ItemsControl ItemsSource="{Binding Groups}" Margin="12,2,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RegexGroupItemViewModel}">
                                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}">
                                                            <Run Text="{Binding Token, Mode=OneWay}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <Run Text=" (" />
                                                            <Run Text="{Binding GroupName, Mode=OneWay}" />
                                                            <Run Text="): &quot;" />
                                                            <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" Foreground="#10B981" />
                                                            <Run Text="&quot;" />
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- 5. Replacement Preview Result -->
                        <TextBlock Text="Vista Previa tras Reemplazo:" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,4" />
                        <TextBox Text="{Binding ReplacementResult, Mode=OneWay}"
                                 IsReadOnly="True" AcceptsReturn="True" Height="80" VerticalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5" Foreground="#10B981"
                                 Padding="8,5" Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 3. Footer: Action Buttons -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Padding="16,6" Margin="0,0,8,0">
                    <TextBlock Text="Cancelar" FontSize="12" />
                </Button>
                <Button Click="Apply_Click" Style="{DynamicResource PrimaryButton}" Padding="18,6">
                    <TextBlock Text="✓ Aplicar al Campo" FontSize="12" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
