<Window x:Class="FileFlow.Plugin.FileSystem.UI.Views.AdvancedRenamerEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.Plugin.FileSystem.UI.ViewModels"
        xmlns:models="clr-namespace:FileFlow.Plugin.FileSystem.UI.Models"
        xmlns:sdk="clr-namespace:FileFlow.Sdk.Renaming;assembly=FileFlow.Sdk"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        xmlns:conv="clr-namespace:FileFlow.Plugin.FileSystem.UI.Converters"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_WindowTitle]}"
        Height="800" Width="1100"
        MinHeight="620" MinWidth="880"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <conv:InverseNullToVisibilityConverter x:Key="InverseNullToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Header & Presets -->
            <RowDefinition Height="Auto" />
            <!-- 1. Main Content: Step List (Left) + Step Config (Right) -->
            <RowDefinition Height="3*" MinHeight="180" />
            <!-- 2. Horizontal Splitter for Live Preview Resizing -->
            <RowDefinition Height="8" />
            <!-- 3. Live Preview Table -->
            <RowDefinition Height="2*" MinHeight="120" />
            <!-- 4. Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. Header & Presets Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Pipeline Name, Title & Description -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏷️" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding PipelineName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}"
                                 CaretBrush="{DynamicResource AccentPrimaryBrush}"
                                 Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                 Padding="8,3" MinWidth="220" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_NameToolTip], FallbackValue='Nombre descriptivo de este pipeline de renombrado'}" />
                        <Border Background="{DynamicResource AccentSuccessBrush}" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_MethodsBadge]}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_HeaderSubtitle]}"
                               FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <!-- Right: Preset Selector & Import/Export -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_PresetLabel]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    
                    <ComboBox Width="180" ItemsSource="{Binding AvailablePresets}" DisplayMemberPath="Name" 
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              SelectionChanged="PresetComboBox_SelectionChanged"
                              Padding="8,5" Margin="0,0,6,0" />

                    <Button Command="{Binding SaveCurrentAsPresetCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,5" Margin="0,0,4,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_SavePresetToolTip], FallbackValue='Guardar pipeline actual como preset'}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_SaveBtn]}" FontSize="11" />
                    </Button>

                    <Button Command="{Binding LoadPresetFromFileCommand}" Style="{DynamicResource SecondaryButton}" Padding="8,5" Margin="0,0,10,0" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_OpenPresetToolTip], FallbackValue='Cargar archivo .ffren o .json'}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_OpenBtn]}" FontSize="11" />
                    </Button>

                    <Border Width="1" Background="{DynamicResource BorderDarkBrush}" Margin="0,2,10,2" />

                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_CollisionLabel]}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox Width="130" ItemsSource="{Binding CollisionStrategies}" SelectedItem="{Binding CollisionStrategy, Mode=TwoWay}"
                              Padding="8,5" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Body: Steps List (Left) + Step Config Form (Right) -->
        <Grid Grid.Row="1" Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- Left: Pipeline Steps List -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Steps Header & Add Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_MethodsPipeline]}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        
                        <Menu Grid.Column="1" Background="Transparent">
                            <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_AddMethod]}" Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF" Padding="8,4" FontWeight="SemiBold" FontSize="11">
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Template]}" Click="AddMethod_NewName_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Replace]}" Click="AddMethod_SearchReplace_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Insert]}" Click="AddMethod_Insert_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Remove]}" Click="AddMethod_Remove_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Case]}" Click="AddMethod_Case_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Numbering]}" Click="AddMethod_Numbering_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_ListReplace]}" Click="AddMethod_ReplaceList_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_Clean]}" Click="AddMethod_TrimClean_Click" />
                                <MenuItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Tab_PadNumbers]}" Click="AddMethod_NormalizeNumbers_Click" />
                            </MenuItem>
                        </Menu>
                    </Grid>

                    <!-- Steps ListBox -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding Steps}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}"
                             SelectionChanged="StepsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type sdk:RenameMethodStep}">
                                <Border Padding="6,4" Margin="0,1" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" 
                                                  Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed"
                                                  VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MethodType}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </StackPanel>

                                        <Border Grid.Column="2" Background="{DynamicResource BgHeaderBrush}" CornerRadius="4" Padding="4,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ApplyTo}" FontSize="9.5" Foreground="{DynamicResource AccentCyanBrush}" FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Step Order Tools (Up/Down/Delete) -->
                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Command="{Binding MoveStepUpCommand}" CommandParameter="{Binding SelectedStep}" Style="{DynamicResource SecondaryButton}" Padding="4,4" Margin="0,0,3,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Btn_MoveUp]}" FontSize="11" />
                        </Button>
                        <Button Grid.Column="1" Command="{Binding MoveStepDownCommand}" CommandParameter="{Binding SelectedStep}" Style="{DynamicResource SecondaryButton}" Padding="4,4" Margin="3,0,3,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Btn_MoveDown]}" FontSize="11" />
                        </Button>
                        <Button Grid.Column="2" Command="{Binding RemoveStepCommand}" CommandParameter="{Binding SelectedStep}" Style="{DynamicResource SecondaryButton}" Padding="4,4" Margin="3,0,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Renamer_Btn_Delete]}" FontSize="11" Foreground="{DynamicResource AccentErrorBrush}" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Vertical Splitter between Steps List and Configurator -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- Right: Dynamic Step Configurator -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <!-- Empty State: No step selected -->
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_EmptyStateStep], FallbackValue='Selecciona o añade un método del panel izquierdo para configurar sus propiedades.'}"
                               Visibility="{Binding SelectedStep, Converter={StaticResource InverseNullToVisibilityConverter}}"
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" />

                    <!-- Form Content: When a step is selected -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding SelectedStep, Converter={StaticResource NullToVisibilityConverter}}">
                        <StackPanel x:Name="StepFormContainer">
                            
                            <!-- Step Common Settings: Name & ApplyTo -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Nombre del Paso:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding SelectedStep.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             TextChanged="FormInput_Changed"
                                             Padding="8,5" FontSize="12" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Aplicar a:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ApplyToTargets}" SelectedItem="{Binding SelectedStep.ApplyTo, Mode=TwoWay}"
                                              SelectionChanged="FormCombo_Changed"
                                              Padding="8,5" />
                                </StackPanel>
                            </Grid>

                            <Separator Margin="0,0,0,12" />

                            <!-- 1. METHOD: NewName Form -->
                            <StackPanel x:Name="PanelNewName" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Plantilla de Nuevo Nombre:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtNewNamePattern}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,3">
                                        <TextBlock Text="🏷️ Insertar Variable / Tag..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    </Button>
                                </Grid>
                                <TextBox x:Name="TxtNewNamePattern" Text="{Binding SelectedStep.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="FormInput_Changed"
                                         Padding="8,6" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>

                            <!-- 2. METHOD: SearchReplace Form -->
                            <StackPanel x:Name="PanelSearchReplace" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Texto / Patrón a Buscar:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Click="OpenRegexHelper_SearchReplace_Click" Style="{DynamicResource SecondaryButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="Abrir asistente interactivo y biblioteca de expresiones regulares">
                                                    <TextBlock Text="🪄 Asistente Regex..." FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                                </Button>
                                                <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtSearchPattern}" Style="{DynamicResource SecondaryButton}" Padding="6,2">
                                                    <TextBlock Text="🏷️ Variable" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBox x:Name="TxtSearchPattern" Text="{Binding SelectedStep.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Reemplazar Con:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtReplacePattern}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="6,2">
                                                <TextBlock Text="🏷️ Variable" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBox x:Name="TxtReplacePattern" Text="{Binding SelectedStep.ReplaceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                 TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" />
                                    </StackPanel>
                                </Grid>
                                <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <CheckBox Content="Expresión Regular (Regex)" IsChecked="{Binding SelectedStep.UseRegex, Mode=TwoWay}" Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed" Margin="0,0,16,0" />
                                    <CheckBox Content="Sensible a Mayúsculas/Minúsculas" IsChecked="{Binding SelectedStep.CaseSensitive, Mode=TwoWay}" Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed" Margin="0,0,16,0" />
                                    <CheckBox Content="Reemplazar Todas las Coincidencias" IsChecked="{Binding SelectedStep.ReplaceAll, Mode=TwoWay}" Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- 3. METHOD: Insert Form -->
                            <StackPanel x:Name="PanelInsert" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Texto o Plantilla a Insertar:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtInsertPattern}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="8,3">
                                        <TextBlock Text="🏷️ Insertar Variable / Tag..." FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                    </Button>
                                </Grid>
                                <TextBox x:Name="TxtInsertPattern" Text="{Binding SelectedStep.Pattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="FormInput_Changed"
                                         Padding="8,5" FontSize="12" Margin="0,0,0,8" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Posición de Inserción:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedStep.Position, Mode=TwoWay}" SelectionChanged="FormCombo_Changed"
                                                  Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Índice (0-based):" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.PositionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 4. METHOD: Remove Form -->
                            <StackPanel x:Name="PanelRemove" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="120" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Desde la Posición:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding Positions}" SelectedItem="{Binding SelectedStep.Position, Mode=TwoWay}" SelectionChanged="FormCombo_Changed"
                                                  Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                        <TextBlock Text="Índice:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.PositionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Nº Caracteres:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.CharacterCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,4,0,4">
                                    <TextBlock Text="O eliminar coincidencia de texto / variable:" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtRemovePattern}" Style="{DynamicResource SecondaryButton}" Padding="6,2">
                                            <TextBlock Text="🏷️ Variable" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="TxtRemovePattern" Text="{Binding SelectedStep.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                         TextChanged="FormInput_Changed"
                                         Padding="8,5" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>

                            <!-- 5. METHOD: CaseConversion Form -->
                            <StackPanel x:Name="PanelCaseConversion" Margin="0,0,0,12">
                                <TextBlock Text="Tipo de Transformación de Mayúsculas:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding CaseTypes}" SelectedItem="{Binding SelectedStep.CaseType, Mode=TwoWay}" SelectionChanged="FormCombo_Changed"
                                          Padding="8,5" />
                            </StackPanel>

                            <!-- 6. METHOD: Numbering Form -->
                            <StackPanel x:Name="PanelNumbering" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Número Inicial:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.StartNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="3,0,3,0">
                                        <TextBlock Text="Incremento:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.Increment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                        <TextBlock Text="Relleno de Ceros (Padding):" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.PaddingZeroes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Reiniciar Secuencia En:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding ResetConditions}" SelectedItem="{Binding SelectedStep.ResetOn, Mode=TwoWay}" SelectionChanged="FormCombo_Changed"
                                                  Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Clave de Metadato / Grupo:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtResetMetadataKey}" Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Right" Padding="6,2">
                                                <TextBlock Text="🏷️ Variable" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                            </Button>
                                        </Grid>
                                        <TextBox x:Name="TxtResetMetadataKey" Text="{Binding SelectedStep.ResetMetadataKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <!-- 7. METHOD: ReplaceList Form -->
                            <StackPanel x:Name="PanelReplaceList" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock Text="Tabla de Términos a Sustituir:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding AddReplaceListEntryCommand}" Style="{DynamicResource SecondaryButton}" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="➕ Añadir Fila" FontSize="10.5" />
                                        </Button>
                                        <Button Click="OpenVariablesMenu_Click" Tag="ReplaceList" Style="{DynamicResource SecondaryButton}" Padding="6,2">
                                            <TextBlock Text="🏷️ Insertar Variable..." FontSize="10.5" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <DataGrid x:Name="GridReplaceList" ItemsSource="{Binding SelectedStep.ReplaceList}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          MaxHeight="140">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Buscar Texto (o Variable)" Binding="{Binding Find, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                        <DataGridTextColumn Header="Reemplazar Con (o Variable)" Binding="{Binding ReplaceWith, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <!-- 8. METHOD: TrimClean Form -->
                            <StackPanel x:Name="PanelTrimClean" Margin="0,0,0,12">
                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <CheckBox Content="Recortar Espacios en Extremos (Trim)" IsChecked="{Binding SelectedStep.TrimWhitespace, Mode=TwoWay}" Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed" Margin="0,0,16,6" />
                                    <CheckBox Content="Colapsar Espacios Consecutivos" IsChecked="{Binding SelectedStep.CollapseSpaces, Mode=TwoWay}" Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed" Margin="0,0,16,6" />
                                    <CheckBox Content="Sanitizar Caracteres Inválidos de SO" IsChecked="{Binding SelectedStep.SanitizeInvalidChars, Mode=TwoWay}" Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed" Margin="0,0,16,6" />
                                </WrapPanel>
                                <TextBlock Text="Normalización Unicode:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding NormalizationModes}" SelectedItem="{Binding SelectedStep.NormalizationMode, Mode=TwoWay}" SelectionChanged="FormCombo_Changed"
                                          Padding="8,5" />
                            </StackPanel>

                            <!-- 9. METHOD: NormalizeNumbers Form -->
                            <StackPanel x:Name="PanelNormalizeNumbers" Margin="0,0,0,12">
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="140" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Objetivo de Normalización:" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <ComboBox ItemsSource="{Binding NumberPaddingTargets}" SelectedItem="{Binding SelectedStep.NumberTarget, Mode=TwoWay}" SelectionChanged="FormCombo_Changed"
                                                  Padding="8,5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Dígitos Mínimos (Padding):" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding SelectedStep.NumberPaddingDigits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                                 Padding="8,5" FontSize="12" ToolTip="Ejemplo: 2 convierte '1' en '01'; 3 convierte '1' en '001'" />
                                    </StackPanel>
                                </Grid>

                                <CheckBox Content="Rellenar también número de Temporada en formato 'NxN' (ej. 01x02)"
                                          IsChecked="{Binding SelectedStep.PadSeasonAndEpisode, Mode=TwoWay}"
                                          Checked="StepCheckbox_Changed" Unchecked="StepCheckbox_Changed"
                                          Margin="0,0,0,8" />

                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Patrón Regex Personalizado (Opcional):" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Click="OpenRegexHelper_NormalizeNumbers_Click" Style="{DynamicResource SecondaryButton}" Padding="6,2" Margin="0,0,4,0" ToolTip="Abrir asistente interactivo de expresiones regulares">
                                            <TextBlock Text="🪄 Asistente Regex..." FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" FontWeight="SemiBold" />
                                        </Button>
                                        <Button Click="OpenVariablesMenu_Click" Tag="{Binding ElementName=TxtNumberRegexPattern}" Style="{DynamicResource SecondaryButton}" Padding="6,2">
                                            <TextBlock Text="🏷️ Variable" FontSize="10" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox x:Name="TxtNumberRegexPattern" Text="{Binding SelectedStep.NumberRegexPattern, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="FormInput_Changed"
                                         Padding="8,5" FontSize="12" FontFamily="Cascadia Code, Consolas, monospace" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Horizontal Splitter for Live Preview Resizing -->
        <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Cursor="SizeNS" Margin="0,2" />

        <!-- 3. Bottom Panel: Live Preview Table -->
        <Border Grid.Row="3" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_LivePreviewTitle]}" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PreviewSourceDescription}" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewItems}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_ColOriginalName]}" Binding="{Binding OriginalName}" Width="280" />
                        <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_ColResultName]}" Binding="{Binding ResultName}" Width="*" />
                        <DataGridTextColumn Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_ColStatus]}" Binding="{Binding StatusMessage}" Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 4. Footer Actions Bar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_FooterHint]}" 
                       FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Click="Cancel_Click" Style="{DynamicResource SecondaryButton}" Padding="14,6" Margin="0,0,8,0">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Cancel]}" FontSize="12" />
                </Button>
                <Button Click="Save_Click" Style="{DynamicResource PrimaryButton}" Padding="18,6">
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AdvancedRenamer_SaveAndApply]}" FontSize="12" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
