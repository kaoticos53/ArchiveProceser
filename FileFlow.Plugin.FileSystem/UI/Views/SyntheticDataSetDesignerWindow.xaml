<Window x:Class="FileFlow.Plugin.FileSystem.UI.Views.SyntheticDataSetDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.Plugin.FileSystem.UI.ViewModels"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_WindowTitle], FallbackValue='Diseñador de Conjuntos de Datos Sintéticos'}"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Main 2-column content -->
            <RowDefinition Height="*" />
            <!-- 2. Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_HeaderTitle], FallbackValue='Diseñador de Datos Sintéticos y Árboles Jerárquicos'}"
                                   FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_HeaderDesc], FallbackValue='Crea, personaliza y guarda estructuras de directorios, metadatos y paquetes comprimidos simulados para pruebas.'}"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_SaveButton], FallbackValue='💾 Guardar Dataset'}"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Dataset Catalog (320px) -->
                <ColumnDefinition Width="330" MinWidth="260" MaxWidth="480" />
                <!-- Splitter -->
                <ColumnDefinition Width="6" />
                <!-- Right: Active Dataset Editor (*) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: DataSets Catalog -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Row="0" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                             Padding="8,5" Margin="0,0,0,8"
                             ToolTip="Buscar datasets por nombre o categoría..." />

                    <!-- Actions Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="➕ Nuevo" Command="{Binding NewDataSetCommand}"
                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                        <Button Content="📋 Duplicar" Command="{Binding DuplicateDataSetCommand}"
                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                        <Button Content="📥 Importar" Command="{Binding ImportCommand}"
                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                        <Button Content="📤 Exportar" Command="{Binding ExportCommand}"
                                Padding="8,4" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                    </StackPanel>

                    <!-- DataSets List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredDataSets}"
                             SelectedItem="{Binding SelectedDataSet, Mode=TwoWay}"
                             Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                             BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📦 " FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding TotalFiles, StringFormat='{}{0} arch.'}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Built-in Badge -->
                                        <Border Grid.Column="1" VerticalAlignment="Center"
                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}"
                                                Background="{DynamicResource AccentWarningBrush}" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="Oficial" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Delete Button -->
                    <Button Grid.Row="3" Content="🗑️ Eliminar Dataset" Command="{Binding DeleteDataSetCommand}"
                            IsEnabled="{Binding IsBuiltInSelected, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,8,0,0" Padding="8,4" Background="#3A2020" Foreground="#FF8080"
                            BorderBrush="#663333" Cursor="Hand" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- Right Panel: Editor -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0. Details metadata -->
                        <RowDefinition Height="Auto" />
                        <!-- 1. Stats Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- 2. Tabs: Table vs DSL vs JSON -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 0. Dataset Header fields -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                            <TextBlock Text="Nombre del Dataset:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DataSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="Bold" FontSize="13" Padding="6,4"
                                     Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" />
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                            <TextBlock Text="Categoría:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableCategories}"
                                      SelectedItem="{Binding DataSetCategory, Mode=TwoWay}"
                                      Padding="6,4" Background="{DynamicResource BgSurfaceBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <TextBlock Text="Descripción / Notas del Dataset:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DataSetDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11.5" Padding="6,4"
                                     Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- 1. Stats Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 Carpetas: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDirectories}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />

                            <TextBlock Text="📄 Archivos: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalFiles}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />

                            <TextBlock Text="💾 Tamaño Total Estimado: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,16,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Tabs for Edit Modes -->
                    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <!-- Tab 1: Visual Table -->
                        <TabItem Header="📊 Grilla Visual">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Table Toolbar -->
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="➕ Añadir Archivo" Command="{Binding AddFileCommand}"
                                            Padding="8,4" Margin="0,0,6,0" Background="{DynamicResource BgCardBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                                    <Button Content="📁 Añadir Carpeta" Command="{Binding AddFolderCommand}"
                                            Padding="8,4" Margin="0,0,6,0" Background="{DynamicResource BgCardBrush}"
                                            Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                                    <Button Content="🗑️ Eliminar Fila" Command="{Binding RemoveItemCommand}"
                                            Padding="8,4" Background="{DynamicResource BgCardBrush}"
                                            Foreground="#FF8080" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                                </StackPanel>

                                <!-- Items DataGrid -->
                                <DataGrid Grid.Row="1" ItemsSource="{Binding EditableItems}"
                                          SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False"
                                          Background="{DynamicResource BgDarkBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderDarkBrush}"
                                          GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                          RowHeaderWidth="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Ruta Relativa / Subcarpeta" Binding="{Binding RelativePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="3*" />
                                        <DataGridTextColumn Header="Tamaño (Bytes)" Binding="{Binding FileSizeBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="1.2*" />
                                        <DataGridCheckBoxColumn Header="¿Es Carpeta?" Binding="{Binding IsDirectory, Mode=TwoWay}" Width="1*" />
                                        <DataGridCheckBoxColumn Header="¿Es Comprimido?" Binding="{Binding IsArchive, Mode=OneWay}" Width="1.1*" IsReadOnly="True" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: Fast Tree DSL -->
                        <TabItem Header="🌳 Árbol / DSL Rápido">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" Padding="8,6" CornerRadius="4" Margin="0,0,0,6">
                                    <TextBlock Text="💡 Sintaxis rápida: Escribe carpetas terminadas en '/' e indenta archivos debajo. Añade '| size=1.5GB' o '[archive: file1.txt; file2.pdf]'. Al terminar, pulsa '⚡ Aplicar Estructura'."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>

                                <TextBox Grid.Row="1" Text="{Binding DslText, Mode=TwoWay}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Consolas, Courier New" FontSize="12"
                                         Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                         Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="⚡ Aplicar Estructura al Dataset" Command="{Binding ApplyDslToItemsCommand}"
                                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                            FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: JSON -->
                        <TabItem Header="📄 JSON Crudo">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Text="{Binding JsonText, Mode=TwoWay}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Consolas, Courier New" FontSize="11.5"
                                         Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                         Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="⚡ Aplicar JSON" Command="{Binding ApplyJsonToItemsCommand}"
                                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                            FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Bottom Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close], FallbackValue='Cerrar'}"
                    IsCancel="True" Padding="16,6"
                    Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
