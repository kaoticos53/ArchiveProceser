<Window x:Class="FileFlow.Plugin.FileSystem.UI.Views.SyntheticDataSetDesignerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.Plugin.FileSystem.UI.ViewModels"
        xmlns:converters="clr-namespace:FileFlow.Plugin.FileSystem.UI.Converters"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_WindowTitle], FallbackValue='Diseñador de Conjuntos de Datos Sintéticos'}"
        Height="780" Width="1180"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
        <converters:InverseNullToVisibilityConverter x:Key="InverseNullToVisibility" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibility" />
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Main 2-column content -->
            <RowDefinition Height="*" />
            <!-- 2. Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Top Bar -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📊" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_HeaderTitle], FallbackValue='Diseñador de Datos Sintéticos y Árboles Jerárquicos'}"
                                   FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_HeaderDesc], FallbackValue='Crea, personaliza y guarda estructuras de directorios, metadatos y paquetes comprimidos simulados para pruebas.'}"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding StatusMessage}" FontSize="11.5" Foreground="{DynamicResource AccentPrimaryBrush}" />
                    </Border>
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_SaveButton], FallbackValue='💾 Guardar Dataset'}"
                            Command="{Binding SaveCommand}"
                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Workspace -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left: Dataset Catalog (320px) -->
                <ColumnDefinition Width="330" MinWidth="260" MaxWidth="480" />
                <!-- Splitter -->
                <ColumnDefinition Width="6" />
                <!-- Right: Active Dataset Editor (*) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: DataSets Catalog -->
            <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Row="0" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentPrimaryBrush}"
                             BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                             Padding="8,5" Margin="0,0,0,8"
                             ToolTip="Buscar datasets por nombre o categoría..." />

                    <!-- Actions Toolbar -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="➕ Nuevo" Command="{Binding NewDataSetCommand}"
                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                        <Button Content="📋 Duplicar" Command="{Binding DuplicateDataSetCommand}"
                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                        <Button Content="📥 Importar" Command="{Binding ImportCommand}"
                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                        <Button Content="📤 Exportar" Command="{Binding ExportCommand}"
                                Padding="8,4" Background="{DynamicResource BgSurfaceBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                    </StackPanel>

                    <!-- DataSets List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredDataSets}"
                             SelectedItem="{Binding SelectedDataSet, Mode=TwoWay}"
                             Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                             BorderThickness="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" Margin="0,2" CornerRadius="4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="📦 " FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{DynamicResource BgDarkBrush}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </Border>
                                                <TextBlock Text="{Binding TotalFiles, StringFormat='{}{0} arch.'}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Built-in Badge -->
                                        <Border Grid.Column="1" VerticalAlignment="Center"
                                                Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}"
                                                Background="{DynamicResource AccentWarningBrush}" CornerRadius="3" Padding="4,1">
                                            <TextBlock Text="Oficial" FontSize="9" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Delete Button -->
                    <Button Grid.Row="3" Content="🗑️ Eliminar Dataset" Command="{Binding DeleteDataSetCommand}"
                            IsEnabled="{Binding IsBuiltInSelected, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,8,0,0" Padding="8,4" Background="#3A2020" Foreground="#FF8080"
                            BorderBrush="#663333" Cursor="Hand" HorizontalAlignment="Stretch" />
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

            <!-- Right Panel: Editor -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- 0. Details metadata -->
                        <RowDefinition Height="Auto" />
                        <!-- 1. Stats Bar -->
                        <RowDefinition Height="Auto" />
                        <!-- 2. Tabs: Table vs DSL vs JSON -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 0. Dataset Header fields -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Name -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,6">
                            <TextBlock Text="Nombre del Dataset:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DataSetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontWeight="Bold" FontSize="13" Padding="6,4"
                                     Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" />
                        </StackPanel>

                        <!-- Category -->
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,6">
                            <TextBlock Text="Categoría:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <ComboBox ItemsSource="{Binding AvailableCategories}"
                                      SelectedItem="{Binding DataSetCategory, Mode=TwoWay}"
                                      Padding="6,4" Background="{DynamicResource BgSurfaceBrush}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <!-- Description -->
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2">
                            <TextBlock Text="Descripción / Notas del Dataset:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                            <TextBox Text="{Binding DataSetDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="11.5" Padding="6,4"
                                     Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                     BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" />
                        </StackPanel>
                    </Grid>

                    <!-- 1. Stats Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="10,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁 Carpetas: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalDirectories}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />

                            <TextBlock Text="📄 Archivos: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalFiles}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,16,0" />

                            <TextBlock Text="💾 Tamaño Total Estimado: " FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource AccentSuccessBrush}" Margin="0,0,16,0" />
                        </StackPanel>
                    </Border>

                    <!-- 2. Tabs for Edit Modes -->
                    <TabControl Grid.Row="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                                Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}">
                        <!-- Tab 1: Hierarchical Tree Explorer -->
                        <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_TabTree], FallbackValue='🌳 Explorador de Archivos (Árbol)'}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <!-- Top Toolbar -->
                                    <RowDefinition Height="Auto" />
                                    <!-- Main Content: Tree (Left) + Inspector (Right) -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Tree Toolbar -->
                                <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" CornerRadius="6" Padding="6" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_AddFile], FallbackValue='➕ Archivo'}"
                                                Command="{Binding AddFileToTreeCommand}"
                                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand"
                                                ToolTip="Añadir un nuevo archivo en la carpeta seleccionada o en la raíz" />
                                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_AddFolder], FallbackValue='📁 Carpeta'}"
                                                Command="{Binding AddFolderToTreeCommand}"
                                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand"
                                                ToolTip="Añadir una nueva carpeta en la selección actual o en la raíz" />
                                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_AddArchive], FallbackValue='📦 Comprimido'}"
                                                Command="{Binding AddArchiveToTreeCommand}"
                                                Padding="8,4" Margin="0,0,6,0" Background="{DynamicResource BgSurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand"
                                                ToolTip="Añadir un paquete comprimido simulado (.zip) con contenido interno" />

                                        <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" Margin="2,2,8,2" />

                                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_RemoveNode], FallbackValue='🗑️ Eliminar'}"
                                                Command="{Binding RemoveTreeNodeCommand}"
                                                Padding="8,4" Margin="0,0,8,0" Background="#3A2020"
                                                Foreground="#FF8080" BorderBrush="#663333" Cursor="Hand"
                                                ToolTip="Eliminar el elemento o carpeta seleccionada con todo su contenido" />

                                        <Rectangle Width="1" Fill="{DynamicResource BorderDarkBrush}" Margin="2,2,8,2" />

                                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_ExpandAll], FallbackValue='↕️ Expandir'}"
                                                Command="{Binding ExpandAllTreeCommand}"
                                                Padding="8,4" Margin="0,0,4,0" Background="{DynamicResource BgSurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_CollapseAll], FallbackValue='↕️ Colapsar'}"
                                                Command="{Binding CollapseAllTreeCommand}"
                                                Padding="8,4" Background="{DynamicResource BgSurfaceBrush}"
                                                Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                                    </StackPanel>
                                </Border>

                                <!-- Main Tree & Inspector Split -->
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <!-- Left: Tree View (55%) -->
                                        <ColumnDefinition Width="3*" MinWidth="240" />
                                        <!-- Splitter -->
                                        <ColumnDefinition Width="6" />
                                        <!-- Right: Node Inspector (45%) -->
                                        <ColumnDefinition Width="2*" MinWidth="220" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left: Hierarchical TreeView -->
                                    <Border Grid.Column="0" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="4">
                                        <TreeView ItemsSource="{Binding RootTreeNodes}"
                                                  SelectedItemChanged="TreeView_SelectedItemChanged"
                                                  Background="Transparent" BorderThickness="0"
                                                  Foreground="{DynamicResource TextPrimaryBrush}">
                                            <TreeView.ItemContainerStyle>
                                                <Style TargetType="{x:Type TreeViewItem}">
                                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="Padding" Value="2,3" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                </Style>
                                            </TreeView.ItemContainerStyle>
                                            <TreeView.ItemTemplate>
                                                <HierarchicalDataTemplate DataType="{x:Type vm:SyntheticTreeNodeItem}" ItemsSource="{Binding Children}">
                                                    <Border CornerRadius="4" Padding="4,2" Margin="0,1" Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding IconGlyph}" FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                       FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="2" Background="{DynamicResource BgSurfaceBrush}" CornerRadius="3" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding BadgeText}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </HierarchicalDataTemplate>
                                            </TreeView.ItemTemplate>
                                        </TreeView>
                                    </Border>

                                    <!-- Splitter -->
                                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE" />

                                    <!-- Right: Node Inspector -->
                                    <Border Grid.Column="2" Background="{DynamicResource BgDarkBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="10">
                                        <Grid>
                                            <!-- Empty State Placeholder when no node is selected -->
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Visibility="{Binding SelectedTreeNode, Converter={StaticResource InverseNullToVisibility}}">
                                                <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" Opacity="0.5" />
                                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_InspectorNoSelection], FallbackValue='Selecciona un elemento en el árbol para ver sus propiedades.'}"
                                                           TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="220" />
                                            </StackPanel>

                                            <!-- Property Inspector Form when a node is selected -->
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                                          Visibility="{Binding SelectedTreeNode, Converter={StaticResource NullToVisibility}}">
                                                <StackPanel>
                                                    <!-- Header -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                        <TextBlock Text="{Binding SelectedTreeNode.IconGlyph}" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_InspectorTitle], FallbackValue='Propiedades del Elemento'}"
                                                                   FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <!-- Name Field -->
                                                    <TextBlock Text="Nombre del Archivo / Carpeta:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding SelectedTreeNode.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             FontSize="12" Padding="6,4" Background="{DynamicResource BgSurfaceBrush}"
                                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                             BorderThickness="1" Margin="0,0,0,8" />

                                                    <!-- Relative Path (ReadOnly preview) -->
                                                    <TextBlock Text="Ruta Relativa Calculada:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                    <TextBox Text="{Binding SelectedTreeNode.RelativePath, Mode=OneWay}" IsReadOnly="True"
                                                             FontSize="11" Padding="6,4" Background="{DynamicResource BgCardBrush}"
                                                             Foreground="{DynamicResource TextSecondaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                             BorderThickness="1" Margin="0,0,0,8" />

                                                    <!-- Container info if it is an internal archive entry -->
                                                    <Border Visibility="{Binding SelectedTreeNode.IsArchiveEntry, Converter={StaticResource BoolToVisibility}}"
                                                            Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                            BorderThickness="1" CornerRadius="4" Padding="8,5" Margin="0,0,0,8">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="📦 Contenido dentro de: " FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                            <TextBlock Text="{Binding SelectedTreeNode.Parent.Name}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentPrimaryBrush}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Type Checks (only for top-level filesystem items) -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                                Visibility="{Binding SelectedTreeNode.IsArchiveEntry, Converter={StaticResource InverseBooleanToVisibility}}">
                                                        <CheckBox IsChecked="{Binding SelectedTreeNode.IsDirectory, Mode=TwoWay}"
                                                                  Content="¿Es Directorio?" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                                                        <CheckBox IsChecked="{Binding SelectedTreeNode.IsArchive, Mode=TwoWay}"
                                                                  Content="¿Es Comprimido?" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    </StackPanel>

                                                    <!-- Size in Bytes (only if not directory) -->
                                                    <StackPanel Visibility="{Binding SelectedTreeNode.IsDirectory, Converter={StaticResource InverseBooleanToVisibility}, FallbackValue=Visible}" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Tamaño en Bytes:" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,3" />
                                                            <TextBlock Grid.Column="1" Text="{Binding SelectedTreeNode.SizeFormatted}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentSuccessBrush}" />
                                                        </Grid>
                                                        <TextBox Text="{Binding SelectedTreeNode.FileSizeBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="12" Padding="6,4" Background="{DynamicResource BgSurfaceBrush}"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                 BorderThickness="1" />
                                                    </StackPanel>

                                                    <!-- Archive Entries (if is archive) -->
                                                    <StackPanel Visibility="{Binding SelectedTreeNode.IsArchive, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,8">
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Contenido Interno Simulado del Paquete:" FontWeight="SemiBold" FontSize="11"
                                                                       Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                                            <Button Grid.Column="1" Content="➕ Añadir Entrada" Command="{Binding AddArchiveEntryCommand}"
                                                                    Padding="6,2" FontSize="10" Background="{DynamicResource BgCardBrush}"
                                                                    Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
                                                        </Grid>
                                                        <ItemsControl ItemsSource="{Binding SelectedTreeNode.SimulatedArchiveEntries}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                                                            BorderThickness="1" CornerRadius="4" Padding="6,4" Margin="0,2">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="{Binding InnerPath}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding FileSizeBytes, StringFormat='{}{0:N0} B'}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="6,0,6,0" VerticalAlignment="Center" />
                                                                            <Button Grid.Column="2" Content="✕"
                                                                                    Command="{Binding DataContext.RemoveArchiveEntryCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                    CommandParameter="{Binding}"
                                                                                    Padding="4,1" FontSize="9" Background="#3A2020" Foreground="#FF8080"
                                                                                    BorderThickness="0" Cursor="Hand" ToolTip="Eliminar entrada interna" />
                                                                        </Grid>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </TabItem>

                        <!-- Tab 2: Fast Tree DSL -->
                        <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_TabDsl], FallbackValue='📝 Árbol / DSL Rápido'}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource BgDarkBrush}" Padding="8,6" CornerRadius="4" Margin="0,0,0,6">
                                    <TextBlock Text="💡 Sintaxis rápida: Escribe carpetas terminadas en '/' e indenta archivos debajo. Añade '| size=1.5GB' o '[archive: file1.txt; file2.pdf]'. Al terminar, pulsa '⚡ Aplicar Estructura'."
                                               FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                </Border>

                                <TextBox Grid.Row="1" Text="{Binding DslText, Mode=TwoWay}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Consolas, Courier New" FontSize="12"
                                         Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                         Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="⚡ Aplicar Estructura al Dataset" Command="{Binding ApplyDslToItemsCommand}"
                                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                            FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </Grid>
                        </TabItem>

                        <!-- Tab 3: JSON -->
                        <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[DataSetDesigner_TabJson], FallbackValue='📄 JSON Crudo'}">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox Grid.Row="0" Text="{Binding JsonText, Mode=TwoWay}"
                                         AcceptsReturn="True" AcceptsTab="True"
                                         FontFamily="Consolas, Courier New" FontSize="11.5"
                                         Background="{DynamicResource BgDarkBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                         CaretBrush="{DynamicResource AccentPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                         Padding="8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />

                                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button Content="⚡ Aplicar JSON" Command="{Binding ApplyJsonToItemsCommand}"
                                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                            FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" />
                                </StackPanel>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- 2. Bottom Close Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close], FallbackValue='Cerrar'}"
                    IsCancel="True" Padding="16,6"
                    Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource BorderDarkBrush}" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
