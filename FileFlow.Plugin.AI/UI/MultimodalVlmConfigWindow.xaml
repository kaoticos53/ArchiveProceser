<Window x:Class="FileFlow.Plugin.AI.UI.MultimodalVlmConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileFlow.Plugin.AI.ViewModels"
        xmlns:conv="clr-namespace:FileFlow.Plugin.AI.UI.Converters"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        mc:Ignorable="d"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_WindowTitle], FallbackValue='Configuración Avanzada de IA Multimodal (VLM)'}"
        Height="720" Width="1060"
        MinHeight="580" MinWidth="860"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
        <conv:ConnectionStatusColorConverter x:Key="ConnStatusColor" />

        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                                BorderThickness="0,0,0,2" Margin="0,0,8,0" Padding="{TemplateBinding Padding}" Cursor="Hand">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource BgSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot">
                            <ToggleButton x:Name="toggleButton" 
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False" 
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                CornerRadius="6">
                                            <Path Data="M 0 0 L 4 4 L 8 0 Z" 
                                                  Fill="{DynamicResource TextSecondaryBrush}" 
                                                  HorizontalAlignment="Right" 
                                                  VerticalAlignment="Center" 
                                                  Margin="0,0,10,0" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="contentTemplate" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" 
                                              IsHitTestVisible="False" />
                            <TextBox x:Name="PART_EditableTextBox"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     Margin="8,3,28,3"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentPrimaryBrush}"
                                     BorderThickness="0"
                                     FontSize="{TemplateBinding FontSize}"
                                     FontFamily="{TemplateBinding FontFamily}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed" />
                            <Popup x:Name="PART_Popup" 
                                   AllowsTransparency="True" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   Placement="Bottom" 
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource BgCardBrush}" 
                                        BorderBrush="{DynamicResource BorderDarkBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="8" 
                                        Padding="4"
                                        Margin="0,4,0,0">
                                    <ScrollViewer MaxHeight="240">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter Property="IsTabStop" Value="False" />
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                                <Setter TargetName="contentTemplate" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Tabs Workspace -->
            <RowDefinition Height="*" />
            <!-- 2. Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header Card -->
        <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👁️" FontSize="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_HeaderTitle], FallbackValue='Configuración de IA Multimodal (Vision-Language)'}"
                                   FontWeight="Bold" FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_HeaderSubtitle], FallbackValue='Administra servidores de inferencia locales y remotos, y gestiona plantillas y directrices de análisis visual.'}"
                                   FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnSaveAll], FallbackValue='💾 Guardar Todo'}"
                            Command="{Binding SaveAllCommand}"
                            Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                            Padding="12,6" Margin="0,0,8,0" Cursor="Hand" />
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnApplyAndClose], FallbackValue='✔ Aplicar y Cerrar'}"
                            Command="{Binding ApplyAndCloseCommand}"
                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="14,6" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 1. Main Workspace TabControl -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" Background="Transparent" BorderThickness="0">
            <!-- PESTAÑA 1: PROVEEDORES DE IA -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TabProviders], FallbackValue='🔌 Proveedores de Inferencia'}" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Provider selector list -->
                        <ColumnDefinition Width="280" />
                        <!-- Right: Provider detail settings -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Lista de Proveedores -->
                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_SelectProviderLabel], FallbackValue='Proveedores Disponibles'}"
                                       FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,6,8" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{DynamicResource BgSurfaceBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding EndpointUrl}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource BgDarkBrush}"
                                                        Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="SISTEMA" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- ToolBar de Proveedores -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnNewProvider], FallbackValue='➕ Nuevo'}"
                                        Command="{Binding NewProviderCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="8,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" />
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnDuplicateProvider], FallbackValue='📋 Duplicar'}"
                                        Command="{Binding DuplicateProviderCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="8,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" />
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnDeleteProvider], FallbackValue='🗑️ Eliminar'}"
                                        Command="{Binding DeleteProviderCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="#EF4444"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="8,5" Cursor="Hand" FontSize="11.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Detalle del Proveedor Seleccionado -->
                    <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedProvider}">
                                <!-- Nombre del Proveedor y ID -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_ProviderDisplayNameLabel], FallbackValue='Nombre del Proveedor'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_ProviderIdLabel], FallbackValue='Identificador Interno (ID)'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Endpoint URL -->
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_EndpointUrlLabel], FallbackValue='Endpoint URL (Base /v1)'}" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding EndpointUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />

                                <!-- Model Name con ComboBox editable y botón de detección -->
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_ModelNameLabel], FallbackValue='Nombre del Modelo VLM (Desplegable o escribir a mano)'}" Style="{StaticResource LabelStyle}" />
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" IsEditable="True"
                                              Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding DataContext.AvailableModels, RelativeSource={RelativeSource AncestorType=Window}}"
                                              Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}"
                                              Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,5" FontSize="12.5" />
                                    <Button Grid.Column="1" Margin="8,0,0,0"
                                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnDetectModels], FallbackValue='🔄 Detectar Modelos'}"
                                            Command="{Binding DataContext.RefreshModelsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Padding="10,5" Cursor="Hand" FontSize="11.5" />
                                </Grid>

                                <!-- API Key -->
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_ApiKeyLabel], FallbackValue='API Key / Token (opcional para local)'}" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16" />

                                <Separator Background="{DynamicResource BorderDarkBrush}" Margin="0,4,0,16" />

                                <!-- Parámetros Técnicos en 2 columnas -->
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Columna 1 -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TemperatureLabel], FallbackValue='Temperatura (0.0 Precisión - 1.0 Creativo)'}" Style="{StaticResource LabelStyle}" />
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="{Binding Temperature, StringFormat='{}{0:F2}'}" DockPanel.Dock="Right" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" Width="32" />
                                            <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding Temperature}" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_MaxTokensLabel], FallbackValue='Tokens Máximos'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding MaxTokens, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />

                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_ConcurrencyLimitLabel], FallbackValue='Concurrencia Máxima (Slots Simultáneos)'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding ConcurrencyLimit, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />
                                    </StackPanel>

                                    <!-- Columna 2 -->
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_MaxImageDimensionLabel], FallbackValue='Dimensión Máxima de Imagen (px)'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding MaxImageDimension, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />

                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TimeoutSecondsLabel], FallbackValue='Timeout (segundos)'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />
                                    </StackPanel>
                                </Grid>

                                <!-- Conexión y Diagnóstico -->
                                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_DiagnosisLabel], FallbackValue='Comprobación de Conectividad'}"
                                                       FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding DataContext.ConnectionTestStatus, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       FontSize="11.5" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="Wrap"
                                                       Foreground="{Binding DataContext.ConnectionTestSuccess, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource ConnStatusColor}}" />
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnTestConnection], FallbackValue='⚡ Probar Conexión'}"
                                                Command="{Binding DataContext.TestConnectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Background="{DynamicResource BgCardBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                                Padding="12,6" Cursor="Hand" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 2: GESTOR DE PLANTILLAS -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TabTemplates], FallbackValue='📋 Gestor de Plantillas'}" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <!-- Left: Template master list -->
                        <ColumnDefinition Width="320" />
                        <!-- Right: Template detail editor -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Master List -->
                    <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TemplatesListTitle], FallbackValue='Plantillas de Tareas'}"
                                       FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="6,4,6,8" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{DynamicResource BgSurfaceBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" MaxHeight="30" />
                                                </StackPanel>
                                                <Border Grid.Column="1" CornerRadius="4" Padding="4,2" Margin="6,0,0,0" VerticalAlignment="Top"
                                                        Background="{DynamicResource BgDarkBrush}">
                                                    <TextBlock Text="{Binding IsBuiltIn, Converter={x:Null}}"
                                                               FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="USUARIO" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBuiltIn}" Value="True">
                                                                        <Setter Property="Text" Value="SISTEMA" />
                                                                        <Setter Property="Foreground" Value="#10B981" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- ToolBar de Plantillas -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0" HorizontalAlignment="Center">
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnNewTemplate], FallbackValue='➕ Nueva'}"
                                        Command="{Binding NewTemplateCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="8,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" />
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnDuplicateTemplate], FallbackValue='📋 Duplicar'}"
                                        Command="{Binding DuplicateTemplateCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="8,5" Margin="0,0,6,0" Cursor="Hand" FontSize="11.5" />
                                <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnDeleteTemplate], FallbackValue='🗑️ Eliminar'}"
                                        Command="{Binding DeleteTemplateCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="#EF4444"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="8,5" Cursor="Hand" FontSize="11.5" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Template Detail Editor -->
                    <Border Grid.Column="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel DataContext="{Binding SelectedTemplate}">
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TemplateNameLabel], FallbackValue='Nombre de la Plantilla'}" Style="{StaticResource LabelStyle}" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Margin="12,18,0,0"
                                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnRestoreBuiltIn], FallbackValue='🔄 Restaurar Fábrica'}"
                                            Command="{Binding DataContext.RestoreBuiltInCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Visibility="{Binding IsBuiltIn, Converter={StaticResource BoolToVisibility}}"
                                            Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextSecondaryBrush}"
                                            BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                            Padding="10,5" FontSize="11" Cursor="Hand" />
                                </Grid>

                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TemplateDescLabel], FallbackValue='Descripción'}" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,12" />

                                <!-- System Prompt (Expandible sin MaxHeight artificial) -->
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_SystemPromptLabel], FallbackValue='System Prompt (Rol, Esquema JSON y Directrices del Modelo)'}" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" FontFamily="Consolas, monospace" FontSize="12"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" />

                                <!-- User Prompt (Expandible sin MaxHeight artificial) -->
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_UserPromptLabel], FallbackValue='User Prompt Base (Admite variables {FileName}, {Date}, {Tag})'}" Style="{StaticResource LabelStyle}" />
                                <TextBox Text="{Binding UserPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBox}" FontFamily="Consolas, monospace" FontSize="12"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,14" />

                                <!-- Opciones de Salida -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <CheckBox Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_ForceJsonLabel], FallbackValue='Forzar salida estricta en JSON'}"
                                              IsChecked="{Binding ForceJsonOutput}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,0" VerticalAlignment="Center" />
                                    <CheckBox Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_SaveAsFileLabel], FallbackValue='Guardar salida en archivo adjunto'}"
                                              IsChecked="{Binding SaveAsNewFile}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 3: VISTA PREVIA DEL PROMPT -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TabPromptPreview], FallbackValue='🧪 Vista Previa del Prompt'}" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_AdditionalPromptTestLabel], FallbackValue='Simular Instrucciones Adicionales (Parámetro local del nodo):'}" Style="{StaticResource LabelStyle}" />
                            <TextBox Text="{Binding PreviewAdditionalPrompt, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}" AcceptsReturn="True" TextWrapping="Wrap"
                                     MinHeight="50" MaxHeight="90" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_FinalPromptResolvedLabel], FallbackValue='Prompt Ensamblado Resultante:'}"
                                       FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding PreviewFinalPrompt, Mode=OneWay}"
                                     IsReadOnly="True" Style="{StaticResource ModernTextBox}"
                                     FontFamily="Consolas, monospace" FontSize="12"
                                     Background="{DynamicResource BgSurfaceBrush}" AcceptsReturn="True" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- PESTAÑA 4: BANCO DE PRUEBAS DE 1 CICLO (DESCUBRIMIENTO DE VARIABLES) -->
            <TabItem Header="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_TabSampleTest], FallbackValue='🔬 Probar Muestra (1 Ciclo)'}" Style="{StaticResource ModernTabItem}">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Selector de archivo y botón de ejecución -->
                    <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_SampleFileLabel], FallbackValue='Archivo de Imagen o Documento de Muestra:'}" Style="{StaticResource LabelStyle}" />
                                    <TextBox Text="{Binding SampleFilePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>

                                <Button Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                        Content="📁 Explorar..." Command="{Binding SelectSampleFileCommand}"
                                        Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1"
                                        Padding="12,6" Cursor="Hand" Height="32" />

                                <Button Grid.Column="2" VerticalAlignment="Bottom" Margin="8,0,0,0"
                                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnRunSample], FallbackValue='▶ Ejecutar Prueba'}"
                                        Command="{Binding RunSampleInferenceCommand}"
                                        Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                        FontWeight="Bold" BorderThickness="0"
                                        Padding="16,6" Cursor="Hand" Height="32" />
                            </Grid>

                            <!-- Estado de ejecución / progreso -->
                            <TextBlock Grid.Row="1" Margin="0,8,0,0"
                                       Text="{Binding SampleExecutionStatus}"
                                       FontWeight="SemiBold" FontSize="12"
                                       Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Grid>
                    </Border>

                    <!-- Resultados: 2 Columnas (Salida RAW/JSON a la izquierda, Variables Descubiertas a la derecha) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="1.2*" />
                        </Grid.ColumnDefinitions>

                        <!-- Columna Izquierda: Respuesta del Modelo -->
                        <Border Grid.Column="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_SampleOutputLabel], FallbackValue='Respuesta del Modelo:'}"
                                               FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding SampleDurationMs, StringFormat='⏱ {0} ms'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SampleTokens, StringFormat='🔤 {0} tokens'}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DockPanel>

                                <TextBox Text="{Binding SampleRawResponse, Mode=OneWay}"
                                         IsReadOnly="True" Style="{StaticResource ModernTextBox}"
                                         FontFamily="Consolas, monospace" FontSize="11.5"
                                         Background="{DynamicResource BgSurfaceBrush}" AcceptsReturn="True" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- Columna Derecha: Variables Extraídas y Botón de Importación -->
                        <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="14">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_DiscoveredVarsLabel], FallbackValue='Variables Dinámicas Detectadas:'}"
                                               FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center" />
                                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnApplyVars], FallbackValue='📥 Importar al Flujo'}"
                                            Command="{Binding ApplyDiscoveredVariablesCommand}"
                                            IsEnabled="{Binding CanApplyVariables}"
                                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                                            FontWeight="SemiBold" BorderThickness="0" Padding="10,4" Cursor="Hand" />
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding SampleDiscoveredVariables}"
                                          AutoGenerateColumns="False" IsReadOnly="True"
                                          Background="Transparent" BorderThickness="1" BorderBrush="{DynamicResource BorderDarkBrush}"
                                          RowBackground="{DynamicResource BgSurfaceBrush}" AlternatingRowBackground="{DynamicResource BgCardBrush}"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderDarkBrush}"
                                          HeadersVisibility="Column" Foreground="{DynamicResource TextPrimaryBrush}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Token" Binding="{Binding Token}" Width="160" FontWeight="SemiBold" />
                                        <DataGridTextColumn Header="Valor Extraído" Binding="{Binding Value}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 2. Footer -->
        <Border Grid.Row="2" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Cancel], FallbackValue='Cancelar'}"
                            Click="CancelButton_Click"
                            Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                            BorderThickness="0" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" />
                    <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[VlmConfig_BtnApplyAndClose], FallbackValue='✔ Aplicar y Cerrar'}"
                            Command="{Binding ApplyAndCloseCommand}"
                            Background="{DynamicResource AccentPrimaryBrush}" Foreground="#FFFFFF"
                            FontWeight="SemiBold" Padding="16,7" BorderThickness="0" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
