  <!-- Node Names & Descriptions -->
  <data name="SmartImageClassifierNode_Name" xml:space="preserve"><value>Smart Image Classifier (MobileNet)</value></data>
  <data name="SmartImageClassifierNode_Desc" xml:space="preserve"><value>Analyzes the visual content of photos assigning thematic categories (Landscapes, Invoices, Vehicles, etc.) in metadata.</value></data>
  <data name="FaceDetectorNode_Name" xml:space="preserve"><value>Face Detector (AI)</value></data>
  <data name="FaceDetectorNode_Desc" xml:space="preserve"><value>Analyzes images to detect the presence and count of human faces, branching flows into family photos or objects.</value></data>
  <data name="ObjectDetectorNode_Name" xml:space="preserve"><value>Object Detector (YOLO)</value></data>
  <data name="ObjectDetectorNode_Desc" xml:space="preserve"><value>Detects and identifies multiple everyday objects (people, vehicles, pets, items) present in images.</value></data>
  <data name="PromptObjectDetectorNode_Name" xml:space="preserve"><value>Prompt-based Object Detector (Grounding DINO)</value></data>
  <data name="PromptObjectDetectorNode_Desc" xml:space="preserve"><value>Detects objects and concepts described in open natural language text prompts with automatic Spanish-English translation (MarianMT).</value></data>
  <data name="LocalWhisperTranscriberNode_Name" xml:space="preserve"><value>Speech-to-Text Transcriber (Whisper)</value></data>
  <data name="LocalWhisperTranscriberNode_Desc" xml:space="preserve"><value>Transcribes audio and video files to text and synchronized subtitles (.srt) using local Whisper AI.</value></data>
  <data name="LocalOcrNode_Name" xml:space="preserve"><value>Local Optical Character Recognition (OCR)</value></data>
  <data name="LocalOcrNode_Desc" xml:space="preserve"><value>Extracts text from images and scanned documents locally using Tesseract OCR engine.</value></data>
  <data name="LocalAiTranslatorNode_Name" xml:space="preserve"><value>Local AI Translator (NLLB-200 / MarianMT)</value></data>
  <data name="LocalAiTranslatorNode_Desc" xml:space="preserve"><value>Translates documents, subtitles, and metadata using local neural models NLLB-200 and MarianMT.</value></data>
  <data name="LocalLlmProcessorNode_Name" xml:space="preserve"><value>Local LLM Processor (Qwen 2.5 / Phi-3.5)</value></data>
  <data name="LocalLlmProcessorNode_Desc" xml:space="preserve"><value>Generates executive summaries, extracts structured data to JSON, and processes custom prompts with local in-process LLMs.</value></data>
  <data name="PromptTransformerNode_Name" xml:space="preserve"><value>Dynamic Prompt Transformer</value></data>
  <data name="PromptTransformerNode_Desc" xml:space="preserve"><value>Evaluates dynamic templates with metadata variables, translates concepts to English, and expands visual synonyms.</value></data>

