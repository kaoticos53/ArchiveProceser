  <!-- Nombres y Descripciones de Nodos -->
  <data name="SmartImageClassifierNode_Name" xml:space="preserve"><value>Clasificador Inteligente de Fotos (MobileNet)</value></data>
  <data name="SmartImageClassifierNode_Desc" xml:space="preserve"><value>Analiza el contenido visual de fotos asignando categorías temáticas (Paisajes, Facturas, Vehículos, etc.) en metadatos.</value></data>
  <data name="FaceDetectorNode_Name" xml:space="preserve"><value>Detector Facial (IA)</value></data>
  <data name="FaceDetectorNode_Desc" xml:space="preserve"><value>Analiza imágenes para detectar la presencia y cantidad de rostros humanos, bifurcando flujos en fotos familiares o de objetos.</value></data>
  <data name="ObjectDetectorNode_Name" xml:space="preserve"><value>Detector de Objetos (YOLO)</value></data>
  <data name="ObjectDetectorNode_Desc" xml:space="preserve"><value>Detecta e identifica múltiples objetos cotidianos (personas, vehículos, mascotas, artículos) presentes en imágenes.</value></data>
  <data name="PromptObjectDetectorNode_Name" xml:space="preserve"><value>Detector de Objetos por Prompt (Grounding DINO)</value></data>
  <data name="PromptObjectDetectorNode_Desc" xml:space="preserve"><value>Detecta objetos y conceptos descritos en lenguaje natural libre con traducción automática Español-Inglés usando MarianMT.</value></data>
  <data name="LocalWhisperTranscriberNode_Name" xml:space="preserve"><value>Transcriptor de Voz a Texto (Whisper)</value></data>
  <data name="LocalWhisperTranscriberNode_Desc" xml:space="preserve"><value>Transcribe archivos de audio y vídeo a texto y subtítulos sincronizados (.srt) utilizando el modelo Whisper de forma local y privada.</value></data>
  <data name="LocalOcrNode_Name" xml:space="preserve"><value>Reconocimiento Óptico de Caracteres Local (OCR)</value></data>
  <data name="LocalOcrNode_Desc" xml:space="preserve"><value>Extrae texto de imágenes y documentos escaneados localmente usando el motor Tesseract OCR.</value></data>
  <data name="LocalAiTranslatorNode_Name" xml:space="preserve"><value>Traductor Neuronal Local (NLLB-200 / MarianMT)</value></data>
  <data name="LocalAiTranslatorNode_Desc" xml:space="preserve"><value>Traduce documentos, subtítulos y metadatos con modelos neuronales locales NLLB-200 y MarianMT.</value></data>
  <data name="LocalLlmProcessorNode_Name" xml:space="preserve"><value>Procesador LLM Local (Qwen 2.5 / Phi-3.5)</value></data>
  <data name="LocalLlmProcessorNode_Desc" xml:space="preserve"><value>Genera resúmenes ejecutivos, extrae datos estructurados a JSON y procesa prompts locales con LLM in-process.</value></data>
  <data name="PromptTransformerNode_Name" xml:space="preserve"><value>Transformador Dinámico de Prompts</value></data>
  <data name="PromptTransformerNode_Desc" xml:space="preserve"><value>Evalúa plantillas dinámicas con variables de metadatos, traduce a inglés y expande sinónimos visuales.</value></data>

