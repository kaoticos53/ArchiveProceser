#!/usr/bin/env bash
# AppRun script for FileFlow Studio AppImage
set -e

HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/bin:${HERE}/usr/lib:${LD_LIBRARY_PATH}"

# Si existe un binario o script de ejecución dentro de AppDir
if [ -f "${HERE}/usr/bin/FileFlow.App" ]; then
    exec "${HERE}/usr/bin/FileFlow.App" "$@"
elif [ -f "${HERE}/usr/bin/fileflow" ]; then
    exec "${HERE}/usr/bin/fileflow" "$@"
elif [ -f "${HERE}/FileFlow.App" ]; then
    exec "${HERE}/FileFlow.App" "$@"
else
    echo "Error: No se encontró el ejecutable principal en ${HERE}" >&2
    exit 1
fi

