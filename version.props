<Project>
  <PropertyGroup>
    <!-- =================================================================== -->
    <!-- Control de Versiones SemVer 2.0 (FileFlow Studio)                  -->
    <!--                                                                     -->
    <!-- Formato: MAJOR.MINOR.PATCH[-PRERELEASE]+build.BUILDNUMBER          -->
    <!-- Ejemplo: 1.4.2-beta.1+build.101                                     -->
    <!--                                                                     -->
    <!-- Modifica estos valores manualmente cuando lances un nuevo parche,   -->
    <!-- versión menor, mayor o cambies la fase de pre-lanzamiento.         -->
    <!-- La etiqueta de compilación (+build.N) se incrementa automáticamente.-->
    <!-- =================================================================== -->
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionPatch>0</VersionPatch>
    <!-- Dejar vacío para versiones finales estables (ej. "") o indicar "beta", "beta.1", "alpha.1", "rc.1" -->
    <VersionPreRelease>beta</VersionPreRelease>
  </PropertyGroup>
</Project>
