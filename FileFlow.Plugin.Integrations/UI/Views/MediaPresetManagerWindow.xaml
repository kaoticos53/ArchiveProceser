<Window x:Class="FileFlow.Plugin.Integrations.UI.Views.MediaPresetManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileFlow.Plugin.Integrations.UI.Converters"
        xmlns:loc="clr-namespace:FileFlow.Sdk.Localization;assembly=FileFlow.Sdk"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_WindowTitle]}"
        Height="540" Width="780"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_HeaderTitle]}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentPrimaryBrush}" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_HeaderSubtitle]}" 
                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Click="ResetDefaults_Click" Style="{DynamicResource SecondaryButton}" Padding="10,4" VerticalAlignment="Center" Cursor="Hand" ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_ResetToolTip]}">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_ResetBtn]}" FontSize="11" />
            </Button>
        </Grid>

        <!-- Main Body: List + Edit Form -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Preset List & Quick Actions -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <ListBox x:Name="LstPresets" 
                             SelectionChanged="LstPresets_SelectionChanged"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🎬 " FontSize="11" Visibility="{Binding Category, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Video}" />
                                        <TextBlock Text="🎵 " FontSize="11" Visibility="{Binding Category, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Audio}" />
                                        <TextBlock Text="🎞️ " FontSize="11" Visibility="{Binding Category, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Animation}" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OutputExtension}" FontSize="10" Foreground="{DynamicResource AccentGlowBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Click="NewPreset_Click" Style="{DynamicResource PrimaryButton}" Padding="10,5" Margin="0,0,6,0" Cursor="Hand">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_NewBtn]}" FontSize="11" />
                    </Button>
                    <Button Click="DeletePreset_Click" Style="{DynamicResource SecondaryButton}" Padding="10,5" Cursor="Hand">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_DeleteBtn]}" FontSize="11" Foreground="{DynamicResource AccentErrorBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Right Column: Edit Preset Details Form -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlForm" Margin="4">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_FormTitle]}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                        <!-- Preset Name -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_PresetName]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtName" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11.5" Margin="0,0,0,10" />

                        <!-- Category & Extension -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_Category]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbCategory" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11">
                                    <ComboBoxItem Content="Audio" IsSelected="True" />
                                    <ComboBoxItem Content="Video" />
                                    <ComboBoxItem Content="Animation" />
                                    <ComboBoxItem Content="Custom" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_OutputExt]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtExtension" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11.5" Text=".mp4" />
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_Description]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtDescription" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" Height="45" VerticalScrollBarVisibility="Auto" />

                        <!-- FFmpeg CLI Arguments -->
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_FfmpegArgs]}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                        <TextBox x:Name="TxtFfmpegArgs" Background="{DynamicResource BgSurfaceBrush}" Foreground="{DynamicResource AccentGlowBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" Padding="6,4" FontSize="11" FontFamily="Consolas" Margin="0,0,0,14" TextWrapping="Wrap" Height="60" VerticalScrollBarVisibility="Auto" />

                        <Button Click="SaveCurrent_Click" Style="{DynamicResource PrimaryButton}" Padding="14,6" HorizontalAlignment="Right" Cursor="Hand">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_SavePreset]}" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Click="Close_Click" Style="{DynamicResource PrimaryButton}" Padding="16,6" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close]}" FontSize="11.5" Cursor="Hand" />
        </StackPanel>
    </Grid>
</Window>
