<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:conv="using:FileFlow.Plugin.Integrations.UI.Converters"
        xmlns:services="using:FileFlow.Plugin.Integrations.UI.Services"
        xmlns:loc="using:FileFlow.Sdk.Localization"
        xmlns:vm="using:FileFlow.Plugin.Integrations.UI.ViewModels"
        x:Class="FileFlow.Plugin.Integrations.UI.Views.MediaPresetManagerWindow"
        x:DataType="vm:MediaPresetManagerViewModel"
        Title="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_WindowTitle]}"
        Height="540" Width="780"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgSurfaceBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">

    <Window.Resources>
        <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <StackPanel Grid.Column="0">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_HeaderTitle]}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSubtitle}" Foreground="{DynamicResource AccentPrimaryBrush}" />
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_HeaderSubtitle]}" 
                           FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding ResetDefaultsCommand}" Padding="10,4" VerticalAlignment="Center">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_ResetBtn]}" FontSize="{DynamicResource FontSizeCaption}" />
            </Button>
        </Grid>

        <!-- Main Body: List + Edit Form -->
        <Grid Grid.Row="1" ColumnDefinitions="260,12,*">
            <!-- Left Column: Preset List & Quick Actions -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <Border Grid.Row="0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="6">
                    <ListBox x:Name="LstPresets" 
                             ItemsSource="{Binding Presets}"
                             SelectedItem="{Binding SelectedPreset}"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="services:MediaPreset">
                                <StackPanel Margin="4,3">
                                    <StackPanel Orientation="Horizontal">
                                        <materialIcons:MaterialIcon IsVisible="{Binding Category, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Video}"  Kind="Movie" Width="11" Height="11" />
                                        <materialIcons:MaterialIcon IsVisible="{Binding Category, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Audio}"  Kind="Music" Width="11" Height="11" />
                                        <materialIcons:MaterialIcon IsVisible="{Binding Category, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Animation}"  Kind="Movie" Width="11" Height="11" />
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding OutputExtension}" FontSize="{DynamicResource FontSizeMicro}" Foreground="{DynamicResource AccentPrimaryBrush}" Margin="0,1,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0" Spacing="6">
                    <Button Classes="primary" Command="{Binding NewPresetCommand}" Padding="10,5">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_NewBtn]}" FontSize="{DynamicResource FontSizeCaption}" />
                    </Button>
                    <Button Command="{Binding DeletePresetCommand}" Padding="10,5">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_DeleteBtn]}" FontSize="{DynamicResource FontSizeCaption}" Foreground="{DynamicResource AccentErrorBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Right Column: Edit Preset Details Form -->
            <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderDarkBrush}" BorderThickness="1" CornerRadius="{DynamicResource RadiusMd}" Padding="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PnlForm" Margin="4" Spacing="10" IsEnabled="{Binding HasSelection}">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_FormTitle]}" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}" Foreground="{DynamicResource TextPrimaryBrush}" />

                        <!-- Preset Name -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_PresetName]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="TxtName" Padding="6,4" FontSize="{DynamicResource FontSizeCaption}" Text="{Binding PresetName}" />
                        </StackPanel>

                        <!-- Category & Extension -->
                        <Grid ColumnDefinitions="*,10,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_Category]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <ComboBox x:Name="CmbCategory"
                                          ItemsSource="{Binding Categories}"
                                          SelectedItem="{Binding Category}"
                                          Padding="6,4" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Stretch" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4">
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_OutputExt]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBox x:Name="TxtExtension" Padding="6,4" FontSize="{DynamicResource FontSizeCaption}" Text="{Binding OutputExtension}" />
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_Description]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="TxtDescription" Padding="6,4" FontSize="{DynamicResource FontSizeCaption}" Text="{Binding PresetDescription}" TextWrapping="Wrap" Height="45" AcceptsReturn="True" />
                        </StackPanel>

                        <!-- FFmpeg CLI Arguments -->
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_FfmpegArgs]}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBox x:Name="TxtFfmpegArgs" Padding="6,4" FontSize="{DynamicResource FontSizeCaption}" FontFamily="Cascadia Code, Consolas, monospace" Text="{Binding FfmpegArguments}" TextWrapping="Wrap" Height="60" AcceptsReturn="True" />
                        </StackPanel>

                        <Button Classes="primary" Command="{Binding SaveCurrentCommand}" Padding="14,6" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[PresetManager_SavePreset]}" FontSize="{DynamicResource FontSizeCaption}" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Click="Close_Click" Padding="16,6" Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Common_Close]}" FontSize="{DynamicResource FontSizeCaption}" />
        </StackPanel>
    </Grid>
</Window>
